`;

exports[`www/contact.html 1`] = `
"<!doctype html>
html [lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="Request a custom 3D experience for someone you love or for your business. Reach out and your host will be glad to hear the story." name="description"]
    meta [content="#f7f7fb" media="(prefers-color-scheme: light)" name="theme-color"]
    meta [content="#0e0f14" media="(prefers-color-scheme: dark)" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/contact.html" rel="canonical"]
    meta [content="Contact | SceneXP" property="og:title"]
    meta [content="Request a custom 3D experience for someone you love or for your business. Your host would be glad to hear the story." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="SceneXP" property="og:site_name"]
    meta [content="https://www.scenexp.com/contact.html" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/assets/og-image.jpg?v=4" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="Four scenes from the SceneXP collection in a grid: a glowing orange fractal spiral, a 3D football field with orange and blue players in the middle of a play, a row of red-fruited trees in a green garden, and the blue curve of Earth seen from orbit with a targeting reticle and incoming raiders. Below them the SceneXP.com wordmark and the line, 3D worlds, games, and experiments, right in your browser." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="Contact | SceneXP" name="twitter:title"]
    meta [content="Request a custom 3D experience for someone you love or for your business." name="twitter:description"]
    meta [content="https://www.scenexp.com/assets/og-image.jpg?v=4" name="twitter:image"]
    meta [content="Four scenes from the SceneXP collection in a grid: a glowing orange fractal spiral, a 3D football field with orange and blue players in the middle of a play, a row of red-fruited trees in a green garden, and the blue curve of Earth seen from orbit with a targeting reticle and incoming raiders. Below them the SceneXP.com wordmark and the line, 3D worlds, games, and experiments, right in your browser." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "ContactPage",
        "@id": "https://www.scenexp.com/contact.html#contactpage",
        "url": "https://www.scenexp.com/contact.html",
        "name": "Contact SceneXP",
        "description": "Request a custom 3D experience for someone you love or for your business.",
        "inLanguage": "en-US",
        "isPartOf": {
          "@id": "https://www.scenexp.com/#website"
        }
      }
    title
      "Contact | SceneXP"
    link [as="style" href="/css/site.min.css?v=9" rel="preload"]
    link [href="/favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="/css/site.min.css?v=9" rel="stylesheet"]
    script [src="/js/theme.min.js?v=1"]
    script [defer src="/js/nav.min.js?v=1"]
    script [src="/js/contact.min.js?v=1" type="module"]
  body
    a.skip-link [href="#main"]
      "Skip to main content"
    header.site-header
      div.container.site-header-inner
        a.brand [href="/"]
          svg.brand-mark [aria-hidden="true" focusable="false" viewbox="0 0 32 32"]
            defs
              lineargradient#brand-grad [x1="0" x2="1" y1="0" y2="1"]
                stop [offset="0" stop-color="#6c4cf1"]
                stop [offset="1" stop-color="#06b6d4"]
            rect [fill="url(#brand-grad)" height="32" rx="8" width="32"]
            path [d="M8 22 14 10l4 8 3-5 3 9" fill="none" stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"]
          "SceneXP"
        nav#site-nav.site-nav [aria-label="Main"]
          ul
            li
              a [href="/#experiences"]
                "Experiences"
            li
              a [href="/avatar/"]
                "Avatar"
            li
              a [aria-current="page" href="/contact.html"]
                "Contact"
            li
              a [href="/contribute.html"]
                "Contribute"
        button#nav-toggle.nav-toggle [aria-controls="site-nav" aria-expanded="false" aria-label="Menu" hidden type="button"]
          svg.icon-nav-open [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            path [d="M4 7h16M4 12h16M4 17h16"]
          svg.icon-nav-close [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            path [d="M6 6l12 12M18 6 6 18"]
        button#theme-toggle.theme-toggle [aria-label="Theme" hidden type="button"]
          svg.icon-theme-light [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            circle [cx="12" cy="12" fill="currentColor" r="4.5" stroke="none"]
            path [d=#f2e7be5368]
          svg.icon-theme-dark [aria-hidden="true" focusable="false" viewbox="0 0 24 24"]
            path [d=#bac0ce3668 fill="currentColor"]
          svg.icon-theme-system [aria-hidden="true" focusable="false" viewbox="0 0 24 24"]
            circle [cx="12" cy="12" fill="none" r="8.5" stroke="currentColor" stroke-width="2"]
            path [d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor"]
    main#main
      div.page-hero
        div.container
          h1
            "We would love to hear your story"
          p
            "Alongside the experiments and games in the collection, we build worlds for people. Those begin the same way every time: someone knows a person who deserves a world, or a business that deserves to be more than another template website. If that sounds like you, please reach out. There is no form to fill and no obligation at all, just a friendly conversation about a story worth telling."
      div.section
        div.container.prose
          h2
            "What happens after you say hello"
          ol
            li
              strong
                "You share the story."
              "A few sentences about the person, place, or business you have in mind is plenty to start."
            li
              strong
                "We sketch the world together."
              "You will get ideas for the setting, the people in it, and the little touches that make it feel true."
            li
              strong
                "The world gets built and polished."
              "You review it as it takes shape, and nothing ships until it feels right to you."
            li
              strong
                "You share the link."
              "The finished experience lives at its own address, ready to be a gift, a tribute, or the front door of your business."
          h2
            "About the founder"
          p
            "SceneXP is an open source project, built and looked after by its founder. If you would like to know more about them, you are welcome to visit their portfolio at"
            a [href="https://devsteve.com/" rel="noopener noreferrer" target="_blank" title="Visit devSteve.com, the portfolio site of the SceneXP founder"]
              "devSteve.com"
            "."
          h2
            "Email your host"
          p
            "To keep this address away from spam robots, your browser solves a tiny puzzle before the email appears. It takes a blink of an eye."
        div.container
          div#contact-reveal.contact-reveal [hidden]
            h2
              "Direct email"
            p#contact-reveal-status.contact-reveal-status [aria-live="polite" role="status"]
            p#contact-reveal-link.contact-reveal-link
            p.contact-reveal-note
              "A quick note on the address: SceneXP is a project of Continuum Commerce LLC, the legal entity behind the site, so your email goes to the company inbox."
          noscript
            div.noscript-note
              p
                "The email address appears here once JavaScript is allowed to run. That small step is what keeps the address out of the hands of spam robots. Thank you for understanding, and please do come back with JavaScript enabled."
        div.container.prose
          h2
            "Or find us on GitHub"
          p
            "If you hit a bug in one of the experiences, or you would like to build one of your own with the parts library, GitHub is the better door. An issue carries the browser and the device it happened on, and the answer stays where the next person to hit it will find it. The source lives at"
            a [href="https://github.com/stevendnoll/SceneXP" rel="noopener noreferrer" target="_blank" title="View the SceneXP source code on GitHub"]
              "github.com/stevendnoll/SceneXP"
            ", the"
            a [href="https://github.com/stevendnoll/SceneXP/issues" rel="noopener noreferrer" target="_blank" title="Open an issue on the SceneXP repository"]
              "issue tracker"
            "is open to anyone with an account, and"
            a [href="/contribute.html"]
              "the contributor guide"
            "walks through building a world of your own."
          p
            "It is a public conversation, though, and it needs an account. Anything you would rather keep private belongs in the email above."
    footer.site-footer
      div.container.site-footer-inner
        div.footer-brand
          a.brand [href="/"]
            svg.brand-mark [aria-hidden="true" focusable="false" viewbox="0 0 32 32"]
              defs
                lineargradient#brand-grad-footer [x1="0" x2="1" y1="0" y2="1"]
                  stop [offset="0" stop-color="#6c4cf1"]
                  stop [offset="1" stop-color="#06b6d4"]
              rect [fill="url(#brand-grad-footer)" height="32" rx="8" width="32"]
              path [d="M8 22 14 10l4 8 3-5 3 9" fill="none" stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"]
            "SceneXP"
          p
            "3D worlds, games, and experiments, every one running right in your browser. Thank you for visiting."
        nav.footer-nav [aria-label="Explore"]
          h2
            "Explore"
          ul
            li
              a [href="/#experiences"]
                "Experiences"
            li
              a [href="/avatar/"]
                "Your avatar"
            li
              a [href="/contact.html"]
                "Contact"
            li
              a [href="/contribute.html"]
                "Contribute"
        nav.footer-nav [aria-label="Project"]
          h2
            "Project"
          ul
            li
              a [href="https://github.com/stevendnoll/SceneXP" rel="noopener noreferrer" target="_blank" title="View the SceneXP source code on GitHub"]
                "GitHub"
            li
              a [href="/privacy.html"]
                "Privacy"
            li
              a [href="/terms.html"]
                "Terms"
        div.footer-meta
          p
            "Built with Three.js and browser-native HTML, CSS, and JavaScript. Open source under the MIT license."
          p
            "SceneXP © 2026"
            a [href="https://www.continuumcommercellc.com/" rel="noopener noreferrer" target="_blank" title="View the Continuum Commerce LLC website"]
              "Continuum Commerce LLC"
            ".""
`;

