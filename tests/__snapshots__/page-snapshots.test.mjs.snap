          {
            "@type": "ListItem",
            "position": 2,
            "name": "Gavin's Bug Patrol",
            "item": "https://www.scenexp.com/gavin/"
          }
        ]
      }
    title
      "Gavin's Bug Patrol | SceneXP"
    link [as="style" href="../shared/css/styles-1.0.0.min.css?v=7" rel="preload"]
    link [as="style" href="css/experience.min.css?v=2" rel="preload"]
    link [href="../lib/three/r186/three.min.js" rel="modulepreload"]
    link [href="js/main.min.js" rel="modulepreload"]
    link [href="js/config.min.js" rel="modulepreload"]
    link [href="../shared/js/boot-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/pan-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/scene-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/warmup-1.0.0.min.js" rel="modulepreload"]
    link [href="js/store.min.js" rel="modulepreload"]
    link [href="../shared/js/world-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/scenery-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/telemetry-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/proplist-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/people-1.0.0.min.js" rel="modulepreload"]
    link [href="favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    link [href="css/experience.min.css?v=2" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    h1.sr-only
      "Gavin's Bug Patrol"
    noscript
      div.noscript-fallback
        h1
          "Gavin's Bug Patrol"
        p
          "This is a living 3D close-up of the Confederate Jasmine on the developer's front patio, and it needs JavaScript to run. Every spring his eleven-year-old son Gavin buys ladybugs and praying mantis eggs from the garden center and releases them into the patio plants. Then he and his friends spend weeks searching the leaves for signs of them. In the 3D scene you hold one quiet view of the jasmine while ladybugs patrol the leaves, two mantises keep very still, ants march the planter box, a spider minds her web, bees commute between the flowers, and Gavin and two friends peer in through the far side of the plant. If you would like a small world like this built for someone you love, the developer would be glad to hear from you."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        div.loader-title
          "GAVIN'S BUG PATROL"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    div#blocker
      div#instructions
        p.title
          "WELCOME"
        p.subtitle
          "Every spring, Gavin releases ladybugs into the patio plants"
        p.click-prompt
          "Click to look closer"
        div.controls-hint
          span
            "SIT BACK"
          "No controls needed. The garden does the moving."
          span
            "SPOT THEM"
          "Three praying mantises are hiding. Click them when you find them."
        a#explore-link.welcome-explore [href="/"]
          "More 3D worlds to explore at SceneXP.com"
    div#mantis-chip.mantis-chip [aria-live="polite" role="status"]
    div#dialog-modal.hidden [aria-labelledby="dialog-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#dialog-title.piece-title
            "In the Garden"
          p#dialog-message.piece-subtitle
          button.piece-enter.dialog-primary [data-close type="button"]
            "Keep watching"
    canvas#game-canvas [aria-label="A living 3D close-up of a Confederate Jasmine plant: ladybugs, praying mantises, ants, a spider, and bees move through the leaves while Gavin and two friends peer in from the far side" role="img"]
    section#prop-panel.prop-panel [aria-labelledby="prop-panel-heading" hidden]
      h2#prop-panel-heading.prop-panel-heading
        "Things in the garden"
      p.prop-panel-note
        "Choose anything for a little of its story. The arrow keys move through the list, Escape closes whatever opens, and Tab or Escape puts this list away."
      ul#prop-list.prop-list
    script [src="../lib/three/r186/three.min.js" type="module"]
    script [src="js/main.min.js" type="module"]"
`;

