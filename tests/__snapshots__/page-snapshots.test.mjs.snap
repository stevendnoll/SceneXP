    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    h1.sr-only
      "Jamar's Karaoke Night"
    noscript
      div.noscript-fallback
        h1
          "Jamar's Karaoke Night"
        p
          "This is a living 3D scene of karaoke night at the corner bar, and it needs JavaScript to run. The developer built it as a birthday present for his best friend Jamar, who is exactly the person you hope grabs the microphone on karaoke night. In the 3D scene, Jamar sings from the corner stage while the lyrics screen rolls, the speakers keep the beat, the disco ball turns, and the developer and their friend Mike raise glasses from the booth beside the stage. Everything in the room can be clicked for a little of its story. If you would like a small world like this built for someone you love, the developer would be glad to hear from you."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        div.loader-title
          "JAMAR'S KARAOKE NIGHT"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    div#blocker
      div#instructions
        p.title
          "WELCOME"
        p.subtitle
          "It is karaoke night at the corner bar, and the birthday man has the mic"
        p.click-prompt
          "Click to join the crowd"
        div.controls-hint
          span
            "SIT BACK"
          "No controls needed. Jamar handles the entertainment."
          span
            "LOOK CLOSER"
          "Click anything in the bar, or anyone, for a little of its story."
    div#dialog-modal.hidden [aria-labelledby="dialog-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#dialog-title.piece-title
            "At the Bar"
          p#dialog-message.piece-subtitle
          button.piece-enter.dialog-primary [data-close type="button"]
            "Back to the show"
    div#jukebox-modal.hidden [aria-labelledby="jukebox-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#jukebox-title.piece-title
            "The Jukebox"
          p.piece-subtitle
            "Every quarter plays for the birthday act tonight. Pick what Jamar sings next."
          div#jukebox-songs.jukebox-songs
          button.piece-enter.dialog-primary [data-close type="button"]
            "Back to the show"
    div#tv-view.hidden [aria-label="The karaoke screen, up close" aria-modal="true" role="dialog"]
      div.tv-backdrop [data-close]
      div.tv-frame
        div.tv-bezel
          div.tv-screen
            canvas#tv-canvas.tv-canvas
            div.tv-glass [aria-hidden="true"]
      p#tv-caption.tv-caption
      button.tv-close [aria-label="Step back from the screen" data-close]
        "&times;"
    canvas#game-canvas [aria-label="A living 3D karaoke bar: Jamar sings on the corner stage under magenta and blue lights while the lyrics screen rolls, the speakers keep the beat, the disco ball turns, and Steve and Mike raise glasses from the booth beside the stage" role="img"]
    section#prop-panel.prop-panel [aria-labelledby="prop-panel-heading" hidden]
      h2#prop-panel-heading.prop-panel-heading
        "Things in the bar"
      p.prop-panel-note
        "Choose anything for a little of its story. The arrow keys move through the list, Escape closes whatever opens, and Tab or Escape puts this list away."
      ul#prop-list.prop-list
    script [src="../lib/three/r186/three.min.js" type="module"]
    script [src="js/main.min.js" type="module"]"
`;

