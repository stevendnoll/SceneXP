        "name": "Zumba with Roqui",
        "description": "A walkable 3D Zumba class, built with love for a wonderful instructor at the Matt Griffin YMCA.",
        "datePublished": "2026-07-11",
        "inLanguage": "en-US",
        "isPartOf": {
          "@type": "WebSite",
          "@id": "https://www.scenexp.com/#website"
        }
      }
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
