    link [href="js/store.min.js" rel="modulepreload"]
    link [href="../shared/js/world-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/telemetry-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/people-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/furniture-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/scenery-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/structures-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/lighting-1.0.0.min.js" rel="modulepreload"]
    link [href="favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    link [href="css/experience.min.css?v=1" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    a.skip-link [href="#help-btn"]
      "Skip to the About button"
    h1.sr-only
      "John Walker, The Auto Man"
    noscript
      div.noscript-fallback
        h1
          "John Walker, The Auto Man"
        p
          "This is a living 3D visit to a car dealership desk, and it needs JavaScript to run. It was built for John Walker, who goes by The Auto Man, and what he does is simple: he does the negotiating for you, so you never have to do it yourself. In his own words, he will desk the whole deal on your behalf. There are four places a car deal quietly costs a buyer money, and he works all four of them: the trade valuation, the price, the financing and the rate, and the products they add at the end, like the extended warranty, the tire and wheel protection and the GAP insurance. John has spent more than twenty-five years in sales and marketing, ten of them in the automotive industry, with more than 2,000 vehicles through his hands, and he spent them on the dealership side desking these deals himself. He knows where the money is because he used to be the one holding it. In the 3D scene he is at the desk with his customer, pointing at the deal sheet and making her case, while the lot fills the window behind them. The consultation is free, by phone or by Zoom, and if he cannot get you the deal you want, you owe him nothing. He works in Baltimore, Maryland, and anywhere else by Zoom."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/"]
                "The SceneXP experience directory"
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        img.loader-logo.automan-mark [alt="" height="150" src="favicon.svg" width="150"]
        div.loader-title
          "John Walker, The Auto Man"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    div#coach-marks.coach-marks.coach-out
      button.coach-mark [aria-label="Meet John Walker, The Auto Man" data-who="john" hidden type="button"]
        span.coach-halo [aria-hidden="true"]
        span.coach-name [aria-hidden="true"]
          "John"
      button.coach-mark [aria-label="Meet John's customer, the buyer" data-who="customer" hidden type="button"]
        span.coach-halo [aria-hidden="true"]
        span.coach-name [aria-hidden="true"]
          "Buyer"
      button.coach-mark [aria-label="Meet the dealer" data-who="dealer" hidden type="button"]
        span.coach-halo [aria-hidden="true"]
        span.coach-name [aria-hidden="true"]
          "Dealer"
    div#showroom-toast.showroom-toast [aria-live="polite" role="status"]
    p#intro-handle-hint.intro-handle-hint.coach-out [aria-hidden="true"]
      "Tap to re-open"
    button#intro-handle.intro-handle.coach-out [aria-controls="intro-card" aria-expanded="false" type="button"]
      img.portrait-disc.intro-handle-portrait [alt="" decoding="async" height="256" src="assets/john-walker-avatar.webp" width="256"]
      "John Walker, The Auto Man"
      svg.intro-handle-chevron [aria-hidden="true" viewbox="0 0 12 8"]
        path [d="M 1 6.5 L 6 1.5 L 11 6.5"]
    div#intro-card.intro-card.coach-out [tabindex="-1"]
      button#intro-close.intro-close [aria-label="Collapse this introduction" type="button"]
        "&times;"
      div.intro-head
        img.portrait-disc.intro-portrait [alt="" decoding="async" height="256" src="assets/john-walker-avatar.webp" width="256"]
        p.intro-kicker
          "John Walker, The Auto Man"
      p.intro-lead
        "He does the negotiating, so you never have to."
      p.intro-body
        "Twenty-five years inside the business and more than 2,000 cars, now spent working every line of a deal that costs you money: the trade value, the price, the financing and the rate, and the coverage they add at the end. You do not have to argue for any of it. The first call is free, and if he cannot get you the deal you want, you owe him nothing."
      div.intro-actions
        button#intro-contact.intro-action.lux-primary [type="button"]
          "Talk to John"
        button#intro-about.intro-action [type="button"]
          svg.intro-w [aria-hidden="true" viewbox="3 16.5 58 31"]
            path [d=#f61dfbbb51]
          "What he does"
      p.intro-hint#intro-hint
        "Tap a glowing marker to meet John. Pinch to look closer."
    button#help-btn.ui-float.menu-btn [aria-label="About John, and his flyer" title="About John" type="button"]
      svg [aria-hidden="true" viewbox="3 16.5 58 31"]
        path [d=#f61dfbbb51]
    div#help-modal.hidden [aria-labelledby="poster-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.poster-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        img.about-portrait [alt="John Walker, a bald man in a light blue shirt, smiling in a daylit office with a city skyline behind him." decoding="async" height="720" src="assets/john-walker-about.webp" width="1080"]
        div.about-text
          h2#poster-title.about-title
            "John Walker, The Auto Man"
          p.about-lead
            "He desks the whole deal for you."
          p.about-body
            "There are four places a car deal quietly costs you money: the trade valuation, the price, the financing and the rate, and the products they add at the end, like the extended warranty, the tire and wheel protection and the GAP insurance. John works all four on your behalf. He has spent more than twenty-five years in sales and marketing, ten of them in the automotive industry, with more than 2,000 vehicles through his hands, and he spent them on the dealership side desking these deals himself. He knows where the money is because he used to be the one holding it."
          p.about-body
            "In his own words: let me help you get the best deal for your trade, and I will desk the whole deal for you. That is the part worth repeating. You are not being coached through a negotiation. He does it, and you never have to sit across from anybody and argue about a price."
          p.about-body
            "The consultation is free, by phone or by Zoom. If he cannot get you the deal you want, you owe him nothing, and there is a 100 percent satisfaction guarantee on the small fee if you are not happy. He works in Baltimore, Maryland, and anywhere else by Zoom."
          p.about-flyer
            a#poster-link.about-flyer-link [aria-label="Open John's printed flyer full size in a new tab" href="assets/poster.webp" rel="noopener" target="_blank"]
              "See John's printed flyer &#8599;"
          button#poster-cta.piece-enter.dialog-cta.dialog-primary.lux-primary [type="button"]
            "Talk to John &rarr;"
    div#nudge-modal.hidden [aria-labelledby="nudge-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.complete-card [tabindex="-1"]
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          p.complete-kicker [aria-hidden="true"]
            "Free consultation, by phone or Zoom"
          h2#nudge-title.piece-title
            "Let John handle it"
          p#nudge-message.piece-subtitle
            "In his own words, he will desk the whole deal for you: the trade valuation, the price, the financing and the rate, and the products they add at the end. Twenty-five years of doing that from the dealership side, now spent doing it from yours. If he cannot get you the deal you want, you owe him nothing."
          img#nudge-portrait.portrait-disc.card-portrait [alt="John Walker" decoding="async" height="256" src="assets/john-walker-avatar.webp" width="256"]
          a#contact-call.piece-enter.lux-primary [href=""]
            "Call John"
          a#contact-text.piece-cancel [href=""]
            "Send a text"
          a#contact-email.piece-cancel [href=""]
            "Email John"
          p#contact-status.contact-status [aria-live="polite" role="status"]
          p#contact-fallback.piece-subtitle [aria-live="polite" role="status"]
          p.piece-subtitle.contact-where
            "Baltimore, Maryland, or anywhere by Zoom. 100% satisfaction guarantee."
          p.contact-share
            button#contact-share.contact-share-link [type="button"]
              "Send this to someone who is car shopping"
          button.piece-cancel [data-close]
            "Back to the showroom"
          p.ownership-note
            "The Auto Man name belongs to John Walker and appears here with his blessing."
    canvas#game-canvas [aria-label="A living 3D car dealership desk: John Walker points at a deal sheet and makes his customer's case while she nods along, the dealer listens from across the desk, and cars roll past the lot beyond the glass wall behind them" role="img"]
    script [src="../lib/three/r186/three.min.js" type="module"]
    script [src="js/main.min.js" type="module"]"
`;

