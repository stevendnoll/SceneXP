    link [href="../shared/js/pan-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/scene-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/warmup-1.0.0.min.js" rel="modulepreload"]
    link [href="js/store.min.js" rel="modulepreload"]
    link [href="../shared/js/world-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/telemetry-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/proplist-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/people-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/scenery-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/structures-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/textures-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/lighting-1.0.0.min.js" rel="modulepreload"]
    link [href="favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    a.skip-link [href="#biz-btn"]
      "Skip to the business link"
    h1.sr-only
      "Sunnyvale Jenn Consulting"
    noscript
      div.noscript-fallback
        h1
          "Sunnyvale Jenn Consulting"
        p
          "This is a living 3D visit to the sunny home office of Sunnyvale Jenn Consulting, and it needs JavaScript to run. The developer built it in tribute to Jenn, a talented entrepreneur and former colleague whose calling is helping small businesses untangle and improve their operations. In the 3D scene, Jenn works at her desk facing the doorway, pausing now and then to wave hello. Behind her, a bright window looks out on the back fence, where birds come and go, the week's plan fills the whiteboard, and the rolled yoga mat in the corner is a small nod to her days teaching yoga before consulting. Everything in the room can be clicked for a little of its story. If your business could use calmer operations, Jenn would love to hear from you. And if you would like a small world like this built for someone you admire, so would the developer."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="https://sunnyvalejenn.com/" rel="noopener noreferrer"]
                "Sunnyvale Jenn Consulting website"
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        img.loader-logo.logo-card [alt="" height="150" src="assets/svj-1.webp" width="150"]
        div.loader-title
          "Sunnyvale Jenn Consulting"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    div#blocker
      div#instructions
        img.welcome-logo.logo-card [alt="Sunnyvale Jenn Consulting" height="110" src="assets/svj-1.webp" width="110"]
        p.title
          "WELCOME"
        p.subtitle
          "Jenn is in her home office, and the door is open"
        p.click-prompt
          "Click to step inside"
        div.controls-hint
          span
            "SIT BACK"
          "No controls needed. Jenn is happy to have the company."
          span
            "LOOK CLOSER"
          "Click anything in the office, or Jenn herself, for a little of its story."
        p.welcome-footnote
          "The Sunnyvale Jenn Consulting name and logo belong to Jenn and appear here in tribute."
    a#biz-btn.ui-float.menu-btn.biz-btn.biz-btn-snug [aria-label="Visit the Sunnyvale Jenn Consulting website (opens in a new tab)" href="https://sunnyvalejenn.com/" rel="noopener noreferrer" target="_blank" title="Visit the Sunnyvale Jenn Consulting website"]
      img.biz-logo-round [alt="" height="26" src="assets/svj-1.webp" width="26"]
    div#dialog-modal.hidden [aria-labelledby="dialog-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card [tabindex="-1"]
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#dialog-title.piece-title
            "In the Office"
          p#dialog-message.piece-subtitle
          a#dialog-cta.piece-enter.dialog-cta.hidden [href="https://sunnyvalejenn.com/" rel="noopener noreferrer" target="_blank"]
            "Visit Sunnyvale Jenn Consulting &rarr;"
          button.piece-enter.dialog-primary [data-close type="button"]
            "Back to the visit"
    div#nudge-modal.hidden [aria-labelledby="nudge-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.complete-card [tabindex="-1"]
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          p.complete-kicker [aria-hidden="true"]
            "★ &nbsp;A few stops into the visit&nbsp; ★"
          h2#nudge-title.piece-title
            "Enjoying Jenn's office?"
          p.piece-subtitle
            "Thank you for looking around. This room honors Jenn of Sunnyvale Jenn Consulting, who builds the operations that busy founders do not have time to build. If your business could use that kind of hand, she is a wonderful person to know."
          a#nudge-site.piece-enter [href="https://sunnyvalejenn.com/" rel="noopener noreferrer" target="_blank"]
            "Visit Sunnyvale Jenn Consulting &rarr;"
          a#nudge-contact.piece-cancel [href="/contact.html"]
            "Want a world like this? Get in touch &rarr;"
          button.piece-cancel [data-close]
            "Keep exploring"
    canvas#game-canvas [aria-label="A living 3D home office: Jenn works at a light oak desk facing the doorway, pausing now and then to wave hello, while sunlight pours through the window behind her and birds come and go on the cedar fence outside" role="img"]
    section#prop-panel.prop-panel [aria-labelledby="prop-panel-heading" hidden]
      h2#prop-panel-heading.prop-panel-heading
        "Things in the room"
      p.prop-panel-note
        "Choose anything for a little of its story. The arrow keys move through the list, Escape closes whatever opens, and Tab or Escape puts this list away."
      ul#prop-list.prop-list
    script [src="../lib/three/r186/three.min.js" type="module"]
    script [src="js/main.min.js" type="module"]"
`;

exports[`www/terms.html 1`] = `
"<!doctype html>
html [lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="The friendly terms for visiting SceneXP, including the open source licenses and the logo permissions behind our 3D worlds, games, and experiments." name="description"]
    meta [content="#f7f7fb" media="(prefers-color-scheme: light)" name="theme-color"]
    meta [content="#0e0f14" media="(prefers-color-scheme: dark)" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/terms.html" rel="canonical"]
    meta [content="Terms | SceneXP" property="og:title"]
    meta [content="The friendly terms for visiting SceneXP, including the open source licenses and the logo permissions behind our 3D worlds, games, and experiments." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="SceneXP" property="og:site_name"]
    meta [content="https://www.scenexp.com/terms.html" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/assets/og-image.jpg?v=4" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="Four scenes from the SceneXP collection in a grid: a glowing orange fractal spiral, a 3D football field with orange and blue players in the middle of a play, a row of red-fruited trees in a green garden, and the blue curve of Earth seen from orbit with a targeting reticle and incoming raiders. Below them the SceneXP.com wordmark and the line, 3D worlds, games, and experiments, right in your browser." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="Terms | SceneXP" name="twitter:title"]
    meta [content="The friendly terms for visiting SceneXP, including open source licenses and logo permissions." name="twitter:description"]
    meta [content="https://www.scenexp.com/assets/og-image.jpg?v=4" name="twitter:image"]
    meta [content="Four scenes from the SceneXP collection in a grid: a glowing orange fractal spiral, a 3D football field with orange and blue players in the middle of a play, a row of red-fruited trees in a green garden, and the blue curve of Earth seen from orbit with a targeting reticle and incoming raiders. Below them the SceneXP.com wordmark and the line, 3D worlds, games, and experiments, right in your browser." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "@id": "https://www.scenexp.com/terms.html#webpage",
        "url": "https://www.scenexp.com/terms.html",
        "name": "SceneXP Terms of Service",
        "description": "The terms for visiting and using SceneXP.",
        "inLanguage": "en-US",
        "isPartOf": {
          "@id": "https://www.scenexp.com/#website"
        }
      }
    title
      "Terms | SceneXP"
    link [as="style" href="/css/site.min.css?v=9" rel="preload"]
    link [href="/favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="/css/site.min.css?v=9" rel="stylesheet"]
    script [src="/js/theme.min.js?v=1"]
    script [defer src="/js/nav.min.js?v=1"]
  body
    a.skip-link [href="#main"]
      "Skip to main content"
    header.site-header
      div.container.site-header-inner
        a.brand [href="/"]
          svg.brand-mark [aria-hidden="true" focusable="false" viewbox="0 0 32 32"]
            defs
              lineargradient#brand-grad [x1="0" x2="1" y1="0" y2="1"]
                stop [offset="0" stop-color="#6c4cf1"]
                stop [offset="1" stop-color="#06b6d4"]
            rect [fill="url(#brand-grad)" height="32" rx="8" width="32"]
            path [d="M8 22 14 10l4 8 3-5 3 9" fill="none" stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"]
          "SceneXP"
        nav#site-nav.site-nav [aria-label="Main"]
          ul
            li
              a [href="/#experiences"]
                "Experiences"
            li
              a [href="/avatar/"]
                "Avatar"
            li
              a [href="/contact.html"]
                "Contact"
            li
              a [href="/contribute.html"]
                "Contribute"
        button#nav-toggle.nav-toggle [aria-controls="site-nav" aria-expanded="false" aria-label="Menu" hidden type="button"]
          svg.icon-nav-open [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            path [d="M4 7h16M4 12h16M4 17h16"]
          svg.icon-nav-close [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            path [d="M6 6l12 12M18 6 6 18"]
        button#theme-toggle.theme-toggle [aria-label="Theme" hidden type="button"]
          svg.icon-theme-light [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            circle [cx="12" cy="12" fill="currentColor" r="4.5" stroke="none"]
            path [d=#f2e7be5368]
          svg.icon-theme-dark [aria-hidden="true" focusable="false" viewbox="0 0 24 24"]
            path [d=#bac0ce3668 fill="currentColor"]
          svg.icon-theme-system [aria-hidden="true" focusable="false" viewbox="0 0 24 24"]
            circle [cx="12" cy="12" fill="none" r="8.5" stroke="currentColor" stroke-width="2"]
            path [d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor"]
    main#main
      div.page-hero
        div.container
          h1
            "The terms, kindly stated"
          p
            "Every good visit deserves clear expectations. These are the simple terms for enjoying SceneXP, written to be read rather than skimmed."
      div.section
        div.container.prose
          h2
            "The agreement"
          p
            "By visiting SceneXP or exploring any of its 3D experiences, you agree to these terms. They are short and reasonable, and written to be understood. The site is operated by Continuum Commerce LLC."
          h2
            "Enjoying the site"
          p
            "You are warmly invited to explore every experience, share links with anyone you like, and return as often as you wish. We only ask that you do not attempt to disrupt the service, probe it for vulnerabilities without permission, use the contact form to send spam, or place an unreasonable automated load on the server. In short, please treat the site the way you would treat a home you were welcomed into."
          h2
            "Open source software"
          p
            "SceneXP is built in the open, and it stands on the shoulders of open source software."
          ul
            li
              strong
                "SceneXP itself."
              "The custom HTML, CSS, and JavaScript that make up this site and its experiences are released under the MIT license. The source code lives in the"
              a [href="https://github.com/stevendnoll/SceneXP" rel="noopener noreferrer" target="_blank"]
                "public GitHub repository"
              ", and the"
              a [href="/contribute.html"]
                "contribute page"
              "explains how to build an experience of your own. The one exception is"
              a [href="/whitestone/"]
                "Whitestone Home Care"
              ": its code is published in the same repository so that it can be read, but it belongs to Continuum Commerce LLC with all rights reserved, and it is not covered by the MIT license."
            li
              strong
                "Three.js."
              "The 3D rendering on this site is powered by"
              a [href="https://threejs.org/" rel="noopener noreferrer" target="_blank"]
                "Three.js"
              "(release r186), copyright 2010 to 2026 the Three.js authors, and used under the MIT license. The bundled library file preserves its own license notice, and that notice governs the library rather than our license."
          p
            "Everything else you load here, from fonts to icons, was made for this site. No other third-party code is served."
          h2
            "Company logos and trademarks"
          p
            "Several of our experiences celebrate real businesses, and their logos appear within those worlds and on this site with the kind permission of their owners."
          ul
            li
              strong
                "The Auto Man."
              "The Auto Man name, the three-blade W mark, and the photographs of John Walker are his property and are hosted here solely for the"
              a [href="/automan/"]
                "Auto Man experience"
              "."
            li
              strong
                "Interstate Tire."
              "The Interstate Tire logo is the property of its owner and is hosted here solely for the"
              a [href="/interstate/"]
                "Interstate Tire experience"
              "."
            li
              strong
                "Seed to Seed."
              "The Seed to Seed logo is the property of its owner and is hosted here solely for the"
              a [href="/seedtoseed/"]
                "Seed to Seed experience"
              "."
            li
              strong
                "Sunnyvale Jenn Consulting."
              "The Sunnyvale Jenn Consulting name and its watercolor lotus logo are the property of their owner and are hosted here solely for the"
              a [href="/sunnyvalejenn/"]
                "Sunnyvale Jenn Consulting experience"
              "."
          p
            "These logos, the photographs that appear alongside them, and any other trademarks on the site are not covered by our MIT license. Please do not copy or reuse them without permission from their respective owners. That includes John Walker's three-blade W, which is drawn in the page itself rather than loaded as a picture, so it travels with our open source code without being covered by its license. The SceneXP name and mark belong to Continuum Commerce LLC."
          p
            "So do the X's and O's name, its orange X and blue O mascots, and the game's sound effects, which it shares with the original game at exesnohs.com. They ship with our open source code so the game can be played, but they are not covered by our MIT license either, and we would be grateful if they were not reused elsewhere."
          p
            "The Whitestone Home Care name and logo were made for a fictional company and belong to Continuum Commerce LLC as well. They are not covered by our MIT license either."
          h2
            "About the experiences"
          p
            "The collection holds several kinds of 3D experience. Some are games, simulations, or experiments and depict nobody in particular. Others were created to honor a real person or business, and every one of those is hosted with the blessing of the people it celebrates. Some of them begin as surprises, and if an honoree would prefer that theirs not be shown, it will be removed from the site. Those scenes are affectionate, stylized portraits rather than exact records, so please enjoy them in that spirit."
          p
            "One is a concept rather than a tribute. Whitestone Home Care is a fictional company, invented to show what a small business could offer its customers in 3D. It is not a real business and has no connection to any real company with a similar name. Its prices and bookings are examples, nothing booked there is a real appointment, and no one will come to clean."
          h2
            "Provided as is"
          p
            "SceneXP is a labor of love. The site and everything on it are provided as is, without warranty of any kind, express or implied. We work hard to keep every experience smooth and every page accurate, but we cannot promise the site will always be available or free of errors. To the fullest extent permitted by law, Continuum Commerce LLC is not liable for any damages arising from your use of the site."
          h2
            "Changes to these terms"
          p
            "If these terms ever change, the updated version will be posted on this page. Meaningful changes will be noted plainly rather than buried. Continuing to use the site after a change means you accept the updated terms."
          h2
            "Questions"
          p
            "If anything here is unclear, or if you are a logo owner or contributor with a question, please"
            a [href="/contact.html"]
              "reach out"
            ". We would be glad to help."
          p
            em
              "Last updated October 16, 2026."
    footer.site-footer
      div.container.site-footer-inner
        div.footer-brand
          a.brand [href="/"]
            svg.brand-mark [aria-hidden="true" focusable="false" viewbox="0 0 32 32"]
              defs
                lineargradient#brand-grad-footer [x1="0" x2="1" y1="0" y2="1"]
                  stop [offset="0" stop-color="#6c4cf1"]
                  stop [offset="1" stop-color="#06b6d4"]
              rect [fill="url(#brand-grad-footer)" height="32" rx="8" width="32"]
              path [d="M8 22 14 10l4 8 3-5 3 9" fill="none" stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"]
            "SceneXP"
          p
            "3D worlds, games, and experiments, every one running right in your browser. Thank you for visiting."
        nav.footer-nav [aria-label="Explore"]
          h2
            "Explore"
          ul
            li
              a [href="/#experiences"]
                "Experiences"
            li
              a [href="/avatar/"]
                "Your avatar"
            li
              a [href="/contact.html"]
                "Contact"
            li
              a [href="/contribute.html"]
                "Contribute"
        nav.footer-nav [aria-label="Project"]
          h2
            "Project"
          ul
            li
              a [href="https://github.com/stevendnoll/SceneXP" rel="noopener noreferrer" target="_blank" title="View the SceneXP source code on GitHub"]
                "GitHub"
            li
              a [href="/privacy.html"]
                "Privacy"
            li
              a [aria-current="page" href="/terms.html"]
                "Terms"
        div.footer-meta
          p
            "Built with Three.js and browser-native HTML, CSS, and JavaScript. Open source under the MIT license."
          p
            "SceneXP © 2026"
            a [href="https://www.continuumcommercellc.com/" rel="noopener noreferrer" target="_blank" title="View the Continuum Commerce LLC website"]
              "Continuum Commerce LLC"
            ".""
`;

