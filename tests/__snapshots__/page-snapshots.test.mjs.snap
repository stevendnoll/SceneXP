    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="A living 3D visit to the sunny home office of Sunnyvale Jenn Consulting. Jenn is at her desk untangling a small business's operations, the week's plan is on the whiteboard, and birds come and go on the fence outside her window." name="description"]
    meta [content="#1d4e5f" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/sunnyvalejenn/" rel="canonical"]
    meta [content="Sunnyvale Jenn Consulting" property="og:title"]
    meta [content="A living 3D visit to the home office of Sunnyvale Jenn Consulting. Jenn is at her desk, the sun is in the window, and the birds are on the fence." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="SceneXP" property="og:site_name"]
    meta [content="https://www.scenexp.com/sunnyvalejenn/" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/sunnyvalejenn/assets/og-sunnyvalejenn.jpg?v=1" property="og:image"]
