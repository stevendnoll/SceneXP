            circle [cx="12" cy="12" fill="currentColor" r="4.5" stroke="none"]
            path [d=#f2e7be5368]
          svg.icon-theme-dark [aria-hidden="true" focusable="false" viewbox="0 0 24 24"]
            path [d=#bac0ce3668 fill="currentColor"]
          svg.icon-theme-system [aria-hidden="true" focusable="false" viewbox="0 0 24 24"]
            circle [cx="12" cy="12" fill="none" r="8.5" stroke="currentColor" stroke-width="2"]
            path [d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor"]
    main#main
      div.page-hero
        div.container
          h1
            "We would love to hear your story"
          p
            "Alongside the experiments and games in the collection, we build worlds for people. Those begin the same way every time: someone knows a person who deserves a world, or a business that deserves to be more than another template website. If that sounds like you, please reach out. There is no form to fill and no obligation at all, just a friendly conversation about a story worth telling."
      div.section
        div.container.prose
          h2
            "What happens after you say hello"
          ol
            li
              strong
                "You share the story."
              "A few sentences about the person, place, or business you have in mind is plenty to start."
            li
              strong
                "We sketch the world together."
              "You will get ideas for the setting, the people in it, and the little touches that make it feel true."
            li
              strong
                "The world gets built and polished."
              "You review it as it takes shape, and nothing ships until it feels right to you."
            li
              strong
                "You share the link."
              "The finished experience lives at its own address, ready to be a gift, a tribute, or the front door of your business."
          h2
            "About the founder"
          p
            "SceneXP is an open source project, built and looked after by its founder. If you would like to know more about them, you are welcome to visit their portfolio at"
            a [href="https://devsteve.com/" rel="noopener noreferrer" target="_blank" title="Visit devSteve.com, the portfolio site of the SceneXP founder"]
              "devSteve.com"
            "."
          h2
            "Email your host"
          p
            "To keep this address away from spam robots, your browser solves a tiny puzzle before the email appears. It takes a blink of an eye."
        div.container
          div#contact-reveal.contact-reveal [hidden]
            h2
              "Direct email"
            p#contact-reveal-status.contact-reveal-status [aria-live="polite" role="status"]
            p#contact-reveal-link.contact-reveal-link
            p.contact-reveal-note
              "A quick note on the address: SceneXP is a project of Continuum Commerce LLC, the legal entity behind the site, so your email goes to the company inbox."
          noscript
            div.noscript-note
              p
                "The email address appears here once JavaScript is allowed to run. That small step is what keeps the address out of the hands of spam robots. Thank you for understanding, and please do come back with JavaScript enabled."
        div.container.prose
          h2
            "Or find us on GitHub"
          p
            "If you hit a bug in one of the experiences, or you would like to build one of your own with the parts library, GitHub is the better door. An issue carries the browser and the device it happened on, and the answer stays where the next person to hit it will find it. The source lives at"
            a [href="https://github.com/stevendnoll/SceneXP" rel="noopener noreferrer" target="_blank" title="View the SceneXP source code on GitHub"]
              "github.com/stevendnoll/SceneXP"
            ", the"
            a [href="https://github.com/stevendnoll/SceneXP/issues" rel="noopener noreferrer" target="_blank" title="Open an issue on the SceneXP repository"]
              "issue tracker"
            "is open to anyone with an account, and"
            a [href="/contribute.html"]
              "the contributor guide"
            "walks through building a world of your own."
          p
            "It is a public conversation, though, and it needs an account. Anything you would rather keep private belongs in the email above."
    footer.site-footer
      div.container.site-footer-inner
        div.footer-brand
          a.brand [href="/"]
            svg.brand-mark [aria-hidden="true" focusable="false" viewbox="0 0 32 32"]
              defs
                lineargradient#brand-grad-footer [x1="0" x2="1" y1="0" y2="1"]
                  stop [offset="0" stop-color="#6c4cf1"]
                  stop [offset="1" stop-color="#06b6d4"]
              rect [fill="url(#brand-grad-footer)" height="32" rx="8" width="32"]
              path [d="M8 22 14 10l4 8 3-5 3 9" fill="none" stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"]
            "SceneXP"
          p
            "3D worlds, games, and experiments, every one running right in your browser. Thank you for visiting."
        nav.footer-nav [aria-label="Explore"]
          h2
            "Explore"
          ul
            li
              a [href="/#experiences"]
                "Experiences"
            li
              a [href="/contact.html"]
                "Contact"
            li
              a [href="/contribute.html"]
                "Contribute"
        nav.footer-nav [aria-label="Project"]
          h2
            "Project"
          ul
            li
              a [href="https://github.com/stevendnoll/SceneXP" rel="noopener noreferrer" target="_blank" title="View the SceneXP source code on GitHub"]
                "GitHub"
            li
              a [href="/privacy.html"]
                "Privacy"
            li
              a [href="/terms.html"]
                "Terms"
        div.footer-meta
          p
            "Built with Three.js and browser-native HTML, CSS, and JavaScript. Open source under the MIT license."
          p
            "SceneXP © 2026"
            a [href="https://www.continuumcommercellc.com/" rel="noopener noreferrer" target="_blank" title="View the Continuum Commerce LLC website"]
              "Continuum Commerce LLC"
            ".""
`;

exports[`www/contribute.html 1`] = `
"<!doctype html>
html [lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="Build your own browser-native 3D world, game, or experiment with the SceneXP parts library and share it with the world through a GitHub pull request." name="description"]
    meta [content="#f7f7fb" media="(prefers-color-scheme: light)" name="theme-color"]
    meta [content="#0e0f14" media="(prefers-color-scheme: dark)" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/contribute.html" rel="canonical"]
    meta [content="Contribute | SceneXP" property="og:title"]
    meta [content="Build your own browser-native 3D world, game, or experiment with the SceneXP parts library and share it with the world through a GitHub pull request." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="SceneXP" property="og:site_name"]
    meta [content="https://www.scenexp.com/contribute.html" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/assets/og-image.jpg?v=4" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="Four scenes from the SceneXP collection in a grid: a glowing orange fractal spiral, a 3D football field with orange and blue players in the middle of a play, a row of red-fruited trees in a green garden, and the blue curve of Earth seen from orbit with a targeting reticle and incoming raiders. Below them the SceneXP.com wordmark and the line, 3D worlds, games, and experiments, right in your browser." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="Contribute | SceneXP" name="twitter:title"]
    meta [content="Build your own browser-native 3D world, game, or experiment with the SceneXP parts library and share it through a GitHub pull request." name="twitter:description"]
    meta [content="https://www.scenexp.com/assets/og-image.jpg?v=4" name="twitter:image"]
    meta [content="Four scenes from the SceneXP collection in a grid: a glowing orange fractal spiral, a 3D football field with orange and blue players in the middle of a play, a row of red-fruited trees in a green garden, and the blue curve of Earth seen from orbit with a targeting reticle and incoming raiders. Below them the SceneXP.com wordmark and the line, 3D worlds, games, and experiments, right in your browser." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "@id": "https://www.scenexp.com/contribute.html#webpage",
        "url": "https://www.scenexp.com/contribute.html",
        "name": "Contribute to SceneXP",
        "description": "How to build your own browser-native 3D world, game, or experiment with the SceneXP parts library and contribute it through a GitHub pull request.",
        "inLanguage": "en-US",
        "isPartOf": {
          "@id": "https://www.scenexp.com/#website"
        }
      }
    title
      "Contribute | SceneXP"
    link [as="style" href="/css/site.min.css?v=4" rel="preload"]
    link [href="/favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="/css/site.min.css?v=4" rel="stylesheet"]
    script [src="/js/theme.min.js?v=1"]
    script [defer src="/js/nav.min.js?v=1"]
  body
    a.skip-link [href="#main"]
      "Skip to main content"
    header.site-header
      div.container.site-header-inner
        a.brand [href="/"]
          svg.brand-mark [aria-hidden="true" focusable="false" viewbox="0 0 32 32"]
            defs
              lineargradient#brand-grad [x1="0" x2="1" y1="0" y2="1"]
                stop [offset="0" stop-color="#6c4cf1"]
                stop [offset="1" stop-color="#06b6d4"]
            rect [fill="url(#brand-grad)" height="32" rx="8" width="32"]
            path [d="M8 22 14 10l4 8 3-5 3 9" fill="none" stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"]
          "SceneXP"
        nav#site-nav.site-nav [aria-label="Main"]
          ul
            li
              a [href="/#experiences"]
                "Experiences"
            li
              a [href="/contact.html"]
                "Contact"
            li
              a [aria-current="page" href="/contribute.html"]
                "Contribute"
        button#nav-toggle.nav-toggle [aria-controls="site-nav" aria-expanded="false" aria-label="Menu" hidden type="button"]
          svg.icon-nav-open [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            path [d="M4 7h16M4 12h16M4 17h16"]
          svg.icon-nav-close [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            path [d="M6 6l12 12M18 6 6 18"]
        button#theme-toggle.theme-toggle [aria-label="Theme" hidden type="button"]
          svg.icon-theme-light [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            circle [cx="12" cy="12" fill="currentColor" r="4.5" stroke="none"]
            path [d=#f2e7be5368]
          svg.icon-theme-dark [aria-hidden="true" focusable="false" viewbox="0 0 24 24"]
            path [d=#bac0ce3668 fill="currentColor"]
          svg.icon-theme-system [aria-hidden="true" focusable="false" viewbox="0 0 24 24"]
            circle [cx="12" cy="12" fill="none" r="8.5" stroke="currentColor" stroke-width="2"]
            path [d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor"]
    main#main
      div.page-hero
        div.container
          h1
            "Build your own little world"
          p
            "SceneXP is open source under the MIT license, and new experiences are warmly welcomed through GitHub pull requests. A world to walk through, a game, a story, a simulation, or an experiment. Whatever you have in mind, this page will get you building."
      div.section
        div.container.prose
          h2
            "How the project is put together"
          p
            "There is no framework and no build step beyond minification. Each experience is a static folder of browser-native HTML, CSS, and JavaScript, powered by Three.js."
          ul
            li
              strong
                "One folder per experience."
              "Every experience lives in its own folder under"
              code
                "www/"
              "with its own"
              code
                "index.html"
              ", config, and orchestrator. Styling comes from the shared versioned stylesheet in"
              code
                "www/shared/css"
              ", and an experience that needs rules of its own can add an optional"
              code
                "css/experience.css"
              "."
            li
              strong
                "A shared parts library."
              code
                "www/shared/js"
              "holds versioned, general-purpose modules (scene, lighting, controls, people, scenery, and more). An experience keeps its own"
              code
                "main.js"
              "orchestrator and assembles imported parts driven by one plain config object."
            li
              strong
                "Three.js as a global."
              "Each experience's"
              code
                "index.html"
              "loads"
              code
                "lib/three.min.js"
              "as a classic script before its module graph."
            li
              strong
                "esbuild for minification."
              code
                "npm run build"
              "minifies JS and CSS. Every file under"
              code
                "www/"
              "is picked up automatically, so there is no build configuration to edit."
          h2
            "Pick an interaction model"
          p
            "Every experience so far follows one of four interaction models, and choosing one up front is the biggest design decision you will make. All four are assembled from the same shared parts, so the existing experiences double as working references. A new model is welcome too, if none of these fits what you have in mind."
          ul
            li
              strong
                "Explorable worlds."
              "First-person scenes that visitors walk through, with keyboard and mouse on desktop, dual joysticks on phones, and collision so nobody wanders through a wall. Some also offer a guided autopilot tour."
            li
              strong
                "Composed views."
              "A fixed camera frames one lovingly detailed subject, and the scene moves instead of the visitor. A row of floating buttons offers gentle pan and zoom, with matching swipe and pinch gestures on touch screens, and tapping props opens short lines of story. This is the simplest model to build and a great fit for small subjects. Steve's Home Office stands the camera inside its subject instead, a small room the view can turn all the way around. Fractal Garden extends the model, keeping the fixed viewpoint but letting a tap on the ground plant a tree, so the visitor changes the scene rather than just looking around it."
            li
              strong
                "Hands-off rides."
              "The scene drives itself and the visitor mostly watches, with play and pause, speed, and direction controls for light steering. The Mandelbrot dive is the reference: its auto zoom flies the camera while the visitor picks destinations and adjusts the ride. High Water is the strictest version, with no controls at all beyond starting and replaying."
            li
              strong
                "Piloted flight."
              "The visitor drives a vehicle through open space rather than walking or watching, so the world moves around a camera that never stops. Earth Defense is the reference: keyboard and mouse on desktop, a throttle on the left thumb and a look joystick on the right on phones. Reach for this when the subject is the movement itself rather than the place."
          h2
            "Layer on the delight"
          p
            "Whichever model you choose, a few optional layers have proven to be the difference between a scene visitors look at and a scene they share:"
          ul
            li
              strong
                "Discovery checklists."
              "A short list of things to find in the scene, ticked off with a small celebration as visitors discover them."
            li
              strong
                "Tap-to-talk props."
              "Objects and characters that respond to a click or tap with a short line of story. In a world built for someone, this is where their personality lives."
            li
              strong
                "Guided tours."
              "An autopilot that drives the camera past the highlights until the visitor takes over."
            li
              strong
                "Featuring a business."
              "An experience built for a business can carry its logo on the loading and welcome screens, a floating button to its website, and a warm invitation card that appears as visitors explore. Always with the owner's permission, and always in the spirit of a tribute rather than an advertisement."
          p
            "The shared modules behind each of these live in"
            code
              "www/shared/js"
            ", documented part by part in its"
            code
              "README.md"
            "."
          h2
            "Dress the shared controls"
          p
            "Every experience shares one welcome screen, loading screen, crosshair, joystick pair, floating button set, and panel family. By default that chrome is a quiet near-white that sits under any scene without competing with it. If your world has a mood of its own, name a theme on your"
            code
              "&lt;html&gt;"
            "element and the whole set follows along:"
          pre
            code
              "&lt;html lang="en" data-ui-theme="garden"&gt;"
          p
            "The themes live at the top of"
            code
              "www/shared/css/styles-1.0.0.css"
            ", next to the"
            code
              "--ui-*"
            "tokens they set. Today's set is"
            code
              "garden"
            "(leaf green),"
            code
              "surf"
            "(sea glass aqua),"
            code
              "neon"
            "(stage-light rose), and"
            code
              "ember"
            "(deep-space amber). Leaving the attribute off keeps the default."
          p
            "Adding a theme is six tokens copied from an existing block. Reach for a light tint of your hue rather than the brand color itself, since the welcome overlay is dark and most brand colors disappear against it. The test suite checks the contrast of every theme, so a mistake here shows up as a red test rather than an unreadable welcome screen."
          p
            "One more token to know about. The mobile joysticks follow your accent unless you set"
            code
              "--ui-joystick-rgb"
            ", and they are a pair of filled circles sat low on the screen, one on each side. In pink and flesh tones that arrangement reads as anatomy rather than as controls, so a theme in that part of the spectrum points the joysticks somewhere cooler and leaves the rest of its palette alone."
          h2
            "Run it locally"
          p
            "ES modules need to be served over HTTP, so run any static server from the"
            code
              "www"
            "folder:"
          pre
            code
              "cd www python3 -m http.server 8000 # then open http://localhost:8000"
          h2
            "Add your experience, step by step"
          ol
            li
              strong
                "Fork the repository"
              "at"
              a [href="https://github.com/stevendnoll/SceneXP" rel="noopener noreferrer" target="_blank"]
                "github.com/stevendnoll/SceneXP"
              "and clone your fork."
            li
              strong
                "Create your folder"
              ", for example"
              code
                "www/your-world/"
              ". The existing experiences are the best reference: start from their structure with an"
              code
                "index.html"
              ", a"
              code
                "js/config.js"
              "describing your world, and a"
              code
                "js/main.js"
              "orchestrator that assembles parts from"
              code
                "www/shared/js"
              "."
            li
              strong
                "Follow the metadata pattern."
              "Every experience page carries a strict same-origin Content Security Policy, full Open Graph and Twitter tags, JSON-LD, and a polite no-JavaScript fallback. Copy the pattern from an existing experience."
            li
              strong
                "Make a social card."
              "A 1200 by 630 capture of your world, saved as"
              code
                "assets/og-&lt;world&gt;.webp"
              "with a"
              code
                ".jpg"
              "beside it. Please read the conversion note in"
              a [href="https://github.com/stevendnoll/SceneXP/blob/main/CONTRIBUTING.md" rel="noopener noreferrer" target="_blank"]
                "CONTRIBUTING.md"
              "before you make it, because a screenshot taken on a Mac carries the display's color profile and will come out visibly duller than what you were looking at unless you convert it properly."
            li
              strong
                "Build and test."
              "Run"
              code
                "npm run build"
              "(your new files are minified automatically), then"
              code
                "npm test"
              ". Please include a small unit test for your world, following the"
              code
                "tests"
              "folder's"
              code
                "&lt;experience&gt;-init.test.mjs"
              "pattern. Every pull request should bring tests along for the code it adds or changes."
            li
              strong
                "Add your world to the directory."
              "The home page groups the collection into three categories, so please pick the one your world belongs to: Worlds and games for anything built for its own sake, Small business tributes, or Personal tributes. Then add one card at the top of that group in"
              code
                "www/index.html"
              ", add your world at the top of the same category's structured-data list in that file's head, one URL in"
              code
                "www/sitemap.xml"
              ", and a short description under your category's heading in"
              code
                "www/llms.txt"
              ". The test suite checks that all four agree."
            li
              strong
                "If your world remembers anything, say so in the privacy policy."
              code
                "sessionStorage"
              "needs nothing, since it goes when the tab closes and the policy already covers it. Anything you put in"
              code
                "localStorage"
              "outlives the visit, so it has to be named in"
              code
                "www/privacy.html"
              "along with how a visitor clears it. The test suite keeps the list of files allowed to write persistent storage and will fail the moment yours joins them, which is the reminder rather than the rule."
            li
              strong
                "Open a pull request"
              "telling us the story behind your world. The"
              code
                "main"
              "branch does not accept direct pushes, so every change to the project arrives this way, and we read every pull request with genuine delight."
          h2
            "House rules"
          ul
            li
              strong
                "Give visitors something worth their time."
              "That is the only test an experience has to pass here. Some of ours celebrate a real person, place, or business, and those are always welcome. So is a game, a simulation, or an experiment that honors nobody at all. Kind worlds only, please, whichever kind you bring."
            li
              strong
                "Security first."
              "Same-origin CSP, no third-party scripts, no trackers, no CDNs. Everything ships from this domain."
            li
              strong
                "Accessible and considerate."
              "Keyboard support, reduced-motion respect, and a no-JavaScript fallback are part of the pattern, not extras."
            li
              strong
                "Fast on phones."
              "Many visitors arrive on mobile, so please keep assets lean and performance in mind."
            li
              strong
                "MIT licensed."
              "Your contribution is published under the project's MIT license. The bundled"
              code
                "three.min.js"
              "keeps its own license."
          h2
            "Ready when you are"
          p
            "The source code is live at"
            a [href="https://github.com/stevendnoll/SceneXP" rel="noopener noreferrer" target="_blank"]
              "github.com/stevendnoll/SceneXP"
            ", and we would love to see what you build. If you have questions along the way, or a story you are excited to tell, please"
            a [href="/contact.html"]
              "reach out"
            "and we will figure it out together."
    footer.site-footer
      div.container.site-footer-inner
        div.footer-brand
          a.brand [href="/"]
            svg.brand-mark [aria-hidden="true" focusable="false" viewbox="0 0 32 32"]
              defs
                lineargradient#brand-grad-footer [x1="0" x2="1" y1="0" y2="1"]
                  stop [offset="0" stop-color="#6c4cf1"]
                  stop [offset="1" stop-color="#06b6d4"]
              rect [fill="url(#brand-grad-footer)" height="32" rx="8" width="32"]
              path [d="M8 22 14 10l4 8 3-5 3 9" fill="none" stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"]
            "SceneXP"
          p
            "3D worlds, games, and experiments, every one running right in your browser. Thank you for visiting."
        nav.footer-nav [aria-label="Explore"]
          h2
            "Explore"
          ul
            li
              a [href="/#experiences"]
                "Experiences"
            li
              a [href="/contact.html"]
                "Contact"
            li
              a [href="/contribute.html"]
                "Contribute"
        nav.footer-nav [aria-label="Project"]
          h2
            "Project"
          ul
            li
              a [href="https://github.com/stevendnoll/SceneXP" rel="noopener noreferrer" target="_blank" title="View the SceneXP source code on GitHub"]
                "GitHub"
            li
              a [href="/privacy.html"]
                "Privacy"
            li
              a [href="/terms.html"]
                "Terms"
        div.footer-meta
          p
            "Built with Three.js and browser-native HTML, CSS, and JavaScript. Open source under the MIT license."
          p
            "SceneXP © 2026"
            a [href="https://www.continuumcommercellc.com/" rel="noopener noreferrer" target="_blank" title="View the Continuum Commerce LLC website"]
              "Continuum Commerce LLC"
            ".""
`;

exports[`www/dad/index.html 1`] = `
"<!doctype html>
html [data-ui-theme="garden" lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="Take a quiet walk on a 3D stretch of Maryland's NCR Trail, built in loving memory of a dad who rode it every weekend. Meet the riders, find the river, and listen for the little waterfall." name="description"]
    meta [content="#eef3ec" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/dad/" rel="canonical"]
    meta [content="A Ride on the NCR Trail" property="og:title"]
    meta [content="A quiet 3D walk on Maryland's NCR Trail, built by a son in memory of his dad, who loved to ride it. Say hello to the greeter by his bike, and find the little waterfall." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="A Ride on the NCR Trail" property="og:site_name"]
    meta [content="https://www.scenexp.com/dad/" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/dad/assets/og-dad.jpg?v=2" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="A walkable 3D stretch of the NCR trail, with the Gunpowder River alongside." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="A Ride on the NCR Trail" name="twitter:title"]
    meta [content="A quiet 3D walk on Maryland's NCR Trail, built in loving memory of a dad who rode it every weekend." name="twitter:description"]
    meta [content="https://www.scenexp.com/dad/assets/og-dad.jpg?v=2" name="twitter:image"]
    meta [content="A walkable 3D stretch of the NCR trail, with the Gunpowder River alongside." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://www.scenexp.com/dad/#website",
        "url": "https://www.scenexp.com/dad/",
        "name": "A Ride on the NCR Trail",
        "description": "A walkable 3D stretch of Maryland's NCR Trail, built in loving memory of a dad who loved to ride it.",
        "inLanguage": "en-US"
      }
    title
      "A Ride on the NCR Trail"
    link [as="style" href="../shared/css/styles-1.0.0.min.css?v=7" rel="preload"]
    link [as="script" href="../lib/three.min.js" rel="preload"]
    link [href="favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    a.skip-link [href="#autopilot-btn"]
      "Skip to the page controls"
    h1.sr-only
      "A Ride on the NCR Trail"
    noscript
      div.noscript-fallback
        h1
          "A Ride on the NCR Trail"
        p
          "This is a walkable 3D stretch of Maryland's NCR Trail, which needs JavaScript to run. It was built with love, in memory of a dad who rode this trail nearly every weekend. He is out there still, standing beside his bike, happy to say hello. If you would like a small world like this built for someone you love, the developer would be glad to hear from you."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        div.loader-title
          "THE NCR TRAIL"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    div#blocker
      div#instructions
        p.title
          "WELCOME"
        p.subtitle
          "A quiet stretch of the NCR Trail"
        p.click-prompt
          "Click to take a walk"
        div.controls-hint
          span
            "WASD"
          "Move"
          span
            "MOUSE"
          "Look"
        a#explore-link.welcome-explore [href="/"]
          "More 3D worlds to explore at SceneXP.com"
    div#hud
      div.crosshair [aria-hidden="true"]
      div#look-label.look-label [aria-live="polite" role="status"]
    div#piece-modal.hidden [aria-labelledby="piece-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#piece-title.piece-title
            "Section"
          p#piece-subtitle.piece-subtitle
          a#piece-enter.piece-enter [href="#"]
            "Enter →"
          button.piece-cancel [data-close]
            "Keep exploring"
    div#help-modal.hidden [aria-labelledby="help-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.help-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#help-title.piece-title
            "Hello"
          p.piece-subtitle
            "Well hello there, so glad you came out. This is my favorite stretch of trail in the whole world. Take your time, there is no hurry out here."
          ul.help-list
            li.help-desktop
              strong
                "Move:"
              kbd
                "W"
              kbd
                "A"
              kbd
                "S"
              kbd
                "D"
              "or the arrow keys."
            li.help-desktop
              strong
                "Look:"
              "move the mouse. Click the scene once to capture the cursor. Press"
              kbd
                "Esc"
              "to release it."
            li.help-mobile
              strong
                "Move &amp; look:"
              "use the left joystick to walk and the right joystick to look around."
            li
              strong
                "The river:"
              "follow the fence line east to the overlook. You will hear the little waterfall before you see it."
            li
              strong
                "The riders:"
              "a few of my friends are out on the trail today. Give them a wave as they pass."
            li
              strong
                "The notice board:"
              "the kiosk by the trailhead lists a few things worth finding out here."
            li
              strong
                "Autopilot:"
              "press"
              kbd
                "T"
              "or the tour button (top-left) and the trail will show you around. Move to take back the controls."
            li
              strong
                "Settings:"
              "the gear icon (top-right) adjusts movement and look sensitivity."
          button.piece-cancel [data-close]
            "Thanks, enjoy the trail!"
    div#dialog-modal.hidden [aria-labelledby="dialog-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#dialog-title.piece-title
            "On the Trail"
          p#dialog-message.piece-subtitle
          button.piece-enter.dialog-primary [data-close type="button"]
            "Continue exploring"
          button#dialog-return-btn.piece-cancel.dialog-return.hidden [type="button"]
            "Back to the Trailhead"
    div#complete-modal.hidden [aria-labelledby="complete-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.complete-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          p.complete-kicker [aria-hidden="true"]
            "★ &nbsp;All discoveries found&nbsp; ★"
          h2#complete-title.piece-title
            "You walked every step of it"
          p.piece-subtitle
            "Thank you for taking your time out here. This stretch of trail was built with love, in memory of a dad who rode it for years. If you would like a small world like this made for someone you love, or for your business, I would genuinely love to hear from you."
          a#complete-contact.piece-enter [href="/contact.html"]
            "Get in touch →"
          button#complete-share.piece-cancel.complete-share [type="button"]
            "Share this"
          p#complete-share-status.sr-only [aria-live="polite" role="status"]
          button.piece-cancel [data-close]
            "Keep exploring"
    div#nudge-modal.hidden [aria-labelledby="nudge-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.complete-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          p.complete-kicker [aria-hidden="true"]
            "★ &nbsp;A few discoveries in&nbsp; ★"
          h2#nudge-title.piece-title
            "Enjoying the trail?"
          p.piece-subtitle
            "Thanks for spending a little time out here. This place was built in memory of a wonderful dad. If you would like something like it built for someone you care about, I would love to hear from you. No rush, the trail is not going anywhere."
          a#nudge-contact.piece-enter [href="/contact.html"]
            "Get in touch →"
          button.piece-cancel [data-close]
            "Keep exploring"
    div#whiteboard-view.hidden [aria-label="The trailhead notice board, up close" aria-modal="true" role="dialog"]
      div.whiteboard-backdrop [data-close]
      div.whiteboard-frame
        div.whiteboard-surface
          canvas#whiteboard-canvas.whiteboard-canvas
        div.whiteboard-tray [aria-hidden="true"]
      p#whiteboard-caption.whiteboard-caption
      p.whiteboard-hint [aria-hidden="true"]
        "Drag to pan across the board"
      button.whiteboard-close [aria-label="Step back from the notice board" data-close]
        "&times;"
    div#touch-controls
      div#joystick-zone
        div.joystick-base-fixed
          div.joystick-thumb-fixed
      div#look-joystick-zone
        div.joystick-base-fixed
          div.joystick-thumb-fixed
      div#tap-zone
    button#autopilot-btn.ui-float.menu-btn.autopilot-btn [aria-label="Toggle the autopilot tour (keyboard shortcut T)" aria-pressed="false" title="Autopilot tour (T)"]
      svg [aria-hidden="true" viewbox="0 0 24 24"]
        path [d=#10d062c4ff stroke-dasharray="2.6 2.2"]
        path [d="M21.5 3.6l.6 7.5-6.1-2.4z" fill="currentColor" stroke="none"]
        circle [cx="5" cy="19" fill="currentColor" r="2.2" stroke="none"]
    button#settings-btn.ui-float.settings-btn [aria-controls="settings-panel" aria-expanded="false" aria-label="Movement settings" title="Movement settings"]
      svg.settings-icon [aria-hidden="true" viewbox="0 0 24 24"]
        path [d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"]
        path [d=#88c0d99db8]
    div#settings-panel.settings-panel.hidden
      div.settings-header
        span
          "Settings"
        button#settings-close.settings-close [aria-label="Close"]
          "&times;"
      div.settings-body
        label.settings-label
          "Walk Speed"
          input#walk-speed-slider [max="14" min="2" step="0.5" type="range" value="6.5"]
          span.settings-value#walk-speed-value
            "6.5"
        label.settings-label
          "Look Sensitivity"
          input#look-speed-slider [max="4" min="0.5" step="0.1" type="range" value="1.0"]
          span.settings-value#look-speed-value
            "1.0"
    canvas#game-canvas [aria-label="A walkable 3D stretch of the NCR trail" role="img"]
    script [src="../lib/three.min.js"]
    script [src="js/main.min.js" type="module"]"
`;

exports[`www/earthdefense/index.html 1`] = `
"<!doctype html>
html [data-ui-theme="ember" lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="Fly a single ship in orbit above a massive Earth and defend the installations on Earth and the Moon from an incoming Martian fleet. A small browser game built for the joy of flying through space." name="description"]
    meta [content="#1b1410" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/earthdefense/" rel="canonical"]
    meta [content="Earth Defense" property="og:title"]
    meta [content="Fly in orbit above a massive Earth and hold the line against an incoming Martian fleet. No fire button needed, no tutorial, one sitting." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="SceneXP" property="og:site_name"]
    meta [content="https://www.scenexp.com/earthdefense/" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/earthdefense/assets/og-earthdefense.jpg?v=3" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="A ship's-eye view in low Earth orbit: Earth's blue and white limb curves across the bottom of the frame, Mars sits ahead as a small ruddy disc with the targeting reticle just below it, orange diamonds mark the incoming Martian raiders across a deep starfield, the nearest of them labelled 23k km, and the Moon hangs at the upper right labelled 67k km." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="Earth Defense" name="twitter:title"]
    meta [content="Fly in orbit above a massive Earth and hold the line against an incoming Martian fleet." name="twitter:description"]
    meta [content="https://www.scenexp.com/earthdefense/assets/og-earthdefense.jpg?v=3" name="twitter:image"]
    meta [content="A ship's-eye view in low Earth orbit: Earth's blue and white limb curves across the bottom of the frame, Mars sits ahead as a small ruddy disc with the targeting reticle just below it, orange diamonds mark the incoming Martian raiders across a deep starfield, the nearest of them labelled 23k km, and the Moon hangs at the upper right labelled 67k km." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "VideoGame",
        "@id": "https://www.scenexp.com/earthdefense/#game",
        "url": "https://www.scenexp.com/earthdefense/",
        "name": "Earth Defense",
        "description": "A small browser-based 3D space game. Pilot one ship in orbit above Earth and defend the installations on Earth and the Moon from an incoming Martian fleet. Built for the joy of flying through space.",
        "genre": [
          "Action",
          "Space"
        ],
        "gamePlatform": "Web browser",
        "applicationCategory": "Game",
        "operatingSystem": "Any",
        "inLanguage": "en-US",
        "isAccessibleForFree": true,
        "playMode": "SinglePlayer",
        "image": "https://www.scenexp.com/earthdefense/assets/og-earthdefense.jpg?v=3",
        "author": {
          "@type": "Person",
          "name": "Steve Noll"
        },
        "publisher": {
          "@type": "Organization",
          "name": "Continuum Commerce LLC"
        },
        "isPartOf": {
          "@type": "WebSite",
          "@id": "https://www.scenexp.com/#website"
        }
      }
    title
      "Earth Defense"
    link [as="style" href="../shared/css/styles-1.0.0.min.css?v=7" rel="preload"]
    link [as="style" href="css/experience.min.css?v=4" rel="preload"]
    link [as="script" href="../lib/three.min.js" rel="preload"]
    link [href="favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    link [href="css/experience.min.css?v=4" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    a.skip-link [href="#pause-btn"]
      "Skip to the pause button"
    h1.sr-only
      "Earth Defense"
    noscript
      div.noscript-fallback
        h1
          "Earth Defense"
        p
          "This is a small 3D space game, which needs JavaScript to run. You fly a single ship in orbit above a massive Earth. The Moon is on its slow lap overhead, Mars sits far ahead as a small red disc, and a Martian fleet is already on its way in. Your job is to defend the installations on Earth and the Moon, and you never need a fire button: line a raider up in the middle of your view and your guns take care of the rest. If you would rather press something, the left mouse button and the space bar both shoot."
        p
          "It opens on the Martian commander flying the lead ship of the fleet. &ldquo;Earth will be ours.&rdquo;"
        p
          "SceneXP is a home for 3D experiences that run right in your browser. This one is simply a game, built for the joy of flying through space. There was never a deeper reason than that."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        div.loader-title
          "EARTH DEFENSE"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    div#blocker
      div#instructions
        p.title
          "EARTH DEFENSE"
        p.subtitle
          "Stop the Martian fleet from destroying the installations on Earth and the Moon"
        blockquote.briefing-quote
          p
            "&ldquo;Earth will be ours.&rdquo;"
          cite
            "Intercepted Martian transmission"
        button#take-helm-btn.click-prompt [type="button"]
          "Take the helm"
        button#briefing-menu-btn.briefing-menu-btn [type="button"]
          "Controls and settings"
        div.welcome-hints
          div.controls-hint
            span
              "No fire button needed"
            "Line a raider up in the middle of your view"
          div.controls-hint
            span
              "Seven and twelve"
            "Seven installations to hold, and clearing all twelve raiders is how you win"
        a#explore-link.welcome-explore [href="/"]
          "More 3D worlds to explore at SceneXP.com"
    div#hud
      div#objective-panel.objective-panel [aria-hidden="true"]
        div.objective-row
          span.objective-mark.mark-friendly
          span.objective-count#structures-count
            "7"
          span.objective-label
            "installations"
        div.objective-row
          span.objective-mark.mark-hostile
          span.objective-count#ships-count
            "12"
          span.objective-label
            "raiders"
        div.objective-row.lives-row
          span.objective-label
            "lives"
          span.lives-pips#lives-pips
        div.objective-row.hull-row.hidden#hull-row
          span.objective-label
            "hull"
          span.hull-pips#hull-pips
      div#elapsed-time.elapsed-time [aria-hidden="true"]
        "0:00"
      div#alert-banner.alert-banner.hidden [aria-hidden="true"]
      div#hostile-pips.hostile-pips [aria-hidden="true"]
      div#replay-inset.replay-inset.hidden [aria-hidden="true"]
        span.replay-caption#replay-caption
      div#hostile-range.hostile-range.hidden [aria-hidden="true"]
      div#nav-markers.nav-markers [aria-hidden="true"]
      div#chevron-alert.edge-chevron.chevron-alert.hidden [aria-hidden="true"]
        svg [focusable="false" viewbox="0 0 24 24"]
          path [d="M8 4l8 8-8 8"]
      div#chevron-hostile.edge-chevron.chevron-hostile.hidden [aria-hidden="true"]
        svg [focusable="false" viewbox="0 0 24 24"]
          path [d="M9 5l7 7-7 7"]
      div#reticle.reticle [aria-hidden="true"]
        svg [focusable="false" viewbox="0 0 64 64"]
          circle.reticle-ring [cx="32" cy="32" r="13"]
          path.reticle-ticks [d="M32 8v7M32 49v7M8 32h7M49 32h7"]
          path.reticle-diamond [d="M32 17 47 32 32 47 17 32Z"]
          path.reticle-corners [d=#1afe71b670]
          circle.reticle-dot [cx="32" cy="32" r="1.6"]
      div#lock-bracket.lock-bracket.hidden [aria-hidden="true"]
        svg [focusable="false" viewbox="0 0 48 48"]
          path [d=#e732558685]
      div#speedometer.speedometer [aria-hidden="true"]
        div.speedo-track
          div.speedo-arm.speedo-arm-rev.speedo-ghost#speedo-ghost-rev
          div.speedo-arm.speedo-arm-fwd.speedo-ghost#speedo-ghost-fwd
          div.speedo-arm.speedo-arm-rev#speedo-rev
          div.speedo-arm.speedo-arm-fwd#speedo-fwd
          div.speedo-demand#speedo-demand
          div.speedo-zero#speedo-zero
        div#throttle-readout.throttle-readout
          "0 km/s"
      div#perimeter-notice.perimeter-notice.hidden [aria-live="polite" role="status"]
      p#flight-status.sr-only [aria-live="polite" role="status"]
      p#combat-status.sr-only [aria-live="polite" role="status"]
      p#objective-status.sr-only [aria-live="polite" role="status"]
    div#touch-controls
      div#throttle-zone
        div#throttle-track.throttle-track
          div.throttle-fill#throttle-fill [aria-hidden="true"]
          div.throttle-detent [aria-hidden="true"]
          div.throttle-thumb#throttle-thumb [aria-hidden="true"]
          span.throttle-label.throttle-label-up [aria-hidden="true"]
            "▲"
          span.throttle-label.throttle-label-down [aria-hidden="true"]
            "▼"
      div#look-joystick-zone
        div.joystick-base-fixed
          div.joystick-thumb-fixed#look-thumb
    button#pause-btn.ui-float.menu-btn.pause-btn [aria-label="Pause" title="Pause"]
      svg [aria-hidden="true" viewbox="0 0 24 24"]
        path [d="M9 5.5v13M15 5.5v13"]
    button#skip-intro-btn.skip-intro-btn [aria-label="Skip the opening" type="button"]
      "Skip"
      span.skip-intro-hint
        "&nbsp;the opening"
    div#intro-caption.intro-caption [aria-hidden="true"]
      p.intro-caption-label
        "Intercepted transmission"
      p.intro-caption-line#intro-caption-line
    p#intro-announce.visually-hidden [aria-live="polite" role="status"]
    div#pause-modal.hidden [aria-labelledby="pause-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#pause-title.piece-title
            "Holding station"
          p#pause-subtitle.piece-subtitle
            "Take your time. Nothing moves while this is open."
          ul.help-list
            li.help-desktop
              strong
                "Throttle:"
              kbd
                "W"
              "and"
              kbd
                "S"
              ", or the up and down arrows."
              kbd
                "X"
              "to stop."
            li.help-desktop
              strong
                "Look:"
              "move the mouse, or steer with"
              kbd
                "A"
              kbd
                "D"
              "to turn and"
              kbd
                "Q"
              kbd
                "E"
              "to climb and dive."
            li.help-mobile
              strong
                "Throttle:"
              "the slider on the left. Hold it up to gather speed and pull it down to shed speed. Let go and it springs back to the middle, and the ship keeps the speed it has. Double tap it to come to a stop."
            li.help-mobile
              strong
                "Look:"
              "drag the joystick on the right."
            li
              strong
                "Guns:"
              "you never need a fire button. Line a target up in the middle of your view and the guns take care of the rest. The reticle closes into a diamond the moment they have something."
            li.help-desktop
              strong
                "Firing anyway:"
              "the left mouse button or"
              kbd
                "Space"
              ", if you would rather press something. It shoots straight ahead and hits nothing on its own, so the reticle is still what lands every shot."
            li
              strong
                "The objective:"
              "seven installations on Earth and the Moon, and twelve Martian raiders on their way in. Hold the installations and see off the raiders. Both counts are top left, and both only go down."
            li
              strong
                "Finding things:"
              "every raider carries a diamond, and the closest one is drawn larger with the range to it underneath. Earth and the Moon carry a ring with their distance, and an arrow at the edge of the screen points the way to anything off it."
            li.help-desktop
              strong
                "Pausing:"
              kbd
                "Esc"
              ", or the pause button in the top right. Nothing moves while this panel is open, and everything you can adjust is right here."
            li.help-mobile
              strong
                "Pausing:"
              "the pause button in the top right. Nothing moves while this panel is open, and everything you can adjust is right here."
          details#card-settings.card-settings
            summary
              "Flight settings"
            div.card-settings-body
              label.settings-label
                "Look Sensitivity"
                input#look-speed-slider [max="3" min="0.3" step="0.1" type="range" value="1.0"]
                span.settings-value#look-speed-value
                  "1.0"
              label.settings-check
                input#invert-pitch-toggle [type="checkbox"]
                span
                  "Invert pitch"
              label.settings-check
                input#reduced-fx-toggle [type="checkbox"]
                span
                  "Reduced effects"
              label.settings-check
                input#mute-toggle [type="checkbox"]
                span
                  "Mute sound"
              p.settings-hint
                "Reduced effects lowers the rendering detail, and it starts switched on for phones and tablets. Turn it off any time you would rather have the fuller sky. Nothing in the game is told by sound alone, so muting loses you nothing."
          p.piece-subtitle.dedication
            "Built for the joy of flying through space. There was never a deeper reason than that."
          p.credits
            "Planet and moon textures by"
            a [href="https://www.solarsystemscope.com/textures" rel="noopener noreferrer" target="_blank"]
              "Solar System Scope"
            ", used under"
            a [href="https://creativecommons.org/licenses/by/4.0/" rel="noopener noreferrer" target="_blank"]
              "CC BY 4.0"
            ". Resized and recompressed for this experience."
          button#card-dismiss.piece-enter [data-close type="button"]
            "Back to the helm"
          p.card-home
            a#home-link [href="/"]
              "Back to the main site"
    div#end-modal.hidden [aria-labelledby="end-title" aria-modal="true" role="dialog"]
      div.modal-backdrop
      div.modal-container.piece-card
        div.piece-card-content
          h2#end-title.piece-title
            "Well flown"
          p#end-subtitle.piece-subtitle
          dl.end-stats
            div.end-stat
              dt
                "Time"
              dd#end-time
                "0:00"
            div.end-stat
              dt
                "Installations saved"
              dd#end-saved
                "0"
            div.end-stat
              dt
                "Raiders destroyed"
              dd#end-destroyed
                "0"
          p#end-best.end-best
          div.end-actions
            button#end-share.piece-cancel [type="button"]
              "Share"
            button#restart-btn.piece-enter [type="button"]
              "Fly again"
          p#end-status.end-status.sr-only [aria-live="polite" role="status"]
          div#end-promo.end-promo
    canvas#game-canvas [aria-label="The view from a ship in orbit above Earth, with the Moon and Mars in the distance" role="img"]
    script [src="../lib/three.min.js"]
    script [src="js/main.min.js" type="module"]"
`;

exports[`www/family/index.html 1`] = `
"<!doctype html>
html [data-ui-theme="surf" lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="Play through a 3D pirate mini golf course in Ocean City, Maryland, built from a son's favorite summer memory. Board the pirate ship, walk the plank hole, and meet the family playing their evening round." name="description"]
    meta [content="#eef3ec" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/family/" rel="canonical"]
    meta [content="Putt Putt with Mom and Dad" property="og:title"]
    meta [content="A 3D round of pirate mini golf in Ocean City, built from a son's favorite summer memory of playing putt putt with his parents. Board the ship and walk the plank hole." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="Putt Putt with Mom and Dad" property="og:site_name"]
    meta [content="https://www.scenexp.com/family/" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/family/assets/og-family.jpg?v=1" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="A walkable 3D pirate mini golf course, with a boardable pirate ship floating in a lagoon." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="Putt Putt with Mom and Dad" name="twitter:title"]
    meta [content="A 3D round of pirate mini golf in Ocean City, built from a son's favorite summer memory of playing putt putt with his parents." name="twitter:description"]
    meta [content="https://www.scenexp.com/family/assets/og-family.jpg?v=1" name="twitter:image"]
    meta [content="A walkable 3D pirate mini golf course, with a boardable pirate ship floating in a lagoon." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://www.scenexp.com/family/#website",
        "url": "https://www.scenexp.com/family/",
        "name": "Putt Putt with Mom and Dad",
        "description": "A walkable 3D pirate mini golf course in Ocean City, Maryland, built from a son's favorite summer memory of playing putt putt with his parents.",
        "inLanguage": "en-US"
      }
    title
      "Putt Putt with Mom and Dad"
    link [as="style" href="../shared/css/styles-1.0.0.min.css?v=7" rel="preload"]
    link [as="script" href="../lib/three.min.js" rel="preload"]
    link [href="favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    a.skip-link [href="#autopilot-btn"]
      "Skip to the page controls"
    h1.sr-only
      "Putt Putt with Mom and Dad"
    noscript
      div.noscript-fallback
        h1
          "Putt Putt with Mom and Dad"
        p
          "This is a walkable 3D pirate mini golf course in Ocean City, Maryland, and it needs JavaScript to run. It was built with love from a favorite summer memory: a mom, a dad, and a ten year old playing putt putt by the beach. The family is out there right now, mid round, and the plank hole is waiting. If you would like a small world like this built from a memory you love, the developer would be glad to hear from you."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        div.loader-title
          "PIRATE PUTT PUTT"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    div#blocker
      div#instructions
        p.title
          "WELCOME"
        p.subtitle
          "A pirate mini golf course in Ocean City, MD"
        p.click-prompt
          "Click to play a round"
        div.controls-hint
          span
            "WASD"
          "Move"
          span
            "MOUSE"
          "Look"
        a#explore-link.welcome-explore [href="/"]
          "More 3D worlds to explore at SceneXP.com"
    div#hud
      div.crosshair [aria-hidden="true"]
      div#look-label.look-label [aria-live="polite" role="status"]
    div#piece-modal.hidden [aria-labelledby="piece-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#piece-title.piece-title
            "Section"
          p#piece-subtitle.piece-subtitle
          a#piece-enter.piece-enter [href="#"]
            "Enter →"
          button.piece-cancel [data-close]
            "Keep exploring"
    div#help-modal.hidden [aria-labelledby="help-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.help-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#help-title.piece-title
            "Welcome to Shipwreck Cove"
          p.piece-subtitle
            "Evening! One round of pirate golf, on the house. Take your time out there, the course is all yours tonight. A family is playing their summer round, feel free to say hi."
          ul.help-list
            li.help-desktop
              strong
                "Move:"
              kbd
                "W"
              kbd
                "A"
              kbd
                "S"
              kbd
                "D"
              "or the arrow keys."
            li.help-desktop
              strong
                "Look:"
              "move the mouse. Click the scene once to capture the cursor. Press"
              kbd
                "Esc"
              "to release it."
            li.help-mobile
              strong
                "Move &amp; look:"
              "use the left joystick to walk and the right joystick to look around."
            li
              strong
                "The ship:"
              "cross the gangplank at the north path and you are aboard. Three holes play on deck."
            li
              strong
                "The plank:"
              "the famous hole 7. You can walk the plank yourself, the ropes will keep you dry."
            li
              strong
                "The scorecard:"
              "the board by the entrance lists a few things worth finding tonight."
            li
              strong
                "The conch shell:"
              "right here on the counter. Hold it to your ear and see."
            li
              strong
                "Autopilot:"
              "press"
              kbd
                "T"
              "or the tour button (top-left) and the course will show you around. Move to take back the controls."
            li
              strong
                "Settings:"
              "the gear icon (top-right) adjusts movement and look sensitivity."
          button.piece-cancel [data-close]
            "Thanks, tee me up!"
    div#dialog-modal.hidden [aria-labelledby="dialog-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#dialog-title.piece-title
            "On the Course"
          p#dialog-message.piece-subtitle
          button.piece-enter.dialog-primary [data-close type="button"]
            "Continue exploring"
          button#dialog-return-btn.piece-cancel.dialog-return.hidden [type="button"]
            "Back to the First Tee"
    div#complete-modal.hidden [aria-labelledby="complete-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.complete-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          p.complete-kicker [aria-hidden="true"]
            "★ &nbsp;All discoveries found&nbsp; ★"
          h2#complete-title.piece-title
            "You played the whole course"
          p.piece-subtitle
            "Thank you for spending an evening here. This course was built with love from a favorite childhood memory of playing putt putt with Mom and Dad in Ocean City. If you would like a small world like this made from a memory you love, or for your business, I would genuinely love to hear from you."
          a#complete-contact.piece-enter [href="/contact.html"]
            "Get in touch →"
          button#complete-share.piece-cancel.complete-share [type="button"]
            "Share this"
          p#complete-share-status.sr-only [aria-live="polite" role="status"]
          button.piece-cancel [data-close]
            "Keep exploring"
    div#nudge-modal.hidden [aria-labelledby="nudge-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.complete-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          p.complete-kicker [aria-hidden="true"]
            "★ &nbsp;A few discoveries in&nbsp; ★"
          h2#nudge-title.piece-title
            "Enjoying the course?"
          p.piece-subtitle
            "Thanks for spending a little time here. This place was built from a favorite family memory, one perfect summer evening of putt putt by the beach. If you would like something like it built from a memory you care about, I would love to hear from you. No rush, hole 7 is not going anywhere."
          a#nudge-contact.piece-enter [href="/contact.html"]
            "Get in touch →"
          button.piece-cancel [data-close]
            "Keep exploring"
    div#whiteboard-view.hidden [aria-label="The scorecard board, up close" aria-modal="true" role="dialog"]
      div.whiteboard-backdrop [data-close]
      div.whiteboard-frame
        div.whiteboard-surface
          canvas#whiteboard-canvas.whiteboard-canvas
        div.whiteboard-tray [aria-hidden="true"]
      p#whiteboard-caption.whiteboard-caption
      p.whiteboard-hint [aria-hidden="true"]
        "Drag to pan across the board"
      button.whiteboard-close [aria-label="Step back from the scorecard board" data-close]
        "&times;"
    div#touch-controls
      div#joystick-zone
        div.joystick-base-fixed
          div.joystick-thumb-fixed
      div#look-joystick-zone
        div.joystick-base-fixed
          div.joystick-thumb-fixed
      div#tap-zone
    button#autopilot-btn.ui-float.menu-btn.autopilot-btn [aria-label="Toggle the autopilot tour (keyboard shortcut T)" aria-pressed="false" title="Autopilot tour (T)"]
      svg [aria-hidden="true" viewbox="0 0 24 24"]
        path [d=#10d062c4ff stroke-dasharray="2.6 2.2"]
        path [d="M21.5 3.6l.6 7.5-6.1-2.4z" fill="currentColor" stroke="none"]
        circle [cx="5" cy="19" fill="currentColor" r="2.2" stroke="none"]
    button#settings-btn.ui-float.settings-btn [aria-controls="settings-panel" aria-expanded="false" aria-label="Movement settings" title="Movement settings"]
      svg.settings-icon [aria-hidden="true" viewbox="0 0 24 24"]
        path [d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"]
        path [d=#88c0d99db8]
    div#settings-panel.settings-panel.hidden
      div.settings-header
        span
          "Settings"
        button#settings-close.settings-close [aria-label="Close"]
          "&times;"
      div.settings-body
        label.settings-label
          "Walk Speed"
          input#walk-speed-slider [max="14" min="2" step="0.5" type="range" value="6.5"]
          span.settings-value#walk-speed-value
            "6.5"
        label.settings-label
          "Look Sensitivity"
          input#look-speed-slider [max="4" min="0.5" step="0.1" type="range" value="1.0"]
          span.settings-value#look-speed-value
            "1.0"
    canvas#game-canvas [aria-label="A walkable 3D pirate mini golf course" role="img"]
    script [src="../lib/three.min.js"]
    script [src="js/main.min.js" type="module"]"
`;

exports[`www/garden/index.html 1`] = `
"<!doctype html>
html [data-ui-theme="garden" lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="Plant a garden of 3D fractal trees and watch it live through the years. Choose from seventeen species, each one grown from its own seed so no two are alike, then tend them through spring, summer, autumn, and winter as they grow. Runs in any modern browser with no app and no download." name="description"]
    meta [content="#8fbf76" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/garden/" rel="canonical"]
    meta [content="Fractal Garden" property="og:title"]
    meta [content="Plant a garden of fractal trees, then watch it live through the years. Choose from seventeen species, each grown from its own seed, and tend them through every season as they grow." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="SceneXP" property="og:site_name"]
    meta [content="https://www.scenexp.com/garden/" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/garden/assets/og-garden.jpg?v=3" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="Five fractal fruit trees in full summer leaf, their canopies heavy with red fruit, standing on dark mulch mounds in a walled garden plot. Each trunk has a small blue water gauge at its base. Behind the wall a pale lake sits below gray rolling hills, under a blue sky with white clouds." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="Fractal Garden" name="twitter:title"]
    meta [content="Plant a garden of fractal trees, then watch it live through the years. Every season passes, and the trees remember you." name="twitter:description"]
    meta [content="https://www.scenexp.com/garden/assets/og-garden.jpg?v=3" name="twitter:image"]
    meta [content="Five fractal fruit trees in full summer leaf, their canopies heavy with red fruit, standing on dark mulch mounds in a walled garden plot. Each trunk has a small blue water gauge at its base. Behind the wall a pale lake sits below gray rolling hills, under a blue sky with white clouds." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://www.scenexp.com/garden/#website",
        "url": "https://www.scenexp.com/garden/",
        "name": "Fractal Garden",
        "description": "An interactive 3D scene. Plant fractal trees in an open plot and tend them across the years as the seasons and the weather turn.",
        "inLanguage": "en-US"
      }
    title
      "Fractal Garden"
    link [as="style" href="../shared/css/styles-1.0.0.min.css?v=7" rel="preload"]
    link [as="style" href="css/experience.min.css?v=17" rel="preload"]
    link [as="script" href="../lib/three.min.js" rel="preload"]
    link [href="favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    link [href="css/experience.min.css?v=17" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    h1.sr-only
      "Fractal Garden"
    noscript
      div.noscript-fallback
        h1
          "Fractal Garden"
        p
          "This is an interactive 3D scene, and it needs JavaScript to draw. It begins as an open plot of grassland. You choose a spot, pick one of seventeen trees, and it goes into the ground as a sapling."
        p
          "Then time does the work. Every day and night cycle is a year, and the sun's own hours are the seasons: dawn is spring, noon is summer, dusk is autumn, and midnight is winter. Leaves bud, deepen, turn, and fall. Snow arrives in the small hours and melts as the light comes back. The trees grow a little older every year, and your garden is still there when you return."
        p
          "The one thing they ask for is water, and they ask for it plainly. A small gauge on every bed shows how full that tree's tank is, and a thirsty one raises a blue droplet above it. Tap the droplet and the tree drinks. A tree left dry through enough summers begins to wilt, though it is never truly gone, and the first watering puts buds back on the branches within seconds."
        p
          "SceneXP is a home for 3D experiences that run right in your browser. This one is a garden you plant and tend yourself."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        div.loader-title
          "FRACTAL GARDEN"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    div#blocker [tabindex="-1"]
      div#instructions
        p.title
          "WELCOME"
        p.subtitle
          "An open plot, and as many years as you care to spend on it"
        p.click-prompt#begin-prompt
          "Click to begin"
        ul.controls-hint
          li
            span
              "PLANT"
            "Tap the grass in the plot, or use the Plant button."
          li
            span
              "LOOK"
            "Drag to look around, or use the arrows. Pinch or the plus and minus to zoom."
          li
            span
              "WATER"
            "Tap the blue droplet over a thirsty tree and it drinks."
          li
            span
              "TEND"
            "Tap the mulch under a tree to see how it is doing."
          li
            span
              "GROW"
            "Every day and night is a year, so your trees fill out while you watch."
          li
            span
              "KEEP"
            "Your garden is saved in this browser."
        p#storage-note.storage-note
        a#explore-link.welcome-explore [href="/"]
          "More 3D worlds to explore at SceneXP.com"
    button#help-btn.ui-float.menu-btn.help-btn [aria-label="How this works" title="How this works" type="button"]
      svg [aria-hidden="true" viewbox="0 0 24 24"]
        circle [cx="12" cy="12" fill="none" r="9"]
        path [d="M9.3 9.2a2.8 2.8 0 1 1 3.4 3.3v1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"]
        circle [cx="12.1" cy="17.4" fill="currentColor" r="1.05" stroke="none"]
    button#reset-btn.ui-float.menu-btn.reset-btn [aria-label="Start a new garden" title="Start a new garden" type="button"]
      svg [aria-hidden="true" viewbox="0 0 24 24"]
        path [d="M20 12a8 8 0 1 1-2.5-5.8" fill="none" stroke-linecap="round"]
        path [d="M20 4v4.5h-4.5" fill="none" stroke-linecap="round" stroke-linejoin="round"]
    button#view-reset.pan-btn.view-reset [aria-label="Show the whole garden" hidden title="Show the whole garden" type="button"]
      svg [aria-hidden="true" viewbox="0 0 24 24"]
        path [d="M4 9V5.8A1.8 1.8 0 0 1 5.8 4H9"]
        path [d="M15 4h3.2A1.8 1.8 0 0 1 20 5.8V9"]
        path [d="M20 15v3.2a1.8 1.8 0 0 1-1.8 1.8H15"]
        path [d="M9 20H5.8A1.8 1.8 0 0 1 4 18.2V15"]
        circle [cx="12" cy="12" fill="currentColor" r="1.6" stroke="none"]
    div#season-chip.season-chip [aria-live="polite" role="status"]
    div#garden-toast.garden-toast [aria-live="polite" role="status"]
    button#tend-plant.tend-plant [hidden type="button"]
      "Plant a tree"
    button#water-all.water-all [hidden type="button"]
    div#tend-panel.tend-panel [aria-labelledby="tend-heading" role="group"]
      h2#tend-heading.tend-heading
        "Your trees"
      p.tend-note
        "Choose a tree to see how it is doing, water it, or take it out. Press Escape to close anything that opens."
      p#tend-empty.tend-empty
        "No trees planted yet. Use the Plant a tree button in the top corner."
      ul#tend-list.tend-list
    div#plant-modal.hidden [aria-labelledby="plant-heading" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.plant-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        h2#plant-heading.plant-heading
          "Choose a tree"
        div.plant-tabs [aria-label="Kinds of tree" role="tablist"]
          button#tab-flowering.plant-tab [aria-controls="species-grid" aria-selected="true" role="tab" type="button"]
            "Flowering"
          button#tab-foliage.plant-tab [aria-controls="species-grid" aria-selected="false" role="tab" tabindex="-1" type="button"]
            "Foliage"
        div.plant-layout
          fieldset.species-fieldset
            legend.visually-hidden
              "Species"
            div#species-grid.species-grid [aria-labelledby="tab-flowering" role="tabpanel"]
          div.plant-side
            canvas#preview-canvas.preview-canvas [aria-hidden="true"]
            p#plant-title.plant-title
            p#plant-note.plant-note
        button#plant-confirm.piece-enter [type="button"]
          "Plant it here"
    div#tree-card.hidden [aria-labelledby="tree-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.tree-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        h2#tree-title.piece-title
        div.tree-scroll
          canvas#tree-preview.tree-preview [aria-hidden="true"]
          div#tree-body.tree-body
          div#tree-thirst.tree-thirst [role="img"]
            div#tree-thirst-fill.tree-thirst-fill
        div.tree-actions
          button#tree-water.piece-enter [type="button"]
            "Water it"
          button#tree-remove.tree-remove [type="button"]
            "Remove this tree"
    div#lake-card.hidden [aria-labelledby="lake-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.lake-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        h2#lake-title.plant-heading
          "The lake"
        canvas#lake-view.lake-view [aria-hidden="true"]
        p#lake-note.plant-note
    div#reset-modal.hidden [aria-describedby="reset-body" aria-labelledby="reset-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.reset-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        h2#reset-title.piece-title
          "Start a new garden?"
        p#reset-body.tree-line
        div.tree-actions
          button#reset-confirm.piece-enter [type="button"]
            "Clear the plot"
          button#reset-cancel.tree-remove [type="button"]
            "Keep my garden"
    canvas#scene [aria-label="A 3D plot of open grassland where fractal trees can be planted and tended through the seasons" role="img"]
    script [src="../lib/three.min.js"]
    script [src="js/main.min.js" type="module"]"
`;

exports[`www/gavin/index.html 1`] = `
"<!doctype html>
html [data-ui-theme="garden" lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="Every spring Gavin releases ladybugs and praying mantises into the patio plants. Watch the Confederate Jasmine up close in 3D while ladybugs patrol, bees commute, and Gavin and his friends search the leaves." name="description"]
    meta [content="#2a5c2e" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/gavin/" rel="canonical"]
    meta [content="Gavin's Bug Patrol" property="og:title"]
    meta [content="A living 3D close-up of the jasmine plant where Gavin releases his ladybugs every spring. Sit still, look closely, and see who moved in." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="SceneXP" property="og:site_name"]
    meta [content="https://www.scenexp.com/gavin/" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/gavin/assets/og-gavin.jpg?v=2" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="A 3D close-up of a Confederate Jasmine in a cedar planter box: ladybugs and a praying mantis on the leaves, bees in the air, and three kids' faces peering in through the far side of the plant." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="Gavin's Bug Patrol" name="twitter:title"]
    meta [content="A living 3D close-up of the jasmine plant where Gavin releases his ladybugs every spring. Look closely." name="twitter:description"]
    meta [content="https://www.scenexp.com/gavin/assets/og-gavin.jpg?v=2" name="twitter:image"]
    meta [content="A 3D close-up of a Confederate Jasmine in a cedar planter box: ladybugs and a praying mantis on the leaves, bees in the air, and three kids' faces peering in through the far side of the plant." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://www.scenexp.com/gavin/#website",
        "url": "https://www.scenexp.com/gavin/",
        "name": "Gavin's Bug Patrol",
        "description": "A passive 3D close-up of the Confederate Jasmine where Gavin releases his ladybugs and praying mantises every spring.",
        "inLanguage": "en-US"
      }
    title
      "Gavin's Bug Patrol"
    link [as="style" href="../shared/css/styles-1.0.0.min.css?v=7" rel="preload"]
    link [as="style" href="css/experience.min.css?v=2" rel="preload"]
    link [as="script" href="../lib/three.min.js" rel="preload"]
    link [href="favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    link [href="css/experience.min.css?v=2" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    h1.sr-only
      "Gavin's Bug Patrol"
    noscript
      div.noscript-fallback
        h1
          "Gavin's Bug Patrol"
        p
          "This is a living 3D close-up of the Confederate Jasmine on the developer's front patio, and it needs JavaScript to run. Every spring his eleven-year-old son Gavin buys ladybugs and praying mantis eggs from the garden center and releases them into the patio plants. Then he and his friends spend weeks searching the leaves for signs of them. In the 3D scene you hold one quiet view of the jasmine while ladybugs patrol the leaves, two mantises keep very still, ants march the planter box, a spider minds her web, bees commute between the flowers, and Gavin and two friends peer in through the far side of the plant. If you would like a small world like this built for someone you love, the developer would be glad to hear from you."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        div.loader-title
          "GAVIN'S BUG PATROL"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    div#blocker
      div#instructions
        p.title
          "WELCOME"
        p.subtitle
          "Every spring, Gavin releases ladybugs into the patio plants"
        p.click-prompt
          "Click to look closer"
        div.controls-hint
          span
            "SIT BACK"
          "No controls needed. The garden does the moving."
          span
            "SPOT THEM"
          "Three praying mantises are hiding. Click them when you find them."
        a#explore-link.welcome-explore [href="/"]
          "More 3D worlds to explore at SceneXP.com"
    div#mantis-chip.mantis-chip [aria-live="polite" role="status"]
    div#dialog-modal.hidden [aria-labelledby="dialog-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#dialog-title.piece-title
            "In the Garden"
          p#dialog-message.piece-subtitle
          button.piece-enter.dialog-primary [data-close type="button"]
            "Keep watching"
    canvas#game-canvas [aria-label="A living 3D close-up of a Confederate Jasmine plant: ladybugs, praying mantises, ants, a spider, and bees move through the leaves while Gavin and two friends peer in from the far side" role="img"]
    section#prop-panel.prop-panel [aria-labelledby="prop-panel-heading" hidden]
      h2#prop-panel-heading.prop-panel-heading
        "Things in the garden"
      p.prop-panel-note
        "Choose anything for a little of its story. The arrow keys move through the list, Escape closes whatever opens, and Tab or Escape puts this list away."
      ul#prop-list.prop-list
    script [src="../lib/three.min.js"]
    script [src="js/main.min.js" type="module"]"
`;

exports[`www/highwater/index.html 1`] = `
"<!doctype html>
html [data-ui-theme="surf" lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="Sixty seconds at the water's edge in 3D, beginning on an ordinary bright afternoon. The sky closes over, the surf keeps rising, and the sea does not stay where it belongs. Plays without sound in any modern browser." name="description"]
    meta [content="#8fb6cc" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/highwater/" rel="canonical"]
    meta [content="High Water" property="og:title"]
    meta [content="Sixty seconds at the water's edge, beginning on an ordinary bright afternoon. The weather turns while you stand there, and the sea does not stay where it belongs." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="SceneXP" property="og:site_name"]
    meta [content="https://www.scenexp.com/highwater/" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/highwater/assets/og-highwater.jpg?v=1" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="A view out to sea under a low gray storm sky. A single branching fork of lightning comes down left of center, from the top of the frame to the horizon. The sea below is gray and heaving in long smooth swells, and a small orange and white navigation buoy stands just right of center near the horizon, dwarfed by the water around it." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="High Water" name="twitter:title"]
    meta [content="Sixty seconds at the water's edge on an ordinary bright afternoon. The weather turns while you stand there." name="twitter:description"]
    meta [content="https://www.scenexp.com/highwater/assets/og-highwater.jpg?v=1" name="twitter:image"]
    meta [content="A view out to sea under a low gray storm sky. A single branching fork of lightning comes down left of center, from the top of the frame to the horizon. The sea below is gray and heaving in long smooth swells, and a small orange and white navigation buoy stands just right of center near the horizon, dwarfed by the water around it." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://www.scenexp.com/highwater/#website",
        "url": "https://www.scenexp.com/highwater/",
        "name": "High Water",
        "description": "A passive 3D scene at the water's edge. Sixty seconds that begin on an ordinary bright afternoon and end with the sea closing over the viewer.",
        "inLanguage": "en-US"
      }
    title
      "High Water"
    link [as="style" href="../shared/css/styles-1.0.0.min.css?v=7" rel="preload"]
    link [as="style" href="css/experience.min.css?v=4" rel="preload"]
    link [as="script" href="../lib/three.min.js" rel="preload"]
    link [href="favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    link [href="css/experience.min.css?v=4" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    noscript
      div.noscript-fallback
        h1
          "High Water"
        p
          "This is a passive 3D scene at the water's edge, and it needs JavaScript to draw. It runs for sixty seconds and begins on an ordinary bright afternoon, with the surf coming in and the horizon exactly where you would expect it. Then the weather turns. The sky closes over into a storm base, lightning starts to work along it, the swell builds until the crests stand above the horizon line, and the sea eventually stops behaving."
        p
          "It does not stay an ordinary afternoon, and you may find it unsettling. The sea comes over you at the end. It plays without sound, so you are welcome to watch it anywhere, and you can watch it again as many times as you wish."
        p
          "SceneXP is a home for 3D experiences that run right in your browser. This one is a study of water, built to find out whether a browser could be made to feel like standing somewhere you should not be standing."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    canvas#scene [aria-label="A view out to sea from the water's edge, with waves breaking toward you" role="img"]
    div#welcome
      div.card
        p#paused-at.paused-at [hidden]
          "Paused"
        h1
          "High Water"
        p.lede
          "Sixty seconds at the water's edge, beginning on an ordinary bright afternoon."
        p.warning
          "It does not stay one, and you may find it unsettling. The weather turns, the surf keeps rising, and the sea comes over you at the end. There is lightning, so the screen flashes from time to time. It plays without sound, so you are welcome to watch it anywhere."
        button#begin.primary [type="button"]
          "Begin"
        div#pause-actions.pause-actions [hidden]
          button#resume.primary [aria-describedby="paused-at" type="button"]
            "Resume"
          button#restart [type="button"]
            "Restart"
        p.note
          "You can watch it again as many times as you wish."
        a#explore-link.welcome-explore [href="/"]
          "More 3D worlds to explore at SceneXP.com"
    div#wash [aria-hidden="true"]
    div#blackout [aria-hidden="true"]
    div#controls [hidden]
      button#pause-btn.menu-btn [aria-label="Pause" title="Pause (Esc)" type="button"]
        svg [aria-hidden="true" viewbox="0 0 24 24"]
          path [d="M9 5.5v13M15 5.5v13"]
      div#scrubber
        label.sr-only [for="scrub"]
          "Position in the story"
        input#scrub [aria-valuetext="0 seconds of 60" max="60" min="0" step="0.1" type="range" value="0"]
    div#ending [aria-live="polite" hidden role="status"]
      p.ending-line
        "The sea has taken the beach."
      p.ending-note
        "Thank you for watching. It ends the same way every time."
      div.ending-actions
        button#share [type="button"]
          "Share"
        button#replay [type="button"]
          "Watch it again"
      p#share-status.sr-only [aria-live="polite" role="status"]
      a.welcome-explore.promo-explore [href="/"]
        "More 3D worlds to explore at SceneXP.com"
    script [src="../lib/three.min.js"]
    script [src="js/main.min.js" type="module"]"
`;

exports[`www/index.html 1`] = `
"<!doctype html>
html [lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="SceneXP is a home for 3D worlds, games, experiments, stories, and simulations, every one running entirely in your browser. No app and no download, just a link." name="description"]
    meta [content="#f7f7fb" media="(prefers-color-scheme: light)" name="theme-color"]
    meta [content="#0e0f14" media="(prefers-color-scheme: dark)" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/" rel="canonical"]
    meta [content="SceneXP | 3D Worlds, Games, and Experiments" property="og:title"]
    meta [content="A home for 3D worlds, games, experiments, stories, and simulations, every one running entirely in your browser. No app and no download, just a link." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="SceneXP" property="og:site_name"]
    meta [content="https://www.scenexp.com/" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/assets/og-image.jpg?v=4" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="Four scenes from the SceneXP collection in a grid: a glowing orange fractal spiral, a 3D football field with orange and blue players in the middle of a play, a row of red-fruited trees in a green garden, and the blue curve of Earth seen from orbit with a targeting reticle and incoming raiders. Below them the SceneXP.com wordmark and the line, 3D worlds, games, and experiments, right in your browser." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="SceneXP | 3D Worlds, Games, and Experiments" name="twitter:title"]
    meta [content="3D worlds, games, experiments, and simulations, every one running entirely in your browser. No app and no download." name="twitter:description"]
    meta [content="https://www.scenexp.com/assets/og-image.jpg?v=4" name="twitter:image"]
    meta [content="Four scenes from the SceneXP collection in a grid: a glowing orange fractal spiral, a 3D football field with orange and blue players in the middle of a play, a row of red-fruited trees in a green garden, and the blue curve of Earth seen from orbit with a targeting reticle and incoming raiders. Below them the SceneXP.com wordmark and the line, 3D worlds, games, and experiments, right in your browser." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": "https://www.scenexp.com/#website",
            "url": "https://www.scenexp.com/",
            "name": "SceneXP",
            "description": "A home for 3D worlds, games, experiments, stories, and simulations, every one running entirely in the browser.",
            "inLanguage": "en-US",
            "publisher": {
              "@type": "Organization",
              "name": "Continuum Commerce LLC"
            },
            "author": {
              "@type": "Person",
              "name": "Steve Noll"
            }
          },
          {
            "@type": "ItemList",
            "@id": "https://www.scenexp.com/#worlds-and-games",
            "name": "Worlds and games",
            "description": "The experiences built for their own sake: games to play, worlds to wander, and simulations to run.",
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "url": "https://www.scenexp.com/xo/",
                "name": "X's and O's"
              },
              {
                "@type": "ListItem",
                "position": 2,
                "url": "https://www.scenexp.com/garden/",
                "name": "Fractal Garden"
              },
              {
                "@type": "ListItem",
                "position": 3,
                "url": "https://www.scenexp.com/highwater/",
                "name": "High Water"
              },
              {
                "@type": "ListItem",
                "position": 4,
                "url": "https://www.scenexp.com/earthdefense/",
                "name": "Earth Defense"
              },
              {
                "@type": "ListItem",
                "position": 5,
                "url": "https://www.scenexp.com/mandelbrot/",
                "name": "The Mandelbrot Set"
              },
              {
                "@type": "ListItem",
                "position": 6,
                "url": "https://www.scenexp.com/steve/",
                "name": "Steve's Home Office"
              }
            ]
          },
          {
            "@type": "ItemList",
            "@id": "https://www.scenexp.com/#small-business-tributes",
            "name": "Small business tributes",
            "description": "3D worlds built for real small businesses, in place of another template website.",
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "url": "https://www.scenexp.com/automan/",
                "name": "John Walker, The Auto Man"
              },
              {
                "@type": "ListItem",
                "position": 2,
                "url": "https://www.scenexp.com/interstate/",
                "name": "The Interstate Tire Shop"
              },
              {
                "@type": "ListItem",
                "position": 3,
                "url": "https://www.scenexp.com/seedtoseed/",
                "name": "The Seed to Seed Garden"
              },
              {
                "@type": "ListItem",
                "position": 4,
                "url": "https://www.scenexp.com/sunnyvalejenn/",
                "name": "Sunnyvale Jenn Consulting"
              }
            ]
          },
          {
            "@type": "ItemList",
            "@id": "https://www.scenexp.com/#personal-tributes",
            "name": "Personal tributes",
            "description": "Worlds built to honor a particular person, or to hold on to a particular memory.",
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "url": "https://www.scenexp.com/jamar/",
                "name": "Jamar's Karaoke Night"
              },
              {
                "@type": "ListItem",
                "position": 2,
                "url": "https://www.scenexp.com/gavin/",
                "name": "Gavin's Bug Patrol"
              },
              {
                "@type": "ListItem",
                "position": 3,
                "url": "https://www.scenexp.com/roqui/",
                "name": "Zumba with Roqui"
              },
              {
                "@type": "ListItem",
                "position": 4,
                "url": "https://www.scenexp.com/family/",
                "name": "Putt Putt with Mom and Dad"
              },
              {
                "@type": "ListItem",
                "position": 5,
                "url": "https://www.scenexp.com/dad/",
                "name": "A Ride on the NCR Trail"
              }
            ]
          }
        ]
      }
    title
      "SceneXP | 3D Worlds, Games, and Experiments"
    link [as="style" href="/css/site.min.css?v=4" rel="preload"]
    link [href="/favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="/css/site.min.css?v=4" rel="stylesheet"]
    script [src="/js/theme.min.js?v=1"]
    script [defer src="/js/nav.min.js?v=1"]
  body
    a.skip-link [href="#main"]
      "Skip to main content"
    header.site-header
      div.container.site-header-inner
        a.brand [href="/"]
          svg.brand-mark [aria-hidden="true" focusable="false" viewbox="0 0 32 32"]
            defs
              lineargradient#brand-grad [x1="0" x2="1" y1="0" y2="1"]
                stop [offset="0" stop-color="#6c4cf1"]
                stop [offset="1" stop-color="#06b6d4"]
            rect [fill="url(#brand-grad)" height="32" rx="8" width="32"]
            path [d="M8 22 14 10l4 8 3-5 3 9" fill="none" stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"]
          "SceneXP"
        nav#site-nav.site-nav [aria-label="Main"]
          ul
            li
              a [href="/#experiences"]
                "Experiences"
            li
              a [href="/contact.html"]
                "Contact"
            li
              a [href="/contribute.html"]
                "Contribute"
        button#nav-toggle.nav-toggle [aria-controls="site-nav" aria-expanded="false" aria-label="Menu" hidden type="button"]
          svg.icon-nav-open [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            path [d="M4 7h16M4 12h16M4 17h16"]
          svg.icon-nav-close [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            path [d="M6 6l12 12M18 6 6 18"]
        button#theme-toggle.theme-toggle [aria-label="Theme" hidden type="button"]
          svg.icon-theme-light [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            circle [cx="12" cy="12" fill="currentColor" r="4.5" stroke="none"]
            path [d=#f2e7be5368]
          svg.icon-theme-dark [aria-hidden="true" focusable="false" viewbox="0 0 24 24"]
            path [d=#bac0ce3668 fill="currentColor"]
          svg.icon-theme-system [aria-hidden="true" focusable="false" viewbox="0 0 24 24"]
            circle [cx="12" cy="12" fill="none" r="8.5" stroke="currentColor" stroke-width="2"]
            path [d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor"]
    main#main
      section#experiences.section [aria-labelledby="experiences-heading"]
        div.container
          div.section-head
            h1#experiences-heading
              "3D worlds, games, and experiments, right in your browser"
            p
              "No app, no download, nothing to install."
          section.experience-group [aria-labelledby="worlds-and-games" data-category="worlds"]
            h2#worlds-and-games
              "Worlds and games"
            ul.experience-grid
              li.experience-card [data-slug="xo"]
                a [href="/xo/"]
                  img [alt="A 3D football field seen from high behind the offense in the middle of a play. Orange players with a white X on their jerseys run routes against blue defenders marked O, with lettered rings A to D under the receivers and Q under the quarterback. The 5, 15, 30 and 50 point lines are painted across the green turf, and fans in orange and blue fill the stands on both sides." decoding="async" fetchpriority="high" height="630" loading="eager" src="/xo/assets/og-xo.webp?v=1" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "A football game where you call the plays"
                    h3
                      "X's and O's"
                    p
                      "You are on offense for all ten plays. Pick a play from the playbook, snap the ball, then throw to an open receiver or keep it and run. The farther you carry it the more the play is worth, and 500 is a perfect game."
                    span.experience-cta
                      "Call the first play →"
              li.experience-card [data-slug="garden"]
                a [href="/garden/"]
                  img [alt="Five fractal fruit trees in full summer leaf, their canopies heavy with red fruit, standing on dark mulch mounds in a walled garden plot. Each trunk has a small blue water gauge at its base. Behind the wall a pale lake sits below gray rolling hills, under a blue sky with white clouds." decoding="async" height="630" loading="lazy" src="/garden/assets/og-garden.webp?v=3" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "A garden you plant and tend yourself"
                    h3
                      "Fractal Garden"
                    p
                      "Plant a garden of fractal trees, then watch it live through the years. Choose from seventeen species, each one grown from its own seed so no two are alike, then tend them through spring blossom, summer fruit, autumn color and winter snow. Every tree you plant is still standing when you come back."
                    span.experience-cta
                      "Plant your first tree →"
              li.experience-card [data-slug="highwater"]
                a [href="/highwater/"]
                  img [alt="A view out to sea under a low gray storm sky, with a branching fork of lightning coming down to the horizon and a small orange and white navigation buoy standing in the heaving gray swell." decoding="async" height="630" loading="lazy" src="/highwater/assets/og-highwater.webp?v=1" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "A study of water and weather"
                    h3
                      "High Water"
                    p
                      "Sixty seconds at the water's edge, beginning on an ordinary bright afternoon. The sky closes over, lightning starts to work along the cloud base, and the surf keeps rising. Please know before you start that the sea does not stay where it belongs."
                    span.experience-cta
                      "Stand at the shore →"
              li.experience-card [data-slug="earthdefense"]
                a [href="/earthdefense/"]
                  img [alt="A ship's-eye view in low Earth orbit: Earth's blue and white limb curves across the bottom of the frame, Mars sits ahead as a small ruddy disc with the targeting reticle just below it, and orange diamonds mark the incoming Martian raiders across a deep starfield." decoding="async" height="630" loading="lazy" src="/earthdefense/assets/og-earthdefense.webp?v=2" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "Built for the joy of flying through space"
                    h3
                      "Earth Defense"
                    p
                      "Fly a single ship in orbit above a massive Earth while twelve Martian raiders close on the installations below. You never need a fire button: line a raider up in the middle of your view and your guns take care of the rest."
                    span.experience-cta
                      "Take the helm →"
              li.experience-card [data-slug="mandelbrot"]
                a [href="/mandelbrot/"]
                  img [alt="A deep zoom into the Mandelbrot set: a giant spiral of glowing red and gold fractal filaments coiling toward its center against dark space." decoding="async" height="630" loading="lazy" src="/mandelbrot/assets/og-mandelbrot.webp" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "For Benoit Mandelbrot"
                    h3
                      "The Mandelbrot Set"
                    p
                      "The most famous shape in mathematics floats in a quiet starfield. Choose a destination on its burning edge, press play, and the auto zoom dives hundreds of billions of times deep, until the numbers themselves run out."
                    span.experience-cta
                      "Begin the dive →"
              li.experience-card [data-slug="steve"]
                a [href="/steve/"]
                  img [alt="Steve's 3D home office: he stands at his sit-stand desk working on SceneXP code while a tuxedo cat sleeps by the window." decoding="async" height="630" loading="lazy" src="/steve/assets/og-steve.webp" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "Where SceneXP gets built"
                    h3
                      "Steve's Home Office"
                    p
                      "Step inside the little office in Steve's house where every one of these experiences gets built. Peek at the code on the monitor, watch for birds on the fence, and please mind the sleeping cat."
                    span.experience-cta
                      "Step inside →"
          section.experience-group [aria-labelledby="small-business-tributes" data-category="business"]
            h2#small-business-tributes
              "Small business tributes"
            ul.experience-grid
              li.experience-card [data-slug="automan"]
                a [href="/automan/"]
                  img [alt="A 3D dealership desk seen across the showroom floor: three figures sit around a dark wood table holding a deal sheet and a small yellow model car, a whiteboard behind them reads Today's schedule, 2:00 John Walker, and the glass frontage looks out on trucks parked in the lot." decoding="async" height="630" loading="lazy" src="/automan/assets/card-automan.webp?v=1" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "For a car buying advocate"
                    h3
                      "John Walker, The Auto Man"
                    p
                      "Pull up to a dealership desk where John Walker is sitting on the buyer's side of it. Twenty five years of arguing deals down and more than 2,000 cars, in Baltimore or anywhere by Zoom. Tap anyone at the desk to hear their side of it."
                    span.experience-cta
                      "Take a seat →"
              li.experience-card [data-slug="interstate"]
                a [href="/interstate/"]
                  img [alt="A 3D tire shop storefront with an open garage bay beneath the Interstate Tire sign." decoding="async" height="630" loading="lazy" src="/interstate/assets/og-interstate.webp" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "For a neighborhood tire shop"
                    h3
                      "The Interstate Tire Shop"
                    p
                      "Walk into a 3D tire shop built for Interstate Tire in historic Cockeysville, Maryland. See the car up on the lift, catch the waiting room TV, and stroll Railroad Ave to the 1892 freight depot."
                    span.experience-cta
                      "Step inside →"
              li.experience-card [data-slug="seedtoseed"]
                a [href="/seedtoseed/"]
                  img [alt="A 3D backyard vegetable garden with raised beds, a greenhouse, and a picket fence." decoding="async" height="630" loading="lazy" src="/seedtoseed/assets/og-seedtoseed.webp" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "For a gardening business"
                    h3
                      "The Seed to Seed Garden"
                    p
                      "Stroll a 3D backyard garden built for Seed to Seed, a home vegetable gardening company. Wander the raised beds, step inside the greenhouse, and meet the gardener."
                    span.experience-cta
                      "Step inside →"
              li.experience-card [data-slug="sunnyvalejenn"]
                a [href="/sunnyvalejenn/"]
                  img [alt="A bright 3D home office: Jenn works at a light oak desk facing the doorway, the week's plan fills a whiteboard on one wall, a teal clock hangs above her monitor, and a sunny window looks out on a cedar fence and trees." decoding="async" height="630" loading="lazy" src="/sunnyvalejenn/assets/og-sunnyvalejenn.webp?v=1" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "For a small business operations consultant"
                    h3
                      "Sunnyvale Jenn Consulting"
                    p
                      "Look in on the sunny home office of Sunnyvale Jenn Consulting, built for a consultant who untangles the operations that busy founders never find time for. Jenn is at her desk, the week's plan is on the whiteboard, and the birds keep visiting the fence."
                    span.experience-cta
                      "Step inside →"
          section.experience-group [aria-labelledby="personal-tributes" data-category="personal"]
            h2#personal-tributes
              "Personal tributes"
            ul.experience-grid
              li.experience-card [data-slug="jamar"]
                a [href="/jamar/"]
                  img [alt="A 3D karaoke bar at night: Jamar sings on the corner stage under a happy birthday banner while friends raise glasses from a red vinyl booth." decoding="async" height="630" loading="lazy" src="/jamar/assets/og-jamar.webp" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "Happy Birthday, Jamar!"
                    h3
                      "Jamar's Karaoke Night"
                    p
                      "It is karaoke night at the corner bar, and the birthday singer is Steve's best friend Jamar. Settle in, follow the rolling lyrics screen, and tap the jukebox to pick what he sings next."
                    span.experience-cta
                      "Pull up a stool →"
              li.experience-card [data-slug="gavin"]
                a [href="/gavin/"]
                  img [alt="A 3D close-up of a Confederate Jasmine in a cedar planter box, with three kids peering through the leaves in search of the bugs living there." decoding="async" height="630" loading="lazy" src="/gavin/assets/og-gavin.webp" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "For Gavin, age eleven"
                    h3
                      "Gavin's Bug Patrol"
                    p
                      "Every spring, Steve's son Gavin releases ladybugs and praying mantises into the patio plants. Settle in for a close-up of the jasmine, watch the garden change shifts at dusk, and see if you can spot all three mantises."
                    span.experience-cta
                      "Look closer →"
              li.experience-card [data-slug="roqui"]
                a [href="/roqui/"]
                  img [alt="A joyful 3D Zumba class with dancers mid-step and a disco ball overhead." decoding="async" height="630" loading="lazy" src="/roqui/assets/og-roqui.webp" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "For a wonderful instructor"
                    h3
                      "Zumba with Roqui"
                    p
                      "Step into a joyful 3D Zumba class and say hola to Roqui. Catch the beat, fire up the speakers, and find the disco ball."
                    span.experience-cta
                      "Step inside →"
              li.experience-card [data-slug="family"]
                a [href="/family/"]
                  img [alt="A 3D pirate mini golf course in Ocean City, with a pirate ship at its center." decoding="async" height="630" loading="lazy" src="/family/assets/og-family.webp" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "For a family summer memory"
                    h3
                      "Putt Putt with Mom and Dad"
                    p
                      "Play a 3D round of pirate mini golf in Ocean City, Maryland, built from a favorite summer memory. Board the ship and walk the plank hole."
                    span.experience-cta
                      "Step inside →"
              li.experience-card [data-slug="dad"]
                a [href="/dad/"]
                  img [alt="A walkable 3D stretch of the NCR Trail, with the Gunpowder River alongside." decoding="async" height="630" loading="lazy" src="/dad/assets/og-dad.webp" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "In memory of a dad"
                    h3
                      "A Ride on the NCR Trail"
                    p
                      "Take a quiet walk on a 3D stretch of Maryland's NCR Trail, built for a dad who rode it nearly every weekend. Find the river and listen for the little waterfall."
                    span.experience-cta
                      "Step inside →"
      section.section [aria-labelledby="for-heading"]
        div.container
          div.section-head
            h2#for-heading
              "What you will find here"
            p
              "The collection wanders on purpose, so it is sorted into three groups above. Here is what each of them holds, and every heading below takes you straight to it."
          ul.audience-grid
            li.audience-card
              h3
                a [href="#worlds-and-games"]
                  "Worlds and games"
              p
                "The ones built for their own sake. Call the plays in a game of football, defend Earth from a Martian fleet, dive hundreds of billions of times deep into the Mandelbrot set, watch a modelled ocean shoal and break on a measured beach, or plant a garden of fractal trees and tend it through the seasons."
            li.audience-card
              h3
                a [href="#small-business-tributes"]
                  "Small business tributes"
              p
                "Real businesses, rebuilt as places you can visit. A dealership desk with a car buying advocate on the buyer's side of it, a tire shop on historic Railroad Ave with a car up on the lift, a backyard vegetable garden with a greenhouse, and a consultant's sunny home office."
            li.audience-card
              h3
                a [href="#personal-tributes"]
                  "Personal tributes"
              p
                "Worlds made for a particular person, or to hold on to a particular memory. A quiet trail along the Gunpowder, a karaoke night at the corner bar, a Zumba class, a bug hunt in the jasmine, a round of pirate mini golf."
      section.section [aria-labelledby="how-heading"]
        div.container
          div.section-head
            h2#how-heading
              "Every one of them runs in your browser"
            p
              "No app, no download, no account, and nothing to install. Each experience is browser-native HTML, CSS, and JavaScript with Three.js doing the drawing, served from this domain and nowhere else. There are no third-party scripts, no CDNs, and no trackers anywhere on the site. Open a link and you are already inside."
      section.section [aria-labelledby="commission-heading"]
        div.container
          div.section-head
            h2#commission-heading
              "Built for someone in particular"
            p
              "Several of the worlds above began as a gift. Someone knew a person who deserved a world, or a business that deserved to be more than another template website, and told us the story. We still love making those, so if a person or a place came to mind while you were browsing, we would be glad to hear about it."
          p
            a.btn.btn-ghost [href="/contact.html"]
              "Start the conversation"
      section.cta-band [aria-labelledby="cta-heading"]
        div.container
          div.cta-band-inner
            h2#cta-heading
              "Bring your own little world"
            p
              "SceneXP is open source under the MIT license, and the shared parts library makes a new experience easier to assemble than you might think. Whatever you would build, we would be delighted to host it."
            a.btn [href="/contribute.html"]
              "Read the contributor guide"
    footer.site-footer
      div.container.site-footer-inner
        div.footer-brand
          a.brand [href="/"]
            svg.brand-mark [aria-hidden="true" focusable="false" viewbox="0 0 32 32"]
              defs
                lineargradient#brand-grad-footer [x1="0" x2="1" y1="0" y2="1"]
                  stop [offset="0" stop-color="#6c4cf1"]
                  stop [offset="1" stop-color="#06b6d4"]
              rect [fill="url(#brand-grad-footer)" height="32" rx="8" width="32"]
              path [d="M8 22 14 10l4 8 3-5 3 9" fill="none" stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"]
            "SceneXP"
          p
            "3D worlds, games, and experiments, every one running right in your browser. Thank you for visiting."
        nav.footer-nav [aria-label="Explore"]
          h2
            "Explore"
          ul
            li
              a [href="/#experiences"]
                "Experiences"
            li
              a [href="/contact.html"]
                "Contact"
            li
              a [href="/contribute.html"]
                "Contribute"
        nav.footer-nav [aria-label="Project"]
          h2
            "Project"
          ul
            li
              a [href="https://github.com/stevendnoll/SceneXP" rel="noopener noreferrer" target="_blank" title="View the SceneXP source code on GitHub"]
                "GitHub"
            li
              a [href="/privacy.html"]
                "Privacy"
            li
              a [href="/terms.html"]
                "Terms"
        div.footer-meta
          p
            "Built with Three.js and browser-native HTML, CSS, and JavaScript. Open source under the MIT license."
          p
            "SceneXP © 2026"
            a [href="https://www.continuumcommercellc.com/" rel="noopener noreferrer" target="_blank" title="View the Continuum Commerce LLC website"]
              "Continuum Commerce LLC"
            ".""
`;

exports[`www/interstate/index.html 1`] = `
"<!doctype html>
html [lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="Step into Interstate Tire in walkable 3D. Look around the garage, see a car up on the lift, and browse the tire racks. Tires, brakes, and alignments, call 410-666-7333." name="description"]
    meta [content="#f4f3ef" name="theme-color"]
    meta [content="Interstate Tire" name="author"]
    link [href="https://www.scenexp.com/interstate/" rel="canonical"]
    meta [content="Interstate Tire, 3D Shop Tour" property="og:title"]
    meta [content="Walk through Interstate Tire in 3D. See the garage, the lift, and the tire racks. Tires, brakes, and alignments, call 410-666-7333." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="Interstate Tire" property="og:site_name"]
    meta [content="https://www.scenexp.com/interstate/" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/interstate/assets/og-interstate.jpg?v=1" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="A walkable 3D tour of the Interstate Tire shop." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="Interstate Tire, 3D Shop Tour" name="twitter:title"]
    meta [content="Walk through Interstate Tire in 3D. See the garage, the lift, and the tire racks." name="twitter:description"]
    meta [content="https://www.scenexp.com/interstate/assets/og-interstate.jpg?v=1" name="twitter:image"]
    meta [content="A walkable 3D tour of the Interstate Tire shop." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": "https://www.scenexp.com/interstate/#website",
            "url": "https://www.scenexp.com/interstate/",
            "name": "Interstate Tire",
            "description": "A walkable 3D tour of the Interstate Tire shop.",
            "inLanguage": "en-US",
            "publisher": {
              "@id": "https://www.scenexp.com/interstate/#shop"
            }
          },
          {
            "@type": "TireShop",
            "@id": "https://www.scenexp.com/interstate/#shop",
            "name": "Interstate Tire",
            "url": "https://www.interstatetireco.com/",
            "image": "https://www.scenexp.com/interstate/assets/og-interstate.jpg",
            "telephone": "410-666-7333",
            "knowsAbout": [
              "Tires",
              "Brake service",
              "Wheel alignments",
              "Auto repair"
            ]
          }
        ]
      }
    title
      "Interstate Tire"
    link [as="style" href="../shared/css/styles-1.0.0.min.css?v=7" rel="preload"]
    link [as="script" href="../lib/three.min.js" rel="preload"]
    link [href="favicon.png" rel="icon" sizes="64x64" type="image/png"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    a.skip-link [href="#biz-btn"]
      "Skip to the page controls"
    h1.sr-only
      "Interstate Tire"
    noscript
      div.noscript-fallback
        h1
          "Interstate Tire"
        p
          "This is a walkable 3D tour of the Interstate Tire shop, which needs JavaScript to run. For tires, brakes, and alignments, please call 410-666-7333 or visit the shop's website below. This experience was built by an independent developer, who would be happy to build one for you as well."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="https://www.interstatetireco.com/" rel="noopener noreferrer"]
                "Interstate Tire website"
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        img [alt="" height="180" src="assets/interstate-logo.webp" width="180"]
        div.loader-title
          "INTERSTATE TIRE"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    div#blocker
      div#instructions
        img.welcome-logo [alt="" height="110" src="assets/interstate-logo.webp" width="110"]
        p.title
          "WELCOME"
        p.subtitle
          "A walkable tire shop"
        p.click-prompt
          "Click to explore"
        p.tour-note
          "The shop will show you around on its own. Move anytime to take the wheel."
        div.controls-hint
          span
            "WASD"
          "Move"
          span
            "MOUSE"
          "Look"
    div#hud
      div.crosshair [aria-hidden="true"]
      div#look-label.look-label [aria-live="polite" role="status"]
    div#piece-modal.hidden [aria-labelledby="piece-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#piece-title.piece-title
            "Section"
          p#piece-subtitle.piece-subtitle
          a#piece-enter.piece-enter [href="#"]
            "Enter →"
          button.piece-cancel [data-close]
            "Keep exploring"
    div#help-modal.hidden [aria-labelledby="help-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.help-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#help-title.piece-title
            "Welcome, need a hand?"
          p.piece-subtitle
            "Welcome to Interstate Tire. Here's how to look around."
          ul.help-list
            li.help-desktop
              strong
                "Move:"
              kbd
                "W"
              kbd
                "A"
              kbd
                "S"
              kbd
                "D"
              "or the arrow keys."
            li.help-desktop
              strong
                "Look:"
              "move the mouse. Click the scene once to capture the cursor. Press"
              kbd
                "Esc"
              "to release it."
            li.help-mobile
              strong
                "Move &amp; look:"
              "use the left joystick to walk and the right joystick to look around."
            li
              strong
                "Autopilot:"
              "the shop shows you around on its own from the moment you step in, all the way out to the old freight depot. Move to take back the controls, and press"
              kbd
                "T"
              "or the tour button (top-left) whenever you would like the tour to resume."
            li
              strong
                "Settings:"
              "the gear icon (top-right) adjusts movement and look sensitivity."
            li
              strong
                "Interstate Tire:"
              "the logo button (top-right) opens the shop's own website in a new tab, so you keep your place in the tour."
          a#hello-site.piece-enter [href="https://www.interstatetireco.com/" rel="noopener noreferrer" target="_blank"]
            "Visit the Interstate Tire website →"
          button.piece-cancel [data-close]
            "Got it, thanks!"
          p.piece-footnote
            "The Interstate Tire name and logo are trademarks of their owner and appear here in tribute, with the owner's kind permission."
    div#dialog-modal.hidden [aria-labelledby="dialog-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#dialog-title.piece-title
            "Passerby"
          p#dialog-message.piece-subtitle
          button.piece-enter.dialog-primary [data-close type="button"]
            "Continue exploring"
          button#dialog-return-btn.piece-cancel.dialog-return.hidden [type="button"]
            "Back to the Shop"
    div#complete-modal.hidden [aria-labelledby="complete-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.complete-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          p.complete-kicker [aria-hidden="true"]
            "★ &nbsp;All discoveries found&nbsp; ★"
          h2#complete-title.piece-title
            "You explored every corner"
          p.piece-subtitle
            "Thank you for taking the time to look around. This little world was built to honor Interstate Tire, where tires, brakes, and alignments come with honest advice in between. If your car could use that kind of care, they would love to hear from you. And if you would like a world like this built for your own business, so would the developer."
          a#complete-site.piece-enter [href="https://www.interstatetireco.com/" rel="noopener noreferrer" target="_blank"]
            "Visit Interstate Tire →"
          a#complete-contact.piece-cancel [href="/contact.html"]
            "Get a world like this →"
          button#complete-share.piece-cancel.complete-share [type="button"]
            "Share this"
          p#complete-share-status.sr-only [aria-live="polite" role="status"]
          button.piece-cancel [data-close]
            "Keep exploring"
    div#nudge-modal.hidden [aria-labelledby="nudge-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.complete-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          p.complete-kicker [aria-hidden="true"]
            "★ &nbsp;A few discoveries in&nbsp; ★"
          h2#nudge-title.piece-title
            "Enjoying your visit?"
          p.piece-subtitle
            "Thanks for spending a little time in the shop. This tour was built to honor Interstate Tire, the kind of neighborhood garage that keeps everyone rolling. If your car needs anything at all, they are good people to know. No rush, the bay door is always up."
          a#nudge-site.piece-enter [href="https://www.interstatetireco.com/" rel="noopener noreferrer" target="_blank"]
            "Visit Interstate Tire →"
          a#nudge-contact.piece-cancel [href="/contact.html"]
            "Want a world like this? Get in touch →"
          button.piece-cancel [data-close]
            "Keep exploring"
    div#card-modal.hidden [aria-labelledby="card-name" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.business-card-modal
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#card-name.piece-title
            "Meet the owner"
          p.piece-subtitle
            "Tires, brakes, and alignments, with honest advice in between. If you need anything at all, please call 410-666-7333 or stop by the shop. You are always welcome here."
          a#card-site.piece-enter [href="https://www.interstatetireco.com/" rel="noopener noreferrer" target="_blank"]
            "Visit the shop's website →"
          button.piece-cancel [data-close]
            "Keep exploring"
    div#monitor-view.hidden [aria-label="The studio monitor, up close" aria-modal="true" role="dialog"]
      div.monitor-backdrop [data-close]
      div.monitor-frame
        div.monitor-bezel
          div.monitor-screen
            canvas#monitor-canvas.monitor-canvas
            div.monitor-glass [aria-hidden="true"]
        div.monitor-neck [aria-hidden="true"]
        div.monitor-base [aria-hidden="true"]
      p#monitor-caption.monitor-caption
      button.monitor-close [aria-label="Step back from the monitor" data-close]
        "&times;"
    div#whiteboard-view.hidden [aria-label="The studio whiteboard, up close" aria-modal="true" role="dialog"]
      div.whiteboard-backdrop [data-close]
      div.whiteboard-frame
        div.whiteboard-surface
          canvas#whiteboard-canvas.whiteboard-canvas
        div.whiteboard-tray [aria-hidden="true"]
      p#whiteboard-caption.whiteboard-caption
      p.whiteboard-hint [aria-hidden="true"]
        "Drag to pan across the board"
      button.whiteboard-close [aria-label="Step back from the whiteboard" data-close]
        "&times;"
    div#touch-controls
      div#joystick-zone
        div.joystick-base-fixed
          div.joystick-thumb-fixed
      div#look-joystick-zone
        div.joystick-base-fixed
          div.joystick-thumb-fixed
      div#tap-zone
    a#biz-btn.ui-float.menu-btn.biz-btn [aria-label="Visit the Interstate Tire website (opens in a new tab)" href="https://www.interstatetireco.com/" rel="noopener noreferrer" target="_blank" title="Visit the Interstate Tire website"]
      img [alt="" height="26" src="favicon.png" width="26"]
    button#autopilot-btn.ui-float.menu-btn.autopilot-btn [aria-label="Toggle the autopilot tour (keyboard shortcut T)" aria-pressed="false" title="Autopilot tour (T)"]
      svg [aria-hidden="true" viewbox="0 0 24 24"]
        path [d=#10d062c4ff stroke-dasharray="2.6 2.2"]
        path [d="M21.5 3.6l.6 7.5-6.1-2.4z" fill="currentColor" stroke="none"]
        circle [cx="5" cy="19" fill="currentColor" r="2.2" stroke="none"]
    button#settings-btn.ui-float.settings-btn [aria-controls="settings-panel" aria-expanded="false" aria-label="Movement settings" title="Movement settings"]
      svg.settings-icon [aria-hidden="true" viewbox="0 0 24 24"]
        path [d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"]
        path [d=#88c0d99db8]
    div#settings-panel.settings-panel.hidden
      div.settings-header
        span
          "Settings"
        button#settings-close.settings-close [aria-label="Close"]
          "&times;"
      div.settings-body
        label.settings-label
          "Walk Speed"
          input#walk-speed-slider [max="14" min="2" step="0.5" type="range" value="6.5"]
          span.settings-value#walk-speed-value
            "6.5"
        label.settings-label
          "Look Sensitivity"
          input#look-speed-slider [max="4" min="0.5" step="0.1" type="range" value="1.0"]
          span.settings-value#look-speed-value
            "1.0"
        label.settings-label
          "Ambient Brightness"
          input#settings-light-slider [max="1.5" min="0" step="0.05" type="range" value="1"]
          span.settings-value#settings-light-value
            "100%"
    div#light-panel.settings-panel.hidden [aria-labelledby="light-panel-title" role="dialog"]
      div.settings-header
        span#light-panel-title
          "Shop Lighting"
        button#light-close.settings-close [aria-label="Close" data-close]
          "&times;"
      div.settings-body
        p.light-hint
          "Set the mood. The shop looks good at any brightness."
        label.settings-label
          "Ambient Brightness"
          input#light-slider [max="1.5" min="0" step="0.05" type="range" value="1"]
          span.settings-value#light-value
            "100%"
    canvas#game-canvas [aria-label="A walkable 3D tour of the Interstate Tire shop" role="img"]
    script [src="../lib/three.min.js"]
    script [src="js/main.min.js" type="module"]"
`;

exports[`www/jamar/index.html 1`] = `
"<!doctype html>
html [data-ui-theme="neon" lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="It is karaoke night at the corner bar and Jamar has the microphone. A living 3D scene built as a birthday present: the lyrics screen rolls, the speakers keep the beat, and his best friends hold down the booth." name="description"]
    meta [content="#2c1240" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/jamar/" rel="canonical"]
    meta [content="Jamar's Karaoke Night" property="og:title"]
    meta [content="A living 3D visit to karaoke night at the corner bar, built as a birthday present. Jamar has the mic, the booth has his best friends, and the whole room knows the words." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="SceneXP" property="og:site_name"]
    meta [content="https://www.scenexp.com/jamar/" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/jamar/assets/og-jamar.jpg?v=1" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="A 3D karaoke bar at night: Jamar sings on a corner stage under magenta and blue lights, a lyrics screen glows on the brick wall, and two friends raise glasses from a red vinyl booth." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="Jamar's Karaoke Night" name="twitter:title"]
    meta [content="A living 3D visit to karaoke night at the corner bar, built as a birthday present. Jamar has the mic." name="twitter:description"]
    meta [content="https://www.scenexp.com/jamar/assets/og-jamar.jpg?v=1" name="twitter:image"]
    meta [content="A 3D karaoke bar at night: Jamar sings on a corner stage under magenta and blue lights, a lyrics screen glows on the brick wall, and two friends raise glasses from a red vinyl booth." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://www.scenexp.com/jamar/#website",
        "url": "https://www.scenexp.com/jamar/",
        "name": "Jamar's Karaoke Night",
        "description": "A passive 3D visit to karaoke night at the corner bar, built as a birthday present for Jamar: he has the microphone, the lyrics screen is rolling, and his best friends hold down the booth.",
        "inLanguage": "en-US"
      }
    title
      "Jamar's Karaoke Night"
    link [as="style" href="../shared/css/styles-1.0.0.min.css?v=7" rel="preload"]
    link [as="style" href="css/experience.min.css" rel="preload"]
    link [as="script" href="../lib/three.min.js" rel="preload"]
    link [href="favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    link [href="css/experience.min.css" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    h1.sr-only
      "Jamar's Karaoke Night"
    noscript
      div.noscript-fallback
        h1
          "Jamar's Karaoke Night"
        p
          "This is a living 3D scene of karaoke night at the corner bar, and it needs JavaScript to run. The developer built it as a birthday present for his best friend Jamar, who is exactly the person you hope grabs the microphone on karaoke night. In the 3D scene, Jamar sings from the corner stage while the lyrics screen rolls, the speakers keep the beat, the disco ball turns, and the developer and their friend Mike raise glasses from the booth beside the stage. Everything in the room can be clicked for a little of its story. If you would like a small world like this built for someone you love, the developer would be glad to hear from you."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        div.loader-title
          "JAMAR'S KARAOKE NIGHT"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    div#blocker
      div#instructions
        p.title
          "WELCOME"
        p.subtitle
          "It is karaoke night at the corner bar, and the birthday man has the mic"
        p.click-prompt
          "Click to join the crowd"
        div.controls-hint
          span
            "SIT BACK"
          "No controls needed. Jamar handles the entertainment."
          span
            "LOOK CLOSER"
          "Click anything in the bar, or anyone, for a little of its story."
    div#dialog-modal.hidden [aria-labelledby="dialog-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#dialog-title.piece-title
            "At the Bar"
          p#dialog-message.piece-subtitle
          button.piece-enter.dialog-primary [data-close type="button"]
            "Back to the show"
    div#jukebox-modal.hidden [aria-labelledby="jukebox-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#jukebox-title.piece-title
            "The Jukebox"
          p.piece-subtitle
            "Every quarter plays for the birthday act tonight. Pick what Jamar sings next."
          div#jukebox-songs.jukebox-songs
          button.piece-enter.dialog-primary [data-close type="button"]
            "Back to the show"
    div#tv-view.hidden [aria-label="The karaoke screen, up close" aria-modal="true" role="dialog"]
      div.tv-backdrop [data-close]
      div.tv-frame
        div.tv-bezel
          div.tv-screen
            canvas#tv-canvas.tv-canvas
            div.tv-glass [aria-hidden="true"]
      p#tv-caption.tv-caption
      button.tv-close [aria-label="Step back from the screen" data-close]
        "&times;"
    canvas#game-canvas [aria-label="A living 3D karaoke bar: Jamar sings on the corner stage under magenta and blue lights while the lyrics screen rolls, the speakers keep the beat, the disco ball turns, and Steve and Mike raise glasses from the booth beside the stage" role="img"]
    section#prop-panel.prop-panel [aria-labelledby="prop-panel-heading" hidden]
      h2#prop-panel-heading.prop-panel-heading
        "Things in the bar"
      p.prop-panel-note
        "Choose anything for a little of its story. The arrow keys move through the list, Escape closes whatever opens, and Tab or Escape puts this list away."
      ul#prop-list.prop-list
    script [src="../lib/three.min.js"]
    script [src="js/main.min.js" type="module"]"
`;

exports[`www/mandelbrot/index.html 1`] = `
"<!doctype html>
html [data-ui-theme="ember" lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="Float in a softly lit starfield beside the Mandelbrot set, rendered in 3D with a pure black interior and a neon orange burning edge. Then step in and let the auto zoom fly you down a 3D tunnel of glowing fractal terrain, hundreds of billions of times deep, into the seam where the set's two great circles meet." name="description"]
    meta [content="#0b0e20" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/mandelbrot/" rel="canonical"]
    meta [content="The Mandelbrot Set" property="og:title"]
    meta [content="A quiet float through deep space beside the most famous shape in mathematics. Come see the orange fire at the edge." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="SceneXP" property="og:site_name"]
    meta [content="https://www.scenexp.com/mandelbrot/" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/mandelbrot/assets/og-mandelbrot.jpg?v=1" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="A deep zoom into the Mandelbrot set: a giant spiral of glowing red and gold fractal filaments coiling toward its center against dark space." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="The Mandelbrot Set" name="twitter:title"]
    meta [content="A quiet float through deep space beside the most famous shape in mathematics. Come see the orange fire at the edge." name="twitter:description"]
    meta [content="https://www.scenexp.com/mandelbrot/assets/og-mandelbrot.jpg?v=1" name="twitter:image"]
    meta [content="A deep zoom into the Mandelbrot set: a giant spiral of glowing red and gold fractal filaments coiling toward its center against dark space." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://www.scenexp.com/mandelbrot/#website",
        "url": "https://www.scenexp.com/mandelbrot/",
        "name": "The Mandelbrot Set",
        "description": "A passive 3D float through deep space beside the Mandelbrot set, its black interior outlined by a neon orange glow, honoring Benoit Mandelbrot.",
        "inLanguage": "en-US"
      }
    title
      "The Mandelbrot Set"
    link [as="style" href="../shared/css/styles-1.0.0.min.css?v=7" rel="preload"]
    link [as="style" href="css/experience.min.css?v=2" rel="preload"]
    link [as="script" href="../lib/three.min.js" rel="preload"]
    link [href="favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    link [href="css/experience.min.css?v=2" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    h1.sr-only
      "The Mandelbrot Set"
    noscript
      div.noscript-fallback
        h1
          "The Mandelbrot Set"
        p
          "This is a 3D visit to the Mandelbrot set, floating in deep space, and it needs JavaScript to run. In the scene you drift in a softly lit starfield while the most famous fractal in mathematics hangs in the middle of your view. Its interior is pure black, its infinitely detailed boundary glows neon orange, and faint nebulae keep the space around it from ever going fully dark. Step in and the auto zoom flies you into the boundary's spirals, as deep as a computer's numbers can go, and one of eleven glowing rings can send the next dive somewhere else. The shape honors Benoit Mandelbrot, who first plotted it in 1980. If you would like a small world like this built for someone you admire, the developer would be glad to hear from you."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        div.loader-title
          "THE MANDELBROT SET"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    div#blocker
      div#instructions
        p.title
          "WELCOME"
        p.subtitle
          "You are floating in deep space beside the most famous shape in mathematics"
        p.click-prompt
          "Click to drift closer"
        div.controls-hint
          span
            "DIVE"
          "The flight begins as you step in, down into the burning edge. The detail never ends."
          span
            "STEER"
          "Pause or reset with the buttons below. After a reset, tap a glowing ring to dive somewhere new. Escape brings you back here."
        a#explore-link.welcome-explore [href="/"]
          "More 3D worlds to explore at SceneXP.com"
    div#depth-chip.depth-chip
    div#dialog-modal.hidden [aria-labelledby="dialog-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#dialog-title.piece-title
            "In the Cosmos"
          p#dialog-message.piece-subtitle
          button.piece-enter.dialog-primary [data-close type="button"]
            "Keep floating"
    canvas#game-canvas [aria-label="A 3D view of deep space: the Mandelbrot set floats ahead, a pure black fractal outlined in glowing neon orange, with stars and faint nebulae all around" role="img"]
    section#prop-panel.prop-panel [aria-labelledby="prop-panel-heading" hidden]
      h2#prop-panel-heading.prop-panel-heading
        "Places to dive"
      p.prop-panel-note
        "Choose a place and the dive begins there. The arrow keys move through the list, and Tab or Escape puts it away."
      ul#prop-list.prop-list
    script [src="../lib/three.min.js"]
    script [src="js/main.min.js" type="module"]"
`;

exports[`www/privacy.html 1`] = `
"<!doctype html>
html [lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="How SceneXP handles your privacy: no accounts, no cookies, no third-party trackers, just anonymized usage counts and ordinary server logs." name="description"]
    meta [content="#f7f7fb" media="(prefers-color-scheme: light)" name="theme-color"]
    meta [content="#0e0f14" media="(prefers-color-scheme: dark)" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/privacy.html" rel="canonical"]
    meta [content="Privacy | SceneXP" property="og:title"]
    meta [content="How SceneXP handles your privacy: no accounts, no cookies, no third-party trackers, just anonymized usage counts and ordinary server logs." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="SceneXP" property="og:site_name"]
    meta [content="https://www.scenexp.com/privacy.html" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/assets/og-image.jpg?v=4" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="Four scenes from the SceneXP collection in a grid: a glowing orange fractal spiral, a 3D football field with orange and blue players in the middle of a play, a row of red-fruited trees in a green garden, and the blue curve of Earth seen from orbit with a targeting reticle and incoming raiders. Below them the SceneXP.com wordmark and the line, 3D worlds, games, and experiments, right in your browser." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="Privacy | SceneXP" name="twitter:title"]
    meta [content="No accounts, no cookies, no third-party trackers, just anonymized usage counts and ordinary server logs." name="twitter:description"]
    meta [content="https://www.scenexp.com/assets/og-image.jpg?v=4" name="twitter:image"]
    meta [content="Four scenes from the SceneXP collection in a grid: a glowing orange fractal spiral, a 3D football field with orange and blue players in the middle of a play, a row of red-fruited trees in a green garden, and the blue curve of Earth seen from orbit with a targeting reticle and incoming raiders. Below them the SceneXP.com wordmark and the line, 3D worlds, games, and experiments, right in your browser." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "@id": "https://www.scenexp.com/privacy.html#webpage",
        "url": "https://www.scenexp.com/privacy.html",
        "name": "SceneXP Privacy",
        "description": "How SceneXP handles your privacy.",
        "inLanguage": "en-US",
        "isPartOf": {
          "@id": "https://www.scenexp.com/#website"
        }
      }
    title
      "Privacy | SceneXP"
    link [as="style" href="/css/site.min.css?v=4" rel="preload"]
    link [href="/favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="/css/site.min.css?v=4" rel="stylesheet"]
    script [src="/js/theme.min.js?v=1"]
    script [defer src="/js/nav.min.js?v=1"]
  body
    a.skip-link [href="#main"]
      "Skip to main content"
    header.site-header
      div.container.site-header-inner
        a.brand [href="/"]
          svg.brand-mark [aria-hidden="true" focusable="false" viewbox="0 0 32 32"]
            defs
              lineargradient#brand-grad [x1="0" x2="1" y1="0" y2="1"]
                stop [offset="0" stop-color="#6c4cf1"]
                stop [offset="1" stop-color="#06b6d4"]
            rect [fill="url(#brand-grad)" height="32" rx="8" width="32"]
            path [d="M8 22 14 10l4 8 3-5 3 9" fill="none" stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"]
          "SceneXP"
        nav#site-nav.site-nav [aria-label="Main"]
          ul
            li
              a [href="/#experiences"]
                "Experiences"
            li
              a [href="/contact.html"]
                "Contact"
            li
              a [href="/contribute.html"]
                "Contribute"
        button#nav-toggle.nav-toggle [aria-controls="site-nav" aria-expanded="false" aria-label="Menu" hidden type="button"]
          svg.icon-nav-open [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            path [d="M4 7h16M4 12h16M4 17h16"]
          svg.icon-nav-close [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            path [d="M6 6l12 12M18 6 6 18"]
        button#theme-toggle.theme-toggle [aria-label="Theme" hidden type="button"]
          svg.icon-theme-light [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            circle [cx="12" cy="12" fill="currentColor" r="4.5" stroke="none"]
            path [d=#f2e7be5368]
          svg.icon-theme-dark [aria-hidden="true" focusable="false" viewbox="0 0 24 24"]
            path [d=#bac0ce3668 fill="currentColor"]
          svg.icon-theme-system [aria-hidden="true" focusable="false" viewbox="0 0 24 24"]
            circle [cx="12" cy="12" fill="none" r="8.5" stroke="currentColor" stroke-width="2"]
            path [d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor"]
    main#main
      div.page-hero
        div.container
          h1
            "Your privacy, plainly"
          p
            "This site was built to delight you, not to follow you around. Here is the complete picture of what it does and does not do with your visit."
      div.section
        div.container.prose
          h2
            "What this site never does"
          ul
            li
              "No accounts and nothing to sign up for."
            li
              "No cookies."
            li
              "No third-party scripts, fonts, trackers, or advertising of any kind. Every file you load comes from this domain."
            li
              "No selling or sharing of anything about your visit with anyone."
          h2
            "What stays on your device"
          ul
            li
              strong
                "Your theme choice."
              "If you pick light or dark mode, that preference is saved in your browser's local storage. It never leaves your device."
            li
              strong
                "A small puzzle token."
              "The contact page and the 3D experiences ask your browser to solve a tiny proof-of-work puzzle that deters spam robots. The solved token is kept in your browser's session storage and expires on its own. It is the one item on this list that does travel: it rides along with the usage pings described below, so that one visit's pings can be grouped together, and a short piece of it becomes the reference in the subject line if you email us from the contact page."
            li
              strong
                "Your progress inside an experience, while the tab is open."
              "Each 3D experience remembers your discovery checklist progress and whether you have already seen its little celebration messages. That lives in your browser's session storage and is cleared when the tab closes."
            li
              strong
                "A few things that are meant to outlast the visit."
              "Where an experience would be poorer for forgetting, it saves to your browser's local storage instead, so it is still there when you come back. The Fractal Garden saves your garden: which trees you planted, where you planted them, and how they are getting on. The garden has a Start a new garden button that clears its save on the spot. Earth Defense saves your best score along with your sound and control settings."
            li
              strong
                "Your game of X's and O's."
              "X's and O's saves your best score in your browser's local storage, along with the last play you called, the defense you chose to face, the colors you chose for the teams and the field, whether you turned the sound on or off, and whether you turned on Auto jump, so the game comes back the way you left it. It also keeps a game you have not finished, which is the play number, the running score, and one line for each play so far, so closing the tab halfway through does not cost you the whole game. That one is cleared as soon as the game ends, and the Start over button in the playbook clears it on the spot."
            li
              strong
                "You can remove any of it whenever you like."
              "Apart from that puzzle token, everything above stays on your device and is never sent to us or to anyone else. Clearing this site's data in your browser settings removes all of it at once."
          h2
            "What the web server keeps"
          p
            "Each time your browser asks this site for something, the web server writes a short line to its log, the way nearly every website does. That line includes your IP address, the time, the address of what was asked for, the page that sent you here, and the brief description your browser gives of itself, such as its name, its version, and your operating system. We use these logs only to keep the site running and secure, for example to track down a fault or turn away an attack. They are never sold or shared, never used to build a picture of who you are, and are deleted automatically within a year."
          h2
            "Anonymous usage counts"
          p
            "As visitors explore the 3D experiences, the pages send simple pings to this same domain, such as "someone found the waterfall." Each ping names the experience it came from and carries your browser's language setting, a note of whether you are on a phone or a computer, and the puzzle token that groups one visit's pings together. The pings land in a separate log of their own, which never records your IP address or the description your browser gives of itself, and are summarized into anonymized daily counts. In the published summaries each visitor is known only by a throwaway label: no names, no IP addresses, and no browser fingerprints. Some experiences display these counts inside the world itself as a little visitor dashboard."
          p
            "X's and O's notes a little more, because the game is the plays. Each time you call a play, snap the ball, or throw it, and each time a play ends, it records the play and the defense, the receiver you picked, how it turned out and what it was worth, along with your running score, whether the sound was on, and whether your screen was held upright or sideways. It never records the size of your screen or anything else that could pick your device out from anyone else's."
          h2
            "If you email us"
          p
            "Your message and address are used only to reply to you. That is the whole story."
          h2
            "Questions"
          p
            "If anything here gives you pause, please"
            a [href="/contact.html"]
              "reach out"
            ". We are happy to explain anything in more detail."
          p
            em
              "Last updated September 18, 2026."
    footer.site-footer
      div.container.site-footer-inner
        div.footer-brand
          a.brand [href="/"]
            svg.brand-mark [aria-hidden="true" focusable="false" viewbox="0 0 32 32"]
              defs
                lineargradient#brand-grad-footer [x1="0" x2="1" y1="0" y2="1"]
                  stop [offset="0" stop-color="#6c4cf1"]
                  stop [offset="1" stop-color="#06b6d4"]
              rect [fill="url(#brand-grad-footer)" height="32" rx="8" width="32"]
              path [d="M8 22 14 10l4 8 3-5 3 9" fill="none" stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"]
            "SceneXP"
          p
            "3D worlds, games, and experiments, every one running right in your browser. Thank you for visiting."
        nav.footer-nav [aria-label="Explore"]
          h2
            "Explore"
          ul
            li
              a [href="/#experiences"]
                "Experiences"
            li
              a [href="/contact.html"]
                "Contact"
            li
              a [href="/contribute.html"]
                "Contribute"
        nav.footer-nav [aria-label="Project"]
          h2
            "Project"
          ul
            li
              a [href="https://github.com/stevendnoll/SceneXP" rel="noopener noreferrer" target="_blank" title="View the SceneXP source code on GitHub"]
                "GitHub"
            li
              a [aria-current="page" href="/privacy.html"]
                "Privacy"
            li
              a [href="/terms.html"]
                "Terms"
        div.footer-meta
          p
            "Built with Three.js and browser-native HTML, CSS, and JavaScript. Open source under the MIT license."
          p
            "SceneXP © 2026"
            a [href="https://www.continuumcommercellc.com/" rel="noopener noreferrer" target="_blank" title="View the Continuum Commerce LLC website"]
              "Continuum Commerce LLC"
            ".""
`;

exports[`www/roqui/index.html 1`] = `
"<!doctype html>
html [data-ui-theme="neon" lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="Step into a joyful 3D Zumba class led by Roqui, a wonderful instructor at the Matt Griffin YMCA. Catch the beat, meet the class, fire up the speakers, and find the disco ball." name="description"]
    meta [content="#ff2d78" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/roqui/" rel="canonical"]
    meta [content="Zumba with Roqui" property="og:title"]
    meta [content="A joyful 3D Zumba class, built with love for a wonderful instructor. Step in, catch the beat, and say hola to Roqui and her class." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="Zumba with Roqui" property="og:site_name"]
    meta [content="https://www.scenexp.com/roqui/" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/roqui/assets/og-roqui.jpg?v=1" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="Roqui's 3D Zumba class mid-song: lights down, disco ball spinning, the class dancing in front of the mirror wall." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="Zumba with Roqui" name="twitter:title"]
    meta [content="A joyful 3D Zumba class, built with love for a wonderful instructor. Step in and catch the beat." name="twitter:description"]
    meta [content="https://www.scenexp.com/roqui/assets/og-roqui.jpg?v=1" name="twitter:image"]
    meta [content="Roqui's 3D Zumba class mid-song: lights down, disco ball spinning, the class dancing in front of the mirror wall." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://www.scenexp.com/roqui/#website",
        "url": "https://www.scenexp.com/roqui/",
        "name": "Zumba with Roqui",
        "description": "A walkable 3D Zumba class, built with love for a wonderful instructor at the Matt Griffin YMCA.",
        "inLanguage": "en-US"
      }
    title
      "Zumba with Roqui"
    link [as="style" href="../shared/css/styles-1.0.0.min.css?v=7" rel="preload"]
    link [as="script" href="../lib/three.min.js" rel="preload"]
    link [href="favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    a.skip-link [href="#autopilot-btn"]
      "Skip to the page controls"
    h1.sr-only
      "Zumba with Roqui"
    noscript
      div.noscript-fallback
        h1
          "Zumba with Roqui"
        p
          "This is a walkable 3D Zumba class, which needs JavaScript to run. It was built with love for a wonderful Zumba instructor who teaches every week at the Matt Griffin YMCA in SeaTac, Washington. She is in there right now, leading her class in front of the mirror wall, happy to say hola. If you would like a small world like this built for someone you love, the developer would be glad to hear from you."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        div.loader-title
          "ZUMBA WITH ROQUI"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    div#blocker
      div#instructions
        p.title
          "WELCOME"
        p.subtitle
          "Roqui's Zumba class is in session"
        p.click-prompt
          "Click to join the class"
        div.controls-hint
          span
            "WASD"
          "Move"
          span
            "MOUSE"
          "Look"
        a#explore-link.welcome-explore [href="/"]
          "More 3D worlds to explore at SceneXP.com"
    div#hud
      div.crosshair [aria-hidden="true"]
      div#look-label.look-label [aria-live="polite" role="status"]
    div#piece-modal.hidden [aria-labelledby="piece-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#piece-title.piece-title
            "Section"
          p#piece-subtitle.piece-subtitle
          a#piece-enter.piece-enter [href="#"]
            "Enter →"
          button.piece-cancel [data-close]
            "Keep exploring"
    div#help-modal.hidden [aria-labelledby="help-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.help-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#help-title.piece-title
            "¡Hola!"
          p.piece-subtitle
            "So glad you made it to class! No experience needed here, just follow along and keep smiling. The steps will find you, I promise."
          ul.help-list
            li.help-desktop
              strong
                "Move:"
              kbd
                "W"
              kbd
                "A"
              kbd
                "S"
              kbd
                "D"
              "or the arrow keys."
            li.help-desktop
              strong
                "Look:"
              "move the mouse. Click the scene once to capture the cursor. Press"
              kbd
                "Esc"
              "to release it."
            li.help-mobile
              strong
                "Move &amp; look:"
              "use the left joystick to walk and the right joystick to look around."
            li
              strong
                "The music:"
              span.help-verb
                "click"
              "the speakers or my iPhone to start the playlist. The whole room wakes up."
            li
              strong
                "Autopilot:"
              "press"
              kbd
                "T"
              "or the tour button (top-left) and the studio will show you around. Move to take back the controls."
            li
              strong
                "Settings:"
              "the gear icon (top-right) adjusts movement, look sensitivity, and brightness."
          button.piece-cancel [data-close]
            "Thanks, let's dance!"
    div#dialog-modal.hidden [aria-labelledby="dialog-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#dialog-title.piece-title
            "In the Studio"
          p#dialog-message.piece-subtitle
          button.piece-enter.dialog-primary [data-close type="button"]
            "Keep dancing"
          button#dialog-return-btn.piece-cancel.dialog-return.hidden [type="button"]
            "Back to the dance floor"
    div#complete-modal.hidden [aria-labelledby="complete-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.complete-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          p.complete-kicker [aria-hidden="true"]
            "★ &nbsp;All discoveries found&nbsp; ★"
          h2#complete-title.piece-title
            "You danced through all of it"
          p.piece-subtitle
            "Thank you for spending time in here. This little studio was built with love, for a wonderful Zumba instructor whose class really is the best hour of the week. If you would like a small world like this made for someone you love, or for your business, I would genuinely love to hear from you."
          a#complete-contact.piece-enter [href="/contact.html"]
            "Get in touch →"
          button#complete-share.piece-cancel.complete-share [type="button"]
            "Share this"
          p#complete-share-status.sr-only [aria-live="polite" role="status"]
          button.piece-cancel [data-close]
            "Keep exploring"
    div#nudge-modal.hidden [aria-labelledby="nudge-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.complete-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          p.complete-kicker [aria-hidden="true"]
            "★ &nbsp;A few discoveries in&nbsp; ★"
          h2#nudge-title.piece-title
            "Enjoying the class?"
          p.piece-subtitle
            "Thanks for dancing along. This studio was built with love for a wonderful Zumba instructor. If you would like something like it built for someone you care about, I would love to hear from you. No rush, the music is not going anywhere."
          a#nudge-contact.piece-enter [href="/contact.html"]
            "Get in touch →"
          button.piece-cancel [data-close]
            "Keep exploring"
    div#whiteboard-view.hidden [aria-label="The class schedule board, up close" aria-modal="true" role="dialog"]
      div.whiteboard-backdrop [data-close]
      div.whiteboard-frame
        div.whiteboard-surface
          canvas#whiteboard-canvas.whiteboard-canvas
        div.whiteboard-tray [aria-hidden="true"]
      p#whiteboard-caption.whiteboard-caption
      p.whiteboard-hint [aria-hidden="true"]
        "Drag to pan across the board"
      button.whiteboard-close [aria-label="Step back from the schedule board" data-close]
        "&times;"
    div#touch-controls
      div#joystick-zone
        div.joystick-base-fixed
          div.joystick-thumb-fixed
      div#look-joystick-zone
        div.joystick-base-fixed
          div.joystick-thumb-fixed
      div#tap-zone
    button#autopilot-btn.ui-float.menu-btn.autopilot-btn [aria-label="Toggle the autopilot tour (keyboard shortcut T)" aria-pressed="false" title="Autopilot tour (T)"]
      svg [aria-hidden="true" viewbox="0 0 24 24"]
        path [d=#10d062c4ff stroke-dasharray="2.6 2.2"]
        path [d="M21.5 3.6l.6 7.5-6.1-2.4z" fill="currentColor" stroke="none"]
        circle [cx="5" cy="19" fill="currentColor" r="2.2" stroke="none"]
    button#settings-btn.ui-float.settings-btn [aria-controls="settings-panel" aria-expanded="false" aria-label="Movement settings" title="Movement settings"]
      svg.settings-icon [aria-hidden="true" viewbox="0 0 24 24"]
        path [d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"]
        path [d=#88c0d99db8]
    div#settings-panel.settings-panel.hidden
      div.settings-header
        span
          "Settings"
        button#settings-close.settings-close [aria-label="Close"]
          "&times;"
      div.settings-body
        label.settings-label
          "Walk Speed"
          input#walk-speed-slider [max="14" min="2" step="0.5" type="range" value="6.5"]
          span.settings-value#walk-speed-value
            "6.5"
        label.settings-label
          "Look Sensitivity"
          input#look-speed-slider [max="4" min="0.5" step="0.1" type="range" value="1.0"]
          span.settings-value#look-speed-value
            "1.0"
        label.settings-label
          "Ambient Brightness"
          input#settings-light-slider [max="1.5" min="0" step="0.05" type="range" value="1"]
          span.settings-value#settings-light-value
            "100%"
    canvas#game-canvas [aria-label="A walkable 3D Zumba class led by Roqui" role="img"]
    script [src="../lib/three.min.js"]
    script [src="js/main.min.js" type="module"]"
`;

exports[`www/seedtoseed/index.html 1`] = `
"<!doctype html>
html [data-ui-theme="garden" lang="en"]
  head
