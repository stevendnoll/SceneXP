    link [href="js/host.min.js" rel="modulepreload"]
    link [href="js/cast.min.js" rel="modulepreload"]
    link [href="js/meet.min.js" rel="modulepreload"]
    link [href="js/panel.min.js" rel="modulepreload"]
    link [href="js/ics.min.js" rel="modulepreload"]
    link [href="js/qr.min.js" rel="modulepreload"]
    link [href="js/guards.min.js" rel="modulepreload"]
    link [href="js/layout.min.js" rel="modulepreload"]
    link [href="js/rooms.min.js" rel="modulepreload"]
    link [href="../shared/js/people-1.0.0.min.js" rel="modulepreload"]
    link [href="favicon.svg?v=3" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    link [href="css/experience.min.css?v=53" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    h1.sr-only
      "Whitestone Home Care"
    noscript
      div.noscript-fallback
        h1
          "Whitestone Home Care"
        p
          "This is a 3D model of your home, and it needs JavaScript to run. On it, you build a cleaning checklist room by room from a menu of tasks, each with a set price and a time estimate, so your quote and the expected length of the visit update as you go. When the list is ready, you choose a time for your cleaning."
        p
          "Whitestone Home Care is a demo by SceneXP, not a real company. Prices and bookings are examples."
        p
          "SceneXP is a home for 3D experiences that run right in your browser."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/"]
                "Explore SceneXP"
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        img.loader-logo [alt="Whitestone Home Care" height="239" src="assets/logo-whitestone.svg?v=3" width="1068"]
        p.loader-tagline
          "Bright homes, kept with care."
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    canvas#game-canvas [aria-label="A model of your home on a round stone turntable in a bright white studio. Drag to turn it, and tap a floor to open it." role="img"]
    ol#ws-rooms.ws-rooms [hidden]
    div#ws-halo.ws-halo [aria-hidden="true" hidden]
    section#ws-host.ws-host [aria-labelledby="host-name" hidden]
      div.host-head
        button#host-back.host-back [aria-label="Back" hidden title="Back" type="button"]
          svg [aria-hidden="true" focusable="false" height="18" viewbox="0 0 20 20" width="18"]
            path [d="M16 10H5M9.5 5l-5 5 5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2"]
        button#host-portrait.host-portrait [aria-label="Meet Maya" title="Meet Maya" type="button"]
          "M"
        p.host-who
          span#host-name.host-name
            "Maya"
          span.host-role
            "Whitestone Home Care"
        button#host-next.host-next [aria-label="Continue" hidden title="Continue" type="button"]
          svg [aria-hidden="true" focusable="false" height="18" viewbox="0 0 20 20" width="18"]
            path [d="M4 10h11M10.5 5l5 5-5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2"]
      ol#host-progress.host-progress [hidden]
      div#host-facts.host-facts [aria-label="Your home at a glance" hidden role="group"]
      button#host-expand.ws-btn.ws-btn-small.host-expand [aria-label="Need a hand? Ask Maya, your host." hidden type="button"]
        "Need a hand?"
      p#host-line.host-line
      div#host-choices.host-choices [hidden]
      div#host-actions.host-actions
      p#host-small.host-small [hidden]
      div.host-foot
        a#explore-link.host-explore [href="/"]
          "More 3D worlds at SceneXP.com"
        button#host-reset.host-reset [hidden title="Clear everything and start from the beginning" type="button"]
          "Start over"
    aside#ws-panel.ws-panel [aria-labelledby="panel-title" hidden]
      div.panel-head
        button#panel-back.panel-back [aria-label="Back to the whole house" title="Back to the whole house" type="button"]
          svg [aria-hidden="true" focusable="false" height="18" viewbox="0 0 20 20" width="18"]
            path [d="M16 10H5M9.5 5l-5 5 5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2"]
        h2#panel-title.panel-title
      p#panel-summary.panel-summary [hidden]
      p#panel-held.panel-held [hidden]
      div#panel-baths.panel-baths [aria-labelledby="panel-baths-label" hidden role="group"]
        p#panel-baths-label.panel-chips-heading
          "Type of bath"
        div#panel-baths-list.panel-baths-list
      h3#panel-heading.panel-heading [hidden]
      ul#panel-list.panel-list [hidden]
      p#panel-empty.panel-empty [hidden]
      div#panel-detail.panel-detail [hidden]
      div#panel-chips.panel-chips [hidden]
      div#panel-actions.panel-actions
    p#ws-live.sr-only [aria-live="polite" role="status"]
    div#ws-brand.ui-float.ws-brand
      img [alt="Whitestone Home Care" height="239" src="assets/logo-whitestone.svg?v=3" width="1068"]
    div#ws-toast.ws-toast [hidden]
      span#toast-text
      button#toast-undo.ws-btn.ws-btn-small [hidden type="button"]
        "Undo"
    div#setup.card-overlay [hidden]
      div#setup-panel.card-panel.form-panel [aria-describedby="setup-about" aria-labelledby="setup-title-text" aria-modal="true" role="dialog" tabindex="-1"]
        h2#setup-title-text.card-title
          "Start your own"
        p#setup-about.card-meta
          "Tell us a little about your home. You can change any of this later."
        form#setup-form.ws-form [novalidate]
          div.form-row
            label [for="setup-residence"]
              "What kind of home is it?"
            select#setup-residence.ws-select
          div#setup-attached-row.form-row [hidden]
            label [for="setup-attached"]
              "Its neighbors"
            select#setup-attached.ws-select
          fieldset.form-group
            legend
              "Which levels does your home have?"
            div#setup-levels-list.form-columns
            p#setup-levels-note.form-hint
              "Every home has a main floor, so it is always ticked."
          div.form-row
            label [for="setup-frequency"]
              "How often would you like a visit?"
            select#setup-frequency.ws-select
          div.form-row
            label [for="setup-household"]
              "Anything your cleaner should know"
            textarea#setup-household.ws-input [aria-describedby="setup-household-hint" maxlength="500" placeholder="Parking, where supplies are kept, pets at home" rows="3"]
            p#setup-household-hint.form-hint [hidden]
          p#setup-error.form-error [hidden role="alert"]
          div.card-actions
            button#setup-cancel.ws-btn [type="button"]
              "Cancel"
            button#setup-save.ws-btn.ws-btn-primary [type="submit"]
              "Start my checklist"
    div#preferences.card-overlay [hidden]
      div#preferences-panel.card-panel.form-panel [aria-describedby="preferences-about" aria-labelledby="preferences-title" aria-modal="true" role="dialog" tabindex="-1"]
        h2#preferences-title.card-title
          "Anything we should avoid?"
        p#preferences-about.card-meta
          "Care preferences apply to the whole visit, and your cleaner sees them first. They are optional."
        form#prefs-form.ws-form [novalidate]
          div#prefs-groups
          div.form-row
            label [for="prefs-note"]
              "Anything else we should know"
            textarea#prefs-note.ws-input [aria-describedby="prefs-note-hint" maxlength="300" rows="3"]
            p#prefs-note-hint.form-hint [hidden]
          div.card-actions
            button#prefs-skip.ws-btn [type="button"]
              "Not now"
            button#prefs-save.ws-btn.ws-btn-primary [type="submit"]
              "Save preferences"
    div#quote.card-overlay [hidden]
      div#quote-panel.card-panel.list-panel [aria-describedby="demo-quote" aria-labelledby="quote-title" aria-modal="true" role="dialog" tabindex="-1"]
        div.card-head
          h2#quote-title.card-title
            "Your quote"
          button#quote-close.ws-btn.ws-btn-small [type="button"]
            "Close"
        p#demo-quote.demo-notice
          strong.demo-notice-title
            "Just a demo"
          span.demo-notice-text
            "Whitestone Home Care is not a real company. These prices are examples, and nothing is ever charged."
        p#quote-total.quote-total
        p#quote-time.card-meta
        div.card-actions.quote-actions
          button#quote-open-checklist.ws-btn.ws-btn-primary [type="button"]
            "Change tasks"
        p#quote-minimum.quote-minimum
        p#quote-problems.form-hint [hidden]
        div#quote-breakdown.quote-breakdown
        section#quote-prefs.quote-prefs [aria-labelledby="quote-prefs-title" hidden]
          h3#quote-prefs-title.quote-prefs-title
            "Care preferences"
          ul#quote-prefs-list.quote-prefs-list
          p#quote-prefs-note.quote-prefs-note
        p#quote-tax.card-meta
        p.card-meta.quote-promise
          "You will never pay more than your quote without approving it first. Anything we skip comes off your bill."
    div#booking.card-overlay [hidden]
      div#booking-panel.card-panel.booking-panel [aria-describedby="demo-booking booking-summary" aria-labelledby="booking-title" aria-modal="true" role="dialog" tabindex="-1"]
        div.card-head
          h2#booking-title.card-title
            "Choose a time"
          button#booking-close.ws-btn.ws-btn-small [type="button"]
            "Close"
        p#demo-booking.demo-notice
          strong.demo-notice-title
            "Just a demo"
          span.demo-notice-text
            "Whitestone Home Care is not a real company. Choosing a time books nothing, and no cleaner will come."
        p#booking-summary.card-meta
        div.booking-head
          button#booking-prev.ws-btn.ws-btn-small.booking-nav [aria-label="Previous month" title="Previous month" type="button"]
            "&lsaquo;"
          h3#booking-month.booking-month [aria-live="polite"]
          button#booking-next.ws-btn.ws-btn-small.booking-nav [aria-label="Next month" title="Next month" type="button"]
            "&rsaquo;"
        div.booking-calendar [aria-labelledby="booking-month" role="group"]
          div.booking-week.booking-weekdays [aria-hidden="true"]
            span
              "Sun"
            span
              "Mon"
            span
              "Tue"
            span
              "Wed"
            span
              "Thu"
            span
              "Fri"
            span
              "Sat"
          div#booking-days
        p#booking-status.form-note [hidden]
        h3#booking-day-title.booking-day-title [hidden]
        div#booking-times.booking-times [aria-labelledby="booking-day-title" hidden role="radiogroup"]
        p#booking-error.form-error [hidden role="alert"]
        div.card-actions
          button#booking-cancel.ws-btn [type="button"]
            "Not now"
          button#booking-confirm.ws-btn.ws-btn-primary [disabled type="button"]
            "Book my visit"
    div#receipt.card-overlay [hidden]
      div#receipt-panel.card-panel.receipt-panel [aria-describedby="demo-receipt" aria-labelledby="receipt-title" aria-modal="true" role="dialog" tabindex="-1"]
        div.card-head
          h2#receipt-title.card-title
            "Your visit is booked"
          button#receipt-close.ws-btn.ws-btn-small [type="button"]
            "Close"
        p#demo-receipt.demo-notice
          strong.demo-notice-title
            "Just a demo"
          span.demo-notice-text
            "Whitestone Home Care is not a real company. This visit is not real, and no cleaner will come."
        div#receipt-unsent.receipt-unsent [hidden]
          p
            "You have changes your cleaner has not seen yet."
          button#receipt-send.ws-btn.ws-btn-small.ws-btn-primary [type="button"]
            "Send my changes"
        p#receipt-when.receipt-when
        div.receipt-visit
          a#receipt-calendar.ws-btn.ws-btn-small [download href="#"]
            "Add to calendar"
          button#receipt-reschedule.ws-btn.ws-btn-small [hidden type="button"]
            "Change the time"
          button#receipt-cancel-visit.ws-btn.ws-btn-small [hidden type="button"]
            "Cancel my visit"
          button#receipt-book.ws-btn.ws-btn-small.ws-btn-primary [hidden type="button"]
            "Choose a time"
        p#receipt-locked.form-note [hidden]
        p#receipt-quote.receipt-quote
        p.card-meta
          "You will never pay more than your quote without approving it first."
        div.receipt-share
          div.receipt-link
            label.receipt-label [for="receipt-link"]
              "Link for your cleaner"
            input#receipt-link.ws-input [readonly type="text"]
            div.receipt-buttons
              button#receipt-copy-link.ws-btn.ws-btn-small [type="button"]
                "Copy"
              button#receipt-share.ws-btn.ws-btn-small [type="button"]
                "Share"
            p.receipt-label
              "PIN"
            p#receipt-pin.receipt-pin
            button#receipt-copy-pin.ws-btn.ws-btn-small [type="button"]
              "Copy"
            button#receipt-new-pin.ws-btn.ws-btn-small [hidden type="button"]
              "Set a new PIN"
            p#receipt-pin-note.form-note
              "Send the PIN separately, for example by text."
          figure.receipt-qr
            div#receipt-qr-box.receipt-qr-box
            figcaption
              "Scan to open the checklist"
        p#receipt-expires.card-meta
        div.receipt-edit
          label.receipt-label [for="receipt-edit-link"]
            "Your private edit link"
          p.form-note
            "Keep this one to yourself. It lets you edit this checklist, approve add-ons, and read visit reports from any device."
          input#receipt-edit-link.ws-input [readonly type="text"]
          button#receipt-copy-edit.ws-btn.ws-btn-small [type="button"]
            "Copy"
        p#receipt-standin.form-note [hidden]
        p#receipt-status.sr-only [aria-live="polite" role="status"]
        div.card-actions
          button#receipt-unpublish.ws-btn.ws-btn-small.ws-btn-quiet.receipt-unpublish [hidden type="button"]
            "Stop sharing this checklist"
          button#receipt-done.ws-btn.ws-btn-primary [type="button"]
            "Done"
    div#visit-report.card-overlay [hidden]
      div#visit-report-panel.card-panel.list-panel [aria-labelledby="visit-report-title" aria-modal="true" role="dialog" tabindex="-1"]
        div.card-head
          h2#visit-report-title.card-title
            "Your visit report"
          button#visit-report-close.ws-btn.ws-btn-small [type="button"]
            "Close"
        p#visit-report-when.card-meta
        div#visit-report-body.visit-report-body
        p.card-meta.quote-promise
          "You will never pay more than your quote without approving it first. Anything we skip comes off your bill."
        div.card-actions
          button#visit-report-done.ws-btn.ws-btn-primary [type="button"]
            "Done"
    div#addons.card-overlay [hidden]
      div#addons-panel.card-panel.list-panel [aria-labelledby="addons-title" aria-modal="true" role="dialog" tabindex="-1"]
        div.card-head
          h2#addons-title.card-title
            "Add-ons from your cleaner"
          button#addons-close.ws-btn.ws-btn-small [type="button"]
            "Close"
        p#addons-lead.card-meta
        div#addons-body.addons-body
        p.card-meta.quote-promise
          "You only pay for an add-on if you approve it and it is done."
        p#addons-status.sr-only [aria-live="polite" role="status"]
        div.card-actions
          button#addons-done.ws-btn.ws-btn-primary [type="button"]
            "Done"
    div#checklist.card-overlay.checklist-overlay [hidden]
      div#checklist-panel.card-panel.checklist-panel [aria-labelledby="checklist-title" aria-modal="true" role="dialog" tabindex="-1"]
        div.card-head
          h2#checklist-title.card-title
            "Checklist"
          div.card-head-actions
            button#checklist-send.ws-btn.ws-btn-primary.ws-btn-small [hidden type="button"]
              "Send my changes"
            button#checklist-close.ws-btn.ws-btn-small [type="button"]
              "Close"
        p#checklist-summary.card-meta
        p#storage-note.storage-note
        div.checklist-actions
          button#checklist-add-room.ws-btn.ws-btn-primary.ws-btn-small [type="button"]
            "Add a room"
          button#checklist-print.ws-btn.ws-btn-small [type="button"]
            "Print"
          label.checklist-filter-label [for="checklist-filter"]
            "Show"
          select#checklist-filter.ws-select.checklist-filter
        p#checklist-showing.card-meta [hidden]
        div#checklist-body.checklist-body
    div#room.card-overlay [hidden]
      div#room-panel.card-panel.form-panel [aria-labelledby="room-title" aria-modal="true" role="dialog" tabindex="-1"]
        h2#room-title.card-title
          "Add a room"
        form#room-form.ws-form [novalidate]
          div.form-row
            label [for="room-area"]
              "Kind of room"
            select#room-area.ws-select
          fieldset#room-bath-row.form-group [hidden]
            legend
              "Type of bath"
            div#room-bath-list
          div.form-row
            label [for="room-level"]
              "Level"
            select#room-level.ws-select
          div.form-row
            label [for="room-label"]
              "Its name, if it needs one"
            input#room-label.ws-input [autocomplete="off" maxlength="40" placeholder="Emma's room, or the guest bath" type="text"]
          div#room-preset-row.form-row.form-check
            input#room-preset [aria-describedby="room-preset-list" checked type="checkbox"]
            label [for="room-preset"]
              "Add the standard tasks for this room"
          p#room-preset-list.form-note
          p#room-held.form-note [hidden]
          p#room-error.form-error [hidden role="alert"]
          div.card-actions
            button#room-remove.ws-btn.ws-btn-quiet [hidden type="button"]
              "Remove this room"
            button#room-cancel.ws-btn [type="button"]
              "Cancel"
            button#room-save.ws-btn.ws-btn-primary [type="submit"]
              "Add room"
    div#task.card-overlay [hidden]
      div#task-panel.card-panel.form-panel [aria-labelledby="task-title" aria-modal="true" role="dialog" tabindex="-1"]
        h2#task-title.card-title
          "Add a task"
        form#task-form.ws-form [novalidate]
          div.form-row
            label [for="task-task"]
              "Task"
            select#task-task.ws-select [aria-describedby="task-about"]
            p#task-about.form-note
          fieldset#task-options-row.form-group
            legend
              "Options"
            div#task-options-list
          div#task-size-row.form-row
            label [for="task-size"]
              "Size of the room"
            select#task-size.ws-select
          div#task-quantity-row.form-row
            label [for="task-quantity"]
              "How many"
            input#task-quantity.ws-input.ws-input-short [inputmode="numeric" max="50" min="1" step="1" type="number"]
          div.form-row.form-check
            input#task-important [type="checkbox"]
            label [for="task-important"]
              "Important. Please start here."
          p#task-price.task-price [aria-live="polite"]
          details#task-more.form-more
            summary
              "Notes, things to avoid, and photos"
            div.form-row
              label [for="task-notes"]
                "How you would like it done"
              textarea#task-notes.ws-input [aria-describedby="task-notes-hint" maxlength="500" rows="2"]
              p#task-notes-hint.form-hint [hidden]
            div.form-row
              label [for="task-avoid"]
                "Anything to avoid"
              textarea#task-avoid.ws-input [aria-describedby="task-avoid-hint" maxlength="500" placeholder="No abrasives on the marble" rows="2"]
              p#task-avoid-hint.form-hint [hidden]
            div.form-row
              label [for="task-products"]
                "Products to use or skip"
              input#task-products.ws-input [autocomplete="off" maxlength="200" type="text"]
            div.form-row
              p#task-photos-label.form-label
                "Photos"
              ul#task-photos.task-photos [aria-labelledby="task-photos-label"]
              input#task-photo-input.sr-only [accept="image/*" type="file"]
              label#task-photo-add.ws-btn.ws-btn-small.ws-file [for="task-photo-input"]
                "Add a photo"
              p#task-photo-note.form-note
                "Photos are resized and stripped of their location before they are kept."
          p#task-held.form-note [hidden]
          p#task-error.form-error [hidden role="alert"]
          div.card-actions
            button#task-remove.ws-btn.ws-btn-quiet [hidden type="button"]
              "Remove this task"
            button#task-cancel.ws-btn [type="button"]
              "Cancel"
            button#task-save.ws-btn.ws-btn-primary [type="submit"]
              "Add task"
    div#meet.card-overlay [hidden]
      div#meet-panel.card-panel.meet-panel [aria-describedby="meet-line" aria-labelledby="meet-title" aria-modal="true" role="dialog" tabindex="-1"]
        div.card-head
          h2#meet-title.card-title
            "Meet Maya"
          button#meet-close.ws-btn.ws-btn-small [type="button"]
            "Close"
        div.meet-stage
          canvas#meet-canvas.meet-canvas [aria-hidden="true"]
        p#meet-line.card-detail.meet-line
          "Hi there! I'm Maya, your host at Whitestone Home Care. I'm right here whenever you'd like a hand."
    div#confirm.card-overlay [hidden]
      div#confirm-panel.card-panel [aria-describedby="confirm-detail" aria-labelledby="confirm-title" aria-modal="true" role="dialog" tabindex="-1"]
        h2#confirm-title.card-title
        p#confirm-detail.card-detail
        div#confirm-actions.card-actions
    script [src="../lib/three/r186/three.min.js" type="module"]
    script [src="js/main.min.js" type="module"]"
`;

exports[`www/whitestone/tasks/index.html 1`] = `
"<!doctype html>
html [lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="no-referrer" name="referrer"]
    meta [content="noindex, nofollow" name="robots"]
    meta [content="Open the cleaning checklist your customer shared with you, room by room, with every task and note in one place." name="description"]
    meta [content="#F4F2EE" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/whitestone/tasks/" rel="canonical"]
    meta [content="Your Whitestone checklist" property="og:title"]
    meta [content="A cleaning checklist was shared with you. Open it with the 6 digit PIN that came with the link." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="SceneXP" property="og:site_name"]
    meta [content="https://www.scenexp.com/whitestone/tasks/" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/whitestone/tasks/assets/og-whitestone-tasks.jpg?v=1" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="The Whitestone Home Care wordmark, a low slate gable over the name, on warm stone." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="Your Whitestone checklist" name="twitter:title"]
    meta [content="A cleaning checklist was shared with you. Open it with the 6 digit PIN that came with the link." name="twitter:description"]
    meta [content="https://www.scenexp.com/whitestone/tasks/assets/og-whitestone-tasks.jpg?v=1" name="twitter:image"]
    meta [content="The Whitestone Home Care wordmark, a low slate gable over the name, on warm stone." name="twitter:image:alt"]
    title
      "Your checklist | Whitestone Home Care"
    link [href="../favicon.svg?v=3" rel="icon" type="image/svg+xml"]
    link [href="css/tasks.min.css?v=10" rel="stylesheet"]
    link [href="js/main.min.js" rel="modulepreload"]
    link [href="../js/copy.min.js" rel="modulepreload"]
    link [href="../js/beacons.min.js" rel="modulepreload"]
    link [href="../../shared/js/telemetry-1.0.0.min.js" rel="modulepreload"]
    link [href="../../shared/js/boot-1.0.0.min.js" rel="modulepreload"]
    link [href="../js/config.min.js" rel="modulepreload"]
    link [href="../js/links.min.js" rel="modulepreload"]
    link [href="../js/api.min.js" rel="modulepreload"]
    link [href="../js/standin.min.js" rel="modulepreload"]
    link [href="../js/photos.min.js" rel="modulepreload"]
    link [href="../js/seal.min.js" rel="modulepreload"]
    link [href="../js/sheet.min.js" rel="modulepreload"]
    link [href="../js/pricing.min.js" rel="modulepreload"]
    link [href="../js/sync.min.js" rel="modulepreload"]
    link [href="js/view.min.js" rel="modulepreload"]
    link [href="../js/booking.min.js" rel="modulepreload"]
    link [href="js/visit.min.js" rel="modulepreload"]
    link [href="../js/report.min.js" rel="modulepreload"]
    link [href="js/addons.min.js" rel="modulepreload"]
    link [href="../js/schedule.min.js" rel="modulepreload"]
    link [href="../js/zoned.min.js" rel="modulepreload"]
    link [href="../js/store.min.js" rel="modulepreload"]
    link [href="../js/taxonomy.min.js" rel="modulepreload"]
    link [href="../js/cards.min.js" rel="modulepreload"]
    link [href="../js/addons.min.js" rel="modulepreload"]
    script [src="js/main.min.js" type="module"]
  body
    header.tasks-header
      img.tasks-logo [alt="Whitestone Home Care" height="239" src="../assets/logo-whitestone.svg?v=3" width="1068"]
    main.tasks-main
      section#tasks-gate.tasks-gate
        h1
          "Your cleaning checklist"
        p.tasks-lead
          "A customer shared a checklist with you. Enter the 6 digit PIN that came with the link to open it."
        form#pin-form.pin-form [hidden novalidate]
          label [for="pin-input"]
            "PIN"
          input#pin-input [aria-describedby="pin-status" autocomplete="one-time-code" inputmode="numeric" maxlength="6" name="pin" pattern="[0-9]{6}" required type="text"]
          button#pin-open [type="submit"]
            "Open the checklist"
        p#pin-status.pin-status [aria-live="polite" role="status"]
      div#tasks-view.tasks-view [hidden]
      noscript
        p.tasks-noscript
          "This page needs JavaScript to open a checklist. The checklist is locked in the link your customer shared, and it is only unlocked here, in your own browser, once you enter the PIN. Please allow JavaScript for this page and reload it."
    footer.tasks-footer
      p
        "Whitestone Home Care is a demo by SceneXP, not a real company. Prices and bookings are examples."
      p
        a [href="/privacy.html"]
          "Privacy""
`;

exports[`www/xo/index.html 1`] = `
"<!doctype html>
html [data-ui-theme="neon" lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
