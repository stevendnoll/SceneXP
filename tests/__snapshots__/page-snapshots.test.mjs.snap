    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="Four scenes from the SceneXP collection in a grid: a glowing orange fractal spiral, a 3D football field with orange and blue players in the middle of a play, a row of red-fruited trees in a green garden, and the blue curve of Earth seen from orbit with a targeting reticle and incoming raiders. Below them the SceneXP.com wordmark and the line, 3D worlds, games, and experiments, right in your browser." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="Contribute | SceneXP" name="twitter:title"]
    meta [content="Build your own browser-native 3D world, game, or experiment with the SceneXP parts library and share it through a GitHub pull request." name="twitter:description"]
    meta [content="https://www.scenexp.com/assets/og-image.jpg?v=4" name="twitter:image"]
    meta [content="Four scenes from the SceneXP collection in a grid: a glowing orange fractal spiral, a 3D football field with orange and blue players in the middle of a play, a row of red-fruited trees in a green garden, and the blue curve of Earth seen from orbit with a targeting reticle and incoming raiders. Below them the SceneXP.com wordmark and the line, 3D worlds, games, and experiments, right in your browser." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "@id": "https://www.scenexp.com/contribute.html#webpage",
        "url": "https://www.scenexp.com/contribute.html",
        "name": "Contribute to SceneXP",
        "description": "How to build your own browser-native 3D world, game, or experiment with the SceneXP parts library and contribute it through a GitHub pull request.",
        "inLanguage": "en-US",
        "isPartOf": {
          "@id": "https://www.scenexp.com/#website"
        }
      }
    title
      "Contribute | SceneXP"
    link [as="style" href="/css/site.min.css?v=9" rel="preload"]
    link [href="/favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="/css/site.min.css?v=9" rel="stylesheet"]
    script [src="/js/theme.min.js?v=1"]
    script [defer src="/js/nav.min.js?v=1"]
  body
    a.skip-link [href="#main"]
      "Skip to main content"
    header.site-header
      div.container.site-header-inner
        a.brand [href="/"]
          svg.brand-mark [aria-hidden="true" focusable="false" viewbox="0 0 32 32"]
            defs
              lineargradient#brand-grad [x1="0" x2="1" y1="0" y2="1"]
                stop [offset="0" stop-color="#6c4cf1"]
                stop [offset="1" stop-color="#06b6d4"]
            rect [fill="url(#brand-grad)" height="32" rx="8" width="32"]
            path [d="M8 22 14 10l4 8 3-5 3 9" fill="none" stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"]
          "SceneXP"
        nav#site-nav.site-nav [aria-label="Main"]
          ul
            li
              a [href="/#experiences"]
                "Experiences"
            li
              a [href="/avatar/"]
                "Avatar"
            li
              a [href="/contact.html"]
                "Contact"
            li
              a [aria-current="page" href="/contribute.html"]
                "Contribute"
        button#nav-toggle.nav-toggle [aria-controls="site-nav" aria-expanded="false" aria-label="Menu" hidden type="button"]
          svg.icon-nav-open [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            path [d="M4 7h16M4 12h16M4 17h16"]
          svg.icon-nav-close [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            path [d="M6 6l12 12M18 6 6 18"]
        button#theme-toggle.theme-toggle [aria-label="Theme" hidden type="button"]
          svg.icon-theme-light [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            circle [cx="12" cy="12" fill="currentColor" r="4.5" stroke="none"]
            path [d=#f2e7be5368]
          svg.icon-theme-dark [aria-hidden="true" focusable="false" viewbox="0 0 24 24"]
            path [d=#bac0ce3668 fill="currentColor"]
          svg.icon-theme-system [aria-hidden="true" focusable="false" viewbox="0 0 24 24"]
            circle [cx="12" cy="12" fill="none" r="8.5" stroke="currentColor" stroke-width="2"]
            path [d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor"]
    main#main
      div.page-hero
        div.container
          h1
            "Build your own little world"
          p
            "SceneXP is open source under the MIT license, and new experiences are warmly welcomed through GitHub pull requests. A world to walk through, a game, a story, a simulation, or an experiment. Whatever you have in mind, this page will get you building."
      div.section
        div.container.prose
          h2
            "How the project is put together"
          p
            "There is no framework and no build step beyond minification. Each experience is a static folder of browser-native HTML, CSS, and JavaScript, powered by Three.js."
          ul
            li
              strong
                "One folder per experience."
              "Every experience lives in its own folder under"
              code
                "www/"
              "with its own"
              code
                "index.html"
              ", config, and orchestrator. Styling comes from the shared versioned stylesheet in"
              code
                "www/shared/css"
              ", and an experience that needs rules of its own can add an optional"
              code
                "css/experience.css"
              "."
            li
              strong
                "A shared parts library."
              code
                "www/shared/js"
              "holds versioned, general-purpose modules (scene, lighting, controls, people, scenery, and more). An experience keeps its own"
              code
                "main.js"
              "orchestrator and assembles imported parts driven by one plain config object."
            li
              strong
                "Three.js as a global."
              "Every experience runs the same release of Three.js (r186). Each"
              code
                "index.html"
              "loads"
              code
                "lib/three/r186/three.min.js"
              "as a module script before its own scene, and that bundle sets the global"
              code
                "THREE"
              "."
            li
              strong
                "esbuild for minification."
              code
                "npm run build"
              "minifies JS and CSS. Every file under"
              code
                "www/"
              "is picked up automatically, so there is no build configuration to edit. It also writes each page's list of module preloads, so the browser fetches a scene's modules all at once."
          h2
            "Pick an interaction model"
          p
            "Every experience so far follows one of four interaction models, and choosing one up front is the biggest design decision you will make. All four are assembled from the same shared parts, so the existing experiences double as working references. A new model is welcome too, if none of these fits what you have in mind."
          ul
            li
              strong
                "Explorable worlds."
              "First-person scenes that visitors walk through, with keyboard and mouse on desktop, dual joysticks on phones, and collision so nobody wanders through a wall. Some also offer a guided autopilot tour."
            li
              strong
                "Composed views."
              "A fixed camera frames one lovingly detailed subject, and the scene moves instead of the visitor. A row of floating buttons offers gentle pan and zoom, with matching swipe and pinch gestures on touch screens, and tapping props opens short lines of story. This is the simplest model to build and a great fit for small subjects. Steve's Home Office stands the camera inside its subject instead, a small room the view can turn all the way around. Fractal Garden extends the model, keeping the fixed viewpoint but letting a tap on the ground plant a tree, so the visitor changes the scene rather than just looking around it."
            li
              strong
                "Hands-off rides."
              "The scene drives itself and the visitor mostly watches, with play and pause, speed, and direction controls for light steering. The Mandelbrot dive is the reference: its auto zoom flies the camera while the visitor picks destinations and adjusts the ride. High Water is the strictest version, with no controls at all beyond starting and replaying."
            li
              strong
                "Piloted flight."
              "The visitor drives a vehicle through open space rather than walking or watching, so the world moves around a camera that never stops. Earth Defense is the reference: keyboard and mouse on desktop, a throttle on the left thumb and a look joystick on the right on phones. Reach for this when the subject is the movement itself rather than the place."
          h2
            "Layer on the delight"
          p
            "Whichever model you choose, a few optional layers have proven to be the difference between a scene visitors look at and a scene they share:"
          ul
            li
              strong
                "Discovery checklists."
              "A short list of things to find in the scene, ticked off with a small celebration as visitors discover them."
            li
              strong
                "Tap-to-talk props."
              "Objects and characters that respond to a click or tap with a short line of story. In a world built for someone, this is where their personality lives."
            li
              strong
                "Guided tours."
              "An autopilot that drives the camera past the highlights until the visitor takes over."
            li
              strong
                "Featuring a business."
              "An experience built for a business can carry its logo on the loading and welcome screens, a floating button to its website, and a warm invitation card that appears as visitors explore. Always with the owner's permission, and always in the spirit of a tribute rather than an advertisement."
          p
            "The shared modules behind each of these live in"
            code
              "www/shared/js"
            ", documented part by part in its"
            code
              "README.md"
            "."
          h2
            "Dress the shared controls"
          p
            "Every experience shares one welcome screen, loading screen, crosshair, joystick pair, floating button set, and panel family. By default that chrome is a quiet near-white that sits under any scene without competing with it. If your world has a mood of its own, name a theme on your"
            code
              "&lt;html&gt;"
            "element and the whole set follows along:"
          pre
            code
              "&lt;html lang="en" data-ui-theme="garden"&gt;"
          p
            "The themes live at the top of"
            code
              "www/shared/css/styles-1.0.0.css"
            ", next to the"
            code
              "--ui-*"
            "tokens they set. Today's set is"
            code
              "garden"
            "(leaf green),"
            code
              "surf"
            "(sea glass aqua),"
            code
              "neon"
            "(stage-light rose), and"
            code
              "ember"
            "(deep-space amber). Leaving the attribute off keeps the default."
          p
            "Adding a theme is six tokens copied from an existing block. Reach for a light tint of your hue rather than the brand color itself, since the welcome overlay is dark and most brand colors disappear against it. The test suite checks the contrast of every theme, so a mistake here shows up as a red test rather than an unreadable welcome screen."
          p
            "One more token to know about. The mobile joysticks follow your accent unless you set"
            code
              "--ui-joystick-rgb"
            ", and they are a pair of filled circles sat low on the screen, one on each side. In pink and flesh tones that arrangement reads as anatomy rather than as controls, so a theme in that part of the spectrum points the joysticks somewhere cooler and leaves the rest of its palette alone."
          h2
            "Run it locally"
          p
            "ES modules need to be served over HTTP, so run any static server from the"
            code
              "www"
            "folder:"
          pre
            code
              "cd www python3 -m http.server 8000 # then open http://localhost:8000"
          h2
            "Add your experience, step by step"
          ol
            li
              strong
                "Fork the repository"
              "at"
              a [href="https://github.com/stevendnoll/SceneXP" rel="noopener noreferrer" target="_blank"]
                "github.com/stevendnoll/SceneXP"
              "and clone your fork."
            li
              strong
                "Create your folder"
              ", for example"
              code
                "www/your-world/"
              ". The existing experiences are the best reference: start from their structure with an"
              code
                "index.html"
              ", a"
              code
                "js/config.js"
              "describing your world, and a"
              code
                "js/main.js"
              "orchestrator that assembles parts from"
              code
                "www/shared/js"
              "."
            li
              strong
                "Follow the metadata pattern."
              "Every experience page carries a strict same-origin Content Security Policy, full Open Graph and Twitter tags, JSON-LD, and a polite no-JavaScript fallback. Copy the pattern from an existing experience."
            li
              strong
                "Make a social card."
              "A 1200 by 630 capture of your world, saved as"
              code
                "assets/og-&lt;world&gt;.jpg"
              "with a"
              code
                ".webp"
              "beside it. Please read the conversion note in"
              a [href="https://github.com/stevendnoll/SceneXP/blob/main/CONTRIBUTING.md" rel="noopener noreferrer" target="_blank"]
                "CONTRIBUTING.md"
              "before you make it, because a screenshot taken on a Mac carries the display's color profile and will come out visibly duller than what you were looking at unless you convert it properly."
            li
              strong
                "Build and test."
              "Run"
              code
                "npm run build"
              "(your new files are minified automatically), then"
              code
                "npm test"
              ". Have your scene call"
              code
                "warmShaders()"
              "from the shared warmup part before its loading screen hides, so its first frame does not freeze. Please include a small unit test for your world, following the"
              code
                "tests"
              "folder's"
              code
                "&lt;experience&gt;-init.test.mjs"
              "pattern. Every pull request should bring tests along for the code it adds or changes."
            li
              strong
                "Add your world to the directory."
              "The home page groups the collection into three categories, so please pick the one your world belongs to: Worlds and games for anything built for its own sake, Small business tributes, or Personal tributes. Then add one card at the top of that group in"
              code
                "www/index.html"
              ", add your world at the top of the same category's structured-data list in that file's head, one URL in"
              code
                "www/sitemap.xml"
              ", and a short description under your category's heading in"
              code
                "www/llms.txt"
              ". The test suite checks that all four agree."
            li
              strong
                "If your world remembers anything, say so in the privacy policy."
              code
                "sessionStorage"
              "needs nothing, since it goes when the tab closes and the policy already covers it. Anything you put in"
              code
                "localStorage"
              "outlives the visit, so it has to be named in"
              code
                "www/privacy.html"
              "along with how a visitor clears it. The test suite keeps the list of files allowed to write persistent storage and will fail the moment yours joins them, which is the reminder rather than the rule."
            li
              strong
                "Open a pull request"
              "telling us the story behind your world. The"
              code
                "main"
              "branch does not accept direct pushes, so every change to the project arrives this way, and we read every pull request with genuine delight."
          h2
            "House rules"
          ul
            li
              strong
                "Give visitors something worth their time."
              "That is the only test an experience has to pass here. Some of ours celebrate a real person, place, or business, and those are always welcome. So is a game, a simulation, or an experiment that honors nobody at all. Kind worlds only, please, whichever kind you bring."
            li
              strong
                "Security first."
              "Same-origin CSP, no third-party scripts, no trackers, no CDNs. Everything ships from this domain."
            li
              strong
                "Accessible and considerate."
              "Keyboard support, reduced-motion respect, and a no-JavaScript fallback are part of the pattern, not extras."
            li
              strong
                "Fast on phones."
              "Many visitors arrive on mobile, so please keep assets lean and performance in mind."
            li
              strong
                "MIT licensed."
              "Your contribution is published under the project's MIT license. The bundled Three.js library keeps its own license."
          h2
            "Ready when you are"
          p
            "The source code is live at"
            a [href="https://github.com/stevendnoll/SceneXP" rel="noopener noreferrer" target="_blank"]
              "github.com/stevendnoll/SceneXP"
            ", and we would love to see what you build. If you have questions along the way, or a story you are excited to tell, please"
            a [href="/contact.html"]
              "reach out"
            "and we will figure it out together."
    footer.site-footer
      div.container.site-footer-inner
        div.footer-brand
          a.brand [href="/"]
            svg.brand-mark [aria-hidden="true" focusable="false" viewbox="0 0 32 32"]
              defs
                lineargradient#brand-grad-footer [x1="0" x2="1" y1="0" y2="1"]
                  stop [offset="0" stop-color="#6c4cf1"]
                  stop [offset="1" stop-color="#06b6d4"]
              rect [fill="url(#brand-grad-footer)" height="32" rx="8" width="32"]
              path [d="M8 22 14 10l4 8 3-5 3 9" fill="none" stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"]
            "SceneXP"
          p
            "3D worlds, games, and experiments, every one running right in your browser. Thank you for visiting."
        nav.footer-nav [aria-label="Explore"]
          h2
            "Explore"
          ul
            li
              a [href="/#experiences"]
                "Experiences"
            li
              a [href="/avatar/"]
                "Your avatar"
            li
              a [href="/contact.html"]
                "Contact"
            li
              a [href="/contribute.html"]
                "Contribute"
        nav.footer-nav [aria-label="Project"]
          h2
            "Project"
          ul
            li
              a [href="https://github.com/stevendnoll/SceneXP" rel="noopener noreferrer" target="_blank" title="View the SceneXP source code on GitHub"]
                "GitHub"
            li
              a [href="/privacy.html"]
                "Privacy"
            li
              a [href="/terms.html"]
                "Terms"
        div.footer-meta
          p
            "Built with Three.js and browser-native HTML, CSS, and JavaScript. Open source under the MIT license."
          p
            "SceneXP © 2026"
            a [href="https://www.continuumcommercellc.com/" rel="noopener noreferrer" target="_blank" title="View the Continuum Commerce LLC website"]
              "Continuum Commerce LLC"
            ".""
`;

exports[`www/dad/index.html 1`] = `
"<!doctype html>
html [data-ui-theme="garden" lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
