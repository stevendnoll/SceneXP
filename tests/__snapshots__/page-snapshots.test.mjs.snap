    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="A bright 3D home office: Jenn works at a light oak desk facing the doorway, the week's plan fills a whiteboard on one wall, a teal clock hangs above her monitor, and a sunny window looks out on a cedar fence and trees." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="Sunnyvale Jenn Consulting" name="twitter:title"]
    meta [content="A living 3D visit to the home office of Sunnyvale Jenn Consulting. Jenn is at her desk, and the door is open." name="twitter:description"]
    meta [content="https://www.scenexp.com/sunnyvalejenn/assets/og-sunnyvalejenn.jpg?v=1" name="twitter:image"]
    meta [content="A bright 3D home office: Jenn works at a light oak desk facing the doorway, the week's plan fills a whiteboard on one wall, a teal clock hangs above her monitor, and a sunny window looks out on a cedar fence and trees." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "@id": "https://www.scenexp.com/sunnyvalejenn/#webpage",
        "url": "https://www.scenexp.com/sunnyvalejenn/",
        "name": "Sunnyvale Jenn Consulting",
        "description": "A passive 3D visit to the sunny home office of Sunnyvale Jenn Consulting, built in tribute to Jenn, a talented entrepreneur and small business operations consultant.",
        "datePublished": "2026-07-18",
        "inLanguage": "en-US",
        "isPartOf": {
          "@type": "WebSite",
          "@id": "https://www.scenexp.com/#website"
        },
        "about": {
          "@type": "Organization",
          "name": "Sunnyvale Jenn Consulting",
          "url": "https://sunnyvalejenn.com/"
        }
      }
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
