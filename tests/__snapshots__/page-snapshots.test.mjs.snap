    meta [content="630" property="og:image:height"]
    meta [content="A 3D meme on a painted city street: three figures walk toward the camera on a sidewalk, each labeled in white meme letters. MEMES, on the left, has a purple bob, a lilac top, a black mini skirt and fishnet tights. ME, in the middle, has a beard and a navy sweater and glances toward MEMES with an open mouth. WORK, on the right, frowns in a yellow beanie and a teal T-shirt." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="Meme Studio" name="twitter:title"]
    meta [content="Put yourself in the meme. Your SceneXP avatar stars in a 3D meme you caption and share." name="twitter:description"]
    meta [content="https://www.scenexp.com/meme/assets/og-meme.jpg?v=2" name="twitter:image"]
    meta [content="A 3D meme on a painted city street: three figures walk toward the camera on a sidewalk, each labeled in white meme letters. MEMES, on the left, has a purple bob, a lilac top, a black mini skirt and fishnet tights. ME, in the middle, has a beard and a navy sweater and glances toward MEMES with an open mouth. WORK, on the right, frowns in a yellow beanie and a teal T-shirt." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "@id": "https://www.scenexp.com/meme/#app",
        "url": "https://www.scenexp.com/meme/",
        "name": "Meme Studio",
        "datePublished": "2026-10-28",
        "image": "https://www.scenexp.com/meme/assets/og-meme.jpg?v=2",
        "description": "A browser-based 3D meme generator for SceneXP. The visitor's own avatar stars in a meme laid out as a grid of small lit 3D boxes, one for each panel. Choose a template, type a caption for each panel, add a friend's avatar or dress anyone else in it by hand, and share the result as a picture or as a link the friend can open and remix with their own avatar. Everything is made on the visitor's own device and nothing is uploaded.",
        "applicationCategory": "EntertainmentApplication",
        "operatingSystem": "Any",
        "browserRequirements": "Requires JavaScript. The 3D stage needs WebGL 2.",
        "inLanguage": "en-US",
        "isPartOf": {
          "@type": "WebSite",
          "@id": "https://www.scenexp.com/#website"
        },
        "isAccessibleForFree": true,
