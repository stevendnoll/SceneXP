    link [as="style" href="../shared/css/styles-1.0.0.min.css?v=7" rel="preload"]
    link [as="style" href="../shared/css/player-1.0.0.min.css" rel="preload"]
    link [as="style" href="css/experience.min.css" rel="preload"]
    link [href="../lib/three/r186/three.min.js" rel="modulepreload"]
    link [href="js/main.min.js" rel="modulepreload"]
    link [href="js/config.min.js" rel="modulepreload"]
    link [href="../shared/js/boot-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/warmup-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/telemetry-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/share-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/player-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/resolution-1.0.0.min.js" rel="modulepreload"]
    link [href="js/funnel.min.js" rel="modulepreload"]
    link [href="js/shells.min.js" rel="modulepreload"]
    link [href="js/world.min.js" rel="modulepreload"]
    link [href="../shared/js/lightning-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/fractaltree-1.0.0.min.js" rel="modulepreload"]
    link [href="js/wind.min.js" rel="modulepreload"]
    link [href="js/farm.min.js" rel="modulepreload"]
    link [href="js/pond.min.js" rel="modulepreload"]
    link [href="js/flora.min.js" rel="modulepreload"]
    link [href="js/cow.min.js" rel="modulepreload"]
    link [href="js/rainbow.min.js" rel="modulepreload"]
    link [href="js/payloads.min.js" rel="modulepreload"]
    link [href="js/tumbleweeds.min.js" rel="modulepreload"]
    link [href="js/witch.min.js" rel="modulepreload"]
    link [href="js/narration.min.js" rel="modulepreload"]
    link [href="js/perf.min.js" rel="modulepreload"]
    link [href="../shared/js/treespecies-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/wildflowers-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/narration-1.0.0.min.js" rel="modulepreload"]
    link [href="favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    link [href="../shared/css/player-1.0.0.min.css" rel="stylesheet"]
    link [href="css/experience.min.css" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    noscript
      div.noscript-fallback
        h1
          "Tornado Alley"
        p
          "This is a passive 3D scene on the open prairie, and it needs JavaScript to draw. It runs for thirty seconds and begins on a calm summer evening, with golden light on the wheat and a storm standing on the horizon. Then the storm organizes. Its base lowers and begins to turn, a funnel reaches down to meet the dust rising off the fields, and a tornado stands far out on the plains before it thins into a rope and lets go."
        p
          "Nobody is in its path. There is lightning, so the screen flashes from time to time. It plays without sound, so you are welcome to watch it anywhere, and you can watch it again as many times as you wish."
        p
          "SceneXP is a home for 3D experiences that run right in your browser."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    canvas#scene [aria-label="A wide view across a golden prairie toward a storm on the horizon" role="img"]
    p#story-status.sr-only [aria-live="polite" role="status"]
    div#player-card
      div.card
        p#player-paused-at.paused-at [hidden]
          "Paused"
        h1
          "Tornado Alley"
        p.lede
          "Thirty seconds on the open prairie, beginning on a calm summer evening."
        p.warning
          "A storm builds on the horizon, and a tornado touches down far out across the fields, then thins and lets go. Nobody is in its path. There is lightning, so the screen flashes from time to time. It plays without sound, so you are welcome to watch it anywhere."
        button#player-begin.player-btn.player-btn-primary [type="button"]
          "Begin"
        div#player-pause-actions.player-actions [hidden]
          button#player-resume.player-btn.player-btn-primary [aria-describedby="player-paused-at" type="button"]
            "Resume"
          button#player-restart.player-btn [type="button"]
            "Restart"
        p#load-status.lede [aria-live="polite" hidden role="status"]
        p.note
          "You can watch it again as many times as you wish."
        a#explore-link.welcome-explore [href="/"]
          "More 3D worlds to explore at SceneXP.com"
    div#player-blackout [aria-hidden="true"]
    div#player-controls [hidden]
      button#player-pause.menu-btn [aria-label="Pause" title="Pause (Esc)" type="button"]
        svg [aria-hidden="true" viewbox="0 0 24 24"]
          path [d="M9 5.5v13M15 5.5v13"]
      div#player-scrubber
        label.sr-only [for="player-scrub"]
          "Position in the story"
        input#player-scrub [aria-valuetext="0 seconds of 30" max="30" min="0" step="0.1" type="range" value="0"]
    div#player-ending [aria-live="polite" hidden role="status"]
      p#ending-line.ending-line
        "The storm has moved on. The cow is fine."
      p.ending-note
        "Thank you for watching. The storm rarely picks up the same thing twice."
      div.player-actions
        button#share.player-btn [type="button"]
          "Share"
        button#player-replay.player-btn [type="button"]
          "Watch it again"
      p#share-status.sr-only [aria-live="polite" role="status"]
      a.welcome-explore.promo-explore [href="/"]
        "More 3D worlds to explore at SceneXP.com"
    script [src="../lib/three/r186/three.min.js" type="module"]
    script [src="js/main.min.js" type="module"]"
`;

