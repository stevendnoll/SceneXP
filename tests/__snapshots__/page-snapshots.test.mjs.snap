  body
    a.skip-link [href="#biz-btn"]
      "Skip to the page controls"
    h1.sr-only
      "Interstate Tire"
    noscript
      div.noscript-fallback
        h1
          "Interstate Tire"
        p
          "This is a walkable 3D tour of the Interstate Tire shop, which needs JavaScript to run. For tires, brakes, and alignments, please call 410-666-7333 or visit the shop's website below. This experience was built by an independent developer, who would be happy to build one for you as well."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="https://www.interstatetireco.com/" rel="noopener noreferrer"]
                "Interstate Tire website"
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        img [alt="" height="180" src="assets/interstate-logo.webp" width="180"]
        div.loader-title
          "INTERSTATE TIRE"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    div#blocker
      div#instructions
        img.welcome-logo [alt="" height="110" src="assets/interstate-logo.webp" width="110"]
        p.title
          "WELCOME"
        p.subtitle
          "A walkable tire shop"
        p.click-prompt
          "Click to explore"
        p.tour-note
          "The shop will show you around on its own. Move anytime to take the wheel."
        div.controls-hint
          span
            "WASD"
          "Move"
          span
            "MOUSE"
          "Look"
    div#hud
      div.crosshair [aria-hidden="true"]
      div#look-label.look-label [aria-live="polite" role="status"]
    div#piece-modal.hidden [aria-labelledby="piece-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#piece-title.piece-title
            "Section"
          p#piece-subtitle.piece-subtitle
          a#piece-enter.piece-enter [href="#"]
            "Enter →"
          button.piece-cancel [data-close]
            "Keep exploring"
    div#help-modal.hidden [aria-labelledby="help-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.help-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#help-title.piece-title
            "Welcome, need a hand?"
          p.piece-subtitle
            "Welcome to Interstate Tire. Here's how to look around."
          ul.help-list
            li.help-desktop
              strong
                "Move:"
              kbd
                "W"
              kbd
                "A"
              kbd
                "S"
              kbd
                "D"
              "or the arrow keys."
            li.help-desktop
              strong
                "Look:"
              "move the mouse. Click the scene once to capture the cursor. Press"
              kbd
                "Esc"
              "to release it."
            li.help-mobile
              strong
                "Move &amp; look:"
              "use the left joystick to walk and the right joystick to look around."
            li
              strong
                "Autopilot:"
              "the shop shows you around on its own from the moment you step in, all the way out to the old freight depot. Move to take back the controls, and press"
              kbd
                "T"
              "or the tour button (top-left) whenever you would like the tour to resume."
            li
              strong
                "Settings:"
              "the gear icon (top-right) adjusts movement and look sensitivity."
            li
              strong
                "Interstate Tire:"
              "the logo button (top-right) opens the shop's own website in a new tab, so you keep your place in the tour."
          a#hello-site.piece-enter [href="https://www.interstatetireco.com/" rel="noopener noreferrer" target="_blank"]
            "Visit the Interstate Tire website →"
          button.piece-cancel [data-close]
            "Got it, thanks!"
          p.piece-footnote
            "The Interstate Tire name and logo are trademarks of their owner and appear here in tribute, with the owner's kind permission."
    div#dialog-modal.hidden [aria-labelledby="dialog-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#dialog-title.piece-title
            "Passerby"
          p#dialog-message.piece-subtitle
          button.piece-enter.dialog-primary [data-close type="button"]
            "Continue exploring"
          button#dialog-return-btn.piece-cancel.dialog-return.hidden [type="button"]
            "Back to the Shop"
    div#complete-modal.hidden [aria-labelledby="complete-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.complete-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          p.complete-kicker [aria-hidden="true"]
            "★ &nbsp;All discoveries found&nbsp; ★"
          h2#complete-title.piece-title
            "You explored every corner"
          p.piece-subtitle
            "Thank you for taking the time to look around. This little world was built to honor Interstate Tire, where tires, brakes, and alignments come with honest advice in between. If your car could use that kind of care, they would love to hear from you. And if you would like a world like this built for your own business, so would the developer."
          a#complete-site.piece-enter [href="https://www.interstatetireco.com/" rel="noopener noreferrer" target="_blank"]
            "Visit Interstate Tire →"
          a#complete-contact.piece-cancel [href="/contact.html"]
            "Get a world like this →"
          button#complete-share.piece-cancel.complete-share [type="button"]
            "Share this"
          p#complete-share-status.sr-only [aria-live="polite" role="status"]
          button.piece-cancel [data-close]
            "Keep exploring"
    div#nudge-modal.hidden [aria-labelledby="nudge-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.complete-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          p.complete-kicker [aria-hidden="true"]
            "★ &nbsp;A few discoveries in&nbsp; ★"
          h2#nudge-title.piece-title
            "Enjoying your visit?"
          p.piece-subtitle
            "Thanks for spending a little time in the shop. This tour was built to honor Interstate Tire, the kind of neighborhood garage that keeps everyone rolling. If your car needs anything at all, they are good people to know. No rush, the bay door is always up."
          a#nudge-site.piece-enter [href="https://www.interstatetireco.com/" rel="noopener noreferrer" target="_blank"]
            "Visit Interstate Tire →"
          a#nudge-contact.piece-cancel [href="/contact.html"]
            "Want a world like this? Get in touch →"
          button.piece-cancel [data-close]
            "Keep exploring"
    div#card-modal.hidden [aria-labelledby="card-name" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.business-card-modal
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#card-name.piece-title
            "Meet the owner"
          p.piece-subtitle
            "Tires, brakes, and alignments, with honest advice in between. If you need anything at all, please call 410-666-7333 or stop by the shop. You are always welcome here."
          a#card-site.piece-enter [href="https://www.interstatetireco.com/" rel="noopener noreferrer" target="_blank"]
            "Visit the shop's website →"
          button.piece-cancel [data-close]
            "Keep exploring"
    div#monitor-view.hidden [aria-label="The studio monitor, up close" aria-modal="true" role="dialog"]
      div.monitor-backdrop [data-close]
      div.monitor-frame
        div.monitor-bezel
          div.monitor-screen
            canvas#monitor-canvas.monitor-canvas
            div.monitor-glass [aria-hidden="true"]
        div.monitor-neck [aria-hidden="true"]
        div.monitor-base [aria-hidden="true"]
      p#monitor-caption.monitor-caption
      button.monitor-close [aria-label="Step back from the monitor" data-close]
        "&times;"
    div#whiteboard-view.hidden [aria-label="The studio whiteboard, up close" aria-modal="true" role="dialog"]
      div.whiteboard-backdrop [data-close]
      div.whiteboard-frame
        div.whiteboard-surface
          canvas#whiteboard-canvas.whiteboard-canvas
        div.whiteboard-tray [aria-hidden="true"]
      p#whiteboard-caption.whiteboard-caption
      p.whiteboard-hint [aria-hidden="true"]
        "Drag to pan across the board"
      button.whiteboard-close [aria-label="Step back from the whiteboard" data-close]
        "&times;"
    div#touch-controls
      div#joystick-zone
        div.joystick-base-fixed
          div.joystick-thumb-fixed
      div#look-joystick-zone
        div.joystick-base-fixed
          div.joystick-thumb-fixed
      div#tap-zone
    a#biz-btn.ui-float.menu-btn.biz-btn [aria-label="Visit the Interstate Tire website (opens in a new tab)" href="https://www.interstatetireco.com/" rel="noopener noreferrer" target="_blank" title="Visit the Interstate Tire website"]
      img [alt="" height="26" src="favicon.png" width="26"]
    button#autopilot-btn.ui-float.menu-btn.autopilot-btn [aria-label="Toggle the autopilot tour (keyboard shortcut T)" aria-pressed="false" title="Autopilot tour (T)"]
      svg [aria-hidden="true" viewbox="0 0 24 24"]
        path [d=#10d062c4ff stroke-dasharray="2.6 2.2"]
        path [d="M21.5 3.6l.6 7.5-6.1-2.4z" fill="currentColor" stroke="none"]
        circle [cx="5" cy="19" fill="currentColor" r="2.2" stroke="none"]
    button#settings-btn.ui-float.settings-btn [aria-controls="settings-panel" aria-expanded="false" aria-label="Movement settings" title="Movement settings"]
      svg.settings-icon [aria-hidden="true" viewbox="0 0 24 24"]
        path [d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"]
        path [d=#88c0d99db8]
    div#settings-panel.settings-panel.hidden
      div.settings-header
        span
          "Settings"
        button#settings-close.settings-close [aria-label="Close"]
          "&times;"
      div.settings-body
        label.settings-label
          "Walk Speed"
          input#walk-speed-slider [max="14" min="2" step="0.5" type="range" value="6.5"]
          span.settings-value#walk-speed-value
            "6.5"
        label.settings-label
          "Look Sensitivity"
          input#look-speed-slider [max="4" min="0.5" step="0.1" type="range" value="1.0"]
          span.settings-value#look-speed-value
            "1.0"
        label.settings-label
          "Ambient Brightness"
          input#settings-light-slider [max="1.5" min="0" step="0.05" type="range" value="1"]
          span.settings-value#settings-light-value
            "100%"
    div#light-panel.settings-panel.hidden [aria-labelledby="light-panel-title" role="dialog"]
      div.settings-header
        span#light-panel-title
          "Shop Lighting"
        button#light-close.settings-close [aria-label="Close" data-close]
          "&times;"
      div.settings-body
        p.light-hint
          "Set the mood. The shop looks good at any brightness."
        label.settings-label
          "Ambient Brightness"
          input#light-slider [max="1.5" min="0" step="0.05" type="range" value="1"]
          span.settings-value#light-value
            "100%"
    canvas#game-canvas [aria-label="A walkable 3D tour of the Interstate Tire shop" role="img"]
    script [src="../lib/three/r186/three.min.js" type="module"]
    script [src="js/main.min.js" type="module"]"
`;

