                "Experiences"
            li
              a [href="/avatar/"]
                "Your avatar"
            li
              a [href="/contact.html"]
                "Contact"
            li
              a [href="/contribute.html"]
                "Contribute"
        nav.footer-nav [aria-label="Project"]
          h2
