  body.av-body
    h1.sr-only
      "Your Avatar"
    noscript
      div.noscript-fallback
        h1
          "Your Avatar"
        p
          "This is where you make a figure that looks like you, and it needs JavaScript to run. You choose a face shape, eyes, eyebrows, a nose, an expression, hair in any color, a build, clothes, shoes and a hat on a figure that turns slowly in a bright white studio, and press Save. SceneXP scenes that show you as a person then dress you that way."
        p
          "Your avatar is kept only in your own browser. Nothing about it is sent to us."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/"]
                "More 3D worlds to explore at SceneXP.com"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#avatar-app.av-app [hidden]
      div.av-stage
        canvas#av-canvas.av-canvas [aria-label="Your avatar, standing on a round plinth in a white studio" role="img"]
        p#av-stage-status.av-stage-status [aria-live="polite" role="status"]
        div#av-turn.av-turn
          button#av-zoom-out.av-turn-btn [aria-label="Zoom out" title="Zoom out" type="button"]
            svg [aria-hidden="true" viewbox="0 0 24 24"]
              path [d="M6.5 12h11"]
          button#av-turn-left.av-turn-btn [aria-label="Turn left" title="Turn left" type="button"]
            svg [aria-hidden="true" viewbox="0 0 24 24"]
              path [d="M9 7.5 5 11.5l4 4"]
              path [d="M5.5 11.5h8a5 5 0 0 1 5 5v1"]
          button#av-turn-right.av-turn-btn [aria-label="Turn right" title="Turn right" type="button"]
            svg [aria-hidden="true" viewbox="0 0 24 24"]
              path [d="m15 7.5 4 4-4 4"]
              path [d="M18.5 11.5h-8a5 5 0 0 0-5 5v1"]
          button#av-zoom-in.av-turn-btn [aria-label="Zoom in" title="Zoom in" type="button"]
            svg [aria-hidden="true" viewbox="0 0 24 24"]
              path [d="M6.5 12h11M12 6.5v11"]
      section.av-sheet [aria-labelledby="av-heading"]
        div.av-top
          a#av-return.av-return [href="/"]
            svg.av-return-icon [aria-hidden="true" focusable="false" viewbox="0 0 24 24"]
              path [d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4"]
            span#av-return-text
              "Back to SceneXP"
        p.av-eyebrow
          "Your Avatar"
        h2#av-heading.av-heading
          "Step into SceneXP as you"
        p.av-lede
          "Choose a look, then press Save. Your avatar is kept in this browser, and scenes that show you as a person will dress you this way."
        div#av-incoming.av-incoming [aria-labelledby="av-incoming-text" hidden role="region"]
          p#av-incoming-text.av-incoming-text
            "Keep this avatar?"
          p#av-incoming-replaces.av-note [hidden]
            "Keeping it replaces the one saved on this browser."
          div.av-row
            button#av-keep.av-primary [type="button"]
              "Keep this avatar"
            button#av-decline.av-secondary [type="button"]
              "Not now"
        div#av-editor.av-editor
          div.av-random-row
            button#av-random.av-secondary.av-random [title="A random look, from every choice there is" type="button"]
              "Surprise me"
            button#av-export-open.av-secondary.av-random [title="A picture or a short video of your avatar, for anywhere else" type="button"]
              "Export my avatar"
          div#av-tabs.av-tabs [aria-label="Choose what to change" role="tablist"]
          div#av-panels.av-panels
        div#av-actions.av-actions
          button#av-save.av-primary.av-save [type="button"]
            "Save my avatar"
          p#av-unsaved.av-note.av-unsaved
          p#av-status.av-status [aria-live="polite" role="status"]
          h3.av-subhead
            "Take it to another device"
          div.av-row.av-transfer
            button#av-link.av-secondary [type="button"]
              "Share a link"
            button#av-file-save.av-secondary [type="button"]
              "Save a file"
            button#av-file-open.av-secondary [type="button"]
              "Open a file"
          input#av-file-input [accept=".json,application/json" aria-label="Open an avatar file" hidden tabindex="-1" type="file"]
          p.av-note.av-privacy
            "Your avatar stays on this device, and nothing about it is sent to us."
            a [href="/privacy.html"]
              "Privacy"
          button#av-forget.av-forget [hidden type="button"]
            "Forget my avatar"
          div#av-forget-confirm.av-confirm [hidden]
            p.av-confirm-text
              "Forget your avatar on this browser? Scenes will show the usual figure again."
            div.av-row
              button#av-forget-yes.av-secondary.av-danger [type="button"]
                "Forget it"
              button#av-forget-no.av-secondary [type="button"]
                "Keep it"
          div#av-lab.av-lab [hidden]
            p.av-note
              "Lab"
            button#av-lab-portrait.av-secondary [type="button"]
              "Save the default portrait"
    dialog#av-export.av-export [aria-labelledby="av-export-title"]
      div.av-export-card
        div.av-export-head
