"<!doctype html>
html [data-ui-theme="surf" lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="Sixty seconds at the water's edge in 3D, beginning on an ordinary bright afternoon. The sky closes over, the surf keeps rising, and the sea does not stay where it belongs. Plays without sound in any modern browser." name="description"]
    meta [content="#8fb6cc" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/highwater/" rel="canonical"]
    meta [content="High Water" property="og:title"]
    meta [content="Sixty seconds at the water's edge, beginning on an ordinary bright afternoon. The weather turns while you stand there, and the sea does not stay where it belongs." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="SceneXP" property="og:site_name"]
    meta [content="https://www.scenexp.com/highwater/" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/highwater/assets/og-highwater.jpg?v=1" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="A view out to sea under a low gray storm sky. A single branching fork of lightning comes down left of center, from the top of the frame to the horizon. The sea below is gray and heaving in long smooth swells, and a small orange and white navigation buoy stands just right of center near the horizon, dwarfed by the water around it." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="High Water" name="twitter:title"]
    meta [content="Sixty seconds at the water's edge on an ordinary bright afternoon. The weather turns while you stand there." name="twitter:description"]
    meta [content="https://www.scenexp.com/highwater/assets/og-highwater.jpg?v=1" name="twitter:image"]
    meta [content="A view out to sea under a low gray storm sky. A single branching fork of lightning comes down left of center, from the top of the frame to the horizon. The sea below is gray and heaving in long smooth swells, and a small orange and white navigation buoy stands just right of center near the horizon, dwarfed by the water around it." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "@id": "https://www.scenexp.com/highwater/#webpage",
        "url": "https://www.scenexp.com/highwater/",
        "name": "High Water",
        "description": "A passive 3D scene at the water's edge. Sixty seconds that begin on an ordinary bright afternoon and end with the sea closing over the viewer.",
        "datePublished": "2026-08-21",
        "inLanguage": "en-US",
        "isPartOf": {
          "@type": "WebSite",
          "@id": "https://www.scenexp.com/#website"
        }
      }
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "SceneXP",
            "item": "https://www.scenexp.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "High Water",
            "item": "https://www.scenexp.com/highwater/"
          }
        ]
      }
    title
      "High Water | SceneXP"
    link [as="style" href="../shared/css/styles-1.0.0.min.css?v=7" rel="preload"]
    link [as="style" href="../shared/css/player-1.0.0.min.css" rel="preload"]
    link [as="style" href="css/experience.min.css?v=5" rel="preload"]
    link [href="../lib/three/r186/three.min.js" rel="modulepreload"]
    link [href="js/main.min.js" rel="modulepreload"]
    link [href="js/config.min.js" rel="modulepreload"]
    link [href="../shared/js/boot-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/warmup-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/telemetry-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/share-1.0.0.min.js" rel="modulepreload"]
    link [href="js/water.min.js" rel="modulepreload"]
    link [href="js/sky.min.js" rel="modulepreload"]
    link [href="js/sand.min.js" rel="modulepreload"]
    link [href="js/storm.min.js" rel="modulepreload"]
    link [href="js/buoy.min.js" rel="modulepreload"]
    link [href="js/lightning.min.js" rel="modulepreload"]
    link [href="../shared/js/player-1.0.0.min.js" rel="modulepreload"]
    link [href="js/player.min.js" rel="modulepreload"]
    link [href="../shared/js/narration-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/resolution-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/lightning-1.0.0.min.js" rel="modulepreload"]
    link [href="favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    link [href="../shared/css/player-1.0.0.min.css" rel="stylesheet"]
    link [href="css/experience.min.css?v=5" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    noscript
      div.noscript-fallback
        h1
          "High Water"
        p
          "This is a passive 3D scene at the water's edge, and it needs JavaScript to draw. It runs for sixty seconds and begins on an ordinary bright afternoon, with the surf coming in and the horizon exactly where you would expect it. Then the weather turns. The sky closes over into a storm base, lightning starts to work along it, the swell builds until the crests stand above the horizon line, and the sea eventually stops behaving."
        p
          "It does not stay an ordinary afternoon, and you may find it unsettling. The sea comes over you at the end. It plays without sound, so you are welcome to watch it anywhere, and you can watch it again as many times as you wish."
        p
          "SceneXP is a home for 3D experiences that run right in your browser. This one is a study of water, built to find out whether a browser could be made to feel like standing somewhere you should not be standing."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    canvas#scene [aria-label="A view out to sea from the water's edge, with waves breaking toward you" role="img"]
    p#story-status.sr-only [aria-live="polite" role="status"]
    div#player-card
      div.card
        p#player-paused-at.paused-at [hidden]
          "Paused"
        h1
          "High Water"
        p.lede
          "Sixty seconds at the water's edge, beginning on an ordinary bright afternoon."
        p.warning
          "It does not stay one, and you may find it unsettling. The weather turns, the surf keeps rising, and the sea comes over you at the end. There is lightning, so the screen flashes from time to time. It plays without sound, so you are welcome to watch it anywhere."
        button#player-begin.player-btn.player-btn-primary [type="button"]
          "Begin"
        div#player-pause-actions.player-actions [hidden]
          button#player-resume.player-btn.player-btn-primary [aria-describedby="player-paused-at" type="button"]
            "Resume"
          button#player-restart.player-btn [type="button"]
            "Restart"
        p#load-status.lede [aria-live="polite" hidden role="status"]
        p.note
          "You can watch it again as many times as you wish."
        a#explore-link.welcome-explore [href="/"]
          "More 3D worlds to explore at SceneXP.com"
    div#wash [aria-hidden="true"]
    div#player-blackout [aria-hidden="true"]
    div#player-controls [hidden]
      button#player-pause.menu-btn [aria-label="Pause" title="Pause (Esc)" type="button"]
        svg [aria-hidden="true" viewbox="0 0 24 24"]
          path [d="M9 5.5v13M15 5.5v13"]
      div#player-scrubber
        label.sr-only [for="player-scrub"]
          "Position in the story"
        input#player-scrub [aria-valuetext="0 seconds of 60" max="60" min="0" step="0.1" type="range" value="0"]
    div#player-ending [aria-live="polite" hidden role="status"]
      p.ending-line
        "The sea has taken the beach."
      p.ending-note
        "Thank you for watching. It ends the same way every time."
      div.player-actions
        button#share.player-btn [type="button"]
          "Share"
        button#player-replay.player-btn [type="button"]
          "Watch it again"
      p#share-status.sr-only [aria-live="polite" role="status"]
      a.welcome-explore.promo-explore [href="/"]
        "More 3D worlds to explore at SceneXP.com"
    script [src="../lib/three/r186/three.min.js" type="module"]
    script [src="js/main.min.js" type="module"]"
`;

