        "name": "John Walker, The Auto Man",
        "description": "A 3D showroom built for John Walker, The Auto Man, who does the negotiating for car buyers so they never have to do it themselves.",
        "datePublished": "2026-09-01",
        "inLanguage": "en-US",
        "isPartOf": {
          "@type": "WebSite",
          "@id": "https://www.scenexp.com/#website"
        },
        "about": {
          "@type": "ProfessionalService",
          "@id": "https://www.scenexp.com/automan/#business",
          "name": "John Walker, The Auto Man",
          "url": "https://www.scenexp.com/automan/",
          "description": "John Walker negotiates car purchases and sales on the buyer's behalf. He desks the whole deal for you: the trade valuation, the price, the financing and the rate, and the extended warranty, tire and wheel protection and GAP insurance they add at the end. You do not negotiate with the dealership at all, he does it for you. Free consultation by phone or Zoom, and if he cannot get you the deal you want you owe him nothing.",
          "areaServed": {
            "@type": "Place",
            "name": "Baltimore, Maryland, and remote via Zoom"
          },
          "founder": {
