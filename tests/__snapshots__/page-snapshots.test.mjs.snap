    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    h1.sr-only
      "Derby Day"
    noscript
      div.noscript-fallback
        h1
          "Derby Day"
        p
          "This is a wooden derby car race, and it needs JavaScript to run. You build your car on a workbench: you draw its shape on the block and cut it out, sand it, paint it, name it, and choose where its weights go and how its axles are tuned. Then it lines up at the top of a four-lane aluminum track against three of the neighbors' cars, and races four heats so every car runs in every lane. The times are averaged, and the fastest average wins."
        h2
          "What makes a derby car fast"
        p
          "The axles matter most. A nail straight from the kit has a burr under its head and crimp marks along its shaft. Filing them off, polishing through finer and finer sandpaper, and adding dry graphite can save more than a tenth of a second."
        p
          "Weight comes next. Air drag and the spinning wheels do not grow with a car's mass, so a car at the full five ounces loses less of its speed to them than a lighter one."
        p
          "Where the weight sits matters too. A car with its weight about three quarters of an inch in front of the rear axle keeps its center of mass higher up the slope for longer, so it has further to fall. Too far back and the front goes light, and the car wobbles."
        p
          "The shape matters least of the three a builder works hardest on, though a slim wedge still beats a plain block."
        h2
          "Challenge a friend"
        p
          "Send your car to a friend in a link. They race their own car against it, head to head, four heats with each car in every lane, and the physics runs the same on every device, so your car posts the same times on theirs. Nothing is uploaded: the car travels in the link itself."
        p
          "SceneXP is a home for 3D experiences that run right in your browser."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        div.loader-title
          "DERBY DAY"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    aside#bench.bench.hidden [aria-labelledby="bench-title"]
      div.bench-scroll
        header.bench-head
          h2#bench-title.bench-title [tabindex="-1"]
            "Your workbench"
          p#bench-host.bench-host [aria-live="polite" role="status"]
          div#bench-host-actions.bench-host-actions
        div#bench-body.bench-body
      div.bench-foot
        button#bench-turn.bench-btn.bench-turn [aria-label="Turn the car" title="Turn the car" type="button"]
          svg [aria-hidden="true" focusable="false" viewbox="0 0 24 24"]
            path [d="M20 12a8 8 0 1 1-2.34-5.66"]
            path [d="M20 4v4.5h-4.5"]
        p#bench-summary.bench-summary
        button#bench-race.go-btn [type="button"]
          "Race it"
      p#bench-status.sr-only [aria-live="polite" role="status"]
    div#blocker [tabindex="-1"]
      div#instructions.checkin
        p.title
          "DERBY DAY"
        p.subtitle
          "Race a wooden derby car down a four-lane track"
        p#checkin-invite.checkin-invite [hidden]
        fieldset.choice-group
          legend
            "Your race"
          div#event-options.choices
        fieldset.choice-group
          legend#car-legend
            "Your car"
          div#car-options.choices
        p#checkin-note.checkin-note [hidden role="alert"]
        button#go-btn.go-btn [type="button"]
          "Go!"
        p.checkin-back-row
          button#checkin-back.results-another [type="button"]
            "Back to the workbench"
        p.checkin-more
          a#explore-link.checkin-explore [href="/"]
            "More 3D worlds to explore at SceneXP.com"
    canvas#game-canvas [aria-label="A four-lane aluminum derby track running down the length of a community hall, with wooden derby cars at the starting gate" role="img" tabindex="-1"]
    button#help-btn.ui-float.menu-btn.help-btn [aria-label="Back to check-in" title="Back to check-in (Esc)" type="button"]
      svg [aria-hidden="true" viewbox="0 0 24 24"]
        path [d="M14.5 6.5L9 12l5.5 5.5" stroke-linejoin="round"]
    div#timer.timer [aria-hidden="true"]
    p#caption.caption [aria-hidden="true"]
    p#race-status.sr-only [aria-live="polite" role="status"]
    p#countdown.countdown [aria-hidden="true"]
    div#photo-finish.photo-finish [aria-hidden="true"]
      p.photo-label
        "PHOTO FINISH"
      p#photo-gap.photo-gap
    span#you-tag.you-tag [aria-hidden="true"]
      "You"
    button#skip-btn.ui-float.skip-btn [type="button"]
      "Skip to results"
    div#weighin-note.weighin-note.hidden [aria-labelledby="weighin-text" aria-modal="false" role="dialog"]
      p#weighin-text.weighin-text
      button#weighin-back.go-btn [type="button"]
        "Back to the workbench"
    button#sound-btn.ui-float.menu-btn.sound-btn [aria-label="Sound" aria-pressed="false" title="Sound off (M)" type="button"]
      svg [aria-hidden="true" viewbox="0 0 24 24"]
        path [d="M4 9.5h3.2L12 5.5v13l-4.8-4H4z" stroke-linejoin="round"]
        path.sound-waves [d=#839f041928]
        path.sound-off [d="M16 9.5l5 5M21 9.5l-5 5"]
    div#results-modal.results-modal.hidden [aria-labelledby="results-title" aria-modal="true" role="dialog"]
      div.results-card
        p#results-event.results-event
        h2#results-title.results-title [tabindex="-1"]
          "Results"
        table#results-table.results-table
        h3.results-sub
          "Each lane’s average"
        ul#results-lanes.results-lanes
        h3#results-why-heading.results-sub
          "Why your car ran as it did"
        ul#results-why.results-why
        h3#results-tuneups-heading.results-sub
          "What each tune-up was worth"
        ul#results-tuneups.results-why
        p#results-trophy.results-trophy [hidden]
        div.results-actions
          button#results-challenge.go-btn [type="button"]
            "Challenge a friend"
          button#results-share.results-another [type="button"]
            "Share my race"
          button#results-harder.results-another [hidden type="button"]
            "Try the next division"
          button#results-again.results-another [type="button"]
            "Race again"
          button#results-tune.results-another [type="button"]
            "Tune my car"
          button#results-another.results-another [type="button"]
            "Choose another race"
        p#results-status.sr-only [aria-live="polite" role="status"]
        p.results-mark [aria-hidden="true"]
          "Derby Day &middot; SceneXP.com"
    div#clip-modal.clip-modal.hidden [aria-describedby="clip-progress" aria-labelledby="clip-title" aria-modal="true" role="dialog"]
      div.clip-card
        h2#clip-title.clip-title [tabindex="-1"]
          "Your race, ready to share"
        div#clip-stage.clip-stage
        p#clip-progress.clip-progress
          "Making your clip…"
        label.clip-sound [for="clip-sound"]
          input#clip-sound [checked type="checkbox"]
          "Include sound"
        div.clip-actions
          button#clip-share.go-btn [hidden type="button"]
            "Share video"
          button#clip-image.results-another [type="button"]
            "Save a picture"
          button#clip-again.results-another [hidden type="button"]
            "Make it again"
          button#clip-close.results-another [type="button"]
            "Done"
        p.clip-note
          "Made on this device. Nothing is uploaded."
        p#clip-status.sr-only [aria-live="polite" role="status"]
    div#challenge-modal.clip-modal.challenge-modal.hidden [aria-describedby="challenge-text" aria-labelledby="challenge-title" aria-modal="true" role="dialog"]
      div.clip-card.challenge-card
        h2#challenge-title.clip-title [tabindex="-1"]
          "Challenge a friend"
        p#challenge-text.challenge-text
        label.challenge-label [for="challenge-from"]
          "Your first name (optional)"
        input#challenge-from.challenge-from [autocapitalize="words" autocomplete="given-name" maxlength="20" spellcheck="false" type="text"]
        input#challenge-link.challenge-link [aria-label="The challenge link" hidden readonly type="text"]
        div.clip-actions
          button#challenge-send.go-btn [type="button"]
            "Send the challenge"
          button#challenge-copy.results-another [type="button"]
            "Copy the link"
          button#challenge-close.results-another [type="button"]
            "Done"
        p#challenge-status.challenge-status [aria-live="polite" role="status"]
        p.clip-note
          "The link holds your car and the name you type, nothing else. Nothing is uploaded."
    script [src="../lib/three/r186/three.min.js" type="module"]
    script [src="js/main.min.js" type="module"]"
`;

exports[`www/earthdefense/index.html 1`] = `
"<!doctype html>
html [data-ui-theme="ember" lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="Fly a single ship in orbit above a massive Earth and defend the installations on Earth and the Moon from an incoming Martian fleet. A small browser game built for the joy of flying through space." name="description"]
    meta [content="#1b1410" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/earthdefense/" rel="canonical"]
    meta [content="Earth Defense" property="og:title"]
    meta [content="Fly in orbit above a massive Earth and hold the line against an incoming Martian fleet. No fire button needed, no tutorial, one sitting." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="SceneXP" property="og:site_name"]
    meta [content="https://www.scenexp.com/earthdefense/" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/earthdefense/assets/og-earthdefense.jpg?v=3" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="A ship's-eye view in low Earth orbit: Earth's blue and white limb curves across the bottom of the frame, Mars sits ahead as a small ruddy disc with the targeting reticle just below it, orange diamonds mark the incoming Martian raiders across a deep starfield, the nearest of them labelled 23k km, and the Moon hangs at the upper right labelled 67k km." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="Earth Defense" name="twitter:title"]
    meta [content="Fly in orbit above a massive Earth and hold the line against an incoming Martian fleet." name="twitter:description"]
    meta [content="https://www.scenexp.com/earthdefense/assets/og-earthdefense.jpg?v=3" name="twitter:image"]
    meta [content="A ship's-eye view in low Earth orbit: Earth's blue and white limb curves across the bottom of the frame, Mars sits ahead as a small ruddy disc with the targeting reticle just below it, orange diamonds mark the incoming Martian raiders across a deep starfield, the nearest of them labelled 23k km, and the Moon hangs at the upper right labelled 67k km." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "VideoGame",
        "@id": "https://www.scenexp.com/earthdefense/#game",
        "url": "https://www.scenexp.com/earthdefense/",
        "name": "Earth Defense",
        "description": "A small browser-based 3D space game. Pilot one ship in orbit above Earth and defend the installations on Earth and the Moon from an incoming Martian fleet. Built for the joy of flying through space.",
        "genre": [
          "Action",
          "Space"
        ],
        "gamePlatform": "Web browser",
        "applicationCategory": "Game",
        "operatingSystem": "Any",
        "datePublished": "2026-08-05",
        "inLanguage": "en-US",
        "isPartOf": {
          "@type": "WebSite",
          "@id": "https://www.scenexp.com/#website"
        },
        "isAccessibleForFree": true,
        "playMode": "SinglePlayer",
        "image": "https://www.scenexp.com/earthdefense/assets/og-earthdefense.jpg?v=3",
        "author": {
          "@type": "Person",
          "name": "Steve Noll"
        },
        "publisher": {
          "@type": "Organization",
          "name": "Continuum Commerce LLC"
        }
      }
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "SceneXP",
            "item": "https://www.scenexp.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Earth Defense",
            "item": "https://www.scenexp.com/earthdefense/"
          }
        ]
      }
    title
      "Earth Defense | SceneXP"
    link [as="style" href="../shared/css/styles-1.0.0.min.css?v=7" rel="preload"]
    link [as="style" href="css/experience.min.css?v=4" rel="preload"]
    link [href="../lib/three/r186/three.min.js" rel="modulepreload"]
    link [href="js/main.min.js" rel="modulepreload"]
    link [href="js/config.min.js" rel="modulepreload"]
    link [href="../shared/js/boot-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/warmup-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/space-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/flight-1.0.0.min.js" rel="modulepreload"]
    link [href="js/world.min.js" rel="modulepreload"]
    link [href="../shared/js/bodies-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/targeting-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/weapons-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/gamestate-1.0.0.min.js" rel="modulepreload"]
    link [href="js/cockpit.min.js" rel="modulepreload"]
    link [href="js/fleet.min.js" rel="modulepreload"]
    link [href="js/intro.min.js" rel="modulepreload"]
    link [href="js/martian.min.js" rel="modulepreload"]
    link [href="js/hud.min.js" rel="modulepreload"]
    link [href="js/replay.min.js" rel="modulepreload"]
    link [href="js/finale.min.js" rel="modulepreload"]
    link [href="js/audio.min.js" rel="modulepreload"]
    link [href="../shared/js/telemetry-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/share-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/promo-1.0.0.min.js" rel="modulepreload"]
    link [href="js/structures.min.js" rel="modulepreload"]
    link [href="favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    link [href="css/experience.min.css?v=4" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    a.skip-link [href="#pause-btn"]
      "Skip to the pause button"
    h1.sr-only
      "Earth Defense"
    noscript
      div.noscript-fallback
        h1
          "Earth Defense"
        p
          "This is a small 3D space game, which needs JavaScript to run. You fly a single ship in orbit above a massive Earth. The Moon is on its slow lap overhead, Mars sits far ahead as a small red disc, and a Martian fleet is already on its way in. Your job is to defend the installations on Earth and the Moon, and you never need a fire button: line a raider up in the middle of your view and your guns take care of the rest. If you would rather press something, the left mouse button and the space bar both shoot."
        p
          "It opens on the Martian commander flying the lead ship of the fleet. &ldquo;Earth will be ours.&rdquo;"
        p
          "SceneXP is a home for 3D experiences that run right in your browser. This one is simply a game, built for the joy of flying through space. There was never a deeper reason than that."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        div.loader-title
          "EARTH DEFENSE"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    div#blocker
      div#instructions
        p.title
          "EARTH DEFENSE"
        p.subtitle
          "Stop the Martian fleet from destroying the installations on Earth and the Moon"
        blockquote.briefing-quote
          p
            "&ldquo;Earth will be ours.&rdquo;"
          cite
            "Intercepted Martian transmission"
        button#take-helm-btn.click-prompt [type="button"]
          "Take the helm"
        button#briefing-menu-btn.briefing-menu-btn [type="button"]
          "Controls and settings"
        div.welcome-hints
          div.controls-hint
            span
              "No fire button needed"
            "Line a raider up in the middle of your view"
          div.controls-hint
            span
              "Seven and twelve"
            "Seven installations to hold, and clearing all twelve raiders is how you win"
        a#explore-link.welcome-explore [href="/"]
          "More 3D worlds to explore at SceneXP.com"
    div#hud
      div#objective-panel.objective-panel [aria-hidden="true"]
        div.objective-row
          span.objective-mark.mark-friendly
          span.objective-count#structures-count
            "7"
          span.objective-label
            "installations"
        div.objective-row
          span.objective-mark.mark-hostile
          span.objective-count#ships-count
            "12"
          span.objective-label
            "raiders"
        div.objective-row.lives-row
          span.objective-label
            "lives"
          span.lives-pips#lives-pips
        div.objective-row.hull-row.hidden#hull-row
          span.objective-label
            "hull"
          span.hull-pips#hull-pips
      div#elapsed-time.elapsed-time [aria-hidden="true"]
        "0:00"
      div#alert-banner.alert-banner.hidden [aria-hidden="true"]
      div#hostile-pips.hostile-pips [aria-hidden="true"]
      div#replay-inset.replay-inset.hidden [aria-hidden="true"]
        span.replay-caption#replay-caption
      div#hostile-range.hostile-range.hidden [aria-hidden="true"]
      div#nav-markers.nav-markers [aria-hidden="true"]
      div#chevron-alert.edge-chevron.chevron-alert.hidden [aria-hidden="true"]
        svg [focusable="false" viewbox="0 0 24 24"]
          path [d="M8 4l8 8-8 8"]
      div#chevron-hostile.edge-chevron.chevron-hostile.hidden [aria-hidden="true"]
        svg [focusable="false" viewbox="0 0 24 24"]
          path [d="M9 5l7 7-7 7"]
      div#reticle.reticle [aria-hidden="true"]
        svg [focusable="false" viewbox="0 0 64 64"]
          circle.reticle-ring [cx="32" cy="32" r="13"]
          path.reticle-ticks [d="M32 8v7M32 49v7M8 32h7M49 32h7"]
          path.reticle-diamond [d="M32 17 47 32 32 47 17 32Z"]
          path.reticle-corners [d=#1afe71b670]
          circle.reticle-dot [cx="32" cy="32" r="1.6"]
      div#lock-bracket.lock-bracket.hidden [aria-hidden="true"]
        svg [focusable="false" viewbox="0 0 48 48"]
          path [d=#e732558685]
      div#speedometer.speedometer [aria-hidden="true"]
        div.speedo-track
          div.speedo-arm.speedo-arm-rev.speedo-ghost#speedo-ghost-rev
          div.speedo-arm.speedo-arm-fwd.speedo-ghost#speedo-ghost-fwd
          div.speedo-arm.speedo-arm-rev#speedo-rev
          div.speedo-arm.speedo-arm-fwd#speedo-fwd
          div.speedo-demand#speedo-demand
          div.speedo-zero#speedo-zero
        div#throttle-readout.throttle-readout
          "0 km/s"
      div#perimeter-notice.perimeter-notice.hidden [aria-live="polite" role="status"]
      p#flight-status.sr-only [aria-live="polite" role="status"]
      p#combat-status.sr-only [aria-live="polite" role="status"]
      p#objective-status.sr-only [aria-live="polite" role="status"]
    div#touch-controls
      div#throttle-zone
        div#throttle-track.throttle-track
          div.throttle-fill#throttle-fill [aria-hidden="true"]
          div.throttle-detent [aria-hidden="true"]
          div.throttle-thumb#throttle-thumb [aria-hidden="true"]
          span.throttle-label.throttle-label-up [aria-hidden="true"]
            "▲"
          span.throttle-label.throttle-label-down [aria-hidden="true"]
            "▼"
      div#look-joystick-zone
        div.joystick-base-fixed
          div.joystick-thumb-fixed#look-thumb
    button#pause-btn.ui-float.menu-btn.pause-btn [aria-label="Pause" title="Pause"]
      svg [aria-hidden="true" viewbox="0 0 24 24"]
        path [d="M9 5.5v13M15 5.5v13"]
    button#skip-intro-btn.skip-intro-btn [aria-label="Skip the opening" type="button"]
      "Skip"
      span.skip-intro-hint
        "&nbsp;the opening"
    div#intro-caption.intro-caption [aria-hidden="true"]
      p.intro-caption-label
        "Intercepted transmission"
      p.intro-caption-line#intro-caption-line
    p#intro-announce.visually-hidden [aria-live="polite" role="status"]
    div#pause-modal.hidden [aria-labelledby="pause-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#pause-title.piece-title
            "Holding station"
          p#pause-subtitle.piece-subtitle
            "Take your time. Nothing moves while this is open."
          ul.help-list
            li.help-desktop
              strong
                "Throttle:"
              kbd
                "W"
              "and"
              kbd
                "S"
              ", or the up and down arrows."
              kbd
                "X"
              "to stop."
            li.help-desktop
              strong
                "Look:"
              "move the mouse, or steer with"
              kbd
                "A"
              kbd
                "D"
              "to turn and"
              kbd
                "Q"
              kbd
                "E"
              "to climb and dive."
            li.help-mobile
              strong
                "Throttle:"
              "the slider on the left. Hold it up to gather speed and pull it down to shed speed. Let go and it springs back to the middle, and the ship keeps the speed it has. Double tap it to come to a stop."
            li.help-mobile
              strong
                "Look:"
              "drag the joystick on the right."
            li
              strong
                "Guns:"
              "you never need a fire button. Line a target up in the middle of your view and the guns take care of the rest. The reticle closes into a diamond the moment they have something."
            li.help-desktop
              strong
                "Firing anyway:"
              "the left mouse button or"
              kbd
                "Space"
              ", if you would rather press something. It shoots straight ahead and hits nothing on its own, so the reticle is still what lands every shot."
            li
              strong
                "The objective:"
              "seven installations on Earth and the Moon, and twelve Martian raiders on their way in. Hold the installations and see off the raiders. Both counts are top left, and both only go down."
            li
              strong
                "Finding things:"
              "every raider carries a diamond, and the closest one is drawn larger with the range to it underneath. Earth and the Moon carry a ring with their distance, and an arrow at the edge of the screen points the way to anything off it."
            li.help-desktop
              strong
                "Pausing:"
              kbd
                "Esc"
              ", or the pause button in the top right. Nothing moves while this panel is open, and everything you can adjust is right here."
            li.help-mobile
              strong
                "Pausing:"
              "the pause button in the top right. Nothing moves while this panel is open, and everything you can adjust is right here."
          details#card-settings.card-settings
            summary
              "Flight settings"
            div.card-settings-body
              label.settings-label
                "Look Sensitivity"
                input#look-speed-slider [max="3" min="0.3" step="0.1" type="range" value="1.0"]
                span.settings-value#look-speed-value
                  "1.0"
              label.settings-check
                input#invert-pitch-toggle [type="checkbox"]
                span
                  "Invert pitch"
              label.settings-check
                input#reduced-fx-toggle [type="checkbox"]
                span
                  "Reduced effects"
              label.settings-check
                input#mute-toggle [type="checkbox"]
                span
                  "Mute sound"
              p.settings-hint
                "Reduced effects lowers the rendering detail, and it starts switched on for phones and tablets. Turn it off any time you would rather have the fuller sky. Nothing in the game is told by sound alone, so muting loses you nothing."
          p.piece-subtitle.dedication
            "Built for the joy of flying through space. There was never a deeper reason than that."
          p.credits
            "Planet and moon textures by"
            a [href="https://www.solarsystemscope.com/textures" rel="noopener noreferrer" target="_blank"]
              "Solar System Scope"
            ", used under"
            a [href="https://creativecommons.org/licenses/by/4.0/" rel="noopener noreferrer" target="_blank"]
              "CC BY 4.0"
            ". Resized and recompressed for this experience."
          button#card-dismiss.piece-enter [data-close type="button"]
            "Back to the helm"
          p.card-home
            a#home-link [href="/"]
              "Back to the main site"
    div#end-modal.hidden [aria-labelledby="end-title" aria-modal="true" role="dialog"]
      div.modal-backdrop
      div.modal-container.piece-card
        div.piece-card-content
          h2#end-title.piece-title
            "Well flown"
          p#end-subtitle.piece-subtitle
          dl.end-stats
            div.end-stat
              dt
                "Time"
              dd#end-time
                "0:00"
            div.end-stat
              dt
                "Installations saved"
              dd#end-saved
                "0"
            div.end-stat
              dt
                "Raiders destroyed"
              dd#end-destroyed
                "0"
          p#end-best.end-best
          div.end-actions
            button#end-share.piece-cancel [type="button"]
              "Share"
            button#restart-btn.piece-enter [type="button"]
              "Fly again"
          p#end-status.end-status.sr-only [aria-live="polite" role="status"]
          div#end-promo.end-promo
    canvas#game-canvas [aria-label="The view from a ship in orbit above Earth, with the Moon and Mars in the distance" role="img"]
    script [src="../lib/three/r186/three.min.js" type="module"]
    script [src="js/main.min.js" type="module"]"
`;

exports[`www/family/index.html 1`] = `
"<!doctype html>
html [data-ui-theme="surf" lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="Play through a 3D pirate mini golf course in Ocean City, Maryland, built from a son's favorite summer memory. Board the pirate ship, walk the plank hole, and meet the family playing their evening round." name="description"]
    meta [content="#eef3ec" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/family/" rel="canonical"]
    meta [content="Putt Putt with Mom and Dad" property="og:title"]
    meta [content="A 3D round of pirate mini golf in Ocean City, built from a son's favorite summer memory of playing putt putt with his parents. Board the ship and walk the plank hole." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="Putt Putt with Mom and Dad" property="og:site_name"]
    meta [content="https://www.scenexp.com/family/" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/family/assets/og-family.jpg?v=1" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="A walkable 3D pirate mini golf course, with a boardable pirate ship floating in a lagoon." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="Putt Putt with Mom and Dad" name="twitter:title"]
    meta [content="A 3D round of pirate mini golf in Ocean City, built from a son's favorite summer memory of playing putt putt with his parents." name="twitter:description"]
    meta [content="https://www.scenexp.com/family/assets/og-family.jpg?v=1" name="twitter:image"]
    meta [content="A walkable 3D pirate mini golf course, with a boardable pirate ship floating in a lagoon." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "@id": "https://www.scenexp.com/family/#webpage",
        "url": "https://www.scenexp.com/family/",
        "name": "Putt Putt with Mom and Dad",
        "description": "A walkable 3D pirate mini golf course in Ocean City, Maryland, built from a son's favorite summer memory of playing putt putt with his parents.",
        "datePublished": "2026-07-08",
        "inLanguage": "en-US",
        "isPartOf": {
          "@type": "WebSite",
          "@id": "https://www.scenexp.com/#website"
        }
      }
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "SceneXP",
            "item": "https://www.scenexp.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Putt Putt with Mom and Dad",
            "item": "https://www.scenexp.com/family/"
          }
        ]
      }
    title
      "Putt Putt with Mom and Dad | SceneXP"
    link [as="style" href="../shared/css/styles-1.0.0.min.css?v=7" rel="preload"]
    link [href="../lib/three/r186/three.min.js" rel="modulepreload"]
    link [href="js/main.min.js" rel="modulepreload"]
    link [href="js/config.min.js" rel="modulepreload"]
    link [href="../shared/js/boot-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/collision-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/scene-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/warmup-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/controls-1.0.0.min.js" rel="modulepreload"]
    link [href="js/store.min.js" rel="modulepreload"]
    link [href="js/gallery.min.js" rel="modulepreload"]
    link [href="../shared/js/checklist-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/telemetry-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/share-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/autopilot-1.0.0.min.js" rel="modulepreload"]
    link [href="js/listings.min.js" rel="modulepreload"]
    link [href="../shared/js/world-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/people-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/scenery-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/pedestrians-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/npcs-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/gallery-1.0.0.min.js" rel="modulepreload"]
    link [href="favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    a.skip-link [href="#autopilot-btn"]
      "Skip to the page controls"
    h1.sr-only
      "Putt Putt with Mom and Dad"
    noscript
      div.noscript-fallback
        h1
          "Putt Putt with Mom and Dad"
        p
          "This is a walkable 3D pirate mini golf course in Ocean City, Maryland, and it needs JavaScript to run. It was built with love from a favorite summer memory: a mom, a dad, and a ten year old playing putt putt by the beach. The family is out there right now, mid round, and the plank hole is waiting. If you would like a small world like this built from a memory you love, the developer would be glad to hear from you."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        div.loader-title
          "PIRATE PUTT PUTT"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    div#blocker
      div#instructions
        p.title
          "WELCOME"
        p.subtitle
          "A pirate mini golf course in Ocean City, MD"
        p.click-prompt
          "Click to play a round"
        div.controls-hint
          span
            "WASD"
          "Move"
          span
            "MOUSE"
          "Look"
        a#explore-link.welcome-explore [href="/"]
          "More 3D worlds to explore at SceneXP.com"
    div#hud
      div.crosshair [aria-hidden="true"]
      div#look-label.look-label [aria-live="polite" role="status"]
    div#piece-modal.hidden [aria-labelledby="piece-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#piece-title.piece-title
            "Section"
          p#piece-subtitle.piece-subtitle
          a#piece-enter.piece-enter [href="#"]
            "Enter →"
          button.piece-cancel [data-close]
            "Keep exploring"
    div#help-modal.hidden [aria-labelledby="help-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.help-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#help-title.piece-title
            "Welcome to Shipwreck Cove"
          p.piece-subtitle
            "Evening! One round of pirate golf, on the house. Take your time out there, the course is all yours tonight. A family is playing their summer round, feel free to say hi."
          ul.help-list
            li.help-desktop
              strong
                "Move:"
              kbd
                "W"
              kbd
                "A"
              kbd
                "S"
              kbd
                "D"
              "or the arrow keys."
            li.help-desktop
              strong
                "Look:"
              "move the mouse. Click the scene once to capture the cursor. Press"
              kbd
                "Esc"
              "to release it."
            li.help-mobile
              strong
                "Move &amp; look:"
              "use the left joystick to walk and the right joystick to look around."
            li
              strong
                "The ship:"
              "cross the gangplank at the north path and you are aboard. Three holes play on deck."
            li
              strong
                "The plank:"
              "the famous hole 7. You can walk the plank yourself, the ropes will keep you dry."
            li
              strong
                "The scorecard:"
              "the board by the entrance lists a few things worth finding tonight."
            li
              strong
                "The conch shell:"
              "right here on the counter. Hold it to your ear and see."
            li
              strong
                "Autopilot:"
              "press"
              kbd
                "T"
              "or the tour button (top-left) and the course will show you around. Move to take back the controls."
            li
              strong
                "Settings:"
              "the gear icon (top-right) adjusts movement and look sensitivity."
          button.piece-cancel [data-close]
            "Thanks, tee me up!"
    div#dialog-modal.hidden [aria-labelledby="dialog-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#dialog-title.piece-title
            "On the Course"
          p#dialog-message.piece-subtitle
          button.piece-enter.dialog-primary [data-close type="button"]
            "Continue exploring"
          button#dialog-return-btn.piece-cancel.dialog-return.hidden [type="button"]
            "Back to the First Tee"
    div#complete-modal.hidden [aria-labelledby="complete-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.complete-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          p.complete-kicker [aria-hidden="true"]
            "★ &nbsp;All discoveries found&nbsp; ★"
          h2#complete-title.piece-title
            "You played the whole course"
          p.piece-subtitle
            "Thank you for spending an evening here. This course was built with love from a favorite childhood memory of playing putt putt with Mom and Dad in Ocean City. If you would like a small world like this made from a memory you love, or for your business, I would genuinely love to hear from you."
          a#complete-contact.piece-enter [href="/contact.html"]
            "Get in touch →"
          button#complete-share.piece-cancel.complete-share [type="button"]
            "Share this"
          p#complete-share-status.sr-only [aria-live="polite" role="status"]
          button.piece-cancel [data-close]
            "Keep exploring"
    div#nudge-modal.hidden [aria-labelledby="nudge-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.complete-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          p.complete-kicker [aria-hidden="true"]
            "★ &nbsp;A few discoveries in&nbsp; ★"
          h2#nudge-title.piece-title
            "Enjoying the course?"
          p.piece-subtitle
            "Thanks for spending a little time here. This place was built from a favorite family memory, one perfect summer evening of putt putt by the beach. If you would like something like it built from a memory you care about, I would love to hear from you. No rush, hole 7 is not going anywhere."
          a#nudge-contact.piece-enter [href="/contact.html"]
            "Get in touch →"
          button.piece-cancel [data-close]
            "Keep exploring"
    div#whiteboard-view.hidden [aria-label="The scorecard board, up close" aria-modal="true" role="dialog"]
      div.whiteboard-backdrop [data-close]
      div.whiteboard-frame
        div.whiteboard-surface
          canvas#whiteboard-canvas.whiteboard-canvas
        div.whiteboard-tray [aria-hidden="true"]
      p#whiteboard-caption.whiteboard-caption
      p.whiteboard-hint [aria-hidden="true"]
        "Drag to pan across the board"
      button.whiteboard-close [aria-label="Step back from the scorecard board" data-close]
        "&times;"
    div#touch-controls
      div#joystick-zone
        div.joystick-base-fixed
          div.joystick-thumb-fixed
      div#look-joystick-zone
        div.joystick-base-fixed
          div.joystick-thumb-fixed
      div#tap-zone
    button#autopilot-btn.ui-float.menu-btn.autopilot-btn [aria-label="Toggle the autopilot tour (keyboard shortcut T)" aria-pressed="false" title="Autopilot tour (T)"]
      svg [aria-hidden="true" viewbox="0 0 24 24"]
        path [d=#10d062c4ff stroke-dasharray="2.6 2.2"]
        path [d="M21.5 3.6l.6 7.5-6.1-2.4z" fill="currentColor" stroke="none"]
        circle [cx="5" cy="19" fill="currentColor" r="2.2" stroke="none"]
    button#settings-btn.ui-float.settings-btn [aria-controls="settings-panel" aria-expanded="false" aria-label="Movement settings" title="Movement settings"]
      svg.settings-icon [aria-hidden="true" viewbox="0 0 24 24"]
        path [d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"]
        path [d=#88c0d99db8]
    div#settings-panel.settings-panel.hidden
      div.settings-header
        span
          "Settings"
        button#settings-close.settings-close [aria-label="Close"]
          "&times;"
      div.settings-body
        label.settings-label
          "Walk Speed"
          input#walk-speed-slider [max="14" min="2" step="0.5" type="range" value="6.5"]
          span.settings-value#walk-speed-value
            "6.5"
        label.settings-label
          "Look Sensitivity"
          input#look-speed-slider [max="4" min="0.5" step="0.1" type="range" value="1.0"]
          span.settings-value#look-speed-value
            "1.0"
    canvas#game-canvas [aria-label="A walkable 3D pirate mini golf course" role="img"]
    script [src="../lib/three/r186/three.min.js" type="module"]
    script [src="js/main.min.js" type="module"]"
`;

exports[`www/garden/index.html 1`] = `
"<!doctype html>
html [data-ui-theme="garden" lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="Plant a garden of 3D fractal trees and watch it live through the years. Choose from seventeen species, each one grown from its own seed so no two are alike, then tend them through spring, summer, autumn, and winter as they grow. Runs in any modern browser with no app and no download." name="description"]
    meta [content="#8fbf76" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/garden/" rel="canonical"]
    meta [content="Fractal Garden" property="og:title"]
    meta [content="Plant a garden of fractal trees, then watch it live through the years. Choose from seventeen species, each grown from its own seed, and tend them through every season as they grow." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="SceneXP" property="og:site_name"]
    meta [content="https://www.scenexp.com/garden/" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/garden/assets/og-garden.jpg?v=3" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="Five fractal fruit trees in full summer leaf, their canopies heavy with red fruit, standing on dark mulch mounds in a walled garden plot. Each trunk has a small blue water gauge at its base. Behind the wall a pale lake sits below gray rolling hills, under a blue sky with white clouds." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="Fractal Garden" name="twitter:title"]
    meta [content="Plant a garden of fractal trees, then watch it live through the years. Every season passes, and the trees remember you." name="twitter:description"]
    meta [content="https://www.scenexp.com/garden/assets/og-garden.jpg?v=3" name="twitter:image"]
    meta [content="Five fractal fruit trees in full summer leaf, their canopies heavy with red fruit, standing on dark mulch mounds in a walled garden plot. Each trunk has a small blue water gauge at its base. Behind the wall a pale lake sits below gray rolling hills, under a blue sky with white clouds." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "@id": "https://www.scenexp.com/garden/#webpage",
        "url": "https://www.scenexp.com/garden/",
        "name": "Fractal Garden",
        "description": "An interactive 3D scene. Plant fractal trees in an open plot and tend them across the years as the seasons and the weather turn.",
        "datePublished": "2026-08-26",
        "inLanguage": "en-US",
        "isPartOf": {
          "@type": "WebSite",
          "@id": "https://www.scenexp.com/#website"
        }
      }
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "SceneXP",
            "item": "https://www.scenexp.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Fractal Garden",
            "item": "https://www.scenexp.com/garden/"
          }
        ]
      }
    title
      "Fractal Garden | SceneXP"
    link [as="style" href="../shared/css/styles-1.0.0.min.css?v=7" rel="preload"]
    link [as="style" href="css/experience.min.css?v=17" rel="preload"]
    link [href="../lib/three/r186/three.min.js" rel="modulepreload"]
    link [href="js/main.min.js" rel="modulepreload"]
    link [href="js/config.min.js" rel="modulepreload"]
    link [href="js/clock.min.js" rel="modulepreload"]
    link [href="js/sky.min.js" rel="modulepreload"]
    link [href="js/terrain.min.js" rel="modulepreload"]
    link [href="js/forest.min.js" rel="modulepreload"]
    link [href="js/vista.min.js" rel="modulepreload"]
    link [href="js/wildlife.min.js" rel="modulepreload"]
    link [href="js/weather.min.js" rel="modulepreload"]
    link [href="js/precip.min.js" rel="modulepreload"]
    link [href="../shared/js/treespecies-1.0.0.min.js" rel="modulepreload"]
    link [href="js/view.min.js" rel="modulepreload"]
    link [href="js/beds.min.js" rel="modulepreload"]
    link [href="../shared/js/fractaltree-1.0.0.min.js" rel="modulepreload"]
    link [href="js/garden.min.js" rel="modulepreload"]
    link [href="js/ui.min.js" rel="modulepreload"]
    link [href="../shared/js/boot-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/warmup-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/pan-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/telemetry-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/wildflowers-1.0.0.min.js" rel="modulepreload"]
    link [href="favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    link [href="css/experience.min.css?v=17" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    h1.sr-only
      "Fractal Garden"
    noscript
      div.noscript-fallback
        h1
          "Fractal Garden"
        p
          "This is an interactive 3D scene, and it needs JavaScript to draw. It begins as an open plot of grassland. You choose a spot, pick one of seventeen trees, and it goes into the ground as a sapling."
        p
          "Then time does the work. Every day and night cycle is a year, and the sun's own hours are the seasons: dawn is spring, noon is summer, dusk is autumn, and midnight is winter. Leaves bud, deepen, turn, and fall. Snow arrives in the small hours and melts as the light comes back. The trees grow a little older every year, and your garden is still there when you return."
        p
          "The one thing they ask for is water, and they ask for it plainly. A small gauge on every bed shows how full that tree's tank is, and a thirsty one raises a blue droplet above it. Tap the droplet and the tree drinks. A tree left dry through enough summers begins to wilt, though it is never truly gone, and the first watering puts buds back on the branches within seconds."
        p
          "SceneXP is a home for 3D experiences that run right in your browser. This one is a garden you plant and tend yourself."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        div.loader-title
          "FRACTAL GARDEN"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    div#blocker [tabindex="-1"]
      div#instructions
        p.title
          "WELCOME"
        p.subtitle
          "An open plot, and as many years as you care to spend on it"
        p.click-prompt#begin-prompt
          "Click to begin"
        ul.controls-hint
          li
            span
              "PLANT"
            "Tap the grass in the plot, or use the Plant button."
          li
            span
              "LOOK"
            "Drag to look around, or use the arrows. Pinch or the plus and minus to zoom."
          li
            span
              "WATER"
            "Tap the blue droplet over a thirsty tree and it drinks."
          li
            span
              "TEND"
            "Tap the mulch under a tree to see how it is doing."
          li
            span
              "GROW"
            "Every day and night is a year, so your trees fill out while you watch."
          li
            span
              "KEEP"
            "Your garden is saved in this browser."
        p#storage-note.storage-note
        a#explore-link.welcome-explore [href="/"]
          "More 3D worlds to explore at SceneXP.com"
    button#help-btn.ui-float.menu-btn.help-btn [aria-label="How this works" title="How this works" type="button"]
      svg [aria-hidden="true" viewbox="0 0 24 24"]
        circle [cx="12" cy="12" fill="none" r="9"]
        path [d="M9.3 9.2a2.8 2.8 0 1 1 3.4 3.3v1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"]
        circle [cx="12.1" cy="17.4" fill="currentColor" r="1.05" stroke="none"]
    button#reset-btn.ui-float.menu-btn.reset-btn [aria-label="Start a new garden" title="Start a new garden" type="button"]
      svg [aria-hidden="true" viewbox="0 0 24 24"]
        path [d="M20 12a8 8 0 1 1-2.5-5.8" fill="none" stroke-linecap="round"]
        path [d="M20 4v4.5h-4.5" fill="none" stroke-linecap="round" stroke-linejoin="round"]
    button#view-reset.pan-btn.view-reset [aria-label="Show the whole garden" hidden title="Show the whole garden" type="button"]
      svg [aria-hidden="true" viewbox="0 0 24 24"]
        path [d="M4 9V5.8A1.8 1.8 0 0 1 5.8 4H9"]
        path [d="M15 4h3.2A1.8 1.8 0 0 1 20 5.8V9"]
        path [d="M20 15v3.2a1.8 1.8 0 0 1-1.8 1.8H15"]
        path [d="M9 20H5.8A1.8 1.8 0 0 1 4 18.2V15"]
        circle [cx="12" cy="12" fill="currentColor" r="1.6" stroke="none"]
    div#season-chip.season-chip [aria-live="polite" role="status"]
    div#garden-toast.garden-toast [aria-live="polite" role="status"]
    button#tend-plant.tend-plant [hidden type="button"]
      "Plant a tree"
    button#water-all.water-all [hidden type="button"]
    div#tend-panel.tend-panel [aria-labelledby="tend-heading" role="group"]
      h2#tend-heading.tend-heading
        "Your trees"
      p.tend-note
        "Choose a tree to see how it is doing, water it, or take it out. Press Escape to close anything that opens."
      p#tend-empty.tend-empty
        "No trees planted yet. Use the Plant a tree button in the top corner."
      ul#tend-list.tend-list
    div#plant-modal.hidden [aria-labelledby="plant-heading" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.plant-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        h2#plant-heading.plant-heading
          "Choose a tree"
        div.plant-tabs [aria-label="Kinds of tree" role="tablist"]
          button#tab-flowering.plant-tab [aria-controls="species-grid" aria-selected="true" role="tab" type="button"]
            "Flowering"
          button#tab-foliage.plant-tab [aria-controls="species-grid" aria-selected="false" role="tab" tabindex="-1" type="button"]
            "Foliage"
        div.plant-layout
          fieldset.species-fieldset
            legend.visually-hidden
              "Species"
            div#species-grid.species-grid [aria-labelledby="tab-flowering" role="tabpanel"]
          div.plant-side
            canvas#preview-canvas.preview-canvas [aria-hidden="true"]
            p#plant-title.plant-title
            p#plant-note.plant-note
        button#plant-confirm.piece-enter [type="button"]
          "Plant it here"
    div#tree-card.hidden [aria-labelledby="tree-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.tree-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        h2#tree-title.piece-title
        div.tree-scroll
          canvas#tree-preview.tree-preview [aria-hidden="true"]
          div#tree-body.tree-body
          div#tree-thirst.tree-thirst [role="img"]
            div#tree-thirst-fill.tree-thirst-fill
        div.tree-actions
          button#tree-water.piece-enter [type="button"]
            "Water it"
          button#tree-remove.tree-remove [type="button"]
            "Remove this tree"
    div#lake-card.hidden [aria-labelledby="lake-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.lake-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        h2#lake-title.plant-heading
          "The lake"
        canvas#lake-view.lake-view [aria-hidden="true"]
        p#lake-note.plant-note
    div#reset-modal.hidden [aria-describedby="reset-body" aria-labelledby="reset-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.reset-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        h2#reset-title.piece-title
          "Start a new garden?"
        p#reset-body.tree-line
        div.tree-actions
          button#reset-confirm.piece-enter [type="button"]
            "Clear the plot"
          button#reset-cancel.tree-remove [type="button"]
            "Keep my garden"
    canvas#scene [aria-label="A 3D plot of open grassland where fractal trees can be planted and tended through the seasons" role="img"]
    script [src="../lib/three/r186/three.min.js" type="module"]
    script [src="js/main.min.js" type="module"]"
`;

