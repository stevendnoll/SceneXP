    link [href="../shared/js/boot-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/warmup-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/telemetry-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/share-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/promo-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/treespecies-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/fractaltree-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/people-1.0.0.min.js" rel="modulepreload"]
    link [href="js/hedge.min.js" rel="modulepreload"]
    link [href="js/surfaces.min.js" rel="modulepreload"]
    link [href="../shared/js/cast-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/avatar-layers-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/avatar-shapes-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/avatar-hair-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/avatar-hats-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/avatar-wardrobe-1.0.0.min.js" rel="modulepreload"]
    link [href="favicon.svg?v=2" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    link [href="css/experience.min.css?v=14" rel="stylesheet"]
    link [href="../shared/css/avatar-1.0.0.min.css" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    h1.sr-only
      "Leaf Blower"
    noscript
      div.noscript-fallback
        h1
          "Leaf Blower"
        p
          "This is a front yard buried in autumn leaves, and it needs JavaScript to run. Thousands of red, orange and gold leaves cover the lawn in front of a white house, and a leaf blower is waiting for you. Point it anywhere and every leaf in its path tumbles, skids and piles up on its own, drawn live in your browser."
        p
          "SceneXP is a home for 3D experiences that run right in your browser."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        div.loader-title
          "LEAF BLOWER"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    div#blocker [tabindex="-1"]
      div#instructions
        p.title
          "WELCOME"
        p.subtitle
          "A front yard buried in autumn leaves, and a leaf blower waiting for you"
        button#step-in.click-prompt.step-in [type="button"]
          "Click to step in"
        p.tour-note
          "Clear the lawn in five minutes. The clock starts with your first blow."
        p.controls-brief
          span.for-mouse
            "Point to walk &middot; Hold the mouse button to blow &middot; Scroll to zoom"
          span.for-touch
            "Touch the lawn or use the joystick to walk &middot; Hold the blow button to blow &middot; Pinch to zoom"
        details#all-controls.all-controls
          summary#all-controls-toggle
            "All the controls"
          div.controls-hint.for-mouse
            span
              "WALK"
            "Point at the lawn with the mouse and you will walk over and aim the leaf blower there. WASD or the arrow keys walk too."
            span
              "BLOW"
            "Hold the mouse button or Space."
            span
              "ZOOM"
            "Scroll, or pinch on a trackpad, to come in closer or stand back. The + and - keys zoom too, and 0 brings back the usual view."
            span
              "SOUND"
            "The leaf blower makes a whoosh. M or the speaker in the corner turns it on and off."
            span
              "HELP"
            "The question mark in the corner, or Escape, brings you back here."
          div.controls-hint.for-touch
            span
              "WALK"
            "Touch the lawn and you will walk over and aim the leaf blower there, or drag to steer. The joystick in the lower left walks you too, and a light push turns you in place to aim."
            span
              "BLOW"
            "Hold the blow button in the lower right."
            span
              "ZOOM"
            "Pinch with two fingers to come in closer or stand back."
            span
              "SOUND"
            "The leaf blower makes a whoosh. It starts off on a phone or tablet, so tap the speaker in the corner to hear it."
            span
              "HELP"
            "The question mark in the corner brings you back here."
        div.welcome-more
          p#avatar-playing.cast-line.avatar-line
            img#avatar-playing-img [alt="" decoding="async" height="28" src="../assets/avatar/default.png" width="28"]
            span#avatar-playing-text
              "Playing as the usual figure."
            a#avatar-playing-link.welcome-free.cast-btn [href="../avatar/?return=/leaves/"]
              "Make your avatar"
          p#best-line.cast-line.best-line [hidden]
            span#best-text
            button#best-forget.welcome-free.cast-btn [type="button"]
              "Forget my best time"
          p.welcome-ways
            button#free-btn.welcome-free [type="button"]
              "Play with no clock"
            span.welcome-dot [aria-hidden="true"]
              "&middot;"
            a#explore-link.welcome-explore [href="/"]
              "More 3D worlds to explore at SceneXP.com"
    canvas#game-canvas [aria-label="A front lawn buried in red, orange and gold autumn leaves in front of a white house, with a person holding a leaf blower" role="img"]
    button#help-btn.ui-float.menu-btn.help-btn [aria-label="Help" title="Help (Esc)" type="button"]
      svg [aria-hidden="true" viewbox="0 0 24 24"]
        circle [cx="12" cy="12" fill="none" r="9"]
        path [d="M9.3 9.2a2.8 2.8 0 1 1 3.4 3.3v1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"]
        circle [cx="12.1" cy="17.4" fill="currentColor" r="1.05" stroke="none"]
    button#sound-btn.ui-float.menu-btn.sound-btn [aria-label="Sound" aria-pressed="true" title="Sound on (M)" type="button"]
      svg [aria-hidden="true" viewbox="0 0 24 24"]
        path [d="M4 9.5h3.2L12 5.5v13l-4.8-4H4z" stroke-linejoin="round"]
        path.sound-waves [d=#839f041928]
        path.sound-off [d="M16 9.5l5 5M21 9.5l-5 5"]
    div#touch-controls [aria-hidden="true"]
      div#joystick-zone
        div.joystick-base-fixed
          div.joystick-thumb-fixed
    button#blow-btn.ui-float.blow-btn [aria-label="Blow: hold to run the leaf blower" title="Hold to blow" type="button"]
      svg [aria-hidden="true" viewbox="0 0 24 24"]
        path [d="M3 8h10.5a2.75 2.75 0 1 0-2.75-2.75"]
        path [d="M3 12h15a3 3 0 1 1-3 3"]
        path [d="M3 16h7"]
      span.blow-label [aria-hidden="true"]
        "BLOW"
    div#round-hud.round-hud
      span#hud-clock.hud-clock
        "1:00"
      span#hud-cleared.hud-cleared
        "0% cleared"
      span#hud-hint.hud-hint
        "Blow to start the clock"
      button#hud-new.hud-btn [hidden type="button"]
        "New round"
    p#round-status.sr-only [aria-live="polite" role="status"]
    p#find-toast.find-toast [aria-hidden="true"]
    div#cheer-banner.cheer-banner [aria-hidden="true"]
      p#cheer-big.cheer-big
      p#cheer-small.cheer-small
      p#cheer-extra.cheer-extra
    div#end-modal.hidden [aria-describedby="end-line" aria-labelledby="end-title" aria-modal="true" role="dialog"]
      div.modal-backdrop
      div.end-card
        div.end-hero
          canvas#end-pile.end-pile [aria-hidden="true"]
          p#end-ribbon.end-ribbon [hidden]
        div.end-body
          p#end-kicker.end-kicker
            "Time is up"
          h2#end-title.end-title
            "Respectable work"
          p.end-score
            span#end-percent
              "0%"
            "of the lawn cleared"
          p#end-line.end-line
          p#end-dive.end-note
          p#end-finds.end-note.end-finds
          p#end-best.end-note.end-best
          dl.end-stats
            div.end-stat
              dt
                "On the tarp"
              dd#end-tarp
                "0"
            div.end-stat
              dt
                "In the street"
              dd#end-street
                "0"
            div.end-stat
              dt
                "Sent over the fence"
              dd#end-neighbor
                "0"
            div.end-stat
              dt
                "Still on the lawn"
              dd#end-lawn
                "0"
          div.end-actions
            button#end-again.end-again [type="button"]
              "Play again"
            button#end-share.end-share [type="button"]
              "Share"
          button#end-free.end-free [type="button"]
            "Keep blowing leaves"
          p#end-status.sr-only [aria-live="polite" role="status"]
          div#end-promo.end-promo
          p.end-mark [aria-hidden="true"]
            "Leaf Blower &middot; SceneXP.com"
    script [src="../lib/three/r186/three.min.js" type="module"]
    script [src="js/main.min.js" type="module"]"
`;

