    meta [content="John Walker, The Auto Man" name="twitter:title"]
    meta [content="You never have to negotiate with a car dealer again. John Walker desks the whole deal on your side of the desk." name="twitter:description"]
    meta [content="https://www.scenexp.com/automan/assets/og-automan.jpg?v=1" name="twitter:image"]
    meta [content="A dark navy card carrying John Walker's gold three-blade W above his name, John Walker, The Auto Man, set in wide-spaced capitals." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "@id": "https://www.scenexp.com/automan/#webpage",
