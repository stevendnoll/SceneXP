    meta [content="A 3D close-up of a Confederate Jasmine in a cedar planter box: ladybugs and a praying mantis on the leaves, bees in the air, and three kids' faces peering in through the far side of the plant." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
