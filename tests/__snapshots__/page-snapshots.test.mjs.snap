exports[`www/404.html 1`] = `
"<!doctype html>
html [lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="That page could not be found. Let us walk you back to a world that exists." name="description"]
    meta [content="noindex" name="robots"]
    meta [content="#f7f7fb" media="(prefers-color-scheme: light)" name="theme-color"]
    meta [content="#0e0f14" media="(prefers-color-scheme: dark)" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    title
      "Page Not Found | SceneXP"
    link [as="style" href="/css/site.min.css?v=4" rel="preload"]
    link [href="/favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="/css/site.min.css?v=4" rel="stylesheet"]
    script [src="/js/theme.min.js?v=1"]
    script [defer src="/js/nav.min.js?v=1"]
  body
    a.skip-link [href="#main"]
      "Skip to main content"
    header.site-header
      div.container.site-header-inner
        a.brand [href="/"]
          svg.brand-mark [aria-hidden="true" focusable="false" viewbox="0 0 32 32"]
            defs
              lineargradient#brand-grad [x1="0" x2="1" y1="0" y2="1"]
                stop [offset="0" stop-color="#6c4cf1"]
                stop [offset="1" stop-color="#06b6d4"]
            rect [fill="url(#brand-grad)" height="32" rx="8" width="32"]
            path [d="M8 22 14 10l4 8 3-5 3 9" fill="none" stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"]
          "SceneXP"
        nav#site-nav.site-nav [aria-label="Main"]
          ul
            li
              a [href="/#experiences"]
                "Experiences"
            li
              a [href="/contact.html"]
                "Contact"
            li
              a [href="/contribute.html"]
                "Contribute"
        button#nav-toggle.nav-toggle [aria-controls="site-nav" aria-expanded="false" aria-label="Menu" hidden type="button"]
          svg.icon-nav-open [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            path [d="M4 7h16M4 12h16M4 17h16"]
          svg.icon-nav-close [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            path [d="M6 6l12 12M18 6 6 18"]
        button#theme-toggle.theme-toggle [aria-label="Theme" hidden type="button"]
          svg.icon-theme-light [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            circle [cx="12" cy="12" fill="currentColor" r="4.5" stroke="none"]
            path [d=#f2e7be5368]
          svg.icon-theme-dark [aria-hidden="true" focusable="false" viewbox="0 0 24 24"]
            path [d=#bac0ce3668 fill="currentColor"]
          svg.icon-theme-system [aria-hidden="true" focusable="false" viewbox="0 0 24 24"]
            circle [cx="12" cy="12" fill="none" r="8.5" stroke="currentColor" stroke-width="2"]
            path [d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor"]
    main#main
      div.error-hero
        div.container
          p.error-code [aria-hidden="true"]
            "404"
          h1
            "This little world does not exist yet"
          p
            "The page you are looking for may have moved, or perhaps it was never built. Please allow us to walk you back to somewhere wonderful."
          div.hero-actions
            a.btn.btn-primary [href="/"]
              "Take me home"
            a.btn.btn-ghost [href="/#experiences"]
              "Browse the experiences"
    footer.site-footer
      div.container.site-footer-inner
        div.footer-brand
          a.brand [href="/"]
            svg.brand-mark [aria-hidden="true" focusable="false" viewbox="0 0 32 32"]
              defs
                lineargradient#brand-grad-footer [x1="0" x2="1" y1="0" y2="1"]
                  stop [offset="0" stop-color="#6c4cf1"]
                  stop [offset="1" stop-color="#06b6d4"]
              rect [fill="url(#brand-grad-footer)" height="32" rx="8" width="32"]
              path [d="M8 22 14 10l4 8 3-5 3 9" fill="none" stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"]
            "SceneXP"
          p
            "3D worlds, games, and experiments, every one running right in your browser. Thank you for visiting."
        nav.footer-nav [aria-label="Explore"]
          h2
            "Explore"
          ul
            li
              a [href="/#experiences"]
                "Experiences"
            li
              a [href="/contact.html"]
                "Contact"
            li
              a [href="/contribute.html"]
                "Contribute"
        nav.footer-nav [aria-label="Project"]
          h2
            "Project"
          ul
            li
              a [href="https://github.com/stevendnoll/SceneXP" rel="noopener noreferrer" target="_blank" title="View the SceneXP source code on GitHub"]
                "GitHub"
            li
              a [href="/privacy.html"]
                "Privacy"
            li
              a [href="/terms.html"]
                "Terms"
        div.footer-meta
          p
            "Built with Three.js and browser-native HTML, CSS, and JavaScript. Open source under the MIT license."
          p
            "SceneXP © 2026"
            a [href="https://www.continuumcommercellc.com/" rel="noopener noreferrer" target="_blank" title="View the Continuum Commerce LLC website"]
              "Continuum Commerce LLC"
            ".""
`;

exports[`www/automan/index.html 1`] = `
"<!doctype html>
html [lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="John Walker, The Auto Man, does your car negotiating for you. He desks the whole deal on the buyer's side: the trade valuation, the price, the financing and the rate, and the products they add at the end. Free consultation by phone or Zoom, in Baltimore, Maryland and anywhere by Zoom. Step into the 3D showroom and meet him." name="description"]
    meta [content="#0e1c2e" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/automan/" rel="canonical"]
    meta [content="John Walker, The Auto Man" property="og:title"]
    meta [content="You never have to negotiate with a car dealer again. John Walker desks the whole deal on your side of the desk. Step into the 3D showroom and meet him." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="SceneXP" property="og:site_name"]
    meta [content="https://www.scenexp.com/automan/" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/automan/assets/og-automan.jpg?v=1" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="A dark navy card carrying John Walker's gold three-blade W above his name, John Walker, The Auto Man, set in wide-spaced capitals." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="John Walker, The Auto Man" name="twitter:title"]
    meta [content="You never have to negotiate with a car dealer again. John Walker desks the whole deal on your side of the desk." name="twitter:description"]
    meta [content="https://www.scenexp.com/automan/assets/og-automan.jpg?v=1" name="twitter:image"]
    meta [content="A dark navy card carrying John Walker's gold three-blade W above his name, John Walker, The Auto Man, set in wide-spaced capitals." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://www.scenexp.com/automan/#website",
        "url": "https://www.scenexp.com/automan/",
        "name": "John Walker, The Auto Man",
        "description": "A 3D showroom built for John Walker, The Auto Man, who does the negotiating for car buyers so they never have to do it themselves.",
        "inLanguage": "en-US",
        "about": {
          "@type": "ProfessionalService",
          "@id": "https://www.scenexp.com/automan/#business",
          "name": "John Walker, The Auto Man",
          "url": "https://www.scenexp.com/automan/",
          "description": "John Walker negotiates car purchases and sales on the buyer's behalf. He desks the whole deal for you: the trade valuation, the price, the financing and the rate, and the extended warranty, tire and wheel protection and GAP insurance they add at the end. You do not negotiate with the dealership at all, he does it for you. Free consultation by phone or Zoom, and if he cannot get you the deal you want you owe him nothing.",
          "areaServed": {
            "@type": "Place",
            "name": "Baltimore, Maryland, and remote via Zoom"
          },
          "founder": {
            "@type": "Person",
            "name": "John Walker"
          },
          "slogan": "He does the negotiating, so you never have to."
        }
      }
    title
      "John Walker, The Auto Man"
    link [as="style" href="../shared/css/styles-1.0.0.min.css?v=7" rel="preload"]
    link [as="script" href="../lib/three.min.js" rel="preload"]
    link [href="favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    link [href="css/experience.min.css?v=1" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    a.skip-link [href="#help-btn"]
      "Skip to the About button"
    h1.sr-only
      "John Walker, The Auto Man"
    noscript
      div.noscript-fallback
        h1
          "John Walker, The Auto Man"
        p
          "This is a living 3D visit to a car dealership desk, and it needs JavaScript to run. It was built for John Walker, who goes by The Auto Man, and what he does is simple: he does the negotiating for you, so you never have to do it yourself. In his own words, he will desk the whole deal on your behalf. There are four places a car deal quietly costs a buyer money, and he works all four of them: the trade valuation, the price, the financing and the rate, and the products they add at the end, like the extended warranty, the tire and wheel protection and the GAP insurance. John has spent more than twenty-five years in sales and marketing, ten of them in the automotive industry, with more than 2,000 vehicles through his hands, and he spent them on the dealership side desking these deals himself. He knows where the money is because he used to be the one holding it. In the 3D scene he is at the desk with his customer, pointing at the deal sheet and making her case, while the lot fills the window behind them. The consultation is free, by phone or by Zoom, and if he cannot get you the deal you want, you owe him nothing. He works in Baltimore, Maryland, and anywhere else by Zoom."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/"]
                "The SceneXP experience directory"
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        img.loader-logo.automan-mark [alt="" height="150" src="favicon.svg" width="150"]
        div.loader-title
          "John Walker, The Auto Man"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    div#coach-marks.coach-marks.coach-out
      button.coach-mark [aria-label="Meet John Walker, The Auto Man" data-who="john" hidden type="button"]
        span.coach-halo [aria-hidden="true"]
        span.coach-name [aria-hidden="true"]
          "John"
      button.coach-mark [aria-label="Meet John's customer, the buyer" data-who="customer" hidden type="button"]
        span.coach-halo [aria-hidden="true"]
        span.coach-name [aria-hidden="true"]
          "Buyer"
      button.coach-mark [aria-label="Meet the dealer" data-who="dealer" hidden type="button"]
        span.coach-halo [aria-hidden="true"]
        span.coach-name [aria-hidden="true"]
          "Dealer"
    div#showroom-toast.showroom-toast [aria-live="polite" role="status"]
    p#intro-handle-hint.intro-handle-hint.coach-out [aria-hidden="true"]
      "Tap to re-open"
    button#intro-handle.intro-handle.coach-out [aria-controls="intro-card" aria-expanded="false" type="button"]
      img.portrait-disc.intro-handle-portrait [alt="" decoding="async" height="256" src="assets/john-walker-avatar.webp" width="256"]
      "John Walker, The Auto Man"
      svg.intro-handle-chevron [aria-hidden="true" viewbox="0 0 12 8"]
        path [d="M 1 6.5 L 6 1.5 L 11 6.5"]
    div#intro-card.intro-card.coach-out [tabindex="-1"]
      button#intro-close.intro-close [aria-label="Collapse this introduction" type="button"]
        "&times;"
      div.intro-head
        img.portrait-disc.intro-portrait [alt="" decoding="async" height="256" src="assets/john-walker-avatar.webp" width="256"]
        p.intro-kicker
          "John Walker, The Auto Man"
      p.intro-lead
        "He does the negotiating, so you never have to."
      p.intro-body
        "Twenty-five years inside the business and more than 2,000 cars, now spent working every line of a deal that costs you money: the trade value, the price, the financing and the rate, and the coverage they add at the end. You do not have to argue for any of it. The first call is free, and if he cannot get you the deal you want, you owe him nothing."
      div.intro-actions
        button#intro-contact.intro-action.lux-primary [type="button"]
          "Talk to John"
        button#intro-about.intro-action [type="button"]
          svg.intro-w [aria-hidden="true" viewbox="3 16.5 58 31"]
            path [d=#f61dfbbb51]
          "What he does"
      p.intro-hint#intro-hint
        "Tap a glowing marker to meet John. Pinch to look closer."
    button#help-btn.ui-float.menu-btn [aria-label="About John, and his flyer" title="About John" type="button"]
      svg [aria-hidden="true" viewbox="3 16.5 58 31"]
        path [d=#f61dfbbb51]
    div#help-modal.hidden [aria-labelledby="poster-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.poster-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        img.about-portrait [alt="John Walker, a bald man in a light blue shirt, smiling in a daylit office with a city skyline behind him." decoding="async" height="720" src="assets/john-walker-about.webp" width="1080"]
        div.about-text
          h2#poster-title.about-title
            "John Walker, The Auto Man"
          p.about-lead
            "He desks the whole deal for you."
          p.about-body
            "There are four places a car deal quietly costs you money: the trade valuation, the price, the financing and the rate, and the products they add at the end, like the extended warranty, the tire and wheel protection and the GAP insurance. John works all four on your behalf. He has spent more than twenty-five years in sales and marketing, ten of them in the automotive industry, with more than 2,000 vehicles through his hands, and he spent them on the dealership side desking these deals himself. He knows where the money is because he used to be the one holding it."
          p.about-body
            "In his own words: let me help you get the best deal for your trade, and I will desk the whole deal for you. That is the part worth repeating. You are not being coached through a negotiation. He does it, and you never have to sit across from anybody and argue about a price."
          p.about-body
            "The consultation is free, by phone or by Zoom. If he cannot get you the deal you want, you owe him nothing, and there is a 100 percent satisfaction guarantee on the small fee if you are not happy. He works in Baltimore, Maryland, and anywhere else by Zoom."
          p.about-flyer
            a#poster-link.about-flyer-link [aria-label="Open John's printed flyer full size in a new tab" href="assets/poster.webp" rel="noopener" target="_blank"]
              "See John's printed flyer &#8599;"
          button#poster-cta.piece-enter.dialog-cta.dialog-primary.lux-primary [type="button"]
            "Talk to John &rarr;"
    div#nudge-modal.hidden [aria-labelledby="nudge-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.complete-card [tabindex="-1"]
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          p.complete-kicker [aria-hidden="true"]
            "Free consultation, by phone or Zoom"
          h2#nudge-title.piece-title
            "Let John handle it"
          p#nudge-message.piece-subtitle
            "In his own words, he will desk the whole deal for you: the trade valuation, the price, the financing and the rate, and the products they add at the end. Twenty-five years of doing that from the dealership side, now spent doing it from yours. If he cannot get you the deal you want, you owe him nothing."
          img#nudge-portrait.portrait-disc.card-portrait [alt="John Walker" decoding="async" height="256" src="assets/john-walker-avatar.webp" width="256"]
          a#contact-call.piece-enter.lux-primary [href=""]
            "Call John"
          a#contact-text.piece-cancel [href=""]
            "Send a text"
          a#contact-email.piece-cancel [href=""]
            "Email John"
          p#contact-status.contact-status [aria-live="polite" role="status"]
          p#contact-fallback.piece-subtitle [aria-live="polite" role="status"]
          p.piece-subtitle.contact-where
            "Baltimore, Maryland, or anywhere by Zoom. 100% satisfaction guarantee."
          p.contact-share
            button#contact-share.contact-share-link [type="button"]
              "Send this to someone who is car shopping"
          button.piece-cancel [data-close]
            "Back to the showroom"
          p.ownership-note
            "The Auto Man name belongs to John Walker and appears here with his blessing."
    canvas#game-canvas [aria-label="A living 3D car dealership desk: John Walker points at a deal sheet and makes his customer's case while she nods along, the dealer listens from across the desk, and cars roll past the lot beyond the glass wall behind them" role="img"]
    script [src="../lib/three.min.js"]
    script [src="js/main.min.js" type="module"]"
`;

