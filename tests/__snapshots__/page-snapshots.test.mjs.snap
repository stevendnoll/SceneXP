    link [href="../shared/js/avatar-wardrobe-1.0.0.min.js" rel="modulepreload"]
    link [href="js/poses.min.js" rel="modulepreload"]
    link [href="js/hands.min.js" rel="modulepreload"]
    link [href="js/scenes/index.min.js" rel="modulepreload"]
    link [href="js/backdrops.min.js" rel="modulepreload"]
    link [href="js/scenes/plan.min.js" rel="modulepreload"]
    link [href="js/scenes/space.min.js" rel="modulepreload"]
    link [href="js/scenes/fine.min.js" rel="modulepreload"]
    link [href="js/scenes/handshake.min.js" rel="modulepreload"]
    link [href="favicon.svg?v=1" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    link [href="css/meme.min.css?v=5" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body.mm-body
    h1.sr-only
      "Meme Studio"
    noscript
      div.noscript-fallback
        h1
          "Meme Studio"
        p
          "This is a meme generator with you in it, and it needs JavaScript to run. Your SceneXP avatar stands in each panel of a classic meme layout, built as a row of small lit 3D boxes. You choose a template, type a caption for each panel, and add a friend's avatar if you like. Then you share the result as a picture, or as a link your friend can open and remix with their own avatar."
        p
          "Everything is made on your own device. Nothing you type or make is sent to us."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/"]
                "More 3D worlds to explore at SceneXP.com"
            li
              a [href="/avatar/"]
                "Make your avatar"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#meme-app.mm-app [hidden]
      div.mm-stage
        canvas#mm-canvas.mm-canvas [aria-label="Your meme's panels: small lit boxes with a figure wearing your avatar's face in each" role="img"]
        canvas#mm-overlay.mm-overlay [aria-hidden="true"]
        p#mm-stage-status.mm-stage-status [aria-live="polite" role="status"]
      section.mm-sheet [aria-labelledby="mm-heading"]
        div.mm-top
          a#mm-return.mm-return [href="/"]
            svg.mm-return-icon [aria-hidden="true" focusable="false" viewbox="0 0 24 24"]
              path [d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4"]
            span#mm-return-text
              "Back to SceneXP"
        p.mm-eyebrow
          "Meme Studio"
        h2#mm-heading.mm-heading
          "Put yourself in the meme"
        p#mm-lede.mm-lede
          "Your avatar is already standing in the first one. Pick a meme, type your captions, and share it as a picture or a link."
        div#mm-incoming.mm-incoming [aria-labelledby="mm-incoming-text" hidden role="region"]
          p#mm-incoming-text.mm-incoming-text
            "A friend made this meme for you."
          div.mm-row
            button#mm-make-mine.mm-primary [type="button"]
              "Make it mine"
            button#mm-keep-theirs.mm-secondary [type="button"]
              "Keep it as it is"
          p#mm-incoming-note.mm-note [hidden]
            "You have no avatar yet."
            a.mm-link [href="/avatar/?return=/meme/"]
              "Make yours"
            ", then come back here: this meme will be waiting."
        div#mm-editor.mm-editor
          div#mm-tabs.mm-tabs [aria-label="Choose what to change" role="tablist"]
            button#mm-tab-meme.mm-tab [aria-controls="mm-panel-meme" aria-selected="true" role="tab" type="button"]
              "Meme"
            button#mm-tab-captions.mm-tab [aria-controls="mm-panel-captions" aria-selected="false" role="tab" tabindex="-1" type="button"]
              "Captions"
            button#mm-tab-people.mm-tab [aria-controls="mm-panel-people" aria-selected="false" role="tab" tabindex="-1" type="button"]
              "People"
          div#mm-panel-meme.mm-panel [aria-labelledby="mm-tab-meme" role="tabpanel"]
            div#mm-picker.mm-picker [aria-label="Choose a meme" role="group"]
            div#mm-tint.mm-tint [hidden]
            p#mm-hint.mm-note.mm-hint [hidden]
              "Tap a panel to step into it, and tap again to step back. Drag to tilt the view."
            div#mm-view.mm-view [aria-label="Look at" hidden role="group"]
            h3.mm-subhead
              "The faces"
            div#mm-faces.mm-faces
          div#mm-panel-captions.mm-panel [aria-labelledby="mm-tab-captions" hidden role="tabpanel"]
            div#mm-captions.mm-captions
          div#mm-panel-people.mm-panel [aria-labelledby="mm-tab-people" hidden role="tabpanel"]
            ul#mm-people.mm-people
            input#mm-friend-file [accept=".json,application/json" aria-label="Open a friend's avatar file" hidden tabindex="-1" type="file"]
            p#mm-people-status.mm-note [aria-live="polite" role="status"]
            p.mm-note
              a#mm-make-avatar.mm-link [href="/avatar/?return=/meme/"]
                "Make your avatar"
        h3.mm-subhead
          "Your picture"
        canvas#mm-preview.mm-preview [aria-label="A preview of your meme picture, with your captions and the SceneXP.com mark in the corner" height="540" role="img" width="540"]
        fieldset.mm-group
          legend.mm-legend
            "Size"
          div.mm-options
            label.mm-option
              input#mm-size-square.mm-radio [checked name="mm-size" type="radio" value="square"]
              span.mm-word
                "Square"
            label.mm-option
              input#mm-size-portrait.mm-radio [name="mm-size" type="radio" value="portrait"]
              span.mm-word
                "Portrait"
        div.mm-row
          button#mm-picture-save.mm-primary [hidden type="button"]
            "Save picture"
          button#mm-link.mm-secondary [title="A link that opens this meme, for a friend to make their own" type="button"]
            "Share link"
          button#mm-start-over.mm-secondary [type="button"]
            "Start over"
        p.mm-note
          "The link carries the meme and your avatar. Whoever opens it can put their own avatar in your place."
        p#mm-status.mm-status [aria-live="polite" role="status"]
        div#mm-next.mm-next [hidden]
        p.mm-note.mm-privacy
          "Made on this device. Nothing you type or make is sent to us."
          a [href="/privacy.html"]
            "Privacy"
        p.mm-note.mm-report
          "Seen a meme from here that should not exist?"
          a [href="/contact.html"]
            "Please tell us"
          "."
    script [src="../lib/three/r186/three.min.js" type="module"]
    script [src="js/main.min.js" type="module"]"
`;

exports[`www/office/index.html 1`] = `
