    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="A 3D football field seen from high behind the offense in the middle of a play. Orange players with a white X on their jerseys run routes against blue defenders marked O, with lettered rings A to D under the receivers and Q under the quarterback. The 5, 15, 30 and 50 point lines are painted across the green turf, and fans in orange and blue fill the stands on both sides." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="X's and O's" name="twitter:title"]
    meta [content="A 3D football game where you are always on offense. Pick your team's colors, call a play, and the farther you carry it the more it is worth." name="twitter:description"]
    meta [content="https://www.scenexp.com/xo/assets/og-xo.jpg?v=1" name="twitter:image"]
    meta [content="A 3D football field seen from high behind the offense in the middle of a play. Orange players with a white X on their jerseys run routes against blue defenders marked O, with lettered rings A to D under the receivers and Q under the quarterback. The 5, 15, 30 and 50 point lines are painted across the green turf, and fans in orange and blue fill the stands on both sides." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "VideoGame",
        "@id": "https://www.scenexp.com/xo/#game",
        "url": "https://www.scenexp.com/xo/",
        "name": "X's and O's",
        "image": "https://www.scenexp.com/xo/assets/og-xo.jpg?v=1",
        "description": "A browser-based 3D American football game. You are always on offense: call a play from the playbook, snap the ball, and choose a receiver or keep it and run. Ten plays make a game, and both teams and the field can be dressed in any colors, such as your favorite team and its rival.",
        "genre": [
          "Sports",
          "Strategy"
        ],
        "gamePlatform": "Web browser",
        "applicationCategory": "Game",
        "operatingSystem": "Any",
        "inLanguage": "en-US",
        "isAccessibleForFree": true,
        "playMode": "SinglePlayer",
        "author": {
          "@type": "Person",
          "name": "Steve Noll"
        },
        "publisher": {
          "@type": "Organization",
          "name": "Continuum Commerce LLC"
        },
        "isPartOf": {
          "@type": "WebSite",
          "@id": "https://www.scenexp.com/#website"
        }
      }
    title
      "X's and O's"
    link [as="style" href="../shared/css/styles-1.0.0.min.css?v=7" rel="preload"]
    link [as="style" href="css/experience.min.css?v=18" rel="preload"]
    link [as="script" href="../lib/three.min.js" rel="preload"]
    link [href="favicon.ico" rel="icon" sizes="16x16 32x32 48x48 64x64" type="image/x-icon"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    link [href="css/experience.min.css?v=18" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    h1.sr-only
      "X's and O's"
    noscript
      div.noscript-fallback
        h1
          "X's and O's"
        p
          "This is a 3D American football game, which needs JavaScript to run. You are always on offense. Before each play you choose one from the playbook, and you can pick the defensive formation you would like to face or leave it to chance. Then you snap the ball and decide, in the moment, whether to throw to one of your receivers or keep it and run."
        p
          "Ten plays make a game. The farther you carry the ball the more the play is worth, all the way to fifty points for crossing the field, and an interception costs you ten. Fifty a play is the most on offer, so 500 is a perfect game."
        p
          "SceneXP is a home for 3D experiences that run right in your browser. This one is simply a game."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        img.loader-logo.xo-loader-logo [alt="" fetchpriority="high" height="152" src="assets/exes-n-ohs-logo-152.jpg" width="152"]
        div.loader-title
          "X'S AND O'S"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    canvas#game-canvas [aria-label="A 3D football field, seen from behind your offense." role="img"]
    div#welcome.card-overlay [hidden]
      div.card-panel.welcome-panel [aria-describedby="welcome-intro" aria-labelledby="welcome-title" aria-modal="true" role="dialog"]
        h2#welcome-title.card-title.welcome-title
          img.welcome-logo [alt="" decoding="async" height="64" src="assets/exes-n-ohs-logo-64.jpg" width="64"]
          span
            "X's and O's"
        p#welcome-intro.card-detail
          "Ten plays, and you are on offense for every one of them. The farther you carry the ball, the more the play is worth."
        ol.welcome-steps
          li
            strong
              "Call a play."
            "Pick one from the playbook, and choose a defense to face or leave it to chance."
          li
            strong
              "Snap the ball."
            "Take as long as you like reading the formation first."
          li
            strong
              "Throw or run."
            "Hit a receiver, or keep it yourself and see how far you get. You have ten seconds from the snap to make up your mind, and holding on past that is a sack."
          li
            strong
              "Jump for it."
            "While the ball is in the air, press Jump or tap your receiver to send him up for it. The button lights up as the ball arrives. Jump too early or too late and the pass can sail past him or be picked off. If you would rather just watch, turn on Auto jump in the playbook."
        p.welcome-keys.card-meta
          "On a keyboard:"
          kbd
            "Space"
          ","
          kbd
            "S"
          "or"
          kbd
            "Q"
          "snaps the ball,"
          kbd
            "C"
          "changes the play before you do,"
          kbd
            "A"
          "to"
          kbd
            "D"
          "throw to that receiver, and"
          kbd
            "K"
          "keeps it. With the ball in the air,"
          kbd
            "J"
          "or"
          kbd
            "Space"
          "jumps. During a replay,"
          kbd
            "V"
          "or the arrow keys switch the view."
        p.welcome-ladder-title
          "What a play is worth"
        ul.welcome-ladder
          li
            span.ladder-pts.is-good
              "5"
            "past the first line"
          li
            span.ladder-pts.is-good
              "15"
            "past the second"
          li
            span.ladder-pts.is-good
              "30"
            "past the third"
          li
            span.ladder-pts.is-good
              "50"
            "all the way across"
          li
            span.ladder-pts.is-bad
              "-5"
            "sacked holding the ball"
          li
            span.ladder-pts.is-bad
              "-10"
            "intercepted"
        p.welcome-target
          "Fifty a play is the most you can get, so"
          strong
            "500 is a perfect game"
          ". Good luck."
        p#welcome-resume.card-meta.welcome-resume [hidden]
        div#welcome-actions.card-actions
        p.welcome-explore-row
          a#explore-link.welcome-explore [href="/"]
            "More 3D worlds to explore at SceneXP.com"
    div#colors.card-overlay [hidden]
      div#colors-panel.card-panel.colors-panel [aria-describedby="colors-intro" aria-labelledby="colors-title" aria-modal="true" role="dialog" tabindex="-1"]
        h2#colors-title.card-title
          "Team colors"
        p#colors-intro.card-detail
          "Dress the X's and the O's in your team's colors and your rival's, and pick a field for them to play on."
        div.colors-teams
          section.colors-team [aria-labelledby="colors-x-title"]
            h3#colors-x-title.colors-team-title
              "The X's"
            canvas#colors-x-preview.colors-preview [aria-hidden="true" height="256" width="256"]
            div.colors-row
              label [for="colors-x-jersey"]
                "Jersey"
              input#colors-x-jersey.colors-input [type="color" value="#ff992c"]
            div.colors-row
              label [for="colors-x-helmet"]
                "Helmet"
              input#colors-x-helmet.colors-input [type="color" value="#ff992c"]
            button#colors-x-match.colors-match [aria-label="Match jersey color on the X's helmet" hidden type="button"]
              "Match jersey"
          section.colors-team [aria-labelledby="colors-o-title"]
            h3#colors-o-title.colors-team-title
              "The O's"
            canvas#colors-o-preview.colors-preview [aria-hidden="true" height="256" width="256"]
            div.colors-row
              label [for="colors-o-jersey"]
                "Jersey"
              input#colors-o-jersey.colors-input [type="color" value="#9bcfff"]
            div.colors-row
              label [for="colors-o-helmet"]
                "Helmet"
              input#colors-o-helmet.colors-input [type="color" value="#9bcfff"]
            button#colors-o-match.colors-match [aria-label="Match jersey color on the O's helmet" hidden type="button"]
              "Match jersey"
        div.colors-row.colors-field
          label [for="colors-field"]
            "Field"
          input#colors-field.colors-input [type="color" value="#1f5c2e"]
        p#colors-warning.colors-warning [aria-live="polite" hidden role="status"]
        div.card-actions.colors-actions
          button#colors-reset.hud-btn [type="button"]
            "Reset to original colors"
          button#colors-done.hud-btn.hud-btn-primary [aria-keyshortcuts="Escape" type="button"]
            "Done"
    div#playbook.playbook [hidden]
      div.playbook-panel [aria-labelledby="playbook-title" aria-modal="true" role="dialog"]
        div.playbook-head
          h2#playbook-title.playbook-title
            "Choose your play"
        div.playbook-body
    div#game-hud.hud [hidden]
      div#hud-bar.hud-bar
        span.hud-stat
          "Play"
          strong#hud-play
            "1"
          "of"
          strong#hud-of
            "10"
        span.hud-stat
          "Score"
          strong#hud-score
            "0"
        span.hud-stat.hud-clock#hud-clock [aria-hidden="true" hidden]
          "Clock"
          strong#hud-clock-value
            "10"
        button#mute-btn.hud-mute [aria-pressed="true" type="button"]
          "Sound off"
      div#hud-actions.hud-actions
    p#hud-live.sr-only [aria-live="polite" role="status"]
    p#opening-title.opening-title [aria-hidden="true" hidden]
      "Make them pay."
    div#milestone.milestone [aria-hidden="true" hidden]
      p.milestone-kicker
        "Points"
      p#milestone-number.milestone-number
        "100"
      p#milestone-line.milestone-line
    div#result.card-overlay.card-overlay-low [hidden]
      div.card-panel [aria-labelledby="result-headline" aria-modal="true" role="dialog"]
        p#result-points.result-points
          "+0"
        h2#result-headline.card-title
          "Result"
        p#result-detail.card-detail
        p#result-running.card-meta
        div#result-actions.card-actions
    div#summary.card-overlay [hidden]
      div.card-panel [aria-labelledby="summary-title" aria-modal="true" role="dialog"]
        h2#summary-title.card-title
          "Final score"
        p#summary-total.summary-total
          "0"
        p#summary-verdict.card-detail
        p#summary-line.card-meta
        p#summary-best.card-meta
        ul#summary-plays.summary-plays
        div#summary-actions.card-actions
        p#summary-status.sr-only [aria-live="polite" role="status"]
        div#summary-promo.summary-promo
    script [src="../lib/three.min.js"]
    script [src="js/main.min.js" type="module"]"
`;
