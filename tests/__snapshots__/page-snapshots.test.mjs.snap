    link [href="js/gulls.min.js" rel="modulepreload"]
    link [href="js/orcas.min.js" rel="modulepreload"]
    link [href="js/wheel.min.js" rel="modulepreload"]
    link [href="js/posting.min.js" rel="modulepreload"]
    link [href="favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    link [href="css/experience.min.css?v=5" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    h1.sr-only
      "Corner Office"
    noscript
      div.noscript-fallback
        h1
          "Corner Office"
        p
          "This is a job search tracker set in a 3D office, and it needs JavaScript to run. Your applications, interviews, contacts and follow-ups are kept in the furniture of the room, where you can add, search, sort and filter them."
        p
          "Everything you enter stays in your own browser and is never sent anywhere."
        p
          "SceneXP is a home for 3D experiences that run right in your browser."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        div.loader-title
          "CORNER OFFICE"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    canvas#game-canvas [aria-label="A corner office forty floors up, walled with windows onto a city by the bay, with an observation wheel turning on the waterfront and snowy mountains beyond, under an exposed concrete ceiling. A slim white desk holds a computer with sticky notes on it, a keyboard and mouse, and a slim lamp, with a wastebasket beside it. A low white filing cabinet of folders stands under the window beside a printer, a fabric pinboard of index cards and a glass whiteboard of numbers hang on the walls, and a pair of binoculars on a tripod stands by the windows beside the chair." role="img"]
    p#office-live.sr-only [aria-live="polite" role="status"]
    div#office-hud.ui-float.office-hud [aria-label="Your week" role="group"]
      span#hud-week.hud-chip
      button#hud-due.hud-chip.hud-chip-due [hidden type="button"]
        "Due today"
      span#hud-clock.hud-chip [aria-hidden="true" hidden]
    nav#office-bar.ui-float.office-bar [aria-label="The office"]
      button#bar-binoculars.office-btn.office-btn-primary [hidden title="Put down the binoculars (Escape)" type="button"]
        "Put down the binoculars"
      button#bar-new.office-btn.office-btn-primary [title="New application (N)" type="button"]
        "New application"
      button#bar-computer.office-btn [title="Open the computer (C)" type="button"]
        "Computer"
      button#bar-places.office-btn [aria-controls="places-menu" aria-expanded="false" type="button"]
        "Places"
      button#bar-day.office-btn [type="button"]
        "Watch a day go by"
      button#bar-outtray.office-btn [title="Backups and exports" type="button"]
        "Out-tray"
      button#bar-wastebasket.office-btn [type="button"]
        "Wastebasket"
      button#bar-settings.office-btn [type="button"]
        "Settings"
      button#bar-undo.office-btn [disabled title="Undo (Ctrl or Command and Z)" type="button"]
        "Undo"
    div#places-menu.places-menu [aria-label="Places in the office" hidden role="group"]
    div#office-toast.office-toast [hidden]
      span#toast-text
      button#toast-undo.office-btn.office-btn-small [hidden type="button"]
        "Undo"
      button#toast-share.office-btn.office-btn-small [hidden type="button"]
        "Share my week"
    div#welcome.card-overlay [hidden]
      div#welcome-panel.card-panel.welcome-panel [aria-describedby="welcome-intro" aria-labelledby="welcome-title" aria-modal="true" role="dialog" tabindex="-1"]
        h2#welcome-title.card-title
          "Corner Office"
        p#welcome-intro.card-detail
          "A job search tracker that lives in a 3D office. Your applications, interviews and follow-ups fill the furniture, and everything you enter stays in this browser and goes nowhere else."
        p#welcome-look.card-meta
          "Drag to look around, and scroll or pinch to zoom. The arrow keys and the + and − keys do the same."
        p#welcome-resume.card-meta [hidden]
        p#storage-note.storage-note
        div#welcome-actions.card-actions
        p.welcome-explore-row
          a#explore-link.welcome-explore [href="/"]
            "More 3D worlds to explore at SceneXP.com"
    div#computer.card-overlay.computer-overlay [hidden]
      div#computer-panel.card-panel.computer-panel [aria-labelledby="computer-title" aria-modal="true" role="dialog" tabindex="-1"]
        div.computer-head
          h2#computer-title.card-title
            "Applications"
          button#computer-close.office-btn.office-btn-small [type="button"]
            "Back to the desk"
        div.grid-summary
          p#grid-count.grid-count
          p.grid-week
            span#grid-week
            label [for="grid-goal"]
              "Weekly goal"
            input#grid-goal.office-input.grid-goal [inputmode="numeric" max="100" min="1" type="number"]
            button#grid-share.office-btn.office-btn-small [hidden type="button"]
              "Share my week"
        div.grid-tools
          label.sr-only [for="grid-search"]
            "Search every application"
          input#grid-search.office-input.grid-search [autocomplete="off" placeholder="Search companies, roles, notes and postings" spellcheck="false" type="search"]
          label.grid-sort-label [for="grid-sort"]
            "Sort by"
          select#grid-sort.office-select
          button#grid-dir.office-btn.office-btn-small [aria-label="Reverse the order" type="button"]
            "↓"
          button#grid-new.office-btn.office-btn-primary.office-btn-small [type="button"]
            "New application"
        div.grid-filter-row
          div#grid-filters.grid-filters [aria-label="Filters" role="group"]
          button#grid-clear.office-btn.office-btn-small [hidden type="button"]
            "Clear the search and filters"
        div.grid-scroll
          table#grid-table.grid-table
            caption.sr-only
              "Your applications"
            thead
              tr
                th#grid-h-company [aria-sort="none" scope="col"]
                  button#grid-sort-company.grid-sort [type="button"]
                    "Company"
                th#grid-h-role [scope="col"]
                  "Role"
                th#grid-h-people [scope="col"]
                  "People"
                th#grid-h-status [aria-sort="none" scope="col"]
                  button#grid-sort-status.grid-sort [type="button"]
                    "Status"
                th#grid-h-applied [aria-sort="none" scope="col"]
                  button#grid-sort-applied.grid-sort [type="button"]
                    "Applied"
                th#grid-h-next [scope="col"]
                  "Next up"
                th#grid-h-salary [aria-sort="none" scope="col"]
                  button#grid-sort-salary.grid-sort [type="button"]
                    "Salary"
                th#grid-h-activity [aria-sort="none" scope="col"]
                  button#grid-sort-activity.grid-sort [type="button"]
                    "Last activity"
            tbody#grid-body
          div#grid-empty.grid-empty [hidden]
            p#grid-empty-text
            div#grid-empty-actions.card-actions
    div#calendar.card-overlay [hidden]
      div#calendar-panel.card-panel.calendar-panel [aria-labelledby="calendar-title" aria-modal="true" role="dialog" tabindex="-1"]
        div.computer-head
          h2#calendar-title.card-title
            "Calendar"
          button#calendar-close.office-btn.office-btn-small [type="button"]
            "Close"
        div.cal-nav
          button#cal-prev.office-btn.office-btn-small [type="button"]
            "Previous month"
          button#cal-this.office-btn.office-btn-small [type="button"]
            "This month"
          button#cal-next.office-btn.office-btn-small [type="button"]
            "Next month"
        table.cal-table
          caption.sr-only
            "The days of the month. The arrow keys move between days."
          thead
            tr
              th [abbr="Monday" scope="col"]
                "Mon"
              th [abbr="Tuesday" scope="col"]
                "Tue"
              th [abbr="Wednesday" scope="col"]
                "Wed"
              th [abbr="Thursday" scope="col"]
                "Thu"
              th [abbr="Friday" scope="col"]
                "Fri"
              th [abbr="Saturday" scope="col"]
                "Sat"
              th [abbr="Sunday" scope="col"]
                "Sun"
          tbody#cal-body
        p.cal-key [aria-hidden="true"]
          span.cal-dot
          "An event"
          span.cal-ring
          "A follow-up"
        h3#cal-day-title.card-subtitle
        ul#cal-day-list.folder-list
        div.card-actions
          button#cal-export.office-btn [type="button"]
            "Add everything coming up to my calendar"
    div#cabinet.card-overlay.sheet-overlay [hidden]
      div#cabinet-panel.card-panel.sheet-panel [aria-labelledby="cabinet-title" aria-modal="true" role="dialog" tabindex="-1"]
        div.computer-head
          h2#cabinet-title.card-title
            "The filing cabinet"
          button#cabinet-close.office-btn.office-btn-small [type="button"]
            "Back to the desk"
        div.grid-tools
          label.sr-only [for="cabinet-search"]
            "Search the folders"
          input#cabinet-search.office-input.grid-search [autocomplete="off" placeholder="Search to lift the folders that match" spellcheck="false" type="search"]
          label.grid-sort-label [for="cabinet-sort"]
            "File by"
          select#cabinet-sort.office-select
        div#cabinet-filters.grid-filters.cabinet-filters [aria-label="Filters" role="group"]
        p#cabinet-lifted.card-meta.cabinet-lifted [aria-live="polite" role="status"]
        ul#cabinet-list.cabinet-list
    div#board.card-overlay.sheet-overlay [hidden]
      div#board-panel.card-panel.sheet-panel [aria-describedby="board-summary" aria-labelledby="board-title" aria-modal="true" role="dialog" tabindex="-1"]
        div.computer-head
          h2#board-title.card-title
            "The pinboard"
          button#board-close.office-btn.office-btn-small [type="button"]
            "Back to the desk"
        p#board-summary.card-meta
        p.card-meta.board-hint
          "Drag a card to another column to change its status, or tap or click a card to open its folder."
        form#board-form.board-move [novalidate]
          label [for="board-card"]
            "Card"
          select#board-card.office-select
          label [for="board-to"]
            "Move to"
          select#board-to.office-select
          button#board-move.office-btn.office-btn-primary.office-btn-small [type="submit"]
            "Move"
    div#rolodex.card-overlay.sheet-overlay [hidden]
      div#rolodex-panel.card-panel.sheet-panel [aria-describedby="rolodex-count" aria-labelledby="rolodex-title" aria-modal="true" role="dialog" tabindex="-1"]
        div.computer-head
          h2#rolodex-title.card-title
            "The Rolodex"
          button#rolodex-close.office-btn.office-btn-small [type="button"]
            "Close"
        div.grid-tools
          label.sr-only [for="rolodex-search"]
            "Search the people"
          input#rolodex-search.office-input.grid-search [autocomplete="off" placeholder="Type a name, a company or a title" spellcheck="false" type="search"]
          button#rolodex-new.office-btn.office-btn-primary.office-btn-small [type="button"]
            "New contact"
        p#rolodex-count.card-meta [aria-live="polite" role="status"]
        ul#rolodex-list.rolodex-list
    div#whiteboard.card-overlay.sheet-overlay [hidden]
      div#whiteboard-panel.card-panel.sheet-panel [aria-labelledby="whiteboard-title" aria-modal="true" role="dialog" tabindex="-1"]
        div.computer-head
          h2#whiteboard-title.card-title
            "The whiteboard"
          button#whiteboard-close.office-btn.office-btn-small [type="button"]
            "Back to the desk"
        ul#wb-summary.wb-summary
        p.grid-week
          label [for="wb-goal"]
            "Weekly goal"
          input#wb-goal.office-input.grid-goal [inputmode="numeric" max="100" min="1" type="number"]
          button#wb-share.office-btn.office-btn-small [hidden type="button"]
            "Share my week"
        details.wb-tables
          summary
            "The numbers as tables"
          table.wb-table
            caption
              "How far they got"
            thead
              tr
                th [scope="col"]
                  "Stage"
                th [scope="col"]
                  "Applications"
            tbody#wb-funnel
          table.wb-table
            caption
              "Sent each week"
            thead
              tr
                th [scope="col"]
                  "Week of"
                th [scope="col"]
                  "Sent"
            tbody#wb-weeks
    div#today.card-overlay [hidden]
      div#today-panel.card-panel.form-panel [aria-describedby="today-note" aria-labelledby="today-title" aria-modal="true" role="dialog" tabindex="-1"]
        h2#today-title.card-title
          "Today"
        p#today-note.card-meta
        ul#today-list.folder-list
        p.card-meta
          "A calendar file puts every interview and follow-up coming up into the calendar you already use, each with a reminder, so they find you even when the office is closed."
        div.card-actions
          button#today-close.office-btn [type="button"]
            "Close"
          button#today-calendar.office-btn [type="button"]
            "Open the calendar"
          button#today-export.office-btn.office-btn-primary [type="button"]
            "Add everything coming up to my calendar"
    div#folder.card-overlay [hidden]
      div#folder-panel.card-panel.folder-panel [aria-labelledby="folder-title" aria-modal="true" role="dialog" tabindex="-1"]
        div.computer-head
          h2#folder-title.card-title
          button#folder-close.office-btn.office-btn-small [type="button"]
            "Close the folder"
        div#folder-body.folder-body
        div#folder-actions.card-actions
    div#contact.card-overlay [hidden]
      div#contact-panel.card-panel.folder-panel [aria-labelledby="contact-title" aria-modal="true" role="dialog" tabindex="-1"]
        div.computer-head
          h2#contact-title.card-title
          button#contact-close.office-btn.office-btn-small [type="button"]
            "Close"
        div#contact-body.folder-body
        div#contact-actions.card-actions
    div#wastebasket.card-overlay [hidden]
      div#wastebasket-panel.card-panel [aria-describedby="wastebasket-note" aria-labelledby="wastebasket-title" aria-modal="true" role="dialog" tabindex="-1"]
        h2#wastebasket-title.card-title
          "The wastebasket"
        p#wastebasket-note.card-detail
        ul#wastebasket-list.folder-list
        div.card-actions
          button#wastebasket-close.office-btn [type="button"]
            "Close"
          button#wastebasket-empty.office-btn.office-btn-danger [type="button"]
            "Empty the wastebasket"
    div#outtray.card-overlay [hidden]
      div#outtray-panel.card-panel [aria-describedby="outtray-intro" aria-labelledby="outtray-title" aria-modal="true" role="dialog" tabindex="-1"]
        h2#outtray-title.card-title
          "The out-tray"
        p#outtray-intro.card-detail
          "Your office lives only in this browser. A backup file keeps it safe and carries it to another device."
        div.outtray-actions
          button#outtray-backup.office-btn.office-btn-primary [type="button"]
            "Save a backup"
          button#outtray-csv.office-btn [type="button"]
            "Export applications for a spreadsheet"
          button#outtray-ics.office-btn [type="button"]
            "Add everything coming up to my calendar"
          button#outtray-print.office-btn [type="button"]
            "Print a prep sheet"
          label.office-btn.office-file [for="outtray-restore"]
            "Restore from a backup"
          input#outtray-restore.sr-only [accept="application/json,.json" type="file"]
        p#outtray-note.card-meta [role="status"]
        div.card-actions
          button#outtray-close.office-btn [type="button"]
            "Close"
    div#printer.card-overlay [hidden]
      div#printer-panel.card-panel.form-panel [aria-describedby="printer-intro" aria-labelledby="printer-title" aria-modal="true" role="dialog" tabindex="-1"]
        h2#printer-title.card-title
          "The printer"
        p#printer-intro.card-detail
          "A one-page prep sheet for an interview: the company, the people you will meet, what has happened so far, your notes, and room for your questions. Your browser's print dialog can also save it as a PDF."
        div#printer-choose.form-row
          label [for="printer-app"]
            "Which application"
          select#printer-app.office-select
        p#printer-empty.card-meta [hidden]
          "There is nothing to print yet. A prep sheet is made from an application, so add one first and it will be here."
        div.card-actions
          button#printer-close.office-btn [type="button"]
            "Close"
          button#printer-print.office-btn.office-btn-primary [type="button"]
            "Print"
    div#settings.card-overlay [hidden]
      div#settings-panel.card-panel [aria-labelledby="settings-title" aria-modal="true" role="dialog" tabindex="-1"]
        h2#settings-title.card-title
          "Settings"
        form#settings-form.office-form [novalidate]
          div.form-row
            label [for="set-goal"]
              "Applications to send each week"
            input#set-goal.office-input [inputmode="numeric" required type="number"]
          div.form-row
            label [for="set-followup"]
              "Days before a follow-up reminder"
            input#set-followup.office-input [inputmode="numeric" required type="number"]
          div.form-row
            label [for="set-ghost"]
              "Days of silence before an application has gone quiet"
            input#set-ghost.office-input [inputmode="numeric" required type="number"]
          div.card-actions
            button#settings-save.office-btn.office-btn-primary [type="submit"]
              "Save settings"
        h3.card-subtitle
          "Sample records"
        p.card-meta
          "Samples are invented companies and people, there to show the office full. They are marked Sample everywhere, and clearing them leaves your own records alone."
        div.card-actions
          button#settings-stock.office-btn [type="button"]
            "Stock the office with samples"
          button#settings-clear-samples.office-btn [hidden type="button"]
            "Clear the samples"
        h3.card-subtitle
          "Start over"
        div.card-actions
          button#settings-clear-all.office-btn.office-btn-danger [type="button"]
            "Clear the whole office"
          button#settings-close.office-btn [type="button"]
            "Close"
    div#application-form.card-overlay [hidden]
      div#application-form-panel.card-panel.form-panel [aria-labelledby="application-form-title" aria-modal="true" role="dialog" tabindex="-1"]
        button#application-form-close.card-x [aria-label="Close" title="Close (Escape)" type="button"]
          "&times;"
        h2#application-form-title.card-title
          "New application"
        form#af-form.office-form [novalidate]
          div.form-row
            label [for="af-company"]
              "Company"
            input#af-company.office-input [autocomplete="organization" type="text"]
          div.form-row
            label [for="af-role"]
              "Role"
            input#af-role.office-input [autocomplete="off" type="text"]
          div#af-follow-row.form-row.form-check
            input#af-follow [checked type="checkbox"]
            label#af-follow-text [for="af-follow"]
              "Remind me to follow up"
          details#af-more.form-more
            summary
              "More details"
            div#af-status-row.form-row
              label [for="af-status"]
                "Status"
              select#af-status.office-select
            div.form-row
              label [for="af-applied"]
                "Applied on"
              input#af-applied.office-input [type="date"]
            div.form-row
              label [for="af-posting"]
                "The job posting"
              textarea#af-posting.office-input [placeholder="Paste the whole posting here. It is kept just as it is." rows="4"]
              p#af-found.form-found [hidden]
                span#af-found-text
                button#af-use-found.office-btn.office-btn-small [type="button"]
                  "Use these"
            div.form-row
              label [for="af-url"]
                "Link to the posting"
              input#af-url.office-input [autocomplete="off" inputmode="url" type="url"]
            div.form-row
              label [for="af-source"]
                "Found through"
              input#af-source.office-input [placeholder="A referral, a job board, a recruiter" type="text"]
            div.form-row
              label [for="af-location"]
                "Location"
              input#af-location.office-input [type="text"]
            div.form-row
              label [for="af-workmode"]
                "Where the work happens"
              select#af-workmode.office-select
            fieldset.form-row.form-salary
              legend
                "Salary"
              label [for="af-salary-min"]
                "From"
              input#af-salary-min.office-input [inputmode="numeric" min="0" type="number"]
              label [for="af-salary-max"]
                "To"
              input#af-salary-max.office-input [inputmode="numeric" min="0" type="number"]
              label [for="af-period"]
                "Per"
              select#af-period.office-select
              label [for="af-currency"]
                "Currency"
              input#af-currency.office-input.form-currency [autocomplete="off" maxlength="3" type="text"]
            div.form-row
              label [for="af-notes"]
                "Notes"
              textarea#af-notes.office-input [rows="3"]
          p#af-error.form-error [hidden role="alert"]
          div.card-actions
            button#af-cancel.office-btn [type="button"]
              "Cancel"
            button#af-save.office-btn.office-btn-primary [type="submit"]
              "Save application"
    div#event-form.card-overlay [hidden]
      div#event-form-panel.card-panel.form-panel [aria-describedby="event-form-about" aria-labelledby="event-form-title" aria-modal="true" role="dialog" tabindex="-1"]
        button#event-form-close.card-x [aria-label="Close" title="Close (Escape)" type="button"]
          "&times;"
        h2#event-form-title.card-title
          "Log an event"
        p#event-form-about.card-meta
        form#ef-form.office-form [novalidate]
          div.form-row
            label [for="ef-type"]
              "What kind"
            select#ef-type.office-select
          div.form-row
            label [for="ef-at"]
              "When"
            input#ef-at.office-input [type="datetime-local"]
          div.form-row
            label [for="ef-title"]
              "A short description"
            input#ef-title.office-input [placeholder="Panel with the design team" type="text"]
          div.form-row.form-pair
            div
              label [for="ef-duration"]
                "Minutes"
              input#ef-duration.office-input [inputmode="numeric" min="1" type="number"]
            div
              label [for="ef-round"]
                "Round"
              input#ef-round.office-input [inputmode="numeric" min="1" type="number"]
          fieldset#ef-with-row.form-row.form-with [hidden]
            legend
              "Who was there"
            div#ef-with.form-with-list
          div.form-row
            label [for="ef-outcome"]
              "How it went"
            select#ef-outcome.office-select
          div.form-row
            label [for="ef-notes"]
              "Notes"
            textarea#ef-notes.office-input [rows="3"]
          p#ef-error.form-error [hidden role="alert"]
          div.card-actions
            button#ef-cancel.office-btn [type="button"]
              "Cancel"
            button#ef-save.office-btn.office-btn-primary [type="submit"]
              "Save"
    div#task-form.card-overlay [hidden]
      div#task-form-panel.card-panel.form-panel [aria-describedby="task-form-about" aria-labelledby="task-form-title" aria-modal="true" role="dialog" tabindex="-1"]
        button#task-form-close.card-x [aria-label="Close" title="Close (Escape)" type="button"]
          "&times;"
        h2#task-form-title.card-title
          "Add a follow-up"
        p#task-form-about.card-meta
        form#tf-form.office-form [novalidate]
          div.form-row
            label [for="tf-text"]
              "What to do"
            input#tf-text.office-input [placeholder="Send a thank-you note" type="text"]
          div.form-row
            label [for="tf-due"]
              "When"
            input#tf-due.office-input [type="date"]
          p#tf-error.form-error [hidden role="alert"]
          div.card-actions
            button#tf-cancel.office-btn [type="button"]
              "Cancel"
            button#tf-save.office-btn.office-btn-primary [type="submit"]
              "Save"
    div#contact-form.card-overlay [hidden]
      div#contact-form-panel.card-panel.form-panel [aria-describedby="contact-form-about" aria-labelledby="contact-form-title" aria-modal="true" role="dialog" tabindex="-1"]
        button#contact-form-close.card-x [aria-label="Close" title="Close (Escape)" type="button"]
          "&times;"
        h2#contact-form-title.card-title
          "New contact"
        p#contact-form-about.card-meta
        form#cf-form.office-form [novalidate]
          div.form-row
            label [for="cf-name"]
              "Name"
            input#cf-name.office-input [autocomplete="off" type="text"]
          div.form-row.form-pair
            div
              label [for="cf-title"]
                "Title"
              input#cf-title.office-input [autocomplete="off" placeholder="Recruiter" type="text"]
            div
              label [for="cf-company"]
                "Company"
              input#cf-company.office-input [autocomplete="off" type="text"]
          div.form-row.form-pair
            div
              label [for="cf-email"]
                "Email"
              input#cf-email.office-input [autocomplete="off" inputmode="email" type="email"]
            div
              label [for="cf-phone"]
                "Phone"
              input#cf-phone.office-input [autocomplete="off" inputmode="tel" type="tel"]
          div.form-row
            label [for="cf-linkedin"]
              "LinkedIn"
            input#cf-linkedin.office-input [autocomplete="off" inputmode="url" type="url"]
          div.form-row
            label [for="cf-notes"]
              "Notes"
            textarea#cf-notes.office-input [placeholder="How you met, what you talked about" rows="3"]
          p#cf-error.form-error [hidden role="alert"]
          div.card-actions
            button#cf-cancel.office-btn [type="button"]
              "Cancel"
            button#cf-save.office-btn.office-btn-primary [type="submit"]
              "Save"
    div#confirm.card-overlay [hidden]
      div#confirm-panel.card-panel [aria-describedby="confirm-detail" aria-labelledby="confirm-title" aria-modal="true" role="dialog" tabindex="-1"]
        h2#confirm-title.card-title
        p#confirm-detail.card-detail
        div#confirm-actions.card-actions
    section#print-sheet.print-sheet [aria-hidden="true"]
    script [src="../lib/three/r186/three.min.js" type="module"]
    script [src="js/main.min.js" type="module"]"
`;

exports[`www/privacy.html 1`] = `
"<!doctype html>
html [lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="How SceneXP handles your privacy: no accounts, no cookies, no third-party trackers, just anonymized usage counts and ordinary server logs." name="description"]
    meta [content="#f7f7fb" media="(prefers-color-scheme: light)" name="theme-color"]
    meta [content="#0e0f14" media="(prefers-color-scheme: dark)" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/privacy.html" rel="canonical"]
    meta [content="Privacy | SceneXP" property="og:title"]
    meta [content="How SceneXP handles your privacy: no accounts, no cookies, no third-party trackers, just anonymized usage counts and ordinary server logs." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="SceneXP" property="og:site_name"]
    meta [content="https://www.scenexp.com/privacy.html" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/assets/og-image.jpg?v=4" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="Four scenes from the SceneXP collection in a grid: a glowing orange fractal spiral, a 3D football field with orange and blue players in the middle of a play, a row of red-fruited trees in a green garden, and the blue curve of Earth seen from orbit with a targeting reticle and incoming raiders. Below them the SceneXP.com wordmark and the line, 3D worlds, games, and experiments, right in your browser." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="Privacy | SceneXP" name="twitter:title"]
    meta [content="No accounts, no cookies, no third-party trackers, just anonymized usage counts and ordinary server logs." name="twitter:description"]
    meta [content="https://www.scenexp.com/assets/og-image.jpg?v=4" name="twitter:image"]
    meta [content="Four scenes from the SceneXP collection in a grid: a glowing orange fractal spiral, a 3D football field with orange and blue players in the middle of a play, a row of red-fruited trees in a green garden, and the blue curve of Earth seen from orbit with a targeting reticle and incoming raiders. Below them the SceneXP.com wordmark and the line, 3D worlds, games, and experiments, right in your browser." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "@id": "https://www.scenexp.com/privacy.html#webpage",
        "url": "https://www.scenexp.com/privacy.html",
        "name": "SceneXP Privacy",
        "description": "How SceneXP handles your privacy.",
        "inLanguage": "en-US",
        "isPartOf": {
          "@id": "https://www.scenexp.com/#website"
        }
      }
    title
      "Privacy | SceneXP"
    link [as="style" href="/css/site.min.css?v=9" rel="preload"]
    link [href="/favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="/css/site.min.css?v=9" rel="stylesheet"]
    script [src="/js/theme.min.js?v=1"]
    script [defer src="/js/nav.min.js?v=1"]
  body
    a.skip-link [href="#main"]
      "Skip to main content"
    header.site-header
      div.container.site-header-inner
        a.brand [href="/"]
          svg.brand-mark [aria-hidden="true" focusable="false" viewbox="0 0 32 32"]
            defs
              lineargradient#brand-grad [x1="0" x2="1" y1="0" y2="1"]
                stop [offset="0" stop-color="#6c4cf1"]
                stop [offset="1" stop-color="#06b6d4"]
            rect [fill="url(#brand-grad)" height="32" rx="8" width="32"]
            path [d="M8 22 14 10l4 8 3-5 3 9" fill="none" stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"]
          "SceneXP"
        nav#site-nav.site-nav [aria-label="Main"]
          ul
            li
              a [href="/#experiences"]
                "Experiences"
            li
              a [href="/avatar/"]
                "Avatar"
            li
              a [href="/contact.html"]
                "Contact"
            li
              a [href="/contribute.html"]
                "Contribute"
        button#nav-toggle.nav-toggle [aria-controls="site-nav" aria-expanded="false" aria-label="Menu" hidden type="button"]
          svg.icon-nav-open [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            path [d="M4 7h16M4 12h16M4 17h16"]
          svg.icon-nav-close [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            path [d="M6 6l12 12M18 6 6 18"]
        button#theme-toggle.theme-toggle [aria-label="Theme" hidden type="button"]
          svg.icon-theme-light [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            circle [cx="12" cy="12" fill="currentColor" r="4.5" stroke="none"]
            path [d=#f2e7be5368]
          svg.icon-theme-dark [aria-hidden="true" focusable="false" viewbox="0 0 24 24"]
            path [d=#bac0ce3668 fill="currentColor"]
          svg.icon-theme-system [aria-hidden="true" focusable="false" viewbox="0 0 24 24"]
            circle [cx="12" cy="12" fill="none" r="8.5" stroke="currentColor" stroke-width="2"]
            path [d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor"]
    main#main
      div.page-hero
        div.container
          h1
            "Your privacy, plainly"
          p
            "This site was built to delight you, not to follow you around. Here is the complete picture of what it does and does not do with your visit."
      div.section
        div.container.prose
          h2
            "What this site never does"
          ul
            li
              "No accounts and nothing to sign up for."
            li
              "No cookies."
            li
              "No third-party scripts, fonts, trackers, or advertising of any kind. Every file you load comes from this domain."
            li
              "No selling or sharing of anything about your visit with anyone."
          h2
            "What stays on your device"
          ul
            li
              strong
                "Your theme choice."
              "If you pick light or dark mode, that preference is saved in your browser's local storage. It never leaves your device."
            li
              strong
                "A small puzzle token."
              "The contact page and the 3D experiences ask your browser to solve a tiny proof-of-work puzzle that deters spam robots. The solved token is kept in your browser's session storage and expires on its own. It is the one item on this list that does travel: it rides along with the usage pings described below, so that one visit's pings can be grouped together, and a short piece of it becomes the reference in the subject line if you email us from the contact page."
            li
              strong
                "Your progress inside an experience, while the tab is open."
              "Each 3D experience remembers your discovery checklist progress and whether you have already seen its little celebration messages. That lives in your browser's session storage and is cleared when the tab closes."
            li
              strong
                "A few things that are meant to outlast the visit."
              "Where an experience would be poorer for forgetting, it saves to your browser's local storage instead, so it is still there when you come back. The Fractal Garden saves your garden: which trees you planted, where you planted them, and how they are getting on. The garden has a Start a new garden button that clears its save on the spot. Earth Defense saves your best score along with your sound and control settings."
            li
              strong
                "Your game of X's and O's."
              "X's and O's saves your best score in your browser's local storage, along with the last play you called, the defense you chose to face, the colors you chose for the teams and the field, whether you turned the sound on or off, and whether you turned on Auto jump, so the game comes back the way you left it. It also keeps a game you have not finished, which is the play number, the running score, and one line for each play so far, so closing the tab halfway through does not cost you the whole game. That one is cleared as soon as the game ends, and the Start over button in the playbook clears it on the spot."
            li
              strong
                "Your job search in Corner Office."
              "Corner Office keeps everything you enter, your applications, interviews, contacts and follow-ups, along with your settings and which things in the office you have already opened, in your browser's local storage, so your office is just as you left it when you come back. None of it is ever sent anywhere: its usage pings say only what kind of thing you did, such as adding an application, and never anything you typed. Its Share my week button makes a picture of your week right on your device, with just how many applications you sent each week and your weekly goal, never a company or a role, and hands it only to your own share sheet or downloads folder. Its Out-tray saves a backup you can keep, and its Settings can clear the office on the spot."
            li
              strong
                "Your best time in Leaf Blower."
              "When you clear the whole lawn before the clock runs out, the leaf blower game keeps your fastest time, just the number of seconds, in your browser's local storage, so you have a time to beat. The Forget my best time button on the welcome card clears it on the spot. The person on leaf duty is your avatar, described below. A character chosen on the game's own card before October 26, 2026 is moved into your avatar the next time the game opens, and the old record is removed."
            li
              strong
                "Your avatar."
              "When you save an avatar on the Your Avatar page, its choices are kept in your browser's local storage: its face, eyes, expression, hair, build, clothes and shoes, each one picked from a short list or, for a color, from your browser's color picker, with no name and nothing typed. Beside them is a small picture of its face, drawn right on your device. Nothing about your avatar is ever sent to us, and it is never in our usage pings. The page's pings, described below, count only what kind of thing was done, such as a save or a change to the hair, and never what was chosen. A link or a file you make to move it to another device holds only those choices, and the part of the link that holds them is never sent to our server. A picture or a short video you export of your avatar is made right on your device and handed only to your own share sheet or downloads folder. The Forget my avatar button on that page clears it on the spot."
            li
              strong
                "Your cars in Derby Day."
              "Derby Day saves your cars in your browser's local storage, up to four of them, so they are waiting on the workbench when you come back: each car's name, number, shape, paint, decals, weights and axle work, its best result in each race, your last race, the trophies you have won, how you dressed your family on the family card, whether you chose metric units or turned the sound on, and the first name you last put on a challenge, if you typed one. A challenge link holds the car you send and that name, nothing else. It is made on your device, and the part of the link that holds them is never sent to our server, by you or by the friend who opens it. The Forget my cars button in the workbench's settings clears all of it on the spot."
            li
              strong
                "Your home in Whitestone Home Care."
              "The Whitestone demo keeps the home you build in your browser's local storage, so it is waiting for you when you come back: the kind of home, its floors and rooms, the tasks you chose with their options, stars, and notes, your care preferences, and where you are in Maya's steps. Photos you add to a task are resized and stripped of their location before they are saved, in your browser's own database. There is no Whitestone server, so a checklist you book is kept only in this same browser too, sealed so that it opens only with its link and PIN. If you open a shared checklist on its cleaner's page, that page keeps the checklist's key, a pass that lasts for the visit, the visit's marks and add-ons, and a sealed copy for the hours of the visit, along with any photos taken as proof of the work, for up to 30 days. It also keeps a copy of its own page files so that it can reopen without a connection. Maya's Start over link clears everything the demo keeps on the spot, once you confirm it."
            li
              strong
                "Your last meme in Meme Studio."
              "Meme Studio keeps the meme you are making in your browser's local storage, so it is just as you left it when you come back: which meme you picked, your captions, the face chosen for each panel, and the avatar of a friend in it, whether you added them from their link or file or they sent you the meme, along with anyone you dressed yourself with Customize. Your own avatar is read from where the Your Avatar page keeps it, never copied. None of it is ever sent to us. The page's usage pings say only which meme you picked and what kind of thing you did, such as saving a picture, and never anything you typed. A picture you make of your meme is made right on your device and handed only to your own share sheet or downloads folder. A link you share holds the meme, your captions, your avatar and the looks of the other people you put in it, in the part of the link that is never sent to our server, by you or by the friend who opens it. The Start over button clears your meme on the spot."
            li
              strong
                "You can remove any of it whenever you like."
              "Apart from that puzzle token, everything above stays on your device and is never sent to us or to anyone else. Clearing this site's data in your browser settings removes all of it at once."
          h2
            "What the web server keeps"
          p
            "Each time your browser asks this site for something, the web server writes a short line to its log, the way nearly every website does. That line includes your IP address, the time, the address of what was asked for, the page that sent you here, and the brief description your browser gives of itself, such as its name, its version, and your operating system. We use these logs only to keep the site running and secure, for example to track down a fault or turn away an attack. They are never sold or shared, never used to build a picture of who you are, and are deleted automatically within a year."
          h2
            "Anonymous usage pings"
          p
            "As visitors explore the 3D experiences, the pages send simple pings to this same domain, such as "someone found the waterfall." Each ping names the experience it came from and carries your browser's language setting, a note of whether you are on a phone or a computer, and the puzzle token that groups one visit's pings together. The pings land in a separate log of their own, which never records your IP address or the description your browser gives of itself."
          p
            "The pings are gathered into a public summary for each day, which anyone can read, and which Steve's office displays inside the world itself as a little visitor dashboard. Each visit appears under a throwaway label, such as "Curious Otter," as a timeline of its pings and the time each one arrived, along with its language setting and whether it came from a phone or a computer. The puzzle token stays private, and the summary carries no names, no IP addresses, and no browser fingerprints. Because each visit's pings are listed with their times, someone who already knew exactly when you visited could recognize your visit in the summary."
          p
            "X's and O's notes a little more, because the game is the plays. Each time you call a play, snap the ball, or throw it, and each time a play ends, it records the play and the defense, the receiver you picked, how it turned out and what it was worth, along with your running score, whether the sound was on, and whether your screen was held upright or sideways. These notes appear in the public summary along with the rest of the visit. It never records the size of your screen or anything else that could pick your device out from anyone else's."
          p
            "Whitestone Home Care sends a ping for each button you press, saying only which one and where, such as adding a kitchen from Maya's suggestions, along with whether a demo booking went through and whether a cleaner's PIN opened the checklist. It never sends anything you typed, a price, a date or time, or the PIN itself."
          h2
            "If you email us"
          p
            "Your message and address are used only to reply to you. That is the whole story."
          h2
            "Questions"
          p
            "If anything here gives you pause, please"
            a [href="/contact.html"]
              "reach out"
            ". We are happy to explain anything in more detail."
          p
            em
              "Last updated October 28, 2026."
    footer.site-footer
      div.container.site-footer-inner
        div.footer-brand
          a.brand [href="/"]
            svg.brand-mark [aria-hidden="true" focusable="false" viewbox="0 0 32 32"]
              defs
                lineargradient#brand-grad-footer [x1="0" x2="1" y1="0" y2="1"]
                  stop [offset="0" stop-color="#6c4cf1"]
                  stop [offset="1" stop-color="#06b6d4"]
              rect [fill="url(#brand-grad-footer)" height="32" rx="8" width="32"]
              path [d="M8 22 14 10l4 8 3-5 3 9" fill="none" stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"]
            "SceneXP"
          p
            "3D worlds, games, and experiments, every one running right in your browser. Thank you for visiting."
        nav.footer-nav [aria-label="Explore"]
          h2
            "Explore"
          ul
            li
              a [href="/#experiences"]
                "Experiences"
            li
              a [href="/avatar/"]
                "Your avatar"
            li
              a [href="/contact.html"]
                "Contact"
            li
              a [href="/contribute.html"]
                "Contribute"
        nav.footer-nav [aria-label="Project"]
          h2
            "Project"
          ul
            li
              a [href="https://github.com/stevendnoll/SceneXP" rel="noopener noreferrer" target="_blank" title="View the SceneXP source code on GitHub"]
                "GitHub"
            li
              a [aria-current="page" href="/privacy.html"]
                "Privacy"
            li
              a [href="/terms.html"]
                "Terms"
        div.footer-meta
          p
            "Built with Three.js and browser-native HTML, CSS, and JavaScript. Open source under the MIT license."
          p
            "SceneXP © 2026"
            a [href="https://www.continuumcommercellc.com/" rel="noopener noreferrer" target="_blank" title="View the Continuum Commerce LLC website"]
              "Continuum Commerce LLC"
            ".""
`;

exports[`www/roqui/index.html 1`] = `
"<!doctype html>
html [data-ui-theme="neon" lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="Step into a joyful 3D Zumba class led by Roqui, a wonderful instructor at the Matt Griffin YMCA. Catch the beat, meet the class, fire up the speakers, and find the disco ball." name="description"]
    meta [content="#ff2d78" name="theme-color"]
