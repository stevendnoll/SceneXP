    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "@id": "https://www.scenexp.com/avatar/#app",
        "url": "https://www.scenexp.com/avatar/",
        "name": "Your Avatar",
        "datePublished": "2026-10-27",
        "image": "https://www.scenexp.com/avatar/assets/og-avatar.jpg?v=1",
        "description": "A browser-based 3D avatar maker for SceneXP. Choose a face shape, eyes, eyebrows, a nose, an expression, hair and facial hair in any color, a build, clothes, shoes and a hat on a figure that turns on a plinth in a white studio, and save it. The avatar is kept only in the visitor's own browser, and SceneXP scenes that show the visitor as a person dress them that way. It can be moved to another device with a link or a small file.",
        "applicationCategory": "EntertainmentApplication",
        "operatingSystem": "Any",
        "browserRequirements": "Requires JavaScript. The 3D studio needs WebGL 2.",
        "inLanguage": "en-US",
        "isPartOf": {
          "@type": "WebSite",
          "@id": "https://www.scenexp.com/#website"
        },
        "isAccessibleForFree": true,
