    title
      "SceneXP | 3D Worlds, Games, and Experiments"
    link [as="style" href="/css/site.min.css?v=9" rel="preload"]
    link [href="/favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="/css/site.min.css?v=9" rel="stylesheet"]
    link [href="/shared/css/avatar-1.0.0.min.css" rel="stylesheet"]
    script [src="/js/theme.min.js?v=1"]
    script [defer src="/js/nav.min.js?v=1"]
    script [src="/js/home.min.js?v=2" type="module"]
    link [href="/shared/js/avatar-1.0.0.min.js" rel="modulepreload"]
    script [src="/js/avatar-chip.min.js" type="module"]
  body
    a.skip-link [href="#main"]
      "Skip to main content"
    header.site-header
      div.container.site-header-inner
        a.brand [href="/"]
          svg.brand-mark [aria-hidden="true" focusable="false" viewbox="0 0 32 32"]
            defs
              lineargradient#brand-grad [x1="0" x2="1" y1="0" y2="1"]
                stop [offset="0" stop-color="#6c4cf1"]
                stop [offset="1" stop-color="#06b6d4"]
            rect [fill="url(#brand-grad)" height="32" rx="8" width="32"]
            path [d="M8 22 14 10l4 8 3-5 3 9" fill="none" stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"]
          "SceneXP"
        nav#site-nav.site-nav [aria-label="Main"]
          ul
            li
              a [href="/#experiences"]
                "Experiences"
            li
              a [href="/avatar/"]
                "Avatar"
            li
              a [href="/contact.html"]
                "Contact"
            li
              a [href="/contribute.html"]
                "Contribute"
        button#nav-toggle.nav-toggle [aria-controls="site-nav" aria-expanded="false" aria-label="Menu" hidden type="button"]
          svg.icon-nav-open [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            path [d="M4 7h16M4 12h16M4 17h16"]
          svg.icon-nav-close [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            path [d="M6 6l12 12M18 6 6 18"]
        button#theme-toggle.theme-toggle [aria-label="Theme" hidden type="button"]
          svg.icon-theme-light [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewbox="0 0 24 24"]
            circle [cx="12" cy="12" fill="currentColor" r="4.5" stroke="none"]
            path [d=#f2e7be5368]
          svg.icon-theme-dark [aria-hidden="true" focusable="false" viewbox="0 0 24 24"]
            path [d=#bac0ce3668 fill="currentColor"]
          svg.icon-theme-system [aria-hidden="true" focusable="false" viewbox="0 0 24 24"]
            circle [cx="12" cy="12" fill="none" r="8.5" stroke="currentColor" stroke-width="2"]
            path [d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor"]
    main#main
      section#experiences.section [aria-labelledby="experiences-heading"]
        div.container
          div.section-head
            h1#experiences-heading
              "3D worlds, games, and experiments, right in your browser"
            p
              "No app, no download, nothing to install."
          section.spotlight#spotlight [aria-labelledby="spotlight-heading" aria-roledescription="carousel"]
            h2#spotlight-heading
              "Featured"
            ul.spotlight-slides
              li.spotlight-slide.is-active [aria-label="1 of 4" aria-roledescription="slide" data-slug="meme"]
                a [href="/meme/"]
                  div.spotlight-media
                    img [alt="A 3D meme on a painted city street: three figures walk toward the camera on a sidewalk, each labeled in white meme letters. MEMES, on the left, has a purple bob, a lilac top, a black mini skirt and fishnet tights. ME, in the middle, has a beard and a navy sweater and glances toward MEMES with an open mouth. WORK, on the right, frowns in a yellow beanie and a teal T-shirt." decoding="async" fetchpriority="high" height="630" loading="eager" src="/meme/assets/og-meme.webp?v=2" width="1200"]
                  div.spotlight-body
                    p.spotlight-date
                      "Released"
                      time [datetime="2026-10-28"]
                        "October 28, 2026"
                    p.experience-eyebrow
                      "Put yourself in the meme"
                    h3
                      "Meme Studio"
                    p.spotlight-text
                      "Your avatar stars in a 3D meme you caption yourself. Share it as a picture, or send a link a friend can remix with their own avatar."
                    span.experience-cta
                      "Make your meme →"
              li.spotlight-slide [aria-label="2 of 4" aria-roledescription="slide" data-slug="derby"]
                a [href="/derby/"]
                  div.spotlight-media
                    img [alt="Four wooden derby cars in blue, yellow, green and orange crossing a checkered finish line side by side, seen from above in a photo finish." decoding="async" height="630" loading="lazy" src="/derby/assets/og-derby.webp?v=1" width="1200"]
                  div.spotlight-body
                    p.spotlight-date
                      "Released"
                      time [datetime="2026-10-20"]
                        "October 20, 2026"
                    p.experience-eyebrow
                      "A wooden derby car race"
                    h3
                      "Derby Day"
                    p.spotlight-text
                      "Carve a wooden derby car, tune its axles and race it down a four-lane track. Then send it to a friend and see whose car is faster."
                    span.experience-cta
                      "Build your car →"
              li.spotlight-slide [aria-label="3 of 4" aria-roledescription="slide" data-slug="leaves"]
                a [href="/leaves/"]
                  div.spotlight-media
                    img [alt="A person with a leaf blower stands on the front walk of a white board and batten house, beside a porch with pumpkins and an orange wreath on the door, while a long pile of red, orange and gold leaves sweeps across the lawn onto a blue tarp by the hedge, and the afternoon sun throws leafy tree shadows across the grass and the siding." decoding="async" height="630" loading="lazy" src="/leaves/assets/og-leaves.webp?v=1" width="1200"]
                  div.spotlight-body
                    p.spotlight-date
                      "Released"
                      time [datetime="2026-10-09"]
                        "October 9, 2026"
                    p.experience-eyebrow
                      "A leaf blower game in an autumn front yard"
                    h3
                      "Leaf Blower"
                    p.spotlight-text
                      "Twelve thousand autumn leaves and a leaf blower. Blow them onto the tarp before the clock runs out, then take a running dive into the pile."
                    span.experience-cta
                      "Grab the leaf blower →"
              li.spotlight-slide [aria-label="4 of 4" aria-roledescription="slide" data-slug="xo"]
                a [href="/xo/"]
                  div.spotlight-media
                    img [alt="A 3D football field seen from high behind the offense in the middle of a play. Orange players with a white X on their jerseys run routes against blue defenders marked O, with lettered rings A to D under the receivers and Q under the quarterback. The 5, 15, 30 and 50 point lines are painted across the green turf, and fans in orange and blue fill the stands on both sides." decoding="async" height="630" loading="lazy" src="/xo/assets/og-xo.webp?v=1" width="1200"]
                  div.spotlight-body
                    p.spotlight-date
                      "Released"
                      time [datetime="2026-09-14"]
                        "September 14, 2026"
                    p.experience-eyebrow
                      "A football game where you call the plays"
                    h3
                      "X's and O's"
                    p.spotlight-text
                      "You are on offense for all ten plays. Pick a play, snap the ball, then throw to an open receiver or keep it and run. 500 is a perfect game."
                    span.experience-cta
                      "Call the first play →"
          section.experience-group [aria-labelledby="worlds-and-games" data-category="worlds"]
            h2#worlds-and-games
              "Worlds and games"
            ul.experience-grid
              li.experience-card [data-slug="meme"]
                a [href="/meme/"]
                  img [alt="A 3D meme on a painted city street: three figures walk toward the camera on a sidewalk, each labeled in white meme letters. MEMES, on the left, has a purple bob, a lilac top, a black mini skirt and fishnet tights. ME, in the middle, has a beard and a navy sweater and glances toward MEMES with an open mouth. WORK, on the right, frowns in a yellow beanie and a teal T-shirt." decoding="async" height="630" loading="lazy" src="/meme/assets/og-meme.webp?v=2" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "Put yourself in the meme"
                    h3
                      "Meme Studio"
                    p
                      "Your avatar stars in a meme built from small lit 3D boxes. Pick one of ten templates, type a caption for each panel, choose the faces, and bring a friend's avatar in too. Then share it as a picture, or as a link your friend can open and remix with their own avatar."
                    p.experience-date
                      "Released"
                      time [datetime="2026-10-28"]
                        "October 28, 2026"
                    span.experience-cta
                      "Make your meme →"
              li.experience-card [data-slug="derby"]
                a [href="/derby/"]
                  img [alt="Four wooden derby cars in blue, yellow, green and orange crossing a checkered finish line side by side, seen from above in a photo finish." decoding="async" height="630" loading="lazy" src="/derby/assets/og-derby.webp?v=1" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "A wooden derby car race"
                    h3
                      "Derby Day"
                    p
                      "Carve a wooden derby car on the workbench, weigh it, tune its axles and give it a name, then race it down a four-lane track against the neighbors' cars, timed to the thousandth by real physics. Send your car to a friend and race head to head."
                    p.experience-date
                      "Released"
                      time [datetime="2026-10-20"]
                        "October 20, 2026"
                    span.experience-cta
                      "Build your car →"
              li.experience-card [data-slug="leaves"]
                a [href="/leaves/"]
                  img [alt="A person with a leaf blower stands on the front walk of a white board and batten house, beside a porch with pumpkins and an orange wreath on the door, while a long pile of red, orange and gold leaves sweeps across the lawn onto a blue tarp by the hedge, and the afternoon sun throws leafy tree shadows across the grass and the siding." decoding="async" height="630" loading="lazy" src="/leaves/assets/og-leaves.webp?v=1" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "A leaf blower game in an autumn front yard"
                    h3
                      "Leaf Blower"
                    p
                      "Twelve thousand autumn leaves cover the front yard, and every one tumbles, skids and piles up on its own. Blow them onto the tarp before the clock runs out, keep them out of the neighbor's yard, then take a running dive into the pile. Or skip the clock and just play with the leaves."
                    p.experience-date
                      "Released"
                      time [datetime="2026-10-09"]
                        "October 9, 2026"
                    span.experience-cta
                      "Grab the leaf blower →"
              li.experience-card [data-slug="office"]
                a [href="/office/"]
                  img [alt="A white desk with a computer and a slim lamp in a corner office high over a city at sunset, floor-to-ceiling windows looking past glass towers to the bay, the sun glittering on the water and snowy mountains beyond." decoding="async" height="630" loading="lazy" src="/office/assets/og-office.webp?v=1" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "A job search tracker in a 3D office"
                    h3
                      "Corner Office"
                    p
                      "A working job search tracker in a corner office forty floors above the bay. Your applications, interviews and follow-ups fill the furniture, every application you send earns a firework over the water, and every record stays private in your own browser. Lift the binoculars and you might spot the orcas."
                    p.experience-date
                      "Released"
                      time [datetime="2026-09-28"]
                        "September 28, 2026"
                    span.experience-cta
                      "Step into the office →"
              li.experience-card [data-slug="tornado"]
                a [href="/tornado/"]
                  img [alt="A pale tornado reaching down from a dark, turning storm base to a cloud of dust and flying debris, just left of a small farm with a red barn, across golden fields with wildflowers in the foreground." decoding="async" height="630" loading="lazy" src="/tornado/assets/og-tornado.webp?v=1" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "A storm chaser's view of a tornado"
                    h3
                      "Tornado Alley"
                    p
                      "Thirty seconds on the open prairie, beginning on a calm summer evening. A storm organizes on the horizon, its base begins to turn, and a tornado touches down far out across the fields. Nobody is in its path, though it does pick a few things up along the way."
                    p.experience-date
                      "Released"
                      time [datetime="2026-09-23"]
                        "September 23, 2026"
                    span.experience-cta
                      "Watch the storm roll in →"
              li.experience-card [data-slug="xo"]
                a [href="/xo/"]
                  img [alt="A 3D football field seen from high behind the offense in the middle of a play. Orange players with a white X on their jerseys run routes against blue defenders marked O, with lettered rings A to D under the receivers and Q under the quarterback. The 5, 15, 30 and 50 point lines are painted across the green turf, and fans in orange and blue fill the stands on both sides." decoding="async" height="630" loading="lazy" src="/xo/assets/og-xo.webp?v=1" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "A football game where you call the plays"
                    h3
                      "X's and O's"
                    p
                      "You are on offense for all ten plays. Pick a play from the playbook, snap the ball, then throw to an open receiver or keep it and run. The farther you carry it the more the play is worth, and 500 is a perfect game."
                    p.experience-date
                      "Released"
                      time [datetime="2026-09-14"]
                        "September 14, 2026"
                    span.experience-cta
                      "Call the first play →"
              li.experience-card [data-slug="garden"]
                a [href="/garden/"]
                  img [alt="Five fractal fruit trees in full summer leaf, their canopies heavy with red fruit, standing on dark mulch mounds in a walled garden plot. Each trunk has a small blue water gauge at its base. Behind the wall a pale lake sits below gray rolling hills, under a blue sky with white clouds." decoding="async" height="630" loading="lazy" src="/garden/assets/og-garden.webp?v=3" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "A garden you plant and tend yourself"
                    h3
                      "Fractal Garden"
                    p
                      "Plant a garden of fractal trees, then watch it live through the years. Choose from seventeen species, each one grown from its own seed so no two are alike, then tend them through spring blossom, summer fruit, autumn color and winter snow. Every tree you plant is still standing when you come back."
                    p.experience-date
                      "Released"
                      time [datetime="2026-08-26"]
                        "August 26, 2026"
                    span.experience-cta
                      "Plant your first tree →"
              li.experience-card [data-slug="highwater"]
                a [href="/highwater/"]
                  img [alt="A view out to sea under a low gray storm sky, with a branching fork of lightning coming down to the horizon and a small orange and white navigation buoy standing in the heaving gray swell." decoding="async" height="630" loading="lazy" src="/highwater/assets/og-highwater.webp?v=1" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "A study of water and weather"
                    h3
                      "High Water"
                    p
                      "Sixty seconds at the water's edge, beginning on an ordinary bright afternoon. The sky closes over, lightning starts to work along the cloud base, and the surf keeps rising. Please know before you start that the sea does not stay where it belongs."
                    p.experience-date
                      "Released"
                      time [datetime="2026-08-21"]
                        "August 21, 2026"
                    span.experience-cta
                      "Stand at the shore →"
              li.experience-card [data-slug="earthdefense"]
                a [href="/earthdefense/"]
                  img [alt="A ship's-eye view in low Earth orbit: Earth's blue and white limb curves across the bottom of the frame, Mars sits ahead as a small ruddy disc with the targeting reticle just below it, and orange diamonds mark the incoming Martian raiders across a deep starfield." decoding="async" height="630" loading="lazy" src="/earthdefense/assets/og-earthdefense.webp?v=2" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "Built for the joy of flying through space"
                    h3
                      "Earth Defense"
                    p
                      "Fly a single ship in orbit above a massive Earth while twelve Martian raiders close on the installations below. You never need a fire button: line a raider up in the middle of your view and your guns take care of the rest."
                    p.experience-date
                      "Released"
                      time [datetime="2026-08-05"]
                        "August 5, 2026"
                    span.experience-cta
                      "Take the helm →"
              li.experience-card [data-slug="mandelbrot"]
                a [href="/mandelbrot/"]
                  img [alt="A deep zoom into the Mandelbrot set: a giant spiral of glowing red and gold fractal filaments coiling toward its center against dark space." decoding="async" height="630" loading="lazy" src="/mandelbrot/assets/og-mandelbrot.webp" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "For Benoit Mandelbrot"
                    h3
                      "The Mandelbrot Set"
                    p
                      "The most famous shape in mathematics floats in a quiet starfield. Choose a destination on its burning edge, press play, and the auto zoom dives hundreds of billions of times deep, until the numbers themselves run out."
                    p.experience-date
                      "Released"
                      time [datetime="2026-07-28"]
                        "July 28, 2026"
                    span.experience-cta
                      "Begin the dive →"
              li.experience-card [data-slug="steve"]
                a [href="/steve/"]
                  img [alt="Steve's 3D home office: he stands at his sit-stand desk working on SceneXP code while a tuxedo cat sleeps by the window." decoding="async" height="630" loading="lazy" src="/steve/assets/og-steve.webp" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "Where SceneXP gets built"
                    h3
                      "Steve's Home Office"
                    p
                      "Step inside the little office in Steve's house where every one of these experiences gets built. Peek at the code on the monitor, watch for birds on the fence, and please mind the sleeping cat."
                    p.experience-date
                      "Released"
                      time [datetime="2026-07-26"]
                        "July 26, 2026"
                    span.experience-cta
                      "Step inside →"
          section.experience-group [aria-labelledby="small-business-showcases" data-category="business"]
            h2#small-business-showcases
              "Small business showcases"
            ul.experience-grid
              li.experience-card [data-slug="whitestone"]
                a [href="/whitestone/"]
                  img [alt="A 3D model house on a round lawn on a white turntable, its roof lifted off the main floor to show furnished rooms dotted with small blue task markers, while Maya, a host in a white polo and khakis, gestures toward it." decoding="async" height="630" loading="lazy" src="/whitestone/assets/og-whitestone.webp?v=1" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "A concept for a home cleaning company"
                    h3
                      "Whitestone Home Care"
                    p
                      "A concept, not a real company. Build a model of your own home room by room with Maya, your host, see every task priced as you go, then choose a time for a demo visit."
                    p.experience-date
                      "Released"
                      time [datetime="2026-10-16"]
                        "October 16, 2026"
                    span.experience-cta
                      "Plan a cleaning →"
              li.experience-card [data-slug="automan"]
                a [href="/automan/"]
                  img [alt="A 3D dealership desk seen across the showroom floor: three figures sit around a dark wood table holding a deal sheet and a small yellow model car, a whiteboard behind them reads Today's schedule, 2:00 John Walker, and the glass frontage looks out on trucks parked in the lot." decoding="async" height="630" loading="lazy" src="/automan/assets/card-automan.webp?v=1" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "For a car buying advocate"
                    h3
                      "John Walker, The Auto Man"
                    p
                      "Pull up to a dealership desk where John Walker is sitting on the buyer's side of it. Twenty five years of arguing deals down and more than 2,000 cars, in Baltimore or anywhere by Zoom. Tap anyone at the desk to hear their side of it."
                    p.experience-date
                      "Released"
                      time [datetime="2026-09-01"]
                        "September 1, 2026"
                    span.experience-cta
                      "Take a seat →"
              li.experience-card [data-slug="interstate"]
                a [href="/interstate/"]
                  img [alt="A 3D tire shop storefront with an open garage bay beneath the Interstate Tire sign." decoding="async" height="630" loading="lazy" src="/interstate/assets/og-interstate.webp" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "For a neighborhood tire shop"
                    h3
                      "The Interstate Tire Shop"
                    p
                      "Walk into a 3D tire shop built for Interstate Tire in historic Cockeysville, Maryland. See the car up on the lift, catch the waiting room TV, and stroll Railroad Ave to the 1892 freight depot."
                    p.experience-date
                      "Released"
                      time [datetime="2026-07-23"]
                        "July 23, 2026"
                    span.experience-cta
                      "Step inside →"
              li.experience-card [data-slug="seedtoseed"]
                a [href="/seedtoseed/"]
                  img [alt="A 3D backyard vegetable garden with raised beds, a greenhouse, and a picket fence." decoding="async" height="630" loading="lazy" src="/seedtoseed/assets/og-seedtoseed.webp" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "For a gardening business"
                    h3
                      "The Seed to Seed Garden"
                    p
                      "Stroll a 3D backyard garden built for Seed to Seed, a home vegetable gardening company. Wander the raised beds, step inside the greenhouse, and meet the gardener."
                    p.experience-date
                      "Released"
                      time [datetime="2026-07-21"]
                        "July 21, 2026"
                    span.experience-cta
                      "Step inside →"
              li.experience-card [data-slug="sunnyvalejenn"]
                a [href="/sunnyvalejenn/"]
                  img [alt="A bright 3D home office: Jenn works at a light oak desk facing the doorway, the week's plan fills a whiteboard on one wall, a teal clock hangs above her monitor, and a sunny window looks out on a cedar fence and trees." decoding="async" height="630" loading="lazy" src="/sunnyvalejenn/assets/og-sunnyvalejenn.webp?v=1" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "For a small business operations consultant"
                    h3
                      "Sunnyvale Jenn Consulting"
                    p
                      "Look in on the sunny home office of Sunnyvale Jenn Consulting, built for a consultant who untangles the operations that busy founders never find time for. Jenn is at her desk, the week's plan is on the whiteboard, and the birds keep visiting the fence."
                    p.experience-date
                      "Released"
                      time [datetime="2026-07-18"]
                        "July 18, 2026"
                    span.experience-cta
                      "Step inside →"
          section.experience-group [aria-labelledby="personal-tributes" data-category="personal"]
            h2#personal-tributes
              "Personal tributes"
            ul.experience-grid
              li.experience-card [data-slug="jamar"]
                a [href="/jamar/"]
                  img [alt="A 3D karaoke bar at night: Jamar sings on the corner stage under a happy birthday banner while friends raise glasses from a red vinyl booth." decoding="async" height="630" loading="lazy" src="/jamar/assets/og-jamar.webp" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "Happy Birthday, Jamar!"
                    h3
                      "Jamar's Karaoke Night"
                    p
                      "It is karaoke night at the corner bar, and the birthday singer is Steve's best friend Jamar. Settle in, follow the rolling lyrics screen, and tap the jukebox to pick what he sings next."
                    p.experience-date
                      "Released"
                      time [datetime="2026-07-16"]
                        "July 16, 2026"
                    span.experience-cta
                      "Pull up a stool →"
              li.experience-card [data-slug="gavin"]
                a [href="/gavin/"]
                  img [alt="A 3D close-up of a Confederate Jasmine in a cedar planter box, with three kids peering through the leaves in search of the bugs living there." decoding="async" height="630" loading="lazy" src="/gavin/assets/og-gavin.webp" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "For Gavin, age eleven"
                    h3
                      "Gavin's Bug Patrol"
                    p
                      "Every spring, Steve's son Gavin releases ladybugs and praying mantises into the patio plants. Settle in for a close-up of the jasmine, watch the garden change shifts at dusk, and see if you can spot all three mantises."
                    p.experience-date
                      "Released"
                      time [datetime="2026-07-13"]
                        "July 13, 2026"
                    span.experience-cta
                      "Look closer →"
              li.experience-card [data-slug="roqui"]
                a [href="/roqui/"]
                  img [alt="A joyful 3D Zumba class with dancers mid-step and a disco ball overhead." decoding="async" height="630" loading="lazy" src="/roqui/assets/og-roqui.webp" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "For a wonderful instructor"
                    h3
                      "Zumba with Roqui"
                    p
                      "Step into a joyful 3D Zumba class and say hola to Roqui. Catch the beat, fire up the speakers, and find the disco ball."
                    p.experience-date
                      "Released"
                      time [datetime="2026-07-11"]
                        "July 11, 2026"
                    span.experience-cta
                      "Step inside →"
              li.experience-card [data-slug="family"]
                a [href="/family/"]
                  img [alt="A 3D pirate mini golf course in Ocean City, with a pirate ship at its center." decoding="async" height="630" loading="lazy" src="/family/assets/og-family.webp" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "For a family summer memory"
                    h3
                      "Putt Putt with Mom and Dad"
                    p
                      "Play a 3D round of pirate mini golf in Ocean City, Maryland, built from a favorite summer memory. Board the ship and walk the plank hole."
                    p.experience-date
                      "Released"
                      time [datetime="2026-07-08"]
                        "July 8, 2026"
                    span.experience-cta
                      "Step inside →"
              li.experience-card [data-slug="dad"]
                a [href="/dad/"]
                  img [alt="A walkable 3D stretch of the NCR Trail, with the Gunpowder River alongside." decoding="async" height="630" loading="lazy" src="/dad/assets/og-dad.webp" width="1200"]
                  div.experience-card-body
                    p.experience-eyebrow
                      "In memory of a dad"
                    h3
                      "A Ride on the NCR Trail"
                    p
                      "Take a quiet walk on a 3D stretch of Maryland's NCR Trail, built for a dad who rode it nearly every weekend. Find the river and listen for the little waterfall."
                    p.experience-date
                      "Released"
                      time [datetime="2026-07-06"]
                        "July 6, 2026"
                    span.experience-cta
                      "Step inside →"
      section.section [aria-labelledby="for-heading"]
        div.container
          div.section-head
            h2#for-heading
              "What you will find here"
            p
              "The collection wanders on purpose, so it is sorted into three groups above. Here is what each of them holds, and every heading below takes you straight to it."
          ul.audience-grid
            li.audience-card
              h3
                a [href="#worlds-and-games"]
                  "Worlds and games"
              p
                "The ones built for their own sake. Keep your job search in a corner office above the bay, call the plays in a game of football, defend Earth from a Martian fleet, dive hundreds of billions of times deep into the Mandelbrot set, watch a modeled ocean shoal and break on a measured beach, or plant a garden of fractal trees and tend it through the seasons."
            li.audience-card
              h3
                a [href="#small-business-showcases"]
                  "Small business showcases"
              p
                "Real businesses, rebuilt as places you can visit. A dealership desk with a car buying advocate on the buyer's side of it, a tire shop on historic Railroad Ave with a car up on the lift, a backyard vegetable garden with a greenhouse, and a consultant's sunny home office. And one concept: a home cleaning company where you plan your cleaning on a model of your own home."
            li.audience-card
              h3
                a [href="#personal-tributes"]
                  "Personal tributes"
              p
                "Worlds made for a particular person, or to hold on to a particular memory. A quiet trail along the Gunpowder, a karaoke night at the corner bar, a Zumba class, a bug hunt in the jasmine, a round of pirate mini golf."
      section.section [aria-labelledby="how-heading"]
        div.container
          div.section-head
            h2#how-heading
              "Every one of them runs in your browser"
            p
              "No app, no download, no account, and nothing to install. Each experience is browser-native HTML, CSS, and JavaScript with Three.js doing the drawing, served from this domain and nowhere else. There are no third-party scripts, no CDNs, and no trackers anywhere on the site. Open a link and you are already inside."
      section.section [aria-labelledby="commission-heading"]
        div.container
          div.section-head
            h2#commission-heading
              "Built for someone in particular"
            p
              "Several of the worlds above began as a gift. Someone knew a person who deserved a world, or a business that deserved to be more than another template website, and told us the story. We still love making those, so if a person or a place came to mind while you were browsing, we would be glad to hear about it."
          p
            a.btn.btn-ghost [href="/contact.html"]
              "Start the conversation"
      section.cta-band [aria-labelledby="cta-heading"]
        div.container
          div.cta-band-inner
            h2#cta-heading
              "Bring your own little world"
            p
              "SceneXP is open source under the MIT license, and the shared parts library makes a new experience easier to assemble than you might think. Whatever you would build, we would be delighted to host it."
            a.btn [href="/contribute.html"]
              "Read the contributor guide"
    footer.site-footer
      div.container.site-footer-inner
        div.footer-brand
          a.brand [href="/"]
            svg.brand-mark [aria-hidden="true" focusable="false" viewbox="0 0 32 32"]
              defs
                lineargradient#brand-grad-footer [x1="0" x2="1" y1="0" y2="1"]
                  stop [offset="0" stop-color="#6c4cf1"]
                  stop [offset="1" stop-color="#06b6d4"]
              rect [fill="url(#brand-grad-footer)" height="32" rx="8" width="32"]
              path [d="M8 22 14 10l4 8 3-5 3 9" fill="none" stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"]
            "SceneXP"
          p
            "3D worlds, games, and experiments, every one running right in your browser. Thank you for visiting."
        nav.footer-nav [aria-label="Explore"]
          h2
            "Explore"
          ul
            li
              a [href="/#experiences"]
                "Experiences"
            li
              a [href="/avatar/"]
                "Your avatar"
            li
              a [href="/contact.html"]
                "Contact"
            li
              a [href="/contribute.html"]
                "Contribute"
        nav.footer-nav [aria-label="Project"]
          h2
            "Project"
          ul
            li
              a [href="https://github.com/stevendnoll/SceneXP" rel="noopener noreferrer" target="_blank" title="View the SceneXP source code on GitHub"]
                "GitHub"
            li
              a [href="/privacy.html"]
                "Privacy"
            li
              a [href="/terms.html"]
                "Terms"
        div.footer-meta
          p
            "Built with Three.js and browser-native HTML, CSS, and JavaScript. Open source under the MIT license."
          p
            "SceneXP © 2026"
            a [href="https://www.continuumcommercellc.com/" rel="noopener noreferrer" target="_blank" title="View the Continuum Commerce LLC website"]
              "Continuum Commerce LLC"
            "."
    aside#avatar-chip [aria-label="Your avatar"]
      a#avatar-chip-link [href="/avatar/" title="Make an avatar that looks like you"]
        img#avatar-chip-img [alt="Make your avatar" decoding="async" height="64" loading="lazy" src="/assets/avatar/default.png" width="64"]
        span#avatar-chip-label [hidden]
          "Make your avatar"
      button#avatar-chip-hide [aria-label="Hide this note" hidden type="button"]
        svg [aria-hidden="true" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-width="2.4" viewbox="0 0 24 24"]
          path [d="M6 6l12 12M18 6 6 18"]"
`;

