"<!doctype html>
html [data-ui-theme="ember" lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="Float in a softly lit starfield beside the Mandelbrot set, rendered in 3D with a pure black interior and a neon orange burning edge. Then step in and let the auto zoom fly you down a 3D tunnel of glowing fractal terrain, hundreds of billions of times deep, into the seam where the set's two great circles meet." name="description"]
    meta [content="#0b0e20" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/mandelbrot/" rel="canonical"]
    meta [content="The Mandelbrot Set" property="og:title"]
    meta [content="A quiet float through deep space beside the most famous shape in mathematics. Come see the orange fire at the edge." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="SceneXP" property="og:site_name"]
    meta [content="https://www.scenexp.com/mandelbrot/" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/mandelbrot/assets/og-mandelbrot.jpg?v=1" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="A deep zoom into the Mandelbrot set: a giant spiral of glowing red and gold fractal filaments coiling toward its center against dark space." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="The Mandelbrot Set" name="twitter:title"]
    meta [content="A quiet float through deep space beside the most famous shape in mathematics. Come see the orange fire at the edge." name="twitter:description"]
    meta [content="https://www.scenexp.com/mandelbrot/assets/og-mandelbrot.jpg?v=1" name="twitter:image"]
    meta [content="A deep zoom into the Mandelbrot set: a giant spiral of glowing red and gold fractal filaments coiling toward its center against dark space." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "@id": "https://www.scenexp.com/mandelbrot/#webpage",
        "url": "https://www.scenexp.com/mandelbrot/",
        "name": "The Mandelbrot Set",
        "description": "A passive 3D float through deep space beside the Mandelbrot set, its black interior outlined by a neon orange glow, honoring Benoit Mandelbrot.",
        "datePublished": "2026-07-28",
        "inLanguage": "en-US",
        "isPartOf": {
          "@type": "WebSite",
          "@id": "https://www.scenexp.com/#website"
        }
      }
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "SceneXP",
            "item": "https://www.scenexp.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "The Mandelbrot Set",
            "item": "https://www.scenexp.com/mandelbrot/"
          }
        ]
      }
    title
      "The Mandelbrot Set | SceneXP"
    link [as="style" href="../shared/css/styles-1.0.0.min.css?v=7" rel="preload"]
    link [as="style" href="css/experience.min.css?v=2" rel="preload"]
    link [href="../lib/three/r186/three.min.js" rel="modulepreload"]
    link [href="js/main.min.js" rel="modulepreload"]
    link [href="js/config.min.js" rel="modulepreload"]
    link [href="../shared/js/boot-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/scene-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/warmup-1.0.0.min.js" rel="modulepreload"]
    link [href="js/store.min.js" rel="modulepreload"]
    link [href="../shared/js/world-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/telemetry-1.0.0.min.js" rel="modulepreload"]
    link [href="../shared/js/proplist-1.0.0.min.js" rel="modulepreload"]
    link [href="favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    link [href="css/experience.min.css?v=2" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    h1.sr-only
      "The Mandelbrot Set"
    noscript
      div.noscript-fallback
        h1
          "The Mandelbrot Set"
        p
          "This is a 3D visit to the Mandelbrot set, floating in deep space, and it needs JavaScript to run. In the scene you drift in a softly lit starfield while the most famous fractal in mathematics hangs in the middle of your view. Its interior is pure black, its infinitely detailed boundary glows neon orange, and faint nebulae keep the space around it from ever going fully dark. Step in and the auto zoom flies you into the boundary's spirals, as deep as a computer's numbers can go, and one of eleven glowing rings can send the next dive somewhere else. The shape honors Benoit Mandelbrot, who first plotted it in 1980. If you would like a small world like this built for someone you admire, the developer would be glad to hear from you."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        div.loader-title
          "THE MANDELBROT SET"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    div#blocker [tabindex="-1"]
      div#instructions
        p.title
          "WELCOME"
        p.subtitle
          "You are floating in deep space beside the most famous shape in mathematics"
        p.click-prompt
          "Click to drift closer"
        div.controls-hint
          span
            "DIVE"
          "The flight begins as you step in, down into the burning edge. The detail never ends."
          span
            "STEER"
          "Pause or reset with the buttons below. After a reset, tap a glowing ring to dive somewhere new. The question mark in the corner, or Escape, brings you back here."
        a#explore-link.welcome-explore [href="/"]
          "More 3D worlds to explore at SceneXP.com"
    div#depth-chip.depth-chip
    div#dialog-modal.hidden [aria-labelledby="dialog-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#dialog-title.piece-title
            "In the Cosmos"
          p#dialog-message.piece-subtitle
          button.piece-enter.dialog-primary [data-close type="button"]
            "Keep floating"
    canvas#game-canvas [aria-label="A 3D view of deep space: the Mandelbrot set floats ahead, a pure black fractal outlined in glowing neon orange, with stars and faint nebulae all around" role="img"]
    section#prop-panel.prop-panel [aria-labelledby="prop-panel-heading" hidden]
      h2#prop-panel-heading.prop-panel-heading
        "Places to dive"
      p.prop-panel-note
        "Choose a place and the dive begins there. The arrow keys move through the list, and Tab or Escape puts it away."
      ul#prop-list.prop-list
    button#help-btn.ui-float.menu-btn.help-btn [aria-label="Help" title="Help (Esc)" type="button"]
      svg [aria-hidden="true" viewbox="0 0 24 24"]
        circle [cx="12" cy="12" fill="none" r="9"]
        path [d="M9.3 9.2a2.8 2.8 0 1 1 3.4 3.3v1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"]
        circle [cx="12.1" cy="17.4" fill="currentColor" r="1.05" stroke="none"]
    script [src="../lib/three/r186/three.min.js" type="module"]
    script [src="js/main.min.js" type="module"]"
`;

