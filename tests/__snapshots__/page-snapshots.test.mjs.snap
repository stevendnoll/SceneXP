    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="Stroll through a 3D backyard garden built for Seed to Seed, a home vegetable gardening company. Wander the raised beds, step inside the greenhouse, find the pumpkin patch, and meet the gardener himself." name="description"]
    meta [content="#eef3ec" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/seedtoseed/" rel="canonical"]
    meta [content="The Seed to Seed Garden" property="og:title"]
    meta [content="A 3D backyard garden built for Seed to Seed, a home vegetable gardening company. Wander the raised beds, step inside the greenhouse, and meet the gardener." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="The Seed to Seed Garden" property="og:site_name"]
    meta [content="https://www.scenexp.com/seedtoseed/" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/seedtoseed/assets/og-seedtoseed.jpg?v=2" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="A walkable 3D backyard vegetable garden with raised beds and a greenhouse." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="The Seed to Seed Garden" name="twitter:title"]
    meta [content="A 3D backyard garden built for Seed to Seed, a home vegetable gardening company. Wander the beds and meet the gardener." name="twitter:description"]
    meta [content="https://www.scenexp.com/seedtoseed/assets/og-seedtoseed.jpg?v=2" name="twitter:image"]
    meta [content="A walkable 3D backyard vegetable garden with raised beds and a greenhouse." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://www.scenexp.com/seedtoseed/#website",
        "url": "https://www.scenexp.com/seedtoseed/",
        "name": "The Seed to Seed Garden",
        "description": "A walkable 3D backyard vegetable garden built to honor Seed to Seed, a home vegetable and edible gardening company.",
        "inLanguage": "en-US",
        "about": {
          "@type": "LocalBusiness",
          "name": "Seed to Seed",
          "description": "Seed to Seed educates, inspires, and supports home vegetable and edible gardening, from seed sow to seed save.",
          "url": "https://bakersgardens.com/welcome.html",
          "areaServed": "Maryland, Washington DC, Southern Pennsylvania, Northern Virginia"
        }
      }
    title
      "The Seed to Seed Garden"
    link [as="style" href="../shared/css/styles-1.0.0.min.css?v=7" rel="preload"]
    link [as="script" href="../lib/three.min.js" rel="preload"]
    link [href="favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    a.skip-link [href="#biz-btn"]
      "Skip to the page controls"
    h1.sr-only
      "The Seed to Seed Garden"
    noscript
      div.noscript-fallback
        h1
          "The Seed to Seed Garden"
        p
          "This is a walkable 3D backyard vegetable garden, which needs JavaScript to run. It was built with love to honor Seed to Seed, a home vegetable and edible gardening company that educates, inspires, and supports home gardeners from seed sow to seed save. The gardener is out there among his raised beds, happy to say hello. If you would like help with your own garden, Seed to Seed would be glad to hear from you, and if you would like a world like this built for your own business, so would the developer."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="https://bakersgardens.com/services.html" rel="noopener"]
                "Seed to Seed's services"
            li
              a [href="https://bakersgardens.com/welcome.html" rel="noopener"]
                "Seed to Seed's website"
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        img [alt="" height="164" src="assets/seedtoseed.svg" width="230"]
        div.loader-title
          "SEED TO SEED"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    div#blocker
      div#instructions
        img.welcome-logo [alt="" height="78" src="assets/seedtoseed.svg" width="110"]
        p.title
          "WELCOME"
        p.subtitle
          "The Seed to Seed backyard garden"
        p.click-prompt
          "Click to visit the garden"
        p.tour-note
          "The garden will show you around on its own. Move anytime to wander freely."
        div.controls-hint
          span
            "WASD"
          "Move"
          span
            "MOUSE"
          "Look"
    div#hud
      div.crosshair [aria-hidden="true"]
      div#look-label.look-label [aria-live="polite" role="status"]
    div#piece-modal.hidden [aria-labelledby="piece-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#piece-title.piece-title
            "Section"
          p#piece-subtitle.piece-subtitle
          a#piece-enter.piece-enter [href="#"]
            "Enter →"
          button.piece-cancel [data-close]
            "Keep exploring"
    div#help-modal.hidden [aria-labelledby="help-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.help-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#help-title.piece-title
            "Hello"
          p.piece-subtitle
            "Well hello there, welcome to the garden. Everything you see here started as a seed. Have a look around, and mind the drip lines."
          ul.help-list
            li.help-desktop
              strong
                "Move:"
              kbd
                "W"
              kbd
                "A"
              kbd
                "S"
              kbd
                "D"
              "or the arrow keys."
            li.help-desktop
              strong
                "Look:"
              "move the mouse. Click the scene once to capture the cursor. Press"
              kbd
                "Esc"
              "to release it."
            li.help-mobile
              strong
                "Move &amp; look:"
              "use the left joystick to walk and the right joystick to look around."
            li
              strong
                "Autopilot:"
              "the garden shows you around on its own from the moment you step in. Move to take back the controls, and press"
              kbd
                "T"
              "or the tour button (top-left) whenever you would like the tour to resume."
            li
              strong
                "Settings:"
              "the gear icon (top-right) adjusts movement and look sensitivity."
            li
              strong
                "Seed to Seed:"
              "the logo button (top-right) opens the company's own website in a new tab, so you keep your place in the garden."
          a#hello-services.piece-enter [href="https://bakersgardens.com/services.html" rel="noopener" target="_blank"]
            "See what Seed to Seed offers →"
          button.piece-cancel [data-close]
            "Thanks, enjoy the garden!"
          p.piece-footnote
            "The Seed to Seed name and logo are trademarks of their owner and appear here in tribute, with the owner's kind permission."
    div#dialog-modal.hidden [aria-labelledby="dialog-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#dialog-title.piece-title
            "In the Garden"
          p#dialog-message.piece-subtitle
          button.piece-enter.dialog-primary [data-close type="button"]
            "Continue exploring"
          button#dialog-return-btn.piece-cancel.dialog-return.hidden [type="button"]
            "Back to the Garden Gate"
    div#complete-modal.hidden [aria-labelledby="complete-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.complete-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          p.complete-kicker [aria-hidden="true"]
            "★ &nbsp;All discoveries found&nbsp; ★"
          h2#complete-title.piece-title
            "You found every corner of the garden"
          p.piece-subtitle
            "Thank you for taking your time out here. If your own garden could use this kind of care, Seed to Seed designs, builds, coaches, and troubleshoots for home vegetable gardeners, and they would love to hear from you. And if you would like a little world like this built for your business, the developer would too."
          a#complete-services.piece-enter [href="https://bakersgardens.com/services.html" rel="noopener" target="_blank"]
            "Explore Seed to Seed's services →"
          a#complete-contact.piece-cancel [href="/contact.html"]
            "Get a world like this →"
          button#complete-share.piece-cancel.complete-share [type="button"]
            "Share this"
          p#complete-share-status.sr-only [aria-live="polite" role="status"]
          button.piece-cancel [data-close]
            "Keep exploring"
    div#nudge-modal.hidden [aria-labelledby="nudge-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.complete-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          p.complete-kicker [aria-hidden="true"]
            "★ &nbsp;A few discoveries in&nbsp; ★"
          h2#nudge-title.piece-title
            "Enjoying the garden?"
          p.piece-subtitle
            "Thanks for spending a little time among the beds. This garden was built to honor Seed to Seed, who help home gardeners grow more food. If your garden could use a hand, they are wonderful people to know. No rush, the vegetables are not going anywhere."
          a#nudge-services.piece-enter [href="https://bakersgardens.com/services.html" rel="noopener" target="_blank"]
            "Explore Seed to Seed's services →"
          a#nudge-contact.piece-cancel [href="/contact.html"]
            "Want a world like this? Get in touch →"
          button.piece-cancel [data-close]
            "Keep exploring"
    div#whiteboard-view.hidden [aria-label="The garden chalkboard, up close" aria-modal="true" role="dialog"]
      div.whiteboard-backdrop [data-close]
      div.whiteboard-frame
        div.whiteboard-surface
          canvas#whiteboard-canvas.whiteboard-canvas
        div.whiteboard-tray [aria-hidden="true"]
      p#whiteboard-caption.whiteboard-caption
      p.whiteboard-hint [aria-hidden="true"]
        "Drag to pan across the board"
      button.whiteboard-close [aria-label="Step back from the chalkboard" data-close]
        "&times;"
    div#touch-controls
      div#joystick-zone
        div.joystick-base-fixed
          div.joystick-thumb-fixed
      div#look-joystick-zone
        div.joystick-base-fixed
          div.joystick-thumb-fixed
      div#tap-zone
    a#biz-btn.ui-float.menu-btn.biz-btn [aria-label="Visit the Seed to Seed website (opens in a new tab)" href="https://bakersgardens.com/welcome.html" rel="noopener" target="_blank" title="Visit the Seed to Seed website"]
      img [alt="" height="26" src="favicon.svg" width="26"]
    button#autopilot-btn.ui-float.menu-btn.autopilot-btn [aria-label="Toggle the autopilot tour (keyboard shortcut T)" aria-pressed="false" title="Autopilot tour (T)"]
      svg [aria-hidden="true" viewbox="0 0 24 24"]
        path [d=#10d062c4ff stroke-dasharray="2.6 2.2"]
        path [d="M21.5 3.6l.6 7.5-6.1-2.4z" fill="currentColor" stroke="none"]
        circle [cx="5" cy="19" fill="currentColor" r="2.2" stroke="none"]
    button#settings-btn.ui-float.settings-btn [aria-controls="settings-panel" aria-expanded="false" aria-label="Movement settings" title="Movement settings"]
      svg.settings-icon [aria-hidden="true" viewbox="0 0 24 24"]
        path [d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"]
        path [d=#88c0d99db8]
    div#settings-panel.settings-panel.hidden
      div.settings-header
        span
          "Settings"
        button#settings-close.settings-close [aria-label="Close"]
          "&times;"
      div.settings-body
        label.settings-label
          "Walk Speed"
          input#walk-speed-slider [max="14" min="2" step="0.5" type="range" value="6.5"]
          span.settings-value#walk-speed-value
            "6.5"
        label.settings-label
          "Look Sensitivity"
          input#look-speed-slider [max="4" min="0.5" step="0.1" type="range" value="1.0"]
          span.settings-value#look-speed-value
            "1.0"
    canvas#game-canvas [aria-label="A walkable 3D backyard vegetable garden" role="img"]
    script [src="../lib/three.min.js"]
    script [src="js/main.min.js" type="module"]"
`;

exports[`www/steve/index.html 1`] = `
"<!doctype html>
html [lang="en"]
  head
    meta [charset="UTF-8"]
    meta [content="width=device-width, initial-scale=1.0" name="viewport"]
    meta [content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" http-equiv="Content-Security-Policy"]
    meta [content="strict-origin-when-cross-origin" name="referrer"]
    meta [content="Step inside Steve's tiny home office, the room where SceneXP gets built. A 3D micro-environment you can look all the way around, with a standing desk, the room's own source code on the monitor, and a tuxedo cat asleep by the window." name="description"]
    meta [content="#335241" name="theme-color"]
    meta [content="Steve Noll" name="author"]
    link [href="https://www.scenexp.com/steve/" rel="canonical"]
    meta [content="Steve's Home Office" property="og:title"]
    meta [content="A 3D model of the tiny home office where SceneXP gets built. Step in, look all the way around, and say hi to Steve at his standing desk." property="og:description"]
    meta [content="website" property="og:type"]
    meta [content="SceneXP" property="og:site_name"]
    meta [content="https://www.scenexp.com/steve/" property="og:url"]
    meta [content="en_US" property="og:locale"]
    meta [content="https://www.scenexp.com/steve/assets/og-steve.jpg?v=2" property="og:image"]
    meta [content="image/jpeg" property="og:image:type"]
    meta [content="1200" property="og:image:width"]
    meta [content="630" property="og:image:height"]
    meta [content="Steve's 3D home office: he stands at a black sit-stand desk with a laptop showing the SceneXP site and a monitor full of code, a whiteboard on the green wall behind him sketches a plan, build, test, ship, learn loop, and a tuxedo cat sleeps on a small navy desk by the window." property="og:image:alt"]
    meta [content="summary_large_image" name="twitter:card"]
    meta [content="Steve's Home Office" name="twitter:title"]
    meta [content="A 3D model of the tiny home office where SceneXP gets built. Step in and look all the way around." name="twitter:description"]
    meta [content="https://www.scenexp.com/steve/assets/og-steve.jpg?v=2" name="twitter:image"]
    meta [content="Steve's 3D home office: he stands at a black sit-stand desk with a laptop showing the SceneXP site and a monitor full of code, a whiteboard on the green wall behind him sketches a plan, build, test, ship, learn loop, and a tuxedo cat sleeps on a small navy desk by the window." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://www.scenexp.com/steve/#website",
        "url": "https://www.scenexp.com/steve/",
        "name": "Steve's Home Office",
        "description": "A 3D model of the home office in Steve's house where SceneXP gets built, to look all the way around.",
        "inLanguage": "en-US",
        "author": {
          "@type": "Person",
          "name": "Steve Noll",
          "url": "https://devsteve.com/",
          "sameAs": [
            "https://devsteve.com/"
          ]
        }
      }
    title
      "Steve's Home Office"
    link [as="style" href="../shared/css/styles-1.0.0.min.css?v=7" rel="preload"]
    link [as="style" href="css/experience.min.css?v=1" rel="preload"]
    link [as="script" href="../lib/three.min.js" rel="preload"]
    link [href="favicon.svg" rel="icon" type="image/svg+xml"]
    link [href="../shared/css/styles-1.0.0.min.css?v=7" rel="stylesheet"]
    link [href="css/experience.min.css?v=1" rel="stylesheet"]
    noscript
      link [href="../shared/css/no-js-1.0.0.min.css" rel="stylesheet"]
  body
    a.skip-link [href="#settings-btn"]
      "Skip to the settings button"
    h1.sr-only
      "Steve's Home Office"
    noscript
      div.noscript-fallback
        h1
          "Steve's Home Office"
        p
          "This is a 3D model of the developer's tiny home office, which needs JavaScript to run. It is the room where SceneXP itself gets built: a standing desk with a MacBook and a big Samsung monitor, his son's little blue desk, and a tuxedo cat asleep in the window light. Steve is in there right now, typing away on the very site you are reading. If you would like a small world like this built for someone you love, he would be glad to hear from you."
        nav [aria-label="Site sections"]
          ul
            li
              a [href="/contact.html"]
                "Contact the developer"
            li
              a [href="/privacy.html"]
                "Privacy"
    div#loading-screen
      div.loader-content
        div.loader-title
          "STEVE'S HOME OFFICE"
        div.loader-bar [aria-hidden="true"]
          div.loader-progress#load-progress
        div.loader-status#load-status [aria-live="polite" role="status"]
          "Loading…"
    div#blocker [tabindex="-1"]
      div#instructions
        p.title
          "WELCOME"
        p.subtitle
          "Steve is at his desk, building SceneXP"
        p.click-prompt#begin-prompt
          "Click to step inside"
        div.controls-hint
          span
            "LOOK AROUND"
          "Drag the room, or use the arrow keys. It turns all the way around."
          span
            "LOOK CLOSER"
          "Click anything in here, or Steve himself, for a little of its story."
        a#explore-link.welcome-explore [href="/"]
          "More 3D worlds to explore at SceneXP.com"
    div#piece-modal.hidden [aria-labelledby="piece-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#piece-title.piece-title
            "Section"
          p#piece-subtitle.piece-subtitle
          a#piece-enter.piece-enter [href="#"]
            "Enter →"
          button.piece-cancel [data-close]
            "Keep exploring"
    div#help-modal.hidden [aria-labelledby="help-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.help-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#help-title.piece-title
            "Well, hi there!"
          p.piece-subtitle
            "Welcome to my office! This is the room where SceneXP gets built, modeled after my real home office. Make yourself at home, just mind the cat. She had a long night."
          ul.help-list
            li.help-desktop
              strong
                "Look around:"
              "drag the room, or hold the arrow keys or"
              kbd
                "A"
              "and"
              kbd
                "D"
              ". It turns all the way around. Scroll to zoom."
            li.help-mobile
              strong
                "Look around:"
              "drag the room with a finger, and pinch to zoom. It turns all the way around."
            li
              strong
                "Look closer:"
              span.help-verb
                "click"
              "the things in here. Most of them have a story."
            li.help-desktop
              strong
                "No mouse?"
              "Press"
              kbd
                "Tab"
              "for a list of everything in the room."
            li
              strong
                "Settings:"
              "the gear icon (top-right) sets the brightness."
          p.piece-subtitle
            "Worlds like this one are the playful half of what I do. The rest of it, the software and the sites I build for people, lives over at devSteve.com."
          a#help-site.piece-enter [href="https://devsteve.com/" rel="noopener noreferrer" target="_blank"]
            "See more of my work at devSteve.com &rarr;"
          button.piece-cancel [data-close]
            "Thanks, Steve!"
    div#monitor-view.hidden [aria-label="The monitor on Steve's desk, up close" aria-modal="true" role="dialog"]
      div.monitor-backdrop [data-close]
      div.monitor-frame
        div.monitor-bezel
          div.monitor-screen
            canvas#monitor-canvas.monitor-canvas [aria-label="A code editor showing this room's own source" role="img"]
            div.monitor-glass [aria-hidden="true"]
        div.monitor-neck [aria-hidden="true"]
        div.monitor-base [aria-hidden="true"]
      pre#monitor-source.sr-only
      p#monitor-caption.monitor-caption
      button.monitor-close [aria-label="Step back from the monitor" data-close]
        "&times;"
    div#dialog-modal.hidden [aria-labelledby="dialog-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          h2#dialog-title.piece-title
            "In the Office"
          p#dialog-message.piece-subtitle
          button.piece-enter.dialog-primary [data-close type="button"]
            "Keep exploring"
    div#complete-modal.hidden [aria-labelledby="complete-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.complete-card
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          p.complete-kicker [aria-hidden="true"]
            "★ &nbsp;All discoveries found&nbsp; ★"
          h2#complete-title.piece-title
            "You found all of it"
          p.piece-subtitle
            "Thank you for poking around my little office. Everything in here is real, this is the actual room in my house where SceneXP gets built, cat and all. If you would like a small world like this made for someone you love, or for your business, I would genuinely love to hear from you."
          a#complete-contact.piece-enter [href="/contact.html"]
            "Get in touch →"
          button#complete-share.piece-cancel.complete-share [type="button"]
            "Share this"
          p#complete-share-status.sr-only [aria-live="polite" role="status"]
          button.piece-cancel [data-close]
            "Keep exploring"
    div#nudge-modal.hidden [aria-labelledby="nudge-title" aria-modal="true" role="dialog"]
      div.modal-backdrop [data-close]
      div.modal-container.piece-card.complete-card [tabindex="-1"]
        button.modal-close [aria-label="Close" data-close]
          "&times;"
        div.piece-card-content
          p.complete-kicker [aria-hidden="true"]
            "★ &nbsp;A few stops into the visit&nbsp; ★"
          h2#nudge-title.piece-title
            "Enjoying the visit?"
          p.piece-subtitle
            "Thanks for looking around. This is a 3D model of the real home office where SceneXP gets built, desk, monitor, cat and all. Rooms like this one are the playful half of what I do. If you are curious about the rest of it, my portfolio is one tab away."
          a#nudge-site.piece-enter [href="https://devsteve.com/" rel="noopener noreferrer" target="_blank"]
            "See more of my work at devSteve.com &rarr;"
          button.piece-cancel [data-close]
            "Keep exploring"
    div#analytics-view.hidden [aria-labelledby="analytics-title" aria-modal="true" role="dialog"]
      div.analytics-backdrop [data-close]
      div.analytics-panel
        div.analytics-header
          div.analytics-title-wrap
            h2#analytics-title
              "Visitor activity"
            p#analytics-status.analytics-status [aria-live="polite" role="status"]
          div.analytics-nav
            button#analytics-prev.analytics-navbtn [aria-label="Show the day before" type="button"]
              "&lsaquo;"
            span#analytics-date.analytics-date
            button#analytics-next.analytics-navbtn [aria-label="Show the day after" type="button"]
              "&rsaquo;"
          button#analytics-collapse-all.analytics-collapseall [aria-label="Collapse all sessions" type="button"]
            "Collapse all"
          button.analytics-close [aria-label="Step back from the display" data-close type="button"]
            "&times;"
        div.analytics-controls
          label.analytics-field [for="analytics-group"]
            "Group by"
            select#analytics-group.analytics-select
              option [value="session"]
                "Visit"
              option [value="scene"]
                "Scene"
          label.analytics-field [for="analytics-scene"]
            "Scene"
            select#analytics-scene.analytics-select
          fieldset.afilter
            legend.afilter-legend
              span
                "Show"
              span#analytics-filter-summary.afilter-summary
              button#analytics-select-all.afilter-btn [type="button"]
                "All"
              button#analytics-clear-all.afilter-btn [type="button"]
                "None"
            div#analytics-actions
        div#analytics-body.analytics-body
        p.analytics-foot
          "Anonymous and aggregated. Throwaway labels only, with no names, no addresses, and nothing that could pick one device out from another."
          a [href="/privacy.html"]
            "How this works"
    button#settings-btn.ui-float.settings-btn [aria-controls="settings-panel" aria-expanded="false" aria-label="Settings" title="Settings"]
      svg.settings-icon [aria-hidden="true" viewbox="0 0 24 24"]
        path [d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"]
        path [d=#88c0d99db8]
    button#help-btn.ui-float.menu-btn.help-btn [aria-label="How this works" title="How this works" type="button"]
      svg [aria-hidden="true" viewbox="0 0 24 24"]
        circle [cx="12" cy="12" fill="none" r="9"]
        path [d="M9.3 9.2a2.8 2.8 0 1 1 3.4 3.3v1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"]
        circle [cx="12.1" cy="17.4" fill="currentColor" r="1.05" stroke="none"]
    div#settings-panel.settings-panel.hidden
      div.settings-header
        span
          "Settings"
        button#settings-close.settings-close [aria-label="Close"]
          "&times;"
      div.settings-body
        label.settings-label
          "Ambient Brightness"
          input#settings-light-slider [max="1.5" min="0" step="0.05" type="range" value="1"]
          span.settings-value#settings-light-value
            "100%"
    div#light-panel.settings-panel.hidden [aria-labelledby="light-panel-title" role="dialog"]
      div.settings-header
        span#light-panel-title
          "Office Lighting"
        button#light-close.settings-close [aria-label="Close" data-close]
          "&times;"
      div.settings-body
        p.light-hint
          "Set the mood. Steve works at every brightness, and the cat sleeps through all of them."
        label.settings-label
          "Ambient Brightness"
          input#light-slider [max="1.5" min="0" step="0.05" type="range" value="1"]
          span.settings-value#light-value
            "100%"
    div#office-toast.office-toast [aria-live="polite" role="status"]
    canvas#game-canvas [aria-label="A 3D view of Steve's home office from beside the closet door: Steve works at his sit-stand desk, seen in profile, a whiteboard on the wall behind him sketches a plan, build, test, ship, learn loop, and a tuxedo cat sleeps on a small blue desk by the window" role="img"]
    section#prop-panel.prop-panel [aria-labelledby="prop-panel-heading" hidden]
      h2#prop-panel-heading.prop-panel-heading
        "Things in the room"
      p.prop-panel-note
        "Choose anything for a little of its story. The arrow keys move through the list, Escape closes whatever opens, and Tab or Escape puts this list away."
      ul#prop-list.prop-list
    script [src="../lib/three.min.js"]
    script [src="js/main.min.js" type="module"]"
`;

exports[`www/sunnyvalejenn/index.html 1`] = `
"<!doctype html>
html [lang="en"]
  head
