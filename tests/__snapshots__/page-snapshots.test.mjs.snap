    meta [content="A joyful 3D Zumba class, built with love for a wonderful instructor. Step in and catch the beat." name="twitter:description"]
    meta [content="https://www.scenexp.com/roqui/assets/og-roqui.jpg?v=1" name="twitter:image"]
    meta [content="Roqui's 3D Zumba class mid-song: lights down, disco ball spinning, the class dancing in front of the mirror wall." name="twitter:image:alt"]
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "@id": "https://www.scenexp.com/roqui/#webpage",
