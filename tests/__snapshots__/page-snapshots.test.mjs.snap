        "name": "Gavin's Bug Patrol",
        "description": "A passive 3D close-up of the Confederate Jasmine where Gavin releases his ladybugs and praying mantises every spring.",
        "datePublished": "2026-07-13",
        "inLanguage": "en-US",
        "isPartOf": {
          "@type": "WebSite",
          "@id": "https://www.scenexp.com/#website"
        }
      }
    script [type="application/ld+json"]
      {
        "@context": "https://schema.org",
